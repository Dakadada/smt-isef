   314	                      expected_rows=expected_rows, completeness='passed', accessibility_configuration=accessibility,
   315	                      accessibility_variants='one recorded J3 configuration only; no window sensitivity available',
   316	                      region_biotype_note='J6 gene-only annotation may have region not_available; biotype absent in J6',
   317	                      fraction_denominator='accessibility_evaluated; None when zero; failures retained as status categories',
   318	                      duplex_scope='minimum anywhere in target+flank; not footprint constrained')
   319	        commit(base, result, dict(config=config(), partial_markers=identities, expected_rows=expected_rows))
