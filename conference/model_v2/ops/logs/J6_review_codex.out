   381	def run_shard(*, genome, genes, asos, shard, output_dir, identities: Mapping,
   382	              max_mismatch=3) -> Path:
   383	    """Commit/reuse one shard; .done is the sole completeness marker.
   384	
   385	    Per-shard advisory locks serialize concurrent retries. Orphan temporary files
   386	    are ignored; absent/invalid markers or changed parameters force a rebuild.
   387	    """
   388	    import pyarrow as pa
   389	    import pyarrow.parquet as pq
   390	    _budget(max_mismatch)
   391	    if not {"fasta", "gtf"} <= identities.keys():
   392	        raise ValueError("both FASTA and GTF identities are required")
   393	    genes = _genes(genes)
   394	    asos = tuple(sorted(asos, key=lambda a: a.aso_id))
   395	    if not asos or len({a.aso_id for a in asos}) != len(asos):
   396	        raise ValueError("distinct ASO IDs required")
   397	    output_dir = Path(output_dir)
   398	    output_dir.mkdir(parents=True, exist_ok=True)
   399	    path = output_dir / (shard.shard_id + ".parquet")
   400	    done = path.with_suffix(".done")
   401	    import feng.scan.seed_extend as scanner
   402	    params = dict(version=VERSION, assembly=ASSEMBLY, annotation=ANNOTATION,
   403	                  shard=asdict(shard), max_mismatch=max_mismatch, mode="substitutions",
   404	                  asos=[dict(aso_id=a.aso_id, sequence=a.sequence_5to3) for a in asos],
   405	                  gene_universe_sha256=_digest([asdict(g) for g in genes]),
   406	                  implementation_sha256=_sha256(__file__), scanner_sha256=_sha256(scanner.__file__))
   407	    expected = json.loads(_json(dict(params=params, identities=identities)))
   408	    with path.with_suffix(".lock").open("a") as lock:
   409	        fcntl.flock(lock, fcntl.LOCK_EX)
   410	        _check_identities(identities)
   411	        try:
   412	            manifest = json.loads(done.read_text())
   413	            if (all(manifest.get(k) == v for k, v in expected.items()) and
   414	                    manifest["sha256"] == _sha256(path) and
   415	                    manifest["rows"] == pq.read_metadata(path).num_rows):
   416	                return path
   417	        except (OSError, ValueError, KeyError, TypeError, pa.ArrowException):
   418	            pass
   419	        # Invalidate the old commit marker BEFORE replacing its data file.
   420	        done.unlink(missing_ok=True)
   421	        _fsync_dir(output_dir)
   422	        sites = enumerate_sites(genome, genes, asos, max_mismatch=max_mismatch, shard=shard)
   423	        _check_identities(identities)
   424	        table = pa.Table.from_pylist([asdict(s) for s in sites], schema=_schema())
   425	        temps = []
   426	        try:
   427	            fd, temp = tempfile.mkstemp(prefix=shard.shard_id + ".", suffix=".tmp", dir=output_dir)
   428	            os.close(fd)
   429	            temps.append(Path(temp))
   430	            pq.write_table(table, temp, compression="zstd")
   431	            with open(temp, "rb") as handle:
   432	                os.fsync(handle.fileno())
   433	            sha = _sha256(temp)
   434	            os.replace(temp, path)
   435	            _fsync_dir(output_dir)
   436	            manifest = dict(**expected, rows=table.num_rows, sha256=sha)
   437	            _check_identities(identities)
   438	            fd, temp = tempfile.mkstemp(prefix=shard.shard_id + ".", suffix=".tmp", dir=output_dir)
   439	            temps.append(Path(temp))
   440	            with os.fdopen(fd, "w") as handle:
   441	                handle.write(_json(manifest) + "\n")
   442	                handle.flush()
   443	                os.fsync(handle.fileno())
   444	            os.replace(temp, done)
   445	            _fsync_dir(output_dir)
   446	        finally:
   447	            for temp in temps:
   448	                temp.unlink(missing_ok=True)
   449	    return path
   450	
   451	
   452	def _region(text):
   453	    match = re.fullmatch(r"([A-Za-z0-9_.-]+):(\d+)-(\d+)", text)
   454	    if not match:
   455	        raise argparse.ArgumentTypeError("region must be chrom:start1-end1")
   456	    chrom, start, end = match.groups()
   457	    try:
   458	        return_tuple = chrom, int(start), int(end)
   459	        Shard(*return_tuple)
   460	        return return_tuple
   461	    except ValueError as exc:
   462	        raise argparse.ArgumentTypeError(str(exc)) from exc
