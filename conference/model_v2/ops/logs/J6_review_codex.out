   325	@pytest.mark.parametrize("damage", [None, "missing", "target", "duplicate_id", "checksum"])
   326	def test_sentinel_checker_requires_six_committed_exact_anchor_records(tmp_path, damage):
   327	    import pyarrow as pa
   328	    import pyarrow.parquet as pq
   329	    j = module()
   330	    for name, start in [("SMN2", 70076584), ("SMN1", 70952004)]:
   331	        rows = []
   332	        for aso, seq in [("F18", "CCAGCATTATGAAAGTGA"), ("F14", "CCAGCATTATGAAA"),
   333	                         ("F10", "CCAGCATTAT")]:
   334	            rows.append(dict(site_id=name + aso, aso_id=aso, chrom="chr5", start1=start,
   335	                             end1=start + len(seq) - 1, strand="+", gene_name=name,
   336	                             gene_id=name, target_sequence=seq, mismatch_count=0,
   337	                             mismatch_positions=[], paralog_ambiguity=True,
   338	                             evidence_class="derived"))
   339	        if name == "SMN1":
   340	            if damage == "missing":
   341	                rows.pop()
   342	            elif damage == "target":
   343	                rows[0]["target_sequence"] = "A" * 18
   344	            elif damage == "duplicate_id":
   345	                rows[0]["site_id"] = "SMN2F18"
   346	        path = tmp_path / f"{name}.parquet"
   347	        pq.write_table(pa.Table.from_pylist(rows), path)
   348	        sha = hashlib.sha256(path.read_bytes()).hexdigest()
   349	        path.with_suffix(".done").write_text(json.dumps(dict(rows=len(rows), sha256=sha)))
   350	    if damage == "checksum":
   351	        (tmp_path / "SMN1.parquet").write_bytes(b"invalid")
   352	    if damage is None:
   353	        assert j.check_smn_anchors(tmp_path) == 6
   354	        # Old output files cannot satisfy acceptance for an empty current run.
   355	        with pytest.raises(ValueError, match="missing sentinel anchors"):
   356	            j.check_smn_anchors(tmp_path, paths=[])
   357	    else:
   358	        with pytest.raises(ValueError):
   359	            j.check_smn_anchors(tmp_path)
