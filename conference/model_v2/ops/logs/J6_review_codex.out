    99	class FaiFastaReader:
   100	    """Pure-python random access via the ``.fai`` index (read-only, small slices)."""
   101	
   102	    def __init__(self, fasta_path: Optional[str] = None):
   103	        raw = fasta_path or os.environ.get(FASTA_ENV) or DEFAULT_FASTA
   104	        self.path = Path(os.path.expanduser(str(raw)))
   105	        self.fai_path = Path(str(self.path) + ".fai")
   106	        if not self.path.is_file():
   107	            raise GenomeAccessError(f"genome fasta not found: {self.path}")
   108	        if not self.fai_path.is_file():
   109	            raise GenomeAccessError(f"fasta index not found: {self.fai_path}")
   110	        self._index: Dict[str, Tuple[int, int, int, int]] = {}
   111	        with open(self.fai_path, "r", encoding="ascii") as fh:
   112	            for line in fh:
   113	                parts = line.rstrip("\n").split("\t")
   114	                if len(parts) < 5:
   115	                    continue
   116	                self._index[parts[0]] = (int(parts[1]), int(parts[2]), int(parts[3]), int(parts[4]))
   117	
   118	    def length(self, chrom: str) -> int:
   119	        if chrom not in self._index:
   120	            raise GenomeAccessError(f"unknown contig {chrom!r}")
   121	        return self._index[chrom][0]
   122	
   123	    def _offset(self, chrom: str, pos0: int) -> int:
   124	        _, off, line_bases, line_width = self._index[chrom]
   125	        return off + (pos0 // line_bases) * line_width + (pos0 % line_bases)
   126	
   127	    def fetch(self, chrom: str, start: int, end: int) -> str:
   128	        n = self.length(chrom)
   129	        if not (1 <= start <= end <= n):
   130	            raise GenomeAccessError(f"slice {chrom}:{start}-{end} outside 1..{n}")
   131	        if end - start + 1 > MAX_SLICE_BASES:
   132	            raise GenomeAccessError(f"slice larger than {MAX_SLICE_BASES} bases refused")
   133	        first = self._offset(chrom, start - 1)
   134	        last = self._offset(chrom, end - 1)
   135	        with open(self.path, "rb") as fh:
   136	            fh.seek(first)
   137	            raw = fh.read(last - first + 1)
   138	        seq = raw.replace(b"\n", b"").replace(b"\r", b"").decode("ascii").upper()
   139	        if len(seq) != end - start + 1:
   140	            raise GenomeAccessError(f"short read for {chrom}:{start}-{end}")
   141	        return seq
