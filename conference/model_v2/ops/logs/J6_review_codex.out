   163	def test_atomic_parquet_manifest_and_restart_idempotence(tmp_path):
   164	    import pyarrow.parquet as pq
   165	    j, kwargs = tiny_job(tmp_path)
   166	    path = j.run_shard(**kwargs)
   167	    done = path.with_suffix(".done")
   168	    manifest = json.loads(done.read_text())
   169	    assert manifest["rows"] == 1
   170	    assert manifest["sha256"] == hashlib.sha256(path.read_bytes()).hexdigest()
   171	    assert manifest["params"]["max_mismatch"] == 0
   172	    assert manifest["identities"] == kwargs["identities"]
   173	    table = pq.read_table(path)
   174	    assert table.to_pylist()[0]["mismatch_positions"] == []
   175	    assert table.to_pylist()[0]["transcript_ids"] is None
   176	    mtimes = path.stat().st_mtime_ns, done.stat().st_mtime_ns
   177	    j.run_shard(**kwargs)
   178	    assert (path.stat().st_mtime_ns, done.stat().st_mtime_ns) == mtimes
   179	    assert not list(tmp_path.glob("*.tmp"))
