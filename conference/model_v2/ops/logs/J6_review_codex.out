   464	
   465	def check_smn_anchors(output_dir, *, paths=None) -> int:
   466	    """Sentinel acceptance: six exact F18/F14/F10 records, two distinct genes.
   467	
   468	    Inspect only committed shards in this specific output directory; verify each
   469	    checksum before reading. No new genomic search or reference traversal.
   470	    """
   471	    import pyarrow as pa
   472	    import pyarrow.parquet as pq
   473	    expected = {(gene, aso): (start, start + length - 1, target)
   474	                for gene, start in (("SMN2", 70076584), ("SMN1", 70952004))
   475	                for aso, length, target in (("F18", 18, "CCAGCATTATGAAAGTGA"),
   476	                                            ("F14", 14, "CCAGCATTATGAAA"),
   477	                                            ("F10", 10, "CCAGCATTAT"))}
   478	    found = {}
   479	    markers = (Path(output_dir).glob("*.done") if paths is None else
   480	               (Path(path).with_suffix(".done") for path in paths))
   481	    for done in sorted(markers):
   482	        path = done.with_suffix(".parquet")
   483	        try:
   484	            manifest = json.loads(done.read_text())
   485	            if manifest["sha256"] != _sha256(path):
   486	                raise ValueError(f"sentinel checksum mismatch: {path}")
   487	            if manifest["rows"] != pq.read_metadata(path).num_rows:
   488	                raise ValueError(f"sentinel row-count mismatch: {path}")
   489	            rows = pq.read_table(path, filters=[("start1", "in", [70076584, 70952004])]).to_pylist()
   490	        except (OSError, KeyError, TypeError, pa.ArrowException) as exc:
   491	            raise ValueError(f"invalid committed sentinel shard: {path}") from exc
   492	        for row in rows:
   493	            key = row["gene_name"], row["aso_id"]
   494	            if key not in expected or row["start1"] != expected[key][0]:
   495	                continue
   496	            if (row["chrom"] != "chr5" or row["strand"] != "+" or
   497	                    (row["start1"], row["end1"], row["target_sequence"]) != expected[key] or
   498	                    row["mismatch_count"] != 0 or row["mismatch_positions"] != [] or
   499	                    row["paralog_ambiguity"] is not True or row["evidence_class"] != "derived"):
   500	                raise ValueError(f"invalid sentinel anchor: {key}")
   501	            if key in found:
   502	                raise ValueError(f"duplicate sentinel anchor: {key}")
   503	            found[key] = row
   504	    if set(found) != set(expected):
   505	        raise ValueError(f"missing sentinel anchors: {sorted(set(expected) - set(found))}")
   506	    if len({r["site_id"] for r in found.values()}) != 6:
   507	        raise ValueError("sentinel site IDs collapse distinct ASOs/paralogs")
   508	    if {found[("SMN1", a)]["gene_id"] for a in ("F18", "F14", "F10")} & {
   509	            found[("SMN2", a)]["gene_id"] for a in ("F18", "F14", "F10")}:
   510	        raise ValueError("sentinel gene IDs collapse paralogs")
   511	    return 6
   512	
   513	
   514	def main(argv=None):
   515	    parser = argparse.ArgumentParser(description=__doc__)
   516	    parser.add_argument("--fasta", default=DEFAULT_FASTA)
   517	    parser.add_argument("--gtf", default=DEFAULT_GTF)
   518	    parser.add_argument("--output-dir", required=True)
   519	    parser.add_argument("--region", type=_region)
   520	    parser.add_argument("--asos", nargs="+", choices=sorted(ASOS), default=["F18", "F14", "F10"])
   521	    parser.add_argument("--max-mismatch", type=int, default=3)
   522	    parser.add_argument("--window-size", type=int, default=DEFAULT_WINDOW)
   523	    parser.add_argument("--shard-index", type=int, default=0)
   524	    parser.add_argument("--shard-count", type=int, default=1)
   525	    parser.add_argument("--check-smn-anchors", action="store_true")
   526	    args = parser.parse_args(argv)
   527	    _budget(args.max_mismatch)
   528	    if not 0 <= args.shard_index < args.shard_count:
   529	        parser.error("require 0 <= shard-index < shard-count")
   530	    if args.check_smn_anchors and args.shard_count != 1:
   531	        parser.error("sentinel acceptance requires a single complete shard worker")
   532	    genome = FaiFastaReader(args.fasta)
   533	    identities = dict(fasta=file_identity(genome.path), gtf=file_identity(args.gtf))
   534	    genes = read_gene_bodies(args.gtf, region=args.region)
   535	    if file_identity(args.gtf) != identities["gtf"]:
   536	        raise ValueError("GTF changed while reading")
   537	    if not genes:
   538	        parser.error("no gene bodies overlap the requested universe")
   539	    asos = [ASOS[name] for name in args.asos]
   540	    shards = make_shards(genes, window_size=args.window_size, region=args.region)
   541	    completed = []
   542	    for index, shard in enumerate(shards):
   543	        if index % args.shard_count != args.shard_index:
   544	            continue
   545	        if (file_identity(genome.path) != identities["fasta"] or
   546	                file_identity(args.gtf) != identities["gtf"]):
   547	            raise ValueError("reference input identity changed during run")
   548	        path = run_shard(genome=genome, genes=genes, asos=asos, shard=shard,
   549	                         output_dir=args.output_dir, identities=identities,
   550	                         max_mismatch=args.max_mismatch)
   551	        completed.append(path)
   552	        print(path, flush=True)
   553	    if args.check_smn_anchors:
   554	        print(f"verified_smn_anchors={check_smn_anchors(args.output_dir, paths=completed)}", flush=True)
   555	    return 0
   556	
   557	
   558	if __name__ == "__main__":
   559	    raise SystemExit(main())
