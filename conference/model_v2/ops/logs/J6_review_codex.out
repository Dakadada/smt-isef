   205	def make_shards(genes, *, window_size=DEFAULT_WINDOW, region=None) -> tuple[Shard, ...]:
   206	    """Stable chromosome windows; region clipping affects the explicit shard ID."""
   207	    if type(window_size) is not int or window_size < 1 or window_size > MAX_SLICE_BASES:
   208	        raise ValueError("window_size must be 1..100000")
   209	    if region is not None:
   210	        Shard(*region)
   211	    windows = set()
   212	    for gene in _genes(genes):
   213	        lo, hi = gene.start1, gene.end1
   214	        if region:
   215	            if gene.chrom != region[0]:
   216	                continue
   217	            lo, hi = max(lo, region[1]), min(hi, region[2])
   218	        if lo > hi:
   219	            continue
   220	        for index in range((lo - 1) // window_size, (hi - 1) // window_size + 1):
   221	            start, end = index * window_size + 1, (index + 1) * window_size
   222	            if region:
   223	                start, end = max(start, region[1]), min(end, region[2])
   224	            windows.add(Shard(gene.chrom, start, end))
   225	    return tuple(sorted(windows))
