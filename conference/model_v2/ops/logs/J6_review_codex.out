   182	@pytest.mark.parametrize("damage", ["parquet", "manifest", "missing_done", "params", "identity", "genes", "rows"])
   183	def test_restart_rebuilds_incomplete_corrupt_or_stale_shards(tmp_path, damage):
   184	    j, kwargs = tiny_job(tmp_path)
   185	    path = j.run_shard(**kwargs)
   186	    done = path.with_suffix(".done")
   187	    if damage == "parquet":
   188	        path.write_bytes(b"corrupt")
   189	    elif damage == "manifest":
   190	        done.write_text("{")
   191	    elif damage == "missing_done":
   192	        done.unlink()
   193	    elif damage == "params":
   194	        kwargs["max_mismatch"] = 1
   195	    elif damage == "identity":
   196	        kwargs["identities"]["fasta"]["test"] = "changed"
   197	    elif damage == "genes":
   198	        kwargs["genes"] = [dataclasses.replace(kwargs["genes"][0], gene_id="new")]
   199	    else:
   200	        manifest = json.loads(done.read_text())
   201	        manifest["rows"] = 100
   202	        done.write_text(json.dumps(manifest))
   203	    j.run_shard(**kwargs)
   204	    manifest = json.loads(done.read_text())
   205	    assert manifest["rows"] == 1
   206	    assert manifest["sha256"] == hashlib.sha256(path.read_bytes()).hexdigest()
   207	    assert manifest["params"]["max_mismatch"] == kwargs["max_mismatch"]
   208	    assert manifest["identities"] == kwargs["identities"]
   209	    if damage == "genes":
   210	        import pyarrow.parquet as pq
   211	        assert pq.read_table(path).to_pylist()[0]["gene_id"] == "new"
