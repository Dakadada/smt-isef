    26	
    27	def rc(seq):
    28	    return seq.translate(str.maketrans("ACGTN", "TGCAN"))[::-1]
    29	
    30	
    31	def oracle(seqs, genes, asos, k):
    32	    rows = set()
    33	    for gene in genes:
    34	        for aso in asos:
    35	            query = rc(aso.sequence_5to3)
    36	            for start in range(gene.start1, gene.end1 - len(query) + 2):
    37	                target = seqs[gene.chrom][start - 1:start + len(query) - 1]
    38	                if gene.strand == "-":
    39	                    target = rc(target)
    40	                positions = tuple(sorted(len(query) - i for i, (a, b) in
    41	                                         enumerate(zip(query, target)) if a != b or b == "N"))
    42	                if len(positions) <= k:
    43	                    rows.add((aso.aso_id, gene.chrom, start, start + len(query) - 1,
    44	                              gene.strand, gene.gene_id, target, positions))
    45	    return rows
    46	
    47	
    48	def key(site):
    49	    return (site.aso_id, site.chrom, site.start1, site.end1, site.strand,
    50	            site.gene_id, site.target_sequence, site.mismatch_positions)
