   169	def read_gene_bodies(path, *, region=None) -> tuple[Gene, ...]:
   170	    """Stream one known GTF file; parse only gene lines, retain full gene bounds.
   171	
   172	    Header must explicitly identify GRCh38 and version 50. No feature/transcript
   173	    inference is attempted. Optional region bounds filter overlapping genes.
   174	    """
   175	    if region is not None:
   176	        Shard(*region)
   177	    genes = []
   178	    valid_header = False
   179	    with Path(path).expanduser().open() as handle:
   180	        for line in handle:
   181	            if line.startswith("#"):
   182	                if line.startswith("##description:"):
   183	                    if not (re.search(r"\bGRCh38\b", line) and re.search(r"\bversion 50\b", line)):
   184	                        raise ValueError("GTF must declare GRCh38 / GENCODE version 50")
   185	                    valid_header = True
   186	                continue
   187	            prefix = line.split("\t", 3)
   188	            if len(prefix) < 4 or prefix[2] != "gene":
   189	                continue
   190	            fields = line.rstrip("\n").split("\t")
   191	            if len(fields) != 9:
   192	                raise ValueError("malformed GTF gene record")
   193	            chrom, _, _, lo, hi, _, strand, _, attrs = fields
   194	            lo, hi = int(lo), int(hi)
   195	            if region and (chrom != region[0] or hi < region[1] or lo > region[2]):
   196	                continue
   197	            attributes = dict(re.findall(r'(\w+) "([^"\n]*)";', attrs))
   198	            genes.append(Gene(attributes["gene_id"], chrom, lo, hi, strand,
   199	                              attributes.get("gene_name", "")))
   200	    if not valid_header:
   201	        raise ValueError("missing GRCh38 / GENCODE v50 GTF description")
   202	    return _genes(genes)
