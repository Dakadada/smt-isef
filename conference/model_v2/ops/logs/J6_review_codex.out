   360	def _schema():
   361	    import pyarrow as pa
   362	    return pa.schema([
   363	        ("site_id", pa.string()), ("aso_id", pa.string()), ("chrom", pa.string()),
   364	        ("start1", pa.int64()), ("end1", pa.int64()), ("strand", pa.string()),
   365	        ("gene_id", pa.string()), ("gene_name", pa.string()), ("region_class", pa.string()),
   366	        ("region_classes", pa.list_(pa.string())), ("transcript_ids", pa.list_(pa.string())),
   367	        ("mismatch_count", pa.int32()), ("mismatch_positions", pa.list_(pa.int32())),
   368	        ("target_sequence", pa.string()), ("paralog_ambiguity", pa.bool_()),
   369	        ("evidence_class", pa.string()), ("assembly", pa.string()), ("annotation", pa.string()),
