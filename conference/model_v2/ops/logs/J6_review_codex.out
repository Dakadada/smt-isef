    53	@pytest.mark.parametrize("k", range(4))
    54	@pytest.mark.parametrize("seed", [0, 17, 98])
    55	def test_seed_extend_equals_independent_oracle_with_edges_N_overlaps(seed, k):
    56	    j = module()
    57	    rng = random.Random(seed)
    58	    seq = list("".join(rng.choice("ACGTN") for _ in range(190)))
    59	    target = "AACGTT"
    60	    for pos, planted in [(0, target), (15, "AATGTT"), (40, rc(target)),
    61	                         (65, "AACNTT"), (100, "AAAAAAA"), (184, target)]:
    62	        seq[pos:pos + len(planted)] = planted
    63	    seqs = {"chrT": "".join(seq), "chrTiny": "AC"}
    64	    genes = [j.Gene("g+", "chrT", 1, 190, "+"),
    65	             j.Gene("g-", "chrT", 1, 190, "-"),
    66	             j.Gene("partial", "chrT", 3, 187, "+"),
    67	             j.Gene("tiny", "chrTiny", 1, 2, "+")]
    68	    asos = [ti.ASO("q", rc(target)), ti.ASO("overlap", "TTTT"), ti.ASO("short", "A")]
    69	    genome = ti.InMemoryGenome(seqs)
    70	    expected = oracle(seqs, genes, asos, k)
    71	    unsharded = j.enumerate_sites(genome, genes, asos, max_mismatch=k)
    72	    assert {key(s) for s in unsharded} == expected
    73	    sharded = [s for shard in j.make_shards(genes, window_size=13)
    74	               for s in j.enumerate_sites(genome, genes, asos, max_mismatch=k, shard=shard)]
    75	    assert {key(s) for s in sharded} == expected
    76	    assert len(sharded) == len(expected)
    77	    assert {s.site_id for s in sharded} == {s.site_id for s in unsharded}
    78	    assert all(s.mismatch_count == len(s.mismatch_positions) and s.evidence_class == "derived"
    79	               for s in sharded)
