     1	"""Complete seed-and-extend candidate scanning for the clean-room Feng arm.
     2	
     3	The scanner reports sequence-similarity candidates only. It does not estimate
     4	hybridization thermodynamics or splice activity. Coordinates are zero-based,
     5	half-open offsets into each supplied reference sequence, and the caller must supply
     6	the query in the orientation expected to match the reference.
     7	
     8	The default seed policy partitions a query into ``budget + 1`` nonempty, balanced
     9	blocks. An alignment with at most ``budget`` substitutions (Hamming mode) or edit
    10	operations (edit mode) must leave at least one block exactly matched by the
    11	pigeonhole principle, so extending every occurrence of every block cannot miss an
    12	eligible interval. When a nonempty exact seed cannot be guaranteed, the scanner
    13	falls back to exhaustive extension rather than sacrificing completeness.
    14	"""
    15	
    16	from __future__ import annotations
    17	
    18	from collections.abc import Mapping
    19	from dataclasses import dataclass
    20	from enum import Enum
    21	
    22	
    23	_CANONICAL_BASES = frozenset("ACGT")
    24	_IUPAC_BASES = frozenset("ACGTRYSWKMBDHVN")
    25	
    26	
    27	class SeedLengthPolicy(str, Enum):
    28	    """Completeness-preserving policies for selecting candidate intervals."""
    29	
    30	    BALANCED = "balanced"
    31	    EXHAUSTIVE = "exhaustive"
    32	
    33	
    34	@dataclass(frozen=True, order=True, slots=True)
    35	class HybridizationHit:
    36	    """One sequence candidate in a named reference.
    37	
    38	    ``mismatches`` is the Hamming count in fixed-window mode. In edit mode it is
    39	    the substitution count in the minimum-edit alignment, with fewer substitutions
    40	    used as the deterministic tie-break between equally short alignments.
    41	    """
    42	
    43	    reference_name: str
    44	    start: int
    45	    end: int
    46	    mismatches: int
    47	    edit_distance: int
    48	
    49	
    50	def seed_and_extend(
    51	    query: str,
    52	    reference: str | Mapping[str, str],
    53	    *,
    54	    max_mismatch: int | None = None,
    55	    max_edit: int | None = None,
    56	    seed_policy: SeedLengthPolicy | str = SeedLengthPolicy.BALANCED,
    57	    reference_name: str = "reference",
    58	) -> tuple[HybridizationHit, ...]:
    59	    """Return every reference interval within the declared sequence budget.
    60	
    61	    Args:
    62	        query: Nonempty oligo sequence in reference-matching orientation. ``U`` and
    63	            ``T`` compare as equivalent. IUPAC ambiguity symbols are valid input but
    64	            count as mismatches rather than as wildcards.
    65	        reference: One sequence or a mapping of reference names to sequences.
    66	        max_mismatch: Maximum substitutions. When ``max_edit`` is absent this selects
    67	            fixed-length Hamming mode and defaults to zero. In edit mode it is an
    68	            optional cap on substitutions in the optimal alignment.
    69	        max_edit: When provided, select variable-length edit mode and require
    70	            Levenshtein distance at most this value.
    71	        seed_policy: ``balanced`` uses the pigeonhole-complete partition described in
    72	            the module docstring; ``exhaustive`` disables seeding for audit use.
    73	        reference_name: Name assigned when ``reference`` is a single sequence.
    74	
    75	    Returns:
    76	        A deterministically sorted tuple of unique :class:`HybridizationHit` values.
    77	
    78	    Raises:
    79	        TypeError: If sequences, names, or budgets have invalid types.
    80	        ValueError: If the query is empty, a sequence contains a non-IUPAC symbol, a
    81	            budget is negative, a reference name is empty, or the policy is unknown.
    82	
    83	    Hamming mode evaluates query-length windows. Edit mode evaluates every nonempty
    84	    window whose length differs from the query by at most ``max_edit``. Seeding only
    85	    prunes which of those windows require extension; it never changes eligibility.
    86	    """
    87	    normalized_query = _normalize_sequence(query, label="query", allow_empty=False)
    88	    references = _normalize_references(reference, reference_name)
    89	    mismatch_budget = _validate_budget(max_mismatch, "max_mismatch")
    90	    edit_budget = _validate_budget(max_edit, "max_edit")
    91	    try:
    92	        policy = SeedLengthPolicy(seed_policy)
    93	    except (TypeError, ValueError) as error:
    94	        choices = ", ".join(item.value for item in SeedLengthPolicy)
    95	        raise ValueError(f"seed_policy must be one of: {choices}") from error
    96	
    97	    if edit_budget is None:
    98	        effective_mismatch_budget = 0 if mismatch_budget is None else mismatch_budget
    99	        hits = _scan_hamming(
   100	            normalized_query,
   101	            references,
   102	            effective_mismatch_budget,
   103	            policy,
   104	        )
   105	    else:
   106	        hits = _scan_edit(
   107	            normalized_query,
   108	            references,
   109	            mismatch_budget,
   110	            edit_budget,
   111	            policy,
   112	        )
   113	    return tuple(sorted(hits))
   114	
   115	
   116	def _normalize_sequence(sequence: str, *, label: str, allow_empty: bool) -> str:
   117	    if not isinstance(sequence, str):
   118	        raise TypeError(f"{label} must be a string")
   119	    normalized = sequence.upper().replace("U", "T")
   120	    if not normalized and not allow_empty:
   121	        raise ValueError(f"{label} must not be empty")
   122	    invalid = sorted(set(normalized) - _IUPAC_BASES)
   123	    if invalid:
   124	        raise ValueError(f"{label} contains non-IUPAC symbols: {''.join(invalid)}")
   125	    return normalized
   126	
   127	
   128	def _normalize_references(
   129	    reference: str | Mapping[str, str],
   130	    reference_name: str,
   131	) -> tuple[tuple[str, str], ...]:
   132	    if isinstance(reference, str):
   133	        items = ((reference_name, reference),)
   134	    elif isinstance(reference, Mapping):
   135	        items = tuple(reference.items())
   136	    else:
   137	        raise TypeError("reference must be a sequence string or a name-to-sequence mapping")
   138	
   139	    normalized: list[tuple[str, str]] = []
   140	    for name, sequence in items:
   141	        if not isinstance(name, str):
   142	            raise TypeError("reference names must be strings")
   143	        if not name:
   144	            raise ValueError("reference names must not be empty")
   145	        normalized.append(
   146	            (name, _normalize_sequence(sequence, label=f"reference {name!r}", allow_empty=True))
   147	        )
   148	    return tuple(normalized)
   149	
   150	
   151	def _validate_budget(value: int | None, label: str) -> int | None:
   152	    if value is None:
   153	        return None
   154	    if type(value) is not int:
   155	        raise TypeError(f"{label} must be an integer")
   156	    if value < 0:
   157	        raise ValueError(f"{label} must be nonnegative")
   158	    return value
   159	
   160	
   161	def _bases_match(left: str, right: str) -> bool:
   162	    return left in _CANONICAL_BASES and right in _CANONICAL_BASES and left == right
   163	
   164	
   165	def _hamming_distance(query: str, target: str) -> int:
   166	    return sum(not _bases_match(left, right) for left, right in zip(query, target, strict=True))
   167	
   168	
   169	def _alignment_cost(query: str, target: str) -> tuple[int, int]:
   170	    """Return minimum edit distance and its minimum substitution tie-break."""
   171	    previous = [(column, 0) for column in range(len(target) + 1)]
   172	    for row, query_base in enumerate(query, start=1):
   173	        current = [(row, 0)]
   174	        for column, target_base in enumerate(target, start=1):
   175	            deletion = (previous[column][0] + 1, previous[column][1])
   176	            insertion = (current[column - 1][0] + 1, current[column - 1][1])
   177	            if _bases_match(query_base, target_base):
   178	                diagonal = previous[column - 1]
   179	            else:
   180	                diagonal = (previous[column - 1][0] + 1, previous[column - 1][1] + 1)
   181	            current.append(min(deletion, insertion, diagonal))
   182	        previous = current
   183	    return previous[-1]
   184	
   185	
   186	def _balanced_seeds(query: str, budget: int) -> tuple[tuple[int, str], ...]:
   187	    if budget >= len(query):
   188	        return ()
   189	    block_count = budget + 1
   190	    short_length, longer_blocks = divmod(len(query), block_count)
   191	    offset = 0
   192	    seeds: list[tuple[int, str]] = []
   193	    for index in range(block_count):
   194	        length = short_length + (index < longer_blocks)
   195	        seeds.append((offset, query[offset : offset + length]))
   196	        offset += length
   197	    return tuple(seeds)
   198	
   199	
   200	def _exact_occurrences(reference: str, seed: str) -> tuple[int, ...]:
   201	    if any(base not in _CANONICAL_BASES for base in seed):
   202	        return ()
   203	    positions: list[int] = []
   204	    position = reference.find(seed)
   205	    while position != -1:
   206	        positions.append(position)
   207	        position = reference.find(seed, position + 1)
   208	    return tuple(positions)
   209	
   210	
   211	def _hamming_candidate_starts(
   212	    query: str,
   213	    reference: str,
   214	    budget: int,
   215	    policy: SeedLengthPolicy,
   216	) -> set[int]:
   217	    final_start = len(reference) - len(query)
   218	    if final_start < 0:
   219	        return set()
   220	    seeds = () if policy is SeedLengthPolicy.EXHAUSTIVE else _balanced_seeds(query, budget)
   221	    if not seeds:
   222	        return set(range(final_start + 1))
   223	    starts: set[int] = set()
   224	    for query_offset, seed in seeds:
   225	        for occurrence in _exact_occurrences(reference, seed):
   226	            start = occurrence - query_offset
   227	            if 0 <= start <= final_start:
   228	                starts.add(start)
   229	    return starts
   230	
   231	
   232	def _scan_hamming(
   233	    query: str,
   234	    references: tuple[tuple[str, str], ...],
   235	    budget: int,
   236	    policy: SeedLengthPolicy,
   237	) -> set[HybridizationHit]:
   238	    hits: set[HybridizationHit] = set()
   239	    for name, sequence in references:
   240	        for start in _hamming_candidate_starts(query, sequence, budget, policy):
   241	            end = start + len(query)
   242	            mismatches = _hamming_distance(query, sequence[start:end])
   243	            if mismatches <= budget:
   244	                hits.add(HybridizationHit(name, start, end, mismatches, mismatches))
   245	    return hits
   246	
   247	
   248	def _edit_candidate_intervals(
   249	    query: str,
   250	    reference: str,
   251	    budget: int,
   252	    policy: SeedLengthPolicy,
   253	) -> set[tuple[int, int]]:
