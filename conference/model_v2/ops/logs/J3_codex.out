"""J6: independent Hamming oracle, annotation, coordinates, and crash recovery."""
import dataclasses
import hashlib
import json
import random
import subprocess
import sys
from pathlib import Path

import pytest

ROOT = Path(__file__).resolve().parents[3]
sys.path.insert(0, str(ROOT))
sys.path.insert(0, str(ROOT / "feng/src"))
from conference.model_v2 import trans_intervention as ti


def module():
    from conference.model_v2 import j6_site_universe
    return j6_site_universe


def test_module_exposes_site_enumerator():
    assert callable(module().enumerate_sites)


def rc(seq):
    return seq.translate(str.maketrans("ACGTN", "TGCAN"))[::-1]


def oracle(seqs, genes, asos, k):
    rows = set()
    for gene in genes:
        for aso in asos:
            query = rc(aso.sequence_5to3)
            for start in range(gene.start1, gene.end1 - len(query) + 2):
                target = seqs[gene.chrom][start - 1:start + len(query) - 1]
                if gene.strand == "-":
                    target = rc(target)
                positions = tuple(sorted(len(query) - i for i, (a, b) in
                                         enumerate(zip(query, target)) if a != b or b == "N"))
                if len(positions) <= k:
                    rows.add((aso.aso_id, gene.chrom, start, start + len(query) - 1,
                              gene.strand, gene.gene_id, target, positions))
    return rows


def key(site):
    return (site.aso_id, site.chrom, site.start1, site.end1, site.strand,
            site.gene_id, site.target_sequence, site.mismatch_positions)


@pytest.mark.parametrize("k", range(4))
@pytest.mark.parametrize("seed", [0, 17, 98])
def test_seed_extend_equals_independent_oracle_with_edges_N_overlaps(seed, k):
    j = module()
    rng = random.Random(seed)
    seq = list("".join(rng.choice("ACGTN") for _ in range(190)))
    target = "AACGTT"
    for pos, planted in [(0, target), (15, "AATGTT"), (40, rc(target)),
                         (65, "AACNTT"), (100, "AAAAAAA"), (184, target)]:
        seq[pos:pos + len(planted)] = planted
    seqs = {"chrT": "".join(seq), "chrTiny": "AC"}
    genes = [j.Gene("g+", "chrT", 1, 190, "+"),
             j.Gene("g-", "chrT", 1, 190, "-"),
             j.Gene("partial", "chrT", 3, 187, "+"),
             j.Gene("tiny", "chrTiny", 1, 2, "+")]
    asos = [ti.ASO("q", rc(target)), ti.ASO("overlap", "TTTT"), ti.ASO("short", "A")]
    genome = ti.InMemoryGenome(seqs)
    expected = oracle(seqs, genes, asos, k)
    unsharded = j.enumerate_sites(genome, genes, asos, max_mismatch=k)
    assert {key(s) for s in unsharded} == expected
    sharded = [s for shard in j.make_shards(genes, window_size=13)
               for s in j.enumerate_sites(genome, genes, asos, max_mismatch=k, shard=shard)]
    assert {key(s) for s in sharded} == expected
"""Tests for conference.model_v2.trans_intervention.

Synthetic-genome tests always run. Golden tests read tiny slices of the GRCh38
fasta via its .fai and skip (with reason) when the fasta is absent.
"""
import dataclasses
import json
import random
import sys
from pathlib import Path

import pytest

REPO_ROOT = Path(__file__).resolve().parents[3]
if str(REPO_ROOT) not in sys.path:
    sys.path.insert(0, str(REPO_ROOT))

from conference.model_v2 import trans_intervention as ti  # noqa: E402

# ------------------------------------------------------------------ synthetic fixtures
_rng = random.Random(7)


def _rand(n):
    return "".join(_rng.choice("ACGT") for _ in range(n))


TX = _rand(90)  # transcript sense: 30 nt intron | 20 nt exon | 40 nt intron
PAD_L, PAD_R = _rand(10), _rand(10)
GENOME = ti.InMemoryGenome({
    "chrP": PAD_L + TX + PAD_R,                           # + strand gene, tx at 11..100
    "chrM": PAD_L + ti.reverse_complement(TX) + PAD_R,    # - strand gene, tx at 100..11
    "chrQ": PAD_R + TX + PAD_L,                           # sequence-identical paralog
})
TARGET = TX[59:71]                      # intron +10..+21 downstream of the donor
SYN_ASO = ti.ASO("SYN12", ti.reverse_complement(TARGET))


def _locus(locus_id, chrom, strand, exon, role="reference"):
    return ti.Locus(locus_id=locus_id, gene="SYN", paralog_group="SYN", role=role, chrom=chrom,
                    strand=strand, search_start=11, search_end=100, exon_label="e1",
                    exon_start=exon[0], exon_end=exon[1], coords_evidence="model_assumption")


PLUS = _locus("SYN_plus", "chrP", "+", (41, 60))
MINUS = _locus("SYN_minus", "chrM", "-", (51, 70))
PARALOG = _locus("SYN_paralog", "chrQ", "+", (41, 60), role="alternate")


def _fasta_or_skip():
    try:
        return ti.FaiFastaReader()
    except ti.GenomeAccessError as exc:
        pytest.skip(f"GRCh38 fasta/.fai not available: {exc}")


@pytest.fixture(scope="module")
def genome():
    return _fasta_or_skip()


SMN2, SMN1 = ti.LOCI["SMN2_exon7"], ti.LOCI["SMN1_exon7"]


# ------------------------------------------------------------------ sequence / strand
def test_reverse_complement_and_normalize():
    assert ti.reverse_complement("TCACTTTCATAATGCTGG") == "CCAGCATTATGAAAGTGA"
    assert ti.normalize_sequence("ucacuu") == "TCACTT"
    with pytest.raises(ti.SchemaError):
        ti.normalize_sequence("ACGX")
    with pytest.raises(ti.SchemaError):
        ti.normalize_sequence("")


def test_five_prime_three_prime_flip_is_not_placed():
    flipped = ti.ASO("SYN12_flipped", SYN_ASO.sequence_5to3[::-1])  # 3'->5' written as 5'->3'
    assert ti.place(SYN_ASO, PLUS, GENOME).status == "placed"
    assert ti.place(flipped, PLUS, GENOME).status == "no_match"
    sense = ti.ASO("SYN12_sense", TARGET)  # sense copy of the target, not antisense
    assert ti.place(sense, PLUS, GENOME).status == "no_match"


def test_plus_strand_placement_and_geometry():
    res = ti.place(SYN_ASO, PLUS, GENOME)
    p = res.placement
    assert (res.status, p.start, p.end, p.strand) == ("placed", 70, 81, "+")
    assert p.target_sequence == TARGET
    g = p.geometry
    assert (g.target_5p_pos, g.target_3p_pos) == (70, 81)
    assert (g.donor_last_exonic_base, g.donor_first_intronic_base) == (60, 61)
    assert (g.acceptor_first_exonic_base, g.acceptor_last_intronic_base) == (41, 40)
    assert (g.donor_dist_5p_from_last_exonic, g.donor_dist_3p_from_last_exonic) == (10, 21)
    assert (g.donor_dist_5p_from_first_intronic, g.donor_dist_3p_from_first_intronic) == (9, 20)
    assert (g.acceptor_dist_5p_from_first_exonic, g.acceptor_dist_3p_from_first_exonic) == (29, 40)
    assert (g.region_5p, g.region_3p, g.region) == ("intronic_downstream", "intronic_downstream", "intronic")


def test_minus_strand_gene_mirrors_plus_strand():
    plus = ti.place(SYN_ASO, PLUS, GENOME).placement
    res = ti.place(SYN_ASO, MINUS, GENOME)
# AGENTS.md — Codex working agreement for smt-isef

Standing instructions for any Codex session in this repo. Read before acting. The
human partner drives; you implement, investigate, and review. When a task prompt
conflicts with this file, the task prompt wins — but flag the conflict.

## Repo layout

- `feng/` — the active **prospective** arm (Arms A–E + appendix). All current work
  lives here. This is where you operate unless told otherwise.
- `src/`, `pre/` — the older committed program. Separate effort. Do **not** touch it
  while working `feng/`. Its handoff is `docs/HANDOFF.md`.
- Entry point for state: **`feng/HANDOFF.md`** — read its top `LIVE CHECKPOINT` block
  first every session; it holds the current live job/monitor/thread IDs and the
  next action. `feng/PLAN.md` + `feng/TASKBOARD.md` are the frozen design.

## Environment (exact)

- Python interpreter: `/home/dashii/orcd/pool/feng-env/bin/python`
- Source path: run with `PYTHONPATH=feng/src`
- Test suite (the gate): `PYTHONPATH=feng/src /home/dashii/orcd/pool/feng-env/bin/python -m pytest feng/tests/ -q`
- GPU env: `~/orcd/pool/feng-gpu-env` (torch 2.6.0+cu124 / openmm 8.2 / pangolin 1.0.2).
- Binaries in feng-env: `IntaRNA`, `RNAplfold`, `samtools` (pysam absent → samtools
  fallback is the live path). Do not assume `sklearn` — it is **not** installed.
- Scratch: `$SCRATCH=/home/dashii/orcd/scratch`; pool: `/home/dashii/orcd/pool`.

## HPC guard rails (shared, quota-limited node)

- Never scan/walk/`find`/`du`/`ls -R` `/orcd/scratch` or `/orcd/pool`, or traverse
  `/orcd` broadly. Scope every filesystem op to a known subdir with bounded depth.
- Read quota from `~/orcd/.quota` (cached), not `du`. Read `/etc/motd.d/*` for
  maintenance/policy before substantive work.
- Heavy compute goes to Slurm on `mit_preemptable` with `--requeue` + checkpointing;
  do not run long jobs in the session shell.

## Scientific discipline — non-negotiable

1. **Pre-FREEZE.** No `feng-freeze*` git tag is cut. The prereg seal is UNOPENED and
   the sealed Phase-9 test is one-shot and terminal. **Never** cut a freeze tag, lock
   a real seal, set `FENG_PHASE9_UNLOCK`, or read sealed ΔPSI unless the human
   explicitly says so in that session. These are fail-closed by design — keep them so.
2. **Never manufacture a GO.** Do not move a pre-specified criterion, substitute a
   weaker endpoint, or tune until a result appears. A clean NO-GO is a real result;
   report it honestly. If an endpoint is under-powered or a curve incomplete, return
   indeterminate/None — never a verdict.
3. **Never fabricate a score.** Missing/failed computations return `None` or raise —
   never a fabricated `0.0`. Follow the honest 3-state convention already in the
   scorers. Recompute features leakage-free; never copy a label-derived value into a
   feature column.
4. **Coordinates.** Genome is GRCh38 / GENCODE v50. hg19/GRCh37 inputs must be lifted
   (`feng.rbp.liftover`) before any join; assembly fences are hard — do not weaken them.
5. **Freeze-safety of edits.** Additive, TDD, control-only where matching requires it.
   No new ΔPSI/rank/permutation readout outside the guarded Phase-9 path.

## Token / usage economy — you share one limited account

Codex here is driven by Claude Code and runs on a shared account with a **5-hour
rolling usage limit** that has stalled work mid-task. Be economical so more real
work fits per window:

- **Trust the prompt.** Claude hands you the findings, file:lines, and context you
  need. Don't re-explore the repo, re-read HANDOFF end-to-end, or re-derive what the
  prompt already states. Go straight to the named files.
- **Targeted reads.** Open the specific functions/lines you're changing, not whole
  large files or trees. No broad `grep`/`find` sweeps when a path is given.
- **Don't re-run the full suite gratuitously.** Run the pytest gate once when your
  edits are complete (and only the relevant subset while iterating). Reuse a green
  result the prompt already states rather than reproducing it.
- **Batch the work.** Fix all findings in a pass before the test run; don't
  round-trip per finding.
- **Return tight.** Structured `file:line` + one line each + counts. No prose walls,
  no re-quoting the prompt back, no restating unchanged context.

## Workflow

- **TDD.** Write/extend a test for each change; the full suite must pass before you
  call a task done. Report exact pass/skip/fail counts, never "should pass."
- **Verify on disk**, don't assert from intent — check counts, nulls, mtimes, actual
  file contents.
- **Do not commit, `sbatch`, or launch anything** unless the task explicitly says to.
  Leave unrelated untracked files (e.g. Arm C rank/readout artifacts) unstaged.
- **Reviews are adversarial.** Assume defects exist; return a clear `ADVANCE` /
  `DO-NOT-ADVANCE` verdict with `file:line` + concrete failure scenario + fix per
  finding, ranked HIGH/MED/LOW. Do not raise cosmetic nits at a launch gate.
- On any deviation from a brief (missing dep, wrong assumption, a limitation you
  couldn't fix), flag it explicitly in your return summary rather than hiding it.

## Return format

End substantive tasks with: (1) per-finding/change `file:line` + one line each;
(2) anything unfixed + why; (3) exact pytest counts; (4) new limitations a reviewer
or the human should know.
