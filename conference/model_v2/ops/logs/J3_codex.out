   156	class ChannelCache:
   157	    """Single-file transactional cache, including shared array-worker writers."""
   158	
   159	    def __init__(self, path, namespace):
   160	        Path(path).parent.mkdir(parents=True, exist_ok=True)
   161	        self.db = sqlite3.connect(path, timeout=60)
   162	        self.db.execute("PRAGMA journal_mode=WAL")
   163	        self.db.execute("PRAGMA synchronous=FULL")
   164	        self.db.execute("CREATE TABLE IF NOT EXISTS channels "
   165	                        "(namespace TEXT, key TEXT, channel TEXT, value TEXT, "
   166	                        "PRIMARY KEY(namespace,key,channel))")
   167	        self.db.commit()
   168	        self.namespace = namespace
   169	
   170	    def get(self, key, channel):
   171	        if key is None:
   172	            return None
   173	        row = self.db.execute("SELECT value FROM channels WHERE namespace=? AND key=? AND channel=?",
   174	                              (self.namespace, key, channel)).fetchone()
   175	        if row is None:
   176	            return None
   177	        try:
   178	            result = json.loads(row[0])
   179	            if result["status"] in ("ok", "not_applicable") and isinstance(result["reason"], str):
   180	                return result
   181	        except (ValueError, KeyError, TypeError):
   182	            pass
   183	        return None
   184	
   185	    def put(self, key, channel, result):
