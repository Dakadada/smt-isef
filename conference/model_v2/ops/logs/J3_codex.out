   103	                stdin=subprocess.PIPE, stdout=subprocess.PIPE,
   104	                stderr=self.stderr, text=True,
   105	                env={**os.environ, "OMP_NUM_THREADS": "1"})
   106	            self.identity.update(self._read())
   107	        except Exception as exc:
