   205	def _validate_values(channel, values):
   206	    if channel == "duplex":
   207	        value = values["energy_kcal_mol"]
   208	        if not isinstance(value, (float, int)) or not math.isfinite(value) or abs(value) >= 99999:
   209	            raise ValueError("invalid duplex energy")
   210	        if not isinstance(values.get("structure"), str) or "(" not in values["structure"]:
   211	            raise ValueError("duplex structure missing")
   212	    else:
   213	        value = values["p_unpaired"]
   214	        if not isinstance(value, (float, int)) or not math.isfinite(value) or not 0 <= value <= 1:
   215	            raise ValueError("invalid unpaired probability")
   216	    return values
   217	
   218	
   219	class Scorer(AbstractContextManager):
   220	    def __init__(self, *, backend, genome, cache_path, asos=None, flank=80, window=120, span=60):
   221	        if type(flank) is not int or not 0 <= flank <= 1000:
   222	            raise ValueError("flank must be 0..1000 nt")
   223	        if any(type(x) is not int or x <= 0 for x in (window, span)) or span > window:
   224	            raise ValueError("require 1 <= span <= window")
   225	        self.backend, self.genome = backend, genome
   226	        self.asos = dict(asos if asos is not None else {k: v.sequence_5to3 for k, v in ASOS.items()})
   227	        self.flank, self.window, self.span = flank, window, span
   228	        self.params = dict(version=VERSION, backend=backend.identity, flank=flank, window=window,
   229	                           span=span, asos=self.asos.copy(), implementation_sha256=_sha256(__file__),
   230	                           evidence=dict(complementarity="derived", duplex="model_assumption", accessibility="proxy"))
   231	        self.cache = ChannelCache(cache_path, _digest(self.params))
   232	
   233	    def _context(self, row):
   234	        if self.genome is None:
   235	            raise FileNotFoundError("indexed GRCh38 FASTA unavailable; flanks not supplied by J6")
   236	        start, end, strand = row["start1"], row["end1"], row["strand"]
   237	        if (type(start) is not int or type(end) is not int or not 1 <= start <= end or
   238	                strand not in ("+", "-") or end - start + 1 != len(normalize(row["target_sequence"]))):
   239	            raise ValueError("invalid site coordinates/strand/footprint")
   240	        length = self.genome.length(row["chrom"])
   241	        lo, hi = max(1, start - self.flank), min(length, end + self.flank)
   242	        context = normalize(self.genome.fetch(row["chrom"], lo, hi))
   243	        if strand == "-":
   244	            context = context.translate(str.maketrans("ACGU", "UGCA"))[::-1]
   245	        offset = start - lo if strand == "+" else hi - end
   246	        target = normalize(row["target_sequence"])
   247	        if context[offset:offset + len(target)] != target:
   248	            raise ValueError("target does not match strand-oriented GRCh38 reference")
   249	        return context, offset, context[:offset], context[offset + len(target):]
   250	
   251	    def score(self, row):
   252	        if row.get("assembly") != ASSEMBLY or row.get("annotation") != ANNOTATION:
   253	            raise ValueError("J3 requires GRCh38 / GENCODE v50; liftover before scoring")
   254	        aso = _attempt(lambda: dict(sequence=normalize(self.asos[row["aso_id"]])))
   255	        target = _attempt(lambda: dict(sequence=normalize(row["target_sequence"])))
   256	        comp = (_attempt(lambda: complementarity(aso["values"]["sequence"], target["values"]["sequence"]))
   257	                if aso["status"] == target["status"] == "ok" else
   258	                aso if aso["status"] != "ok" else target)
   259	        context = _attempt(lambda: dict(zip(("sequence", "offset", "left", "right"), self._context(row))))
   260	        ctx = context["values"]
   261	        key = (cache_key(aso["values"]["sequence"], target["values"]["sequence"], (ctx["left"], ctx["right"]))
   262	               if aso["status"] == target["status"] == context["status"] == "ok" else None)
   263	        results = {"complementarity": comp}
   264	        for channel in ("duplex", "accessibility"):
   265	            dependency = (aso if channel == "duplex" and aso["status"] != "ok" else context)
   266	            if dependency["status"] != "ok":
   267	                results[channel] = dependency
   268	                continue
   269	            cached = self.cache.get(key, channel)
   270	            if cached and cached["status"] == "ok":
   271	                check = _attempt(lambda: _validate_values(channel, cached["values"]))
   272	                if check["status"] != "ok":
   273	                    cached = None
   274	            if cached is not None:
   275	                results[channel] = cached
   345	    try:
   346	        with os.fdopen(fd, "w") as handle:
   347	            handle.write(_json(value) + "\n")
   348	            handle.flush()
   349	            os.fsync(handle.fileno())
   350	        os.replace(temporary, path)
   351	        _fsync_dir(path.parent)
   352	    finally:
   353	        Path(temporary).unlink(missing_ok=True)
   354	
   355	
   356	def _reference_identity(genome):
   357	    if genome is None:
   358	        return {"status": "missing"}
   359	    if hasattr(genome, "path"):
   360	        path = Path(genome.path)
   361	        stat = path.stat()
   362	        # Never hash/read an entire reference genome on the login node.
   363	        return dict(path=str(path.resolve()), size=stat.st_size, mtime_ns=stat.st_mtime_ns,
   364	                    fai_sha256=_sha256(genome.fai_path))
   365	    if hasattr(genome, "_seqs"):
   366	        return {"synthetic_sha256": _digest(genome._seqs)}
   367	    raise ValueError("reference must expose indexed FASTA identity")
   368	
   369	
   370	def run_shard(paths, output_dir, scorer, *, shard_index=0, shard_count=1):
   371	    """Bounded streaming writer; interrupted runs retain committed cache entries."""
   372	    import pyarrow as pa
   373	    import pyarrow.parquet as pq
   374	    if (type(shard_index) is not int or type(shard_count) is not int or
   375	            not 0 <= shard_index < shard_count):
   376	        raise ValueError("require 0 <= shard_index < shard_count")
   377	    paths = sorted({Path(p).resolve() for p in paths})
   378	    if not paths:
   379	        raise ValueError("no J6 input parquet shards")
   380	    inputs = _committed_inputs(paths)
   381	    reference = _reference_identity(scorer.genome)
   382	    expected = dict(params=scorer.params, inputs=inputs, reference=reference,
   383	                    shard_index=shard_index, shard_count=shard_count)
   384	    schema = pq.read_schema(paths[0])
   385	    required = {"site_id", "aso_id", "chrom", "start1", "end1", "strand", "target_sequence", "assembly", "annotation"}
   386	    if not required <= set(schema.names) or set(schema.names) & set(_score_schema().names):
   387	        raise ValueError("expected unscored J6 site schema")
   388	    if any(pq.read_schema(p) != schema for p in paths):
   389	        raise ValueError("J6 input schemas differ")
   390	    schema = pa.schema(list(schema) + list(_score_schema()), metadata={
   391	        b"j3_provenance": _json(expected).encode(), b"duplex_model_assumption": ASSUMPTION.encode()})
   392	    output_dir = Path(output_dir)
   393	    output_dir.mkdir(parents=True, exist_ok=True)
   394	    path = output_dir / f"j3_shard{shard_index:04d}_of{shard_count:04d}.parquet"
   395	    done = path.with_suffix(".done")
   396	    with path.with_suffix(".lock").open("a") as lock:
   397	        fcntl.flock(lock, fcntl.LOCK_EX)
   398	        try:
   399	            manifest = json.loads(done.read_text())
   400	            if (all(manifest.get(k) == v for k, v in expected.items()) and
   401	                    manifest["sha256"] == _sha256(path) and manifest["rows"] == pq.read_metadata(path).num_rows):
   402	                return path
   403	        except (OSError, ValueError, KeyError, TypeError, pa.ArrowException):
   404	            pass
   405	        done.unlink(missing_ok=True)
   406	        _fsync_dir(output_dir)
   407	        fd, temp = tempfile.mkstemp(prefix=path.stem + ".", suffix=".tmp", dir=output_dir)
   408	        os.close(fd)
   409	        count = 0
   410	        counts = {c: {s: 0 for s in ("ok", "failed", "missing", "not_applicable")} for c in CHANNELS}
   411	        try:
   412	            with pq.ParquetWriter(temp, schema, compression="zstd") as writer:
   413	                for source in paths:
   414	                    for batch in pq.ParquetFile(source).iter_batches(batch_size=256):
   415	                        rows = []
   416	                        for row in batch.to_pylist():
   417	                            if not isinstance(row["site_id"], str) or not row["site_id"]:
   418	                                raise ValueError("nonempty site_id required")
   419	                            if int(hashlib.sha256(row["site_id"].encode()).hexdigest(), 16) % shard_count != shard_index:
   420	                                continue
   421	                            values = scorer.score(row)
   422	                            rows.append(dict(row, **values))
   423	                            for channel in CHANNELS:
   424	                                counts[channel][values[channel + "_status"]] += 1
   425	                        if rows:
   426	                            writer.write_table(pa.Table.from_pylist(rows, schema=schema))
   427	                            count += len(rows)
   428	            if _committed_inputs(paths) != inputs or _reference_identity(scorer.genome) != reference:
   429	                raise ValueError("input/reference changed during scoring")
   430	            with open(temp, "rb") as handle:
   431	                os.fsync(handle.fileno())
   432	            sha = _sha256(temp)
   433	            os.replace(temp, path)
   434	            _fsync_dir(output_dir)
   435	            _atomic_json(done, dict(**expected, rows=count, sha256=sha, channel_counts=counts))
   436	        finally:
   437	            Path(temp).unlink(missing_ok=True)
   438	    return path
   439	
   440	
   441	def main(argv=None):
   442	    parser = argparse.ArgumentParser(description=__doc__)
   443	    parser.add_argument("--input-dir", required=True)
   444	    parser.add_argument("--output-dir", required=True)
   445	    parser.add_argument("--cache")
   446	    parser.add_argument("--fasta", default=DEFAULT_FASTA)
   447	    parser.add_argument("--vienna-python", default=VIENNA_PYTHON)
   448	    parser.add_argument("--flank", type=int, default=80)
   449	    parser.add_argument("--window", type=int, default=120)
   450	    parser.add_argument("--span", type=int, default=60)
   451	    parser.add_argument("--shard-index", type=int, default=0)
   452	    parser.add_argument("--shard-count", type=int, default=1)
   453	    parser.add_argument("--requeue-safe", action="store_true", help="exit cleanly on TERM/USR1; retain per-channel checkpoints")
   454	    args = parser.parse_args(argv)
   455	    if args.requeue_safe:
   456	        def interrupted(signum, frame):
   457	            raise SystemExit(75)
   458	        signal.signal(signal.SIGTERM, interrupted)
   459	        signal.signal(signal.SIGUSR1, interrupted)
   460	    out = Path(args.output_dir).expanduser()
   461	    paths = sorted(Path(args.input_dir).expanduser().glob("*.parquet"))
   462	    try:
   463	        genome = FaiFastaReader(args.fasta)
   464	    except RuntimeError as exc:
   465	        # Preserve rows and complementarity even when the reference is unavailable.
   466	        print(f"reference unavailable: {exc}", flush=True)
   467	        genome = None
   468	    with ViennaBackend(args.vienna_python) as backend, Scorer(
   469	            backend=backend, genome=genome, cache_path=Path(args.cache).expanduser() if args.cache else out / "j3_cache.sqlite",
   470	            flank=args.flank, window=args.window, span=args.span) as scorer:
   471	        path = run_shard(paths, out, scorer, shard_index=args.shard_index, shard_count=args.shard_count)
   472	        print(path.with_suffix(".done").read_text(), end="", flush=True)
   473	
   474	
   475	if __name__ == "__main__":
   476	    main()

