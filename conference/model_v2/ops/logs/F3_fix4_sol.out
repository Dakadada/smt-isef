    def test_fix4_identity_alias_copies_cannot_reweight_statistics(field, alias, n_copies, consumer):
        rows = labelled(10, 10)
        rows[10]["chemistry_family"] = "moe"
        scores = [.5] * 10 + [1.] + [0.] * 9
