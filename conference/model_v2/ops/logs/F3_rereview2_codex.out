   863	
   864	def _rank_probability(pos: Sequence[float], other: Sequence[float]) -> float:
   865	    """P(pos > other) + 0.5 P(tie), tie-exact (Mann-Whitney U / (n_pos * n_other))."""
   866	    ranks = _midranks(list(pos) + list(other))
   867	    u = sum(ranks[:len(pos)]) - len(pos) * (len(pos) + 1) / 2
   868	    return u / (len(pos) * len(other))
