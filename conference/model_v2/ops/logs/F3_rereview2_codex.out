  1028	@dataclass(frozen=True)
  1029	class PUReport:
  1030	    mode: str
  1031	    quantities: Tuple[PUQuantity, ...]
  1032	    n_positive_rows: int
  1033	    n_positive_units: int
  1034	    n_universe: int
  1035	    universe_states: Tuple[str, ...]
  1036	    excluded_by_state: Mapping[str, int]
  1037	    class_prior: Optional[float]
  1038	    blocked: Mapping[str, str]
  1039	
  1040	    def get(self, name: str, k: Optional[int] = None) -> PUQuantity:
  1041	        for q in self.quantities:
  1042	            if q.name == name and q.k == k:
  1043	                return q
  1044	        raise KeyError((name, k))
