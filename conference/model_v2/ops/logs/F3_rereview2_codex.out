   849	
   850	def _midranks(values: Sequence[float]) -> List[float]:
   851	    order = sorted(range(len(values)), key=values.__getitem__)
   852	    ranks = [0.0] * len(values)
   853	    i = 0
   854	    while i < len(order):
   855	        j = i
   856	        while j + 1 < len(order) and values[order[j + 1]] == values[order[i]]:
   857	            j += 1
   858	        for k in range(i, j + 1):
   859	            ranks[order[k]] = (i + j) / 2 + 1
   860	        i = j + 1
   861	    return ranks
