   360	AXES = ("sequence", "chemistry", "study", "window", "independent_unit")
   361	MODES = {"leave_one_aso_out": "sequence", "leave_study_out": "study",
   362	         "region_blocked": "window"}
   363	_SEQ_RE = re.compile(r"^[ACGTN]+$")
