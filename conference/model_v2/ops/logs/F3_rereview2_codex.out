   248	def validate_table(rows: Any, *, responder_only_studies: Sequence[str] = ()) -> ObservationTable:
   249	    """Validate observation rows (mappings) and return an ``ObservationTable``.
   250	
   251	    ``responder_only_studies``: study ids whose tables list responders only (e.g. a
   252	    hits-only supplement). No ``verified_negative`` may originate from them, and none
   253	    from a row declaring ``source_table_kind`` in ``RESPONDER_ONLY_KINDS``.
   254	    """
   255	    if isinstance(rows, ObservationTable):
   256	        rows = rows.rows
   257	    responder_only = RESPONDER_ONLY_SOURCES | frozenset(_category(s) for s in responder_only_studies)
   258	    out: List[Dict[str, Any]] = []
   259	    seen = set()
   260	    for index, row in enumerate(rows):
   261	        where = f"row {index}"
   262	        if not isinstance(row, Mapping):
   263	            raise SchemaError(f"{where}: not a mapping")
   264	        r = dict(row)
   265	        oid = _nonempty(r, "observation_id", where)
   266	        where = f"row {index} ({oid})"
   267	        if oid in seen:
   268	            raise SchemaError(f"{where}: duplicate observation_id")
   269	        seen.add(oid)
   270	        if "label_state" not in r:
   271	            raise SchemaError(f"{where}: missing label_state")
   272	        state = LabelState.parse(r["label_state"])
   273	        r["label_state"] = state.value
   274	        for name in ("assay_id", "study_id", "independent_unit_id"):
   275	            _nonempty(r, name, where)
   276	        prov = r.get("provenance")
   277	        if isinstance(prov, Mapping):
   278	            if not isinstance(prov.get("source"), str) or not prov["source"].strip():
   279	                raise SchemaError(f"{where}: provenance mapping needs a non-empty 'source'")
   280	        elif not isinstance(prov, str) or not prov.strip():
   281	            raise SchemaError(f"{where}: provenance must be a non-empty string or mapping")
   282	        for text in _strings(prov) + _strings(r.get("source_path")):
   283	            check_source_not_forbidden(text)
   284	        if r.get("evidence_class") is not None:
   285	            r["evidence_class"] = _category(str(r["evidence_class"]))
   286	            if r["evidence_class"] not in EVIDENCE_CLASSES:
   287	                raise SchemaError(f"{where}: bad evidence_class {r['evidence_class']!r}")
   288	        kind = _category(str(r.get("source_table_kind", "")))
   289	        if kind and kind not in SOURCE_TABLE_KINDS:
   290	            raise NegativeEvidenceError(f"{where}: unknown source_table_kind {kind!r}")
   291	        if "source_table_kind" in r:
   292	            r["source_table_kind"] = kind
   293	
   294	        if state is LabelState.VERIFIED_NEGATIVE:
   295	            sources = [r["study_id"]] + _strings(prov) + _strings(r.get("source_path"))
   296	            source_tokens = [_category(form) for s in sources for form in _normalized_source_forms(s)]
   297	            known_responder = any(
   298	                f"_{known}_" in f"_{token}_" for known in responder_only for token in source_tokens)
   299	            if kind in RESPONDER_ONLY_KINDS or known_responder:
   300	                raise NegativeEvidenceError(
   301	                    f"{where}: verified_negative from a responder-only table; absence "
   302	                    "from a responder list is not a measured negative")
   303	            ne = r.get("negative_evidence")
   304	            if not isinstance(ne, Mapping):
   305	                raise NegativeEvidenceError(
   306	                    f"{where}: verified_negative requires an explicit negative_evidence mapping")
   307	            if ne.get("assayed_and_powered") is not True:
   308	                raise NegativeEvidenceError(
   309	                    f"{where}: negative_evidence.assayed_and_powered must be exactly True")
   310	            limit = ne.get("detection_limit")
   311	            if isinstance(limit, bool) or not isinstance(limit, (int, float)) \
   312	                    or not math.isfinite(limit):
   313	                raise NegativeEvidenceError(
   314	                    f"{where}: negative_evidence.detection_limit must be a finite number")
   315	            basis = _category(str(ne.get("basis", "")))
   316	            if basis not in NEGATIVE_BASES:
   317	                raise NegativeEvidenceError(
   318	                    f"{where}: negative_evidence.basis={ne.get('basis')!r} is absence-inferred "
   319	                    "or not a recognized measured-evidence category")
   320	            r["negative_evidence"] = {**ne, "basis": basis}
   385	
   386	def _positive_int(value: Any, name: str) -> None:
   387	    if isinstance(value, bool) or not isinstance(value, int) or value < 1:
   388	        raise SchemaError(f"{name} must be a finite positive integer")
   389	
   390	
   391	@dataclass(frozen=True)
   392	class GroupingConfig:
   393	    """Leakage axes and their thresholds.
   394	
   395	    ``relax`` removes axes from the keep-together set; it is recorded on every plan
   396	    as ``relaxed_axes`` (a declared leakage risk), never applied silently.
   397	    ``window_padding`` pads each window on both sides before clustering (1-based
   398	    closed coordinates, as in J6 ``start1``/``end1``).
   399	    """
   400	    sequence_metric: str = "edit"            # "edit" (Levenshtein) or "hamming"
   401	    sequence_threshold: int = 2
   402	    containment_is_identical: bool = True    # truncations (e.g. 14-mer inside 18-mer)
   403	    min_containment_length: int = 8
   404	    window_padding: int = 0
   405	    strand_aware: bool = True
   406	    relax: Tuple[str, ...] = ()
   407	    max_unique_sequences: int = 4000         # O(n^2) pairwise guard (login-node safe)
   408	
   409	    def __post_init__(self) -> None:
   410	        if self.sequence_metric not in ("edit", "hamming"):
   411	            raise SchemaError(f"bad sequence_metric {self.sequence_metric!r}")
   412	        for name in ("sequence_threshold", "window_padding"):
   413	            value = getattr(self, name)
   414	            if isinstance(value, bool) or not isinstance(value, int) or value < 0:
   415	                raise SchemaError(f"{name} must be a finite nonnegative integer")
   416	        for name in ("min_containment_length", "max_unique_sequences"):
   417	            _positive_int(getattr(self, name), name)
   418	        for name in ("containment_is_identical", "strand_aware"):
   419	            if not isinstance(getattr(self, name), bool):
   420	                raise SchemaError(f"{name} must be a boolean")
   421	        if not isinstance(self.relax, (tuple, list)) or any(
   422	                not isinstance(axis, str) for axis in self.relax):
   423	            raise SchemaError("relax must be a sequence of axis names")
   424	        if len(set(self.relax)) != len(self.relax):
   425	            raise SchemaError("relax must not repeat axes")
   426	        bad = set(self.relax) - set(AXES)
   427	        if bad:
   428	            raise SchemaError(f"unknown axes in relax: {sorted(bad)}")
   429	        if "independent_unit" in self.relax:
   430	            raise SchemaError("independent_unit cannot be relaxed")
   431	        object.__setattr__(self, "relax", tuple(self.relax))
   432	
   433	    @property
   434	    def axes(self) -> Tuple[str, ...]:
   435	        return tuple(a for a in AXES if a not in self.relax)
   436	
   437	
   438	class _UnionFind:
   439	    def __init__(self, n: int):
   440	        self.parent = list(range(n))
   441	
   442	    def find(self, x: int) -> int:
   443	        while self.parent[x] != x:
   444	            self.parent[x] = self.parent[self.parent[x]]
   445	            x = self.parent[x]
   446	        return x
   447	
   448	    def union(self, a: int, b: int) -> None:
   449	        ra, rb = self.find(a), self.find(b)
   450	        if ra != rb:
   451	            self.parent[max(ra, rb)] = min(ra, rb)
   452	
   453	
   454	def normalize_sequence(seq: Any) -> str:
   455	    if not isinstance(seq, str):
   456	        raise SchemaError(f"aso_sequence must be a string, got {seq!r}")
   457	    out = "".join(seq.split()).upper().replace("U", "T")
   458	    if not _SEQ_RE.match(out):
   459	        raise SchemaError(f"aso_sequence {seq!r} is not ACGTUN")
   460	    return out
   461	
   462	
   463	def _edit_within(a: str, b: str, limit: int) -> bool:
   464	    if abs(len(a) - len(b)) > limit:
   465	        return False
   466	    prev = list(range(len(b) + 1))
   467	    for i, ca in enumerate(a, 1):
   468	        cur = [i]
   469	        for j, cb in enumerate(b, 1):
   470	            cur.append(min(prev[j] + 1, cur[j - 1] + 1, prev[j - 1] + (ca != cb)))
   471	        if min(cur) > limit:
   472	            return False
   473	        prev = cur
   474	    return prev[-1] <= limit
   475	
   476	
   477	def _near_identical(a: str, b: str, cfg: GroupingConfig) -> bool:
   478	    if a == b:
   479	        return True
   480	    short, long_ = (a, b) if len(a) <= len(b) else (b, a)
   481	    if cfg.containment_is_identical and len(short) >= cfg.min_containment_length \
   482	            and short in long_:
   483	        return True
   484	    if cfg.sequence_metric == "hamming":
   485	        return len(a) == len(b) and sum(x != y for x, y in zip(a, b)) <= cfg.sequence_threshold
   486	    return _edit_within(a, b, cfg.sequence_threshold)
   487	
   488	
   489	def _sequence_groups(table: ObservationTable, cfg: GroupingConfig) -> List[str]:
   490	    seqs = [normalize_sequence(r.get("aso_sequence")) for r in table.rows]
   491	    uniq = sorted(set(seqs))
   492	    if len(uniq) > cfg.max_unique_sequences:
   493	        raise SplitRefused(
   494	            f"{len(uniq)} unique sequences exceeds max_unique_sequences="
   495	            f"{cfg.max_unique_sequences}; pairwise clustering refused on this node")
   496	    uf = _UnionFind(len(uniq))
   497	    for i in range(len(uniq)):
   498	        for j in range(i + 1, len(uniq)):
   499	            if _near_identical(uniq[i], uniq[j], cfg):
   500	                uf.union(i, j)
   501	    label = {s: f"seq:{uniq[uf.find(i)]}" for i, s in enumerate(uniq)}  # root = smallest
   502	    return [label[s] for s in seqs]
   503	
   504	
   505	def _canonical_chromosome(chrom: str) -> str:
   506	    """GRCh38 primary chromosomes only; unknown contig aliases fail closed."""
   507	    name = chrom.strip().upper()
   508	    if name.startswith("CHR"):
   509	        name = name[3:]
   510	    if name in ("M", "MT"):
   511	        return "chrM"
   512	    if name in {str(i) for i in range(1, 23)} | {"X", "Y"}:
   513	        return "chr" + name
   514	    raise SchemaError(f"unrecognized GRCh38 primary chromosome {chrom!r}")
   515	
   516	
   517	def _window_groups(table: ObservationTable, cfg: GroupingConfig) -> List[str]:
   518	    keyed: Dict[Tuple[str, str], List[Tuple[int, int, int]]] = {}
   519	    for i, r in enumerate(table.rows):
   520	        chrom, start, end, strand = r.get("chrom"), r.get("start"), r.get("end"), r.get("strand")
   521	        ok = (isinstance(chrom, str) and chrom and strand in ("+", "-")
   522	              and all(isinstance(v, int) and not isinstance(v, bool) for v in (start, end))
   523	              and 1 <= start <= end)
   524	        if not ok:
   525	            raise SchemaError(
   526	                f"row {i} ({r['observation_id']}): window axis needs chrom, 1-based closed "
   527	                "int start<=end, strand in +/-")
   528	        chrom = _canonical_chromosome(chrom)
   529	        keyed.setdefault((chrom, strand if cfg.strand_aware else "*"), []).append((start, end, i))
   530	    out = [""] * len(table)
   531	    for (chrom, strand), items in sorted(keyed.items()):
   532	        items.sort()
   533	        cluster: List[int] = []
   534	        lo = hi = 0
   535	        for start, end, i in items + [(None, None, -1)]:  # sentinel flushes the last cluster
   536	            if cluster and (start is None or start > hi + 2 * cfg.window_padding):
   537	                for member in cluster:
   538	                    out[member] = f"win:{chrom}:{strand}:{lo}-{hi}"
   539	                cluster = []
   540	            if start is None:
   541	                break
   542	            if not cluster:
   543	                lo, hi = start, end
   544	            cluster.append(i)
   545	            hi = max(hi, end)
   546	    return out
   547	
   548	
   549	def axis_groups(rows: Any, config: GroupingConfig = GroupingConfig(),
   550	                axes: Optional[Sequence[str]] = None) -> Dict[str, Tuple[str, ...]]:
   551	    """Per-row group id on each requested leakage axis."""
   552	    config.__post_init__()
   553	    table = _as_table(rows)
   554	    out: Dict[str, Tuple[str, ...]] = {}
   555	    for axis in (config.axes if axes is None else axes):
   556	        if axis == "sequence":
   557	            out[axis] = tuple(_sequence_groups(table, config))
   558	        elif axis == "chemistry":
   559	            out[axis] = tuple(
   560	                "chem:" + normalize_chemistry(_nonempty(r, "chemistry_family", f"row {i}"))
   561	                for i, r in enumerate(table.rows))
   562	        elif axis == "study":
   563	            out[axis] = tuple(f"study:{r['study_id']}" for r in table.rows)
   564	        elif axis == "window":
   565	            out[axis] = tuple(_window_groups(table, config))
   566	        elif axis == "independent_unit":
   567	            out[axis] = tuple(f"unit:{r['independent_unit_id']}" for r in table.rows)
   568	        else:
   569	            raise SchemaError(f"unknown axis {axis!r}")
   570	    return out
   571	
