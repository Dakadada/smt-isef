   346	def read_table(path: Any, **kwargs: Any) -> ObservationTable:
   347	    """Read a ``.jsonl`` / ``.json`` observation table, after the forbidden-source guard."""
   348	    name = check_source_not_forbidden(path)
   349	    with open(os.path.expanduser(name), "r", encoding="utf-8") as handle:
   350	        if name.endswith(".jsonl"):
   351	            rows = [json.loads(line) for line in handle if line.strip()]
   352	        elif name.endswith(".json"):
   353	            rows = json.load(handle)
   354	        else:
