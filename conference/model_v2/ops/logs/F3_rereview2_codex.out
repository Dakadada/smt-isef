  1047	def pu_report(rows: Any, scores: Any, *, top_k: Sequence[int] = (), class_prior: Optional[float] = None,
  1048	              min_positives: int = 10, include_unassayed: bool = False) -> PUReport:
  1049	    """PU-valid quantities only. The candidate universe is measured_positive + unlabeled
  1050	    (+ unassayed if ``include_unassayed``); verified_negative and censored rows are excluded.
  1150	
  1151	def effective_clusters(rows: Any, *, merge_axes: Sequence[str] = ("sequence", "window"),
  1152	                       config: GroupingConfig = GroupingConfig()) -> Tuple[str, ...]:
  1153	    """Independent cluster per row: ``independent_unit_id`` merged with every listed
  1154	    leakage axis, so overlapping windows / near-identical ASOs filed under different
  1155	    unit ids still count as ONE cluster. Exact renamed assay copies always collapse,
  1156	    including when optional merge_axes are disabled."""
  1157	    table = _as_table(rows)
  1158	    lists: List[Sequence[str]] = [[f"unit:{r['independent_unit_id']}" for r in table.rows]]
  1159	    duplicate_id = {oid: ids[0] for ids in table.duplicate_assay_records for oid in ids}
  1160	    lists.append([duplicate_id.get(oid, oid) for oid in table.ids])
  1161	    lists += list(axis_groups(table, config, tuple(merge_axes)).values())
  1162	    return tuple(_components(table, lists))
  1163	
  1164	
  1165	def _quantile(sorted_values: Sequence[float], q: float) -> float:
  1166	    pos = q * (len(sorted_values) - 1)
  1167	    lo = int(math.floor(pos))
  1168	    hi = min(lo + 1, len(sorted_values) - 1)
  1169	    return sorted_values[lo] + (sorted_values[hi] - sorted_values[lo]) * (pos - lo)
  1170	
