  1208	    for i in eligible:
  1209	        members.setdefault(clusters[i], []).append(i)
  1210	    ids = sorted(members)
  1211	    if len(ids) < min_clusters:
  1212	        raise UncertaintyRefused(
  1213	            f"CI refused: {len(ids)} independent cluster(s) from {len(eligible)} rows "
  1214	            f"(units merged over {list(merge_axes)}) < minimum {min_clusters}; correlated "
