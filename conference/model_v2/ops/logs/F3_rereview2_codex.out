   743	def make_nested_splits(rows: Any, *, outer_mode: str, inner_mode: Optional[str] = None,
   744	                       config: GroupingConfig = GroupingConfig(), seed: int = 0,
   745	                       outer_n_folds: Optional[int] = None, inner_n_folds: Optional[int] = None,
   746	                       min_outer_groups: int = 3, min_inner_groups: int = 3) -> NestedSplitPlan:
