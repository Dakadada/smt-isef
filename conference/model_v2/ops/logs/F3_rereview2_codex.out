  1251	    keep = [i for i, r in enumerate(table.rows) if r["label_state"] in (POSITIVE, NEGATIVE)]
  1252	    states = [r["label_state"] for r in table.rows]
  1253	    units = effective_clusters(table)
  1254	    relaxed = MetricPolicy(1, 1)
  1255	
  1256	    def statistic(indices: Sequence[int]) -> float:
  1257	        return _supervised(key, name, [states[i] for i in indices], [units[i] for i in indices],
  1258	                           [s[i] for i in indices], relaxed, threshold, n_bins).value
