  1011	PU_QUANTITIES = ("pu_recall_at_top_k", "pu_positive_mean_percentile_rank",
  1012	                 "pu_positive_median_percentile_rank",
  1013	                 "pu_positive_vs_unlabeled_rank_probability",
  1014	                 "pu_prior_adjusted_rank_probability")
  1015	_PU_BASE = ("positive-unlabeled: unlabeled candidates are a mixture of undiscovered "
  1016	            "positives and negatives and are never counted as negatives")
