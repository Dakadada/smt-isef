   923	def _supervised(key: str, display: str, states: Sequence[str], units: Sequence[str],
   924	                scores: Sequence[float], policy: MetricPolicy, threshold: Optional[float],
   925	                n_bins: int) -> MetricResult:
   926	    policy.__post_init__()  # public policy instances are not a validation bypass
   927	    keep = [i for i, st in enumerate(states) if st in (POSITIVE, NEGATIVE)]
   928	    y = [1 if states[i] == POSITIVE else 0 for i in keep]
   929	    s = [scores[i] for i in keep]
   930	    pos_units = {units[i] for i in keep if states[i] == POSITIVE}
   931	    neg_units = {units[i] for i in keep if states[i] == NEGATIVE}
   932	    excluded: Dict[str, int] = {}
   933	    for st in states:
   934	        if st not in (POSITIVE, NEGATIVE):
   935	            excluded[st] = excluded.get(st, 0) + 1
   936	    problems = []
   937	    if not neg_units or len(neg_units) < policy.min_verified_negatives:
   938	        problems.append(f"{len(neg_units)} independent verified_negative unit(s) "
   939	                        f"({len(y) - sum(y)} rows) < minimum {policy.min_verified_negatives}")
   940	    if not pos_units or len(pos_units) < policy.min_positives:
   941	        problems.append(f"{len(pos_units)} independent measured_positive unit(s) "
   942	                        f"({sum(y)} rows) < minimum {policy.min_positives}")
   943	    if problems:
   944	        raise MetricBlocked(display, "; ".join(problems) + (
   945	            f"; excluded (never negatives): {excluded}" if excluded else "")
   946	            + ". Use pu_report() for positive-unlabeled quantities.")
   947	    value = _metric_value(key, y, s, threshold, n_bins)
   948	    return MetricResult(key, value, "derived", "supervised", sum(y), len(y) - sum(y),
   949	                        len(pos_units), len(neg_units), excluded, len(s) - len(set(s)),
   950	                        threshold if key in _THRESHOLD_METRICS else None)
   951	
   952	
   953	def _check_supervised_request(name: str, mode: str, negative_states: Sequence[str]) -> str:
   954	    key = metric_key(name)
   955	    if mode == "pu":
   956	        raise MetricBlocked(name, "positive-unlabeled mode never emits supervised metrics; "
   957	                                  "use pu_report()")
   958	    if mode != "supervised":
   959	        raise SchemaError(f"unknown mode {mode!r}")
   960	    extra = set(negative_states) - {NEGATIVE}
   961	    if extra or NEGATIVE not in negative_states:
   962	        raise LabelStateError(
   963	            f"negative_states={list(negative_states)}: only verified_negative is a negative; "
   964	            f"{sorted(extra)} can never be treated as negative")
   965	    if key not in SUPERVISED_METRICS:
   966	        raise SchemaError(f"unknown metric {name!r}; supported: {list(SUPERVISED_METRICS)}")
   967	    return key
   968	
   969	
   970	def _has_duplicate_contributors(table: ObservationTable, indices: Sequence[int]) -> bool:
   971	    ids = {table.rows[i]["observation_id"] for i in indices}
   972	    return any(sum(oid in ids for oid in copies) > 1 for copies in table.duplicate_assay_records)
   973	
   974	
   975	_DUPLICATE_REASON = ("duplicate assay records: renamed copies provide only 1 independent "
   976	                     "assay per group; resolve copies before computing statistics")
   977	
   978	
   979	def compute_metric(name: str, rows: Any, scores: Any, *, policy: MetricPolicy = MetricPolicy(),
   980	                   threshold: Optional[float] = None, n_bins: int = 10,
   981	                   mode: str = "supervised",
   982	                   negative_states: Sequence[str] = (NEGATIVE,)) -> MetricResult:
   983	    """Guarded supervised metric over measured_positive vs verified_negative rows only.
   984	
   985	    Higher score = more positive. Raises ``MetricBlocked`` (with ``.reason``) when
   986	    either class has fewer independent units than ``policy`` requires.
   987	    """
   988	    key = _check_supervised_request(name, mode, negative_states)
   989	    table = _as_table(rows)
   990	    keep = [i for i, r in enumerate(table.rows) if r["label_state"] in (POSITIVE, NEGATIVE)]
   991	    if _has_duplicate_contributors(table, keep):
   992	        raise MetricBlocked(name, _DUPLICATE_REASON)
   993	    s = _resolve_scores(table, scores)
   994	    return _supervised(key, name, [r["label_state"] for r in table.rows],
   995	                       effective_clusters(table), s, policy, threshold,
   996	                       n_bins)
   997	
   998	
   999	def precision_recall_curve(rows: Any, scores: Any, *, policy: MetricPolicy = MetricPolicy()
  1000	                           ) -> List[Tuple[float, float, float]]:
  1001	    """Guarded (threshold, precision, recall) points; same blocking rule as AUPRC."""
  1002	    table = _as_table(rows)
  1003	    s = _resolve_scores(table, scores)
  1004	    compute_metric("auprc", table, s, policy=policy)  # raises MetricBlocked if not allowed
  1005	    keep = [i for i, r in enumerate(table.rows) if r["label_state"] in (POSITIVE, NEGATIVE)]
  1006	    return _pr_points([int(table.rows[i]["label_state"] == POSITIVE) for i in keep],
  1007	                      [s[i] for i in keep])
