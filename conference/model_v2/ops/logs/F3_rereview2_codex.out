   218	
   219	@dataclass(frozen=True)
   220	class ObservationTable:
   221	    """Deeply immutable validated rows; public consumers revalidate even this wrapper.
   222	
   223	    ``duplicate_assay_records`` lists exact record copies differing only in row/unit
   224	    identifiers. They are retained and counted as one independent unit for grouping;
   225	    statistics refuse duplicate contributors rather than giving copies extra weight.
   226	    """
   227	    rows: Tuple[Mapping[str, Any], ...]
   228	    duplicate_assay_records: Tuple[Tuple[str, ...], ...] = ()
   229	
   230	    def __len__(self) -> int:
   231	        return len(self.rows)
   232	
   233	    @property
   234	    def ids(self) -> Tuple[str, ...]:
   235	        return tuple(r["observation_id"] for r in self.rows)
   236	
