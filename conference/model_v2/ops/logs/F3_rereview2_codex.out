   871	def _pr_points(y: Sequence[int], s: Sequence[float]) -> List[Tuple[float, float, float]]:
   872	    """(threshold, precision, recall) at each distinct score, descending; ties grouped."""
   873	    n_pos = sum(y)
   874	    order = sorted(range(len(s)), key=lambda i: -s[i])
   875	    points, tp, fp, i = [], 0, 0, 0
   876	    while i < len(order):
   877	        j = i
   878	        while j < len(order) and s[order[j]] == s[order[i]]:
   879	            tp += y[order[j]]
   880	            fp += 1 - y[order[j]]
   881	            j += 1
   882	        points.append((s[order[i]], tp / (tp + fp), tp / n_pos))
   883	        i = j
   884	    return points
