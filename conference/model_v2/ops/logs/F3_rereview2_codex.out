   588	def _stable_seed(*parts: Any) -> int:
   589	    blob = json.dumps(parts, sort_keys=True, default=str).encode()
   590	    return int(hashlib.sha256(blob).hexdigest()[:16], 16)
   591	
   592	
   593	def _plain(value: Any) -> Any:
   594	    if isinstance(value, Mapping):
   595	        return {k: _plain(v) for k, v in value.items()}
   596	    if isinstance(value, (tuple, list)):
   597	        return [_plain(v) for v in value]
   598	    if isinstance(value, (set, frozenset)):
   599	        return sorted((_plain(v) for v in value), key=repr)
   600	    if isinstance(value, os.PathLike):
   601	        return os.fspath(value)
   602	    return value
   603	
   604	
   605	def _fingerprint(value: Any) -> str:
   606	    return hashlib.sha256(json.dumps(_plain(value), sort_keys=True,
   607	                                    separators=(",", ":")).encode()).hexdigest()
