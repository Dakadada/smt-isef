   691	def _splits_from_groups(table: ObservationTable, mode: str, config: GroupingConfig,
   692	                        seed: int, n_folds: Optional[int], min_independent_groups: int,
   693	                        groups: Mapping[str, Tuple[str, ...]]) -> SplitPlan:
   694	    _positive_int(min_independent_groups, "min_independent_groups")
   695	    if mode not in MODES or MODES[mode] not in config.axes:
   696	        raise SchemaError(f"invalid split mode or relaxed primary axis: {mode!r}")
   697	    primary, axes = MODES[mode], config.axes
   698	    comp = _components(table, [groups[a] for a in axes])
   699	    n_comp = len(set(comp))
   700	    if n_comp < min_independent_groups:
