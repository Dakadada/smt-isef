   840	    else:
   841	        out = list(scores)
   842	        if len(out) != len(table):
   843	            raise SchemaError(f"{len(out)} scores for {len(table)} rows")
   844	    for value in out:
   845	        if isinstance(value, bool) or not isinstance(value, (int, float)) or not math.isfinite(value):
