  1415	        raise SchemaError("feature inputs require nonempty source_paths and feature_sources manifest")
  1416	    allowed = set()
  1417	    for path in source_paths:
  1418	        if not isinstance(path, (str, os.PathLike)) or not os.fspath(path).strip():
  1419	            raise SchemaError("source_paths entries must be nonempty paths")
  1420	        allowed.add(check_source_not_forbidden(path))
  1421	    # Check ALL declared sources, including entries not consumed by this baseline.
  1422	    for oid, manifest in feature_sources.items():
  1423	        if not isinstance(manifest, Mapping):
  1424	            raise SchemaError(f"feature_sources[{oid!r}] must map columns to source paths")
  1425	        for col, paths in manifest.items():
  1426	            if not isinstance(paths, (list, tuple)) or not paths:
  1427	                raise SchemaError(f"feature source manifest for {oid}/{col} needs nonempty paths")
  1428	            for path in paths:
  1429	                if not isinstance(path, (str, os.PathLike)) or not os.fspath(path).strip():
  1430	                    raise SchemaError("feature source paths must be nonempty")
  1431	                if check_source_not_forbidden(path) not in allowed:
  1432	                    raise SchemaError(f"feature source {path!r} absent from source_paths")
  1433	    for oid, values in features.items():
  1434	        if not isinstance(values, Mapping):
  1435	            raise SchemaError(f"features[{oid!r}] must be a mapping")
  1436	        required = set(values) | (set(columns) if oid in ids else set())
  1437	        if required - set(feature_sources.get(oid, {})):
  1438	            raise SchemaError(f"feature source manifest missing coverage for {oid}")
  1439	    return _freeze(features)
