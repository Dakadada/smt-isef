  1237	    return CIResult(point, _quantile(values, alpha / 2), _quantile(values, 1 - alpha / 2), alpha,
  1238	                    len(ids), n_boot, failed, seed, tuple(merge_axes),
  1239	                    "percentile_cluster_bootstrap", "derived")
