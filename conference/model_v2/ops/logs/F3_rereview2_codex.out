  1222	        draw = [ids[rng.randrange(len(ids))] for _ in ids]
  1223	        try:
  1224	            value = float(statistic(tuple(i for c in draw for i in members[c])))
  1225	        except MetricBlocked:
  1226	            failed += 1
  1227	            continue
  1228	        if math.isfinite(value):
  1229	            values.append(value)
  1230	        else:
  1231	            failed += 1
  1232	    if not values or failed > max_failed_fraction * n_boot:
  1233	        raise UncertaintyRefused(
  1234	            f"CI refused: {failed}/{n_boot} bootstrap replicates were degenerate "
  1235	            f"(> {max_failed_fraction:.0%}); too few clusters per class for a stable interval")
