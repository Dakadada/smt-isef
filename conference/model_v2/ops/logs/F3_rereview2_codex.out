   377	def normalize_chemistry(value: str) -> str:
   378	    text = unicodedata.normalize("NFKC", value).casefold().strip()
   379	    # Remove only known orthographic separators; do not turn MOE/LNA or MOE? into aliases.
   380	    key = re.sub(r"[\s\-'′’]", "", text)
   381	    if key not in CHEMISTRY_ALIASES:
   382	        raise SchemaError(f"unknown or ambiguous chemistry_family {value!r}")
   383	    return CHEMISTRY_ALIASES[key]
