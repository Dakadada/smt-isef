  1405	def _validate_feature_sources(features: Mapping[str, Mapping[str, Any]],
  1406	                              ids: Sequence[str], columns: Sequence[str],
  1407	                              source_paths: Sequence[Any],
  1408	                              feature_sources: Any) -> Mapping[str, Mapping[str, Any]]:
  1409	    """Require declared lineage for every feature cell before passing it to a fitter.
  1410	
  1411	    Manifest shape: {observation_id: {column: (source_path, ...)}}. This validates
  1412	    coverage and forbidden names; it cannot authenticate caller-declared lineage.
  1413	    """
