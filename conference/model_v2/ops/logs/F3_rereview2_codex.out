  1242	def bootstrap_metric_ci(name: str, rows: Any, scores: Any, *,
  1243	                        policy: MetricPolicy = MetricPolicy(), threshold: Optional[float] = None,
  1244	                        n_bins: int = 10, **kwargs: Any) -> CIResult:
