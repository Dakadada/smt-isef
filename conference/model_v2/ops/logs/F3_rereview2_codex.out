  1172	def cluster_bootstrap_ci(rows: Any, statistic: Callable[[Sequence[int]], float], *,
  1173	                         n_boot: int = 1000, seed: int = 0, min_clusters: int = 10,
  1174	                         alpha: float = 0.05, merge_axes: Sequence[str] = ("sequence", "window"),
  1175	                         config: GroupingConfig = GroupingConfig(),
  1176	                         max_failed_fraction: float = 0.1,
  1177	                         eligible_indices: Optional[Sequence[int]] = None) -> CIResult:
  1178	    """Percentile cluster bootstrap. ``statistic(indices)`` receives row indices (with
  1179	    repeats) of whole resampled clusters. Refuses with ``UncertaintyRefused`` when
  1180	    fewer than ``min_clusters`` effective clusters exist, or when too many replicates
  1181	    are degenerate (``MetricBlocked`` / non-finite). ``eligible_indices`` restricts
  1182	    the point/resamples and cluster count to contributing observations, while keeping
  1183	    the original clustering (excluded bridge rows cannot split an established unit).
  1184	    Statistic indices always refer to the original input rows.
  1185	    Sequence and window merging are mandatory; extra merge axes may be requested.
  1186	    Exact assay copies among contributing rows are refused before calling statistic.
  1187	    """
  1188	    merge_axes = tuple(merge_axes)
  1189	    if not {"sequence", "window"}.issubset(merge_axes):
  1190	        raise UncertaintyRefused("CI requires sequence and window merging; axes cannot be weakened")
