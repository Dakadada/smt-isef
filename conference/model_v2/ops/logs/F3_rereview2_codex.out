   238	        return ObservationTable(tuple(self.rows[i] for i in indices))
   239	
   240	
   241	def _nonempty(row: Mapping[str, Any], name: str, where: str) -> str:
   242	    value = row.get(name)
   243	    if not isinstance(value, str) or not value.strip():
   244	        raise SchemaError(f"{where}: field {name!r} must be a non-empty string")
   245	    return value
   246	
