  1195	            or not math.isfinite(alpha) or not 0.0 < alpha < 1.0:
  1196	        raise SchemaError("need finite 0 < alpha < 1")
  1197	    if isinstance(max_failed_fraction, bool) or not isinstance(max_failed_fraction, (int, float)) \
  1198	            or not math.isfinite(max_failed_fraction) or not 0 <= max_failed_fraction <= 1:
  1199	        raise SchemaError("max_failed_fraction must be finite in [0, 1]")
  1200	    clusters = effective_clusters(table, merge_axes=merge_axes, config=config)
  1201	    eligible = tuple(range(len(table))) if eligible_indices is None else tuple(eligible_indices)
  1202	    if any(isinstance(i, bool) or not isinstance(i, int) or not 0 <= i < len(table)
  1203	           for i in eligible) or len(set(eligible)) != len(eligible):
  1204	        raise SchemaError("eligible_indices must be unique valid row indices")
  1205	    if _has_duplicate_contributors(table, eligible):
  1206	        raise UncertaintyRefused(_DUPLICATE_REASON)
