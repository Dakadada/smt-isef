   886	
   887	def _metric_value(key: str, y: Sequence[int], s: Sequence[float],
   888	                  threshold: Optional[float], n_bins: int) -> float:
   889	    n_pos = sum(y)
   890	    if key == "auroc":
   891	        return _rank_probability([v for v, t in zip(s, y) if t], [v for v, t in zip(s, y) if not t])
   892	    if key == "auprc":  # average precision; a tie group contributes one step
   893	        total, prev = 0.0, 0.0
   894	        for _, precision, recall in _pr_points(y, s):
   895	            total += (recall - prev) * precision
   896	            prev = recall
   897	        return total
   898	    if key in _THRESHOLD_METRICS:
   899	        if threshold is None:
   900	            raise SchemaError(f"{key} needs an explicit threshold (score >= threshold is positive)")
   901	        pred = [v >= threshold for v in s]
   902	        tp = sum(1 for p, t in zip(pred, y) if p and t)
   903	        fp = sum(1 for p, t in zip(pred, y) if p and not t)
   904	        if key == "accuracy":
   905	            return (tp + sum(1 for p, t in zip(pred, y) if not p and not t)) / len(y)
   906	        if key == "recall":
   907	            return tp / n_pos
   908	        if tp + fp == 0:
   909	            raise MetricBlocked(key, f"no predictions at threshold {threshold}; {key} undefined")
   910	        return tp / (tp + fp) if key == "precision" else fp / (tp + fp)
   911	    if any(v < 0.0 or v > 1.0 for v in s):
   912	        raise SchemaError(f"{key} needs probabilities in [0, 1]")
   913	    if key == "brier":
   914	        return sum((v - t) ** 2 for v, t in zip(s, y)) / len(y)
   915	    if n_bins < 1:
   916	        raise SchemaError("n_bins must be >= 1")
   917	    bins: Dict[int, List[Tuple[float, int]]] = {}
   918	    for v, t in zip(s, y):
   919	        bins.setdefault(min(int(v * n_bins), n_bins - 1), []).append((v, t))
   920	    return sum(abs(sum(v for v, _ in b) - sum(t for _, t in b)) for b in bins.values()) / len(y)
