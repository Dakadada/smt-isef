   365	# Closed vocabulary. PS alone is a backbone, not an unambiguous chemistry family.
   366	CHEMISTRY_ALIASES = {
   367	    "moe": "moe", "2moe": "moe", "2omoe": "moe", "2omethoxyethyl": "moe",
   368	    "methoxyethyl": "moe",
   369	    "ome": "ome", "2ome": "ome", "2omethyl": "ome",
   370	    "lna": "lna", "lockednucleicacid": "lna",
   371	    "pmo": "pmo", "morpholino": "pmo", "phosphorodiamidatemorpholino": "pmo",
   372	    "pna": "pna", "peptidenucleicacid": "pna", "dna": "dna", "rna": "rna",
