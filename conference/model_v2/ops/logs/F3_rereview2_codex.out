   646	def verify_no_leakage(plan: SplitPlan, rows: Any = None) -> None:
   647	    """Raise ``LeakageError`` if any active-axis group appears in both train and test."""
   648	    if rows is not None:
   649	        table = _as_table(rows)
   650	        if plan.observation_ids != table.ids or plan.data_fingerprint != _fingerprint(table.rows):
   651	            raise SchemaError("split plan was built for a different table (data fingerprint differs)")
   652	        expected = make_splits(table, plan.mode, config=plan.config, seed=plan.seed,
   653	                               n_folds=plan.n_folds,
   654	                               min_independent_groups=plan.min_independent_groups)
   655	        if plan != expected:
   656	            raise LeakageError("split plan differs from recomputed groups/config/folds")
   657	    for fold in plan.folds:
   658	        if set(fold.test_idx) & set(fold.train_idx):
   659	            raise LeakageError(f"fold {fold.fold_id}: a row is in both train and test")
   660	        for axis in plan.axes:
   661	            groups = plan.group_ids[axis]
   662	            both = {groups[i] for i in fold.train_idx} & {groups[i] for i in fold.test_idx}
   663	            if both:
   664	                raise LeakageError(f"fold {fold.fold_id}: {axis} groups straddle: {sorted(both)}")
   665	
