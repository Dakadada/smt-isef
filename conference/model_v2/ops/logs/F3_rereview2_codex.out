   572	
   573	def _components(table: ObservationTable, group_lists: Sequence[Sequence[str]]) -> List[str]:
   574	    """Connected components of rows linked through any of the given group ids."""
   575	    uf = _UnionFind(len(table))
   576	    for groups in group_lists:
   577	        first: Dict[str, int] = {}
   578	        for i, g in enumerate(groups):
   579	            uf.union(first.setdefault(g, i), i)
   580	    ids = table.ids
   581	    smallest: Dict[int, str] = {}
   582	    for i in range(len(table)):
   583	        root = uf.find(i)
   584	        smallest[root] = min(smallest.get(root, ids[i]), ids[i])
   585	    return [f"component:{smallest[uf.find(i)]}" for i in range(len(table))]
