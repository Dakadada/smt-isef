   667	def make_splits(rows: Any, mode: str, *, config: GroupingConfig = GroupingConfig(),
   668	                seed: int = 0, n_folds: Optional[int] = None,
   669	                min_independent_groups: int = 3) -> SplitPlan:
   670	    """Purged group split.
   671	
   672	    ``n_folds=None``: leave-one-primary-unit-out (one ASO cluster / study / region
   673	    block per fold, sorted order). ``n_folds=k``: seeded k-fold over independent
   674	    components. Refuses (``SplitRefused``) when the number of independent components
   675	    over all active axes is below ``min_independent_groups``.
   676	    """
   677	    _positive_int(min_independent_groups, "min_independent_groups")
   678	    if mode == "nested":
   679	        raise SchemaError("use make_nested_splits for mode='nested'")
   680	    if mode not in MODES:
   681	        raise SchemaError(f"unknown mode {mode!r}; expected {sorted(MODES)} or 'nested'")
   682	    primary = MODES[mode]
   683	    axes = config.axes
   684	    if primary not in axes:
   685	        raise SchemaError(f"mode {mode!r} cannot relax its own primary axis {primary!r}")
   686	    table = _as_table(rows)
   687	    groups = axis_groups(table, config, axes)
   688	    return _splits_from_groups(table, mode, config, seed, n_folds, min_independent_groups, groups)
