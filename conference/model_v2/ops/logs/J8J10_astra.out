class SchemaError(ValueError):
    """Structural or invariant violation in an intervention record."""
def _score_schema():
    import pyarrow as pa
    strings = ["score_cache_key", "aso_sequence", "target_with_flank", "flank_left", "flank_right",
               "duplex_model_assumption", "duplex_scope", "accessibility_method", "duplex_structure"]
    strings += [c + suffix for c in CHANNELS for suffix in ("_status", "_reason", "_evidence_class")]
    return pa.schema([(name, pa.string()) for name in strings] + [
        ("footprint_start1_in_context", pa.int32()),
        ("complementarity_wc_pairs", pa.int32()), ("complementarity_gu_pairs", pa.int32()),
        ("complementarity_mismatch_count", pa.int32()),
        ("complementarity_mismatch_positions_1b", pa.list_(pa.int32())),
        ("duplex_energy_kcal_mol", pa.float64()), ("accessibility_p_unpaired", pa.float64())])


def _committed_inputs(paths):
def _schema():
    import pyarrow as pa
    return pa.schema([
        ("site_id", pa.string()), ("aso_id", pa.string()), ("chrom", pa.string()),
        ("start1", pa.int64()), ("end1", pa.int64()), ("strand", pa.string()),
        ("gene_id", pa.string()), ("gene_name", pa.string()), ("region_class", pa.string()),
        ("region_classes", pa.list_(pa.string())), ("transcript_ids", pa.list_(pa.string())),
        ("mismatch_count", pa.int32()), ("mismatch_positions", pa.list_(pa.int32())),
        ("target_sequence", pa.string()), ("paralog_ambiguity", pa.bool_()),
        ("evidence_class", pa.string()), ("assembly", pa.string()), ("annotation", pa.string()),
    ])


def _fsync_dir(path):
    fd = os.open(path, os.O_RDONLY)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)

# J4 scale-out configs for conference.model_v2.gpu_perturbation_atlas
# builder_version=1 assembly=GRCh38 annotation=GENCODE v50
# loci=conference/model_v2/manifests/j2_loci_phase1.tsv loci_sha256=0320754ca0eb2a08e8c6e199b995f69121ba0dfb47d0f2c884e4981c5287fc3a
# exon_pad=100 half_span=50 lengths=10,14,18 stride=5
