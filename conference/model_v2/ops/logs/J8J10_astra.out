print('rss_kib',resource.getrusage(resource.RUSAGE_SELF).ru_maxrss)
Path('/tmp/j8j10-profile.json').write_text(json.dumps(dict(loci=len(loci),j6_n=32,j6_read_s=read,j6_geometry_s=elapsed,j9_n=len(rows),rss_kib=resource.getrusage(resource.RUSAGE_SELF).ru_maxrss)))
