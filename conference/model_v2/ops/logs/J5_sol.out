"""J8: bounded-batch derived-table join. No outcomes or scoring backends.

Coordinates are 1-based inclusive GRCh38/GENCODE v50. Geometry is relative to
curated J2 exon interiors (the manifests include exactly 100 bases of padding).
Distances use the footprint midpoint and transcript orientation. J4 overlap
summaries are explicitly distinct from exact-footprint predictions. JSON feature
cells retain alternative/context identity, status, evidence and missing values.

The SQLite index checkpoints each verified input atomically. Its cache is 32 MiB;
Arrow batches are bounded, but upstream Parquet footers also consume memory.
Full indexing is a Slurm operation; --bounded selects an explicitly partial atlas.
The prior per-source full-genome index projection is ~37 GB, so --max-index-gib must be raised past its
20 GiB default (see jobs/j8_full.sbatch for the per-source measurements).

Known upstream coverage gap, not a defect here: J2 folded u in {8,12,18} while the
ASO footprints are 10/14/18 nt, so only F18 sites (~0.01% of J6) can ever match a
J2 grid cell exactly. Every other site's j2_accessibility is explicitly
not_available; no length substitution is ever performed. J3's own per-footprint
accessibility channel is unaffected and remains the usable accessibility source.
"""
from __future__ import annotations

import argparse
import csv
import hashlib
import json
import math
import os
from pathlib import Path
import sqlite3
import struct
import tempfile
import zlib
from bisect import bisect_left, bisect_right
from itertools import groupby

import pyarrow as pa
import pyarrow.parquet as pq
from conference.model_v2.evaluation_core import check_source_not_forbidden

VERSION = '1.0.0'
ASSEMBLY, ANNOTATION = 'GRCh38', 'GENCODE v50'
OUTCOME_COLUMNS = {'label', 'label_state', 'outcome', 'psi', 'delta_psi', 'dpsi', 'efficacy', 'potency'}
J3_DROP_COLUMNS = {'target_with_flank', 'flank_left', 'flank_right', 'duplex_structure'}


def safe_path(path):
    p = Path(check_source_not_forbidden(path)).expanduser().resolve()
    if any(x.lower() in {'wetlab', 'terminal', 'psi25'} for x in p.parts):
        raise ValueError('outcome source forbidden')
    return p


def sha256(path):
    h = hashlib.sha256()
    with safe_path(path).open('rb') as stream:
        for chunk in iter(lambda: stream.read(1024 * 1024), b''):
            h.update(chunk)
    return h.hexdigest()


def dumps(value):
    return json.dumps(value, sort_keys=True, separators=(',', ':'), allow_nan=False)


def atomic_json(path, value):
    path = safe_path(path)
    fd, temp = tempfile.mkstemp(dir=path.parent, suffix='.tmp')
    try:
        with os.fdopen(fd, 'w') as stream:
            stream.write(dumps(value) + '\n'); stream.flush(); os.fsync(stream.fileno())
        os.replace(temp, path)
    finally:
        if os.path.exists(temp): os.unlink(temp)


def fence(row):
    if row.get('assembly') != ASSEMBLY or row.get('annotation') != ANNOTATION:
        raise ValueError('assembly/annotation fence requires GRCh38 / GENCODE v50')
    if row.get('strand') not in ('+', '-') or not 1 <= row['start1'] <= row['end1']:
        raise ValueError('invalid 1-based inclusive coordinates')


def load_loci(paths):
    result = {}
    for path in paths:
        with safe_path(path).open() as stream:
            for line in stream:
                if not line.strip() or line.startswith('#'): continue
                lid, chrom, start, end, strand = line.strip().split('\t')
                row = dict(locus_id=lid, chrom=chrom, start1=int(start), end1=int(end), strand=strand)
                fence(dict(row, assembly=ASSEMBLY, annotation=ANNOTATION))
                if row['end1'] - row['start1'] < 200: raise ValueError('locus lacks 100nt exon padding')
                if lid in result and result[lid] != row: raise ValueError('conflicting locus geometry')
                result[lid] = row
    # These are full canonical transcript exon lists, not selected interior exons.
    # Terminal transcript ends are not splice junctions. Fail on incomplete lists.
    transcripts={}
    for lid in result:
        if ':ex' in lid:
            tx, number=lid.rsplit(':ex',1)
            transcripts.setdefault(tx,[]).append(int(number))
    for tx, numbers in transcripts.items():
        if sorted(numbers)!=list(range(1,max(numbers)+1)):
            raise ValueError('incomplete canonical exon list: '+tx)
    for lid,row in result.items():
        if row['start1']==1:
            raise ValueError('clipped exon padding needs explicit unpadded geometry')
        if ':ex' in lid:
            tx, number=lid.rsplit(':ex',1); number=int(number)
            row['acceptor_position']=(row['start1']+100 if row['strand']=='+' else row['end1']-100) if number>1 else None
            row['donor_position']=(row['end1']-100 if row['strand']=='+' else row['start1']+100) if number<max(transcripts[tx]) else None
    return sorted(result.values(), key=lambda x:x['locus_id'])


class GeometryIndex:
    """Small curated exon index; nearest boundaries via bisect, overlaps by chromosome."""
    def __init__(self, loci):
        self.groups = {}; self.boundaries = {}; self.intervals={}
        for loc in loci:
            key = (loc['chrom'], loc['strand'])
            self.groups.setdefault(key, []).append(loc)
        for key, group in self.groups.items():
            ordered=sorted(group,key=lambda l:(l['start1'],l['locus_id']))
            ends=[]; maximum=0
            for loc in ordered:
                maximum=max(maximum,loc['end1']); ends.append(maximum)
            self.intervals[key]=([l['start1'] for l in ordered],ends,ordered)
            for kind in ('donor', 'acceptor'):
                positions=[]
                for loc in group:
                    default=loc['end1']-100 if (kind == 'donor') == (key[1] == '+') else loc['start1']+100
                    position=loc.get(kind+'_position',default)
                    if position is not None: positions.append((position,loc['locus_id']))
                self.boundaries[key, kind] = sorted(positions)

    def overlapping(self,row):
        item=self.intervals.get((row['chrom'],row['strand']))
        if item is None: return []
        starts,ends,ordered=item
        lo=bisect_left(ends,row['start1']); hi=bisect_right(starts,row['end1'])
        return [l for l in ordered[lo:hi] if l['end1']>=row['start1']]

    def annotate(self, row):
        fence(row)
        key = (row['chrom'], row['strand']); group = self.groups.get(key, [])
        result = dict(status='ok' if group else 'not_available', evidence_class='derived' if group else 'not_available',
                      anchor='footprint_midpoint', donor_distance=None, acceptor_distance=None,
                      donor_locus=None, acceptor_locus=None, region_class='not_available')
        mid = (row['start1']+row['end1'])/2
        for kind in ('donor','acceptor'):
            boundaries = self.boundaries.get((key,kind), [])
            i = bisect_left(boundaries, (mid, ''))
            options = boundaries[max(0,i-1):i+1]
            if options:
                pos, lid = min(options, key=lambda x:(abs(x[0]-mid),x))
                result[kind+'_distance'] = (mid-pos)*(1 if row['strand']=='+' else -1)
                result[kind+'_locus'] = lid
        local=self.overlapping(row)
        overlaps = [l for l in local if l['start1']+100 <= row['end1'] and l['end1']-100 >= row['start1']]
        if overlaps:
            result['region_class'] = ('exonic' if any(l['start1']+100 <= row['start1'] and row['end1'] <= l['end1']-100 for l in overlaps)
                                      else 'exon_intron_spanning')
        elif local:
            result['region_class'] = 'intronic_flank'
        elif group: result['region_class'] = 'outside_curated_exons'
        return result


def geometry(row, loci):
            reference = sequence[start - shard.start1:end - shard.start1 + 1]
            for aso in self.asos:
                query = aso.target_sequence if gene.strand == "+" else aso.sequence_5to3
                for hit in seed_and_extend(query, reference, max_mismatch=max_mismatch):
                    lo, hi = start + hit.start, start + hit.end - 1
                    if lo > shard.end1:
                        continue
                    target = reference[hit.start:hit.end]
                    if gene.strand == "-":
                        target = reverse_complement(target)
                    positions = tuple(sorted(aso.length - i for i, (a, b) in
                                             enumerate(zip(aso.target_sequence, target)) if a != b))
                    if len(positions) != hit.mismatches:
                        raise ValueError("scanner/mismatch-position disagreement")
                    ambiguous = False
                    if gene.gene_name in self.paralogs:
                        other_name = "SMN1" if gene.gene_name == "SMN2" else "SMN2"
                        others = self.paralogs[other_name]
                        ambiguous = False if others else None
                        for other in others:
                            if other.gene_id not in self._paralog_sequences:
                                seq = _fetch(self.genome, other.chrom, other.start1, other.end1)
                                self._paralog_sequences[other.gene_id] = seq if other.strand == "+" else reverse_complement(seq)
                            if target in self._paralog_sequences[other.gene_id]:
                                ambiguous = True
                                break
                    region, regions, transcripts = _annotation(gene, lo, hi)
                    assembly = "synthetic" if self.synthetic_reference else ASSEMBLY
                    identity = [assembly, ANNOTATION, aso.aso_id, aso.sequence_5to3,
                                gene.gene_id, gene.chrom, lo, hi, gene.strand, target]
                    yield Site("j6-" + _digest(identity), aso.aso_id, gene.chrom, lo, hi,
                               gene.strand, gene.gene_id, gene.gene_name, region, regions,
                               transcripts, hit.mismatches, positions, target, ambiguous, assembly=assembly)


def iter_sites(genome, genes, asos, *, max_mismatch=3, shard=None, synthetic_reference=False):
    """Stream an unsharded or sharded universe without retaining output records."""
    return SiteWorker(genome, genes, asos, synthetic_reference).iter_sites(max_mismatch=max_mismatch, shard=shard)


def enumerate_sites(genome, genes: Sequence[Gene], asos: Sequence[ASO], *,
                    max_mismatch=3, shard: Shard | None = None, synthetic_reference=False) -> list[Site]:
    """Sorted-list compatibility API; use iter_sites for memory-bounded output."""
    return sorted(iter_sites(genome, genes, asos, max_mismatch=max_mismatch, shard=shard,
                             synthetic_reference=synthetic_reference), key=site_sort_key)


def _sha256(path):
    digest = hashlib.sha256()
    with Path(path).open("rb") as handle:
        for block in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest()


def file_identity(path):
    path = Path(path).expanduser().resolve(strict=True)
    info = path.stat()
    result = dict(path=str(path), size=info.st_size, mtime_ns=info.st_mtime_ns, inode=info.st_ino)
    fai = Path(str(path) + ".fai")
    if fai.is_file():
        result["fai_sha256"] = _sha256(fai)
    return result


def _check_identities(identities):
    for identity in identities.values():
        if "path" in identity and file_identity(identity["path"]) != identity:
            raise ValueError("reference input identity changed during run")


def _schema():
    import pyarrow as pa
    return pa.schema([
        ("site_id", pa.string()), ("aso_id", pa.string()), ("chrom", pa.string()),
        ("start1", pa.int64()), ("end1", pa.int64()), ("strand", pa.string()),
        ("gene_id", pa.string()), ("gene_name", pa.string()), ("region_class", pa.string()),
        ("region_classes", pa.list_(pa.string())), ("transcript_ids", pa.list_(pa.string())),
        ("mismatch_count", pa.int32()), ("mismatch_positions", pa.list_(pa.int32())),
        ("target_sequence", pa.string()), ("paralog_ambiguity", pa.bool_()),
        ("evidence_class", pa.string()), ("assembly", pa.string()), ("annotation", pa.string()),
#!/bin/bash
#SBATCH --job-name=mv2-j8-full
#SBATCH --partition=mit_preemptable
#SBATCH --time=24:00:00
#SBATCH --mem=8G
#SBATCH --cpus-per-task=1
#SBATCH --requeue
#SBATCH --output=/home/dashii/smt-isef/conference/model_v2/ops/logs/%x-%j.out
# Full-genome J8 join. No inference, no GPU, single core, single writer.
# Resume: every ingested input and every output shard is an atomic committed
# checkpoint, so a preemption + requeue re-enters and skips completed work.
#
# Revised J8J10-FIX sizing (synthetic density bench; not a production measurement):
#   1,000 configs x 216 cells = 216,000 indexed rows, all 18nt, clustered per locus.
#   Miss work: 58 -> 41 VM steps as the prefix grows 100x; 216-hit lookup: 1,556.
#   Annotation: 329..340 dense rows/s, 9,534..10,161 miss rows/s; synthetic peak RSS ~168 MiB.
#   Dense slice index: 67.1 MB; actual atlas payloads differ, so retain prior disk
#   projection below. The added width index is small and does not enter RAM in full.
# Prior per-source measurements (2026-11-15), retained as extrapolation inputs:
#   J3   256 x 14.1 s / 92.7 MB = 60 min / 23.7 GB
#   J2   32 x 5.7 s + 128 x 25.5 s = 57 min / 8.8 GB
#   J4   20,395 x 216 cells = 4,405,320 rows; ~10 min / 4.1 GB
#   Prior other join/IO allowance: 119 min for 11,002,701 rows / 52,424 shards.
# Add 19..557 min for new miss..dense annotation => ~4.4..13.4 h total;
# this conservatively counts some join overhead twice. Request 24 h for shared IO.
# This is a density scenario envelope, NOT a bound for arbitrarily overlapping loci.
# RAM estimate ~2 GiB from prior 1.6 GB J3 row-group peak + 32 MiB SQLite cache
# + bounded Arrow/JSON batches; retain 8G allocation. Full production RSS unmeasured.
# Disk estimate ~37 GB index (+ ~0.05 GB width index); 48 GiB cap retained.
# Output estimate ~1.4 GB is prior sparse-overlap extrapolation, NOT a dense bound.
# Recheck cached SCRATCH quota before submission; dense overlaps can enlarge output.
# Fresh v2 directory required: old catalogs/contracts lack authenticated marker paths.
set -euo pipefail
cd /home/dashii/smt-isef
export PYTHONPATH=feng/src OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1 ARROW_NUM_THREADS=1
exec /home/dashii/orcd/pool/smt-isef-env/bin/python -m conference.model_v2.j8_feature_join \
  --root "$HOME/orcd/scratch/feng/model_v2" \
  --out "$HOME/orcd/scratch/feng/model_v2/j8_genome_v2" --max-index-gib 48
conference/model_v2/ops/briefs/J5.md:1:# TASK J5 — RBP/eCLIP regulatory-context features (Codex gpt-6.1-sol, high). Owner ONLY new files: conference/model_v2/j5_rbp_context.py, tests/test_j5_rbp_context.py, jobs/j5_*.sbatch. No other edits; no submissions; no commits; no wet-lab/outcome files; no /orcd traversal beyond the named dirs (non-recursive ls of the RBP subfolders only). Read SCIENTIFIC_LOCK.md, ops/briefs/J6_FIX_RESULT.md (site schema), ops/briefs/J8J10_RESULT.md (how J8 joins context).
conference/model_v2/ops/briefs/J5.md:3:Build: (1) provenance manifest per file (accession, RBP, cell line, assembly, sha256, row count, peak-calling method, replicate info if present); (2) per-RBP/cell interval index; (3) for any query interval table (J6 sites, J8 footprint windows) produce features: overlap/proximity (signed distance to nearest peak, strand-aware only if the peak file is stranded), peak signal strength (as given, labelled observed), per-RBP presence flags with cell-line kept SEPARATE (never pooled across HepG2/K562 without a stated rule) and explicit missingness indicators (RBP/cell not assayed != no binding); (4) KD splicing context: direction/magnitude of exon inclusion change per RBP/cell as OBSERVED knockdown evidence for events overlapping the site, with a hard evidence_class label 'knockdown_not_steric_block' and a docstring: RBP knockdown and local steric ASO inhibition are NOT interchangeable; (5) matched negative controls: coordinate-shifted/GC-matched decoy intervals in the same gene for baseline overlap rate (descriptive, no p-values without defined sampling universe); (6) deterministic, streaming, bounded-memory; atomic parquet + .done w/ sha256; idempotent; assembly fence GRCh38; evidence classes everywhere (observed/derived/proxy/not_available). Sentinel sbatch jobs/j5_sentinel.sbatch (mit_quicktest) over the SMN2 exon7 region + 1 Mb window and F18/F14/F10 footprints; and jobs/j5_full.sbatch skeleton over J6 shards (do NOT submit). Tests with synthetic peaks (strand, boundaries, assembly refusal, missingness). Run from repo root: PYTHONPATH=feng/src OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1 ARROW_NUM_THREADS=1 /home/dashii/orcd/pool/smt-isef-env/bin/python -m pytest conference/model_v2/tests/test_j5_rbp_context.py -q. Report <=25 lines conference/model_v2/ops/briefs/J5_RESULT.md incl exact counts, per-file assembly findings, exact submit commands.
