from pathlib import Path
import gzip,re
root=Path.home()/'orcd/scratch/feng/encode/eclip_peaks'
rbps='FUS HNRNPA1 HNRNPC HNRNPL HNRNPM HNRNPU KHSRP PCBP1 PCBP2 PTBP1 RBFOX2 RBM22 SF3B4 SRSF1 SRSF7 SRSF9 TARDBP TIA1 TIAL1 U2AF1 U2AF2'.split()
for rbp in rbps:
    findings=[]
    for cell in ('HepG2','K562'):
        d=root/rbp/cell
        paths=sorted(d.iterdir()) if d.exists() else []
        for p in paths:
            if not p.name.endswith('.bed.gz'): continue
            headers=[]
            with gzip.open(p,'rt') as f:
                for line in f:
                    if line.startswith(('#','track','browser')): headers.append(line.strip())
                    elif line.strip(): break
            findings.append((cell,p.name.split('.')[0],headers))
    print(rbp,findings)
