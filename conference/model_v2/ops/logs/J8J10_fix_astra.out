    p.write_text('tx:ex1\tchr1\t10\t230\t+\ntx:ex3\tchr1\t300\t530\t+\n')
    with pytest.raises(ValueError,match='incomplete'): m.load_loci([p])


def test_shared_catalog_reused_across_output_shards(tmp_path):
