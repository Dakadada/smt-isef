def _direction(column):
    return -1 if any(x in column for x in ('energy','mismatch','abs_','n_sites','n_exact_sites')) else 1


def descriptive_scores(features,columns):
    """Prespecified equal-weight oriented rank composite; all cells must be present."""
    ids=sorted(features)
    if not ids or not columns: raise MetricBlocked('rank_composite','no feature columns / candidates')
    missing=[(c,k) for c in ids for k in columns if not finite(features[c].get(k))]
    if missing: raise MetricBlocked('rank_composite',f'{len(missing)} missing feature cells, e.g. {missing[:3]}')
    scores={c:0. for c in ids}
    for k in columns:
        ranks=rankdata([_direction(k)*features[c][k] for c in ids],method='average')
        for c,r in zip(ids,ranks): scores[c]+=float(r)/len(ids)/len(columns)
    return scores


def baseline_ablation(features,*,source_paths,seed=0):
    """Use evaluation_core registry, lineage guard, M0 and supervised metric guard.

    No fake split groups or fitted ablation are created: these candidates have no
    verified negatives. Leave-outs here compare descriptive fixed composites.
    """
    if not source_paths: raise ValueError('feature provenance required')
    for p in source_paths: ec.check_source_not_forbidden(p)
    rows=[dict(observation_id=c,label_state='unlabeled',assay_id='unassayed',study_id='derived_feature_atlas',
               independent_unit_id=c,provenance={'source':str(source_paths[0]),'source_paths':list(map(str,source_paths))}) for c in sorted(features)]
    table=ec.validate_table(rows)
    random_scores=ec.permuted_reference_scores(table.ids,seed)
    try:
        ec.compute_metric('auroc',table,random_scores,mode='pu')
    except MetricBlocked as exc:
        supervised=dict(status='blocked',reason='No verified negatives or measured labels. '+exc.reason)
    else: raise RuntimeError('unlabeled supervised metric unexpectedly passed evaluation_core')
    baselines={}
    for name in ('M0','M1','M2','M3','M4','M5'):
        columns=ec.baseline_feature_columns(name)
        if name=='M0':
            baselines[name]=dict(status='ok',scores=random_scores,evidence_class='model_assumption',seed=seed); continue
        try:
            full=descriptive_scores(features,columns)
        except MetricBlocked as exc:
            baselines[name]=dict(status='blocked',reason=exc.reason,evidence_class='not_available'); continue
        leave={}
        for family in ec.BASELINES[name].families:
            kept=tuple(c for c in columns if c not in family.columns)
            try:
                scores=descriptive_scores(features,kept)
                leave[family.name]=dict(status='ok',agreement=rank_stability({'full':full,'leave_out':scores}),columns=list(kept))
            except MetricBlocked as exc:
                leave[family.name]=dict(status='blocked',reason=exc.reason)
        baselines[name]=dict(status='ok',scores=full,leave_out=leave,evidence_class='model_assumption')
    return dict(mode='descriptive_rank_agreement_only',supervised=supervised,baselines=baselines,
                composite='equal-weight oriented percentile ranks; fixed assumption, not fitted',
                ablation_fit='not run: no supervised training/splits; evaluation_core registry and metric guards called',seed=seed)


def j9_report(rows,*,source,seed=0,fold_variant='w120s60',mismatch_variant='mm3'):
    candidates=['F18','F14','F10']; scores={}; features={c:{} for c in candidates}
    baseline_variants=('default',fold_variant,mismatch_variant)
    for row in rows:
        if row['aso_id'] not in candidates: continue
        value=row.get('value_double') if row.get('value_double') is not None else row.get('value_int')
        key=(row['feature_name'],row['variant_id'])
        scores.setdefault(key,{})
        if row['aso_id'] in scores[key]: raise ValueError('duplicate J9 feature cell')
        scores[key][row['aso_id']]=value if row['status']=='ok' and finite(value) else None
        if row['variant_id'] in baseline_variants:
            if row['feature_name'] in features[row['aso_id']]: raise ValueError('ambiguous baseline feature alternative')
            features[row['aso_id']][row['feature_name']]=scores[key][row['aso_id']]
    reports={}
    for feature in sorted({k[0] for k in scores}):
        alternatives={v:{c:(_direction(feature)*values[c] if finite(values.get(c)) else None) for c in candidates}
                      for (f,v),values in scores.items() if f==feature}
        reports[feature]=rank_stability(alternatives,candidates=candidates)
    # Compare the prespecified thermodynamic/complementarity/accessibility channels.
    channels={f:{c:(_direction(f)*scores.get((f,v),{}).get(c) if finite(scores.get((f,v),{}).get(c)) else None) for c in candidates}
              for f,v in [('m1_wc_pairs','default'),('m2_duplex_energy_kcal_mol',fold_variant),('m3_accessibility_p_unpaired',fold_variant)]}
    return dict(candidates=candidates,excluded=['3UP8'],per_feature=reports,channel_agreement=rank_stability(channels),
                baseline_variants=list(baseline_variants),
                ablation=baseline_ablation(features,source_paths=[source],seed=seed),evidence_class='derived')


def main(argv=None):
    import pyarrow.parquet as pq
    from itertools import islice
    p=argparse.ArgumentParser(description=__doc__)
    p.add_argument('--j9',required=True); p.add_argument('--j3',required=True); p.add_argument('--out',required=True)
    p.add_argument('--limit',type=int,default=300); p.add_argument('--seed',type=int,default=1729)
    args=p.parse_args(argv)
    if not 2<=args.limit<=1000: p.error('bounded sample limit must be 2..1000')
    paths=[safe_path(args.j9),safe_path(args.j3)]
    variant=j3_fold_variant(paths[1])
    # Bounded output checkpoint; exact source SHA is acquired in Slurm, not login.
    contract=dict(inputs=[dict(path=str(x),sha256=sha256(x)) for x in paths],seed=args.seed,limit=args.limit,
                  j3_fold_variant=variant,code_sha256=sha256(__file__))
    output=safe_path(args.out); output.parent.mkdir(parents=True,exist_ok=True)
    if output.exists():
        prior=json.loads(output.read_text())
        if prior.get('contract')==contract: return
        raise ValueError('changed robustness inputs; choose fresh output')
    j9rows=pq.read_table(paths[0]).to_pylist()
    columns=['site_id','aso_id','aso_sequence','assembly','annotation','chrom','strand','start1','end1','mismatch_count',
             'complementarity_wc_pairs','complementarity_status','duplex_energy_kcal_mol','duplex_status',
             'accessibility_p_unpaired','accessibility_status','target_with_flank','footprint_start1_in_context']
    raw=list(islice((r for b in pq.ParquetFile(paths[1]).iter_batches(batch_size=64,columns=columns) for r in b.to_pylist() if r['aso_id']!='3UP8'),args.limit))
    from conference.model_v2.j8_feature_join import fence
    for r in raw: fence(r)
    rows=[dict(candidate_id=r['site_id'],variant_id=variant,mismatch_count=r['mismatch_count'],
               wc=r['complementarity_wc_pairs'],wc_status=r['complementarity_status'],
               energy=r['duplex_energy_kcal_mol'],energy_status=r['duplex_status'],
               access=r['accessibility_p_unpaired'],access_status=r['accessibility_status']) for r in raw]
    settings=[Setting('complementarity','wc',variant),Setting('duplex','energy',variant,False),Setting('accessibility','access',variant)]
    settings += [Setting(f'max_mismatch_{k}','wc',variant,True,k) for k in (0,1,2,3)]
    # Explicit missing alternatives, never silently reuse the one computed J3 window.
    settings += [Setting(v,'access',v) for v in FOLD_VARIANTS if v!=variant]
    ids=[r['candidate_id'] for r in rows]
    alternatives=alternative_scores(rows,settings,ids)
    nulls=[]
    for i,r in enumerate(raw[:3]):
        length=r['end1']-r['start1']+1
        start=r['footprint_start1_in_context']-1
        scorer=complementarity_scorer(r['aso_sequence'])
        # Orientation guard: the rescored observed footprint must reproduce the J3 cell.
        observed=scorer(r['target_with_flank'][start:start+length])
        if r['complementarity_status']=='ok' and observed!=float(r['complementarity_wc_pairs']):
            raise ValueError('decoy scorer disagrees with the committed J3 complementarity cell: '+r['site_id'])
        nulls.append(dict(site_id=r['site_id'],aso_id=r['aso_id'],observed_wc_pairs=observed,
             channels=null_channels(r['target_with_flank'],start=start,length=length,n=50,seed=args.seed+i,
             scorers={'complementarity':scorer,'duplex':None,'accessibility':None})))
    result=dict(contract=contract,j9=j9_report(j9rows,source=str(paths[0]),seed=args.seed,fold_variant=variant),j3_sample=dict(
        rows=len(raw),sampling_universe='first N non-3UP8 rows in explicitly named J3 shard; convenience sample, not genome representative',
        j3_fold_variant=variant,settings=[asdict(s) for s in settings],stability=rank_stability(alternatives),nulls=nulls),
        blocked=['Duplex-energy and accessibility decoy nulls blocked: both need a folding backend, '
                 'and J10 runs no scoring backend. Only the pure-sequence complementarity channel is rescored.',
                 'J3 alternative fold windows are absent; coverage explicitly incomplete.',
                 'No verified negatives: supervised metrics blocked by evaluation_core.'])
    atomic_json(output,result)


if __name__=='__main__': main()
"""Rank/null/ablation contracts with independent hand-checked expectations."""
import importlib
from collections import Counter
import pytest


def api():
    name='conference.model_v2.j10_robustness'
    assert importlib.util.find_spec(name), 'J10 implementation absent'
    return importlib.import_module(name)


def test_rank_reversal_ties_and_missing_are_explicit():
    m=api()
    r=m.rank_stability({'a':{'x':1,'y':2,'z':3},'b':{'x':3,'y':2,'z':1}})
    assert r['comparisons'][0]['spearman'] == pytest.approx(-1)
    assert r['comparisons'][0]['kendall'] == pytest.approx(-1)
    assert r['sign_flip_frequency'] == 1
    assert r['stability_flag'] == 'unstable'
    tied=m.rank_stability({'a':{'x':1,'y':1},'b':{'x':2,'y':2}})
    assert tied['stability_flag'] == 'indeterminate'
    assert tied['comparisons'][0]['kendall'] is None
    missing=m.rank_stability({'a':{'x':1,'y':None},'b':{'x':1,'y':2}})
    assert missing['stability_flag'] == 'indeterminate'
    assert missing['missing']['a'] == ['y']


def test_alternatives_fixed_candidates_and_direction():
    m=api(); rows=[dict(candidate_id='x',variant_id='w80',wc=3,energy=-4,mismatch_count=0),
                  dict(candidate_id='y',variant_id='w80',wc=1,energy=-2,mismatch_count=2)]
    settings=[m.Setting('wc','wc','w80',True,3),m.Setting('energy','energy','w80',False,3),m.Setting('k0','wc','w80',True,0)]
    scores=m.alternative_scores(rows,settings,['x','y'])
    assert scores['wc']['x'] > scores['wc']['y']
    assert scores['energy']['x'] > scores['energy']['y']
    assert scores['k0']['y'] is None
    with pytest.raises(ValueError): m.alternative_scores(rows+rows,settings,['x','y'])


@pytest.mark.parametrize('seq', ['ACGACGTTAC','AAAA','A','ACACACAC','GGCCAATTGGCCAATT'])
def test_dinucleotide_shuffle_preserves_edges_length_gc_and_seed(seq):
    m=api(); shuffled=m.dinucleotide_shuffle(seq,seed=42)
    assert len(shuffled)==len(seq)
    assert Counter(zip(shuffled,shuffled[1:]))==Counter(zip(seq,seq[1:]))
    assert Counter(shuffled)==Counter(seq)
    assert shuffled==m.dinucleotide_shuffle(seq,seed=42)


def test_decoys_same_locus_exclude_real_match_gc_and_deterministic():
    m=api(); r=m.shifted_decoys('ACGTACGTACGT', start=4,length=4,n=20,seed=3,gc_tolerance=0)
    assert r['sampling_universe']['eligible_count']==8
    assert all(d['start'] != 4 and len(d['sequence'])==4 for d in r['decoys'])
    assert len({d['start'] for d in r['decoys']})==8
    assert r==m.shifted_decoys('ACGTACGTACGT',start=4,length=4,n=20,seed=3,gc_tolerance=0)


def test_null_pvalue_blocked_without_universe_or_minimum_or_failed_score():
    m=api()
    for universe,values in [(None,[1]*30),({'definition':'fixed decoys'},[1,2]),({'definition':'fixed decoys'},[None]*30)]:
        with pytest.raises(m.MetricBlocked): m.empirical_null(3,values,universe=universe,min_decoys=20)
    r=m.empirical_null(3,[1,2,3,4],universe={'definition':'four fixed matched decoys'},min_decoys=4)
    assert r['p_value']==pytest.approx(3/5)
    assert r['distribution']==[1,2,3,4]


def test_nulls_do_not_invent_uncomputed_channel_values():
    m=api()
    result=m.null_channels('ACGTACGT',start=2,length=4,n=25,seed=2,
        scorers={'gc':lambda seq:sum(x in 'GC' for x in seq),'duplex':None},min_decoys=20)
    assert result['duplex']['status']=='blocked'
    assert result['gc']['shuffle']['sampling_universe']['method']=='randomized_euler_trail_nonuniform'
    assert result['gc']['shuffle']['p_value'] is None


def test_ablation_calls_core_guards_and_missing_features_stay_blocked():
    m=api()
    features={'a':{'m1_wc_pairs':1},'b':{'m1_wc_pairs':2},'c':{'m1_wc_pairs':3}}
    r=m.baseline_ablation(features, source_paths=['derived.parquet'], seed=8)
    assert set(r['baselines'])=={'M0','M1','M2','M3','M4','M5'}
    assert r['supervised']['status']=='blocked'
    assert 'negative' in r['supervised']['reason']
    assert r['baselines']['M1']['status']=='blocked'
    assert r['mode']=='descriptive_rank_agreement_only'


def test_complete_ablation_descriptive_leave_out():
    m=api()
    features={x:{c:(i+1)*(-1 if 'energy' in c else 1) for c in m.ec.baseline_feature_columns('M5')} for i,x in enumerate('abc')}
    r=m.baseline_ablation(features,source_paths=['derived.parquet'],seed=1)
    assert r['baselines']['M5']['status']=='ok'
    assert len(r['baselines']['M5']['leave_out'])==5
    assert r['baselines']['M1']['leave_out']['complementarity']['status']=='blocked'
    with pytest.raises(m.ec.ForbiddenSourceError): m.baseline_ablation(features, source_paths=['psi25/outcomes.csv'])


def test_j9_adapter_preserves_seed_and_uses_mm3_counts():
    m=api(); rows=[]
    for c,i in zip(['F18','F14','F10'],[3,2,1]):
        for col in m.ec.baseline_feature_columns('M1'):
            rows.append(dict(aso_id=c,feature_name=col,variant_id='mm3' if 'n_sites' in col or 'n_exact_sites' in col else 'default',
                             value_double=i,value_int=None,status='ok'))
    rows.append(dict(aso_id='3UP8',feature_name='forbidden',variant_id='default',status='ok',value_int=10))
    r=m.j9_report(rows,source='derived.parquet',seed=99)
    assert r['ablation']['baselines']['M1']['status']=='ok'
    assert r['ablation']['seed']==99
    assert 'forbidden' not in r['per_feature']


def test_rank_stable_and_missing_alternative_and_invalid_inputs():
    m=api()
    r=m.rank_stability({'a':{'x':1,'y':2,'z':2},'b':{'x':2,'y':4,'z':4}})
    assert r['stability_flag']=='stable'
    assert r['n_tied_comparisons']==1
    assert m.rank_stability({'one':{'a':1}})['stability_flag']=='indeterminate'
    with pytest.raises(ValueError): m.Setting('a','c',max_mismatch=-1)
    with pytest.raises(ValueError): m.dinucleotide_shuffle('AN',seed=1)
    with pytest.raises(ValueError): m.shifted_decoys('ACGT',start=4,length=2,n=3,seed=1)


def test_null_lower_tail_and_failed_callback():
    m=api()
    assert m.empirical_null(2,[1,2,3],universe={'definition':'three matched decoys'},min_decoys=3,higher_is_extreme=False)['p_value']==.75
    r=m.null_channels('ACGTACGT',start=0,length=4,n=4,seed=1,scorers={'missing':lambda s:None},min_decoys=2)
    assert r['missing']['shift']['p_value'] is None


def test_cli_is_bounded_excludes_3up8_and_restarts(tmp_path):
    import json
    import pyarrow as pa
    import pyarrow.parquet as pq
    m=api(); j9=tmp_path/'j9.parquet'; j3=tmp_path/'j3.parquet'; out=tmp_path/'result.json'
    pq.write_table(pa.Table.from_pylist([dict(aso_id=c,feature_name='m1_wc_pairs',variant_id='default',value_int=i,value_double=None,status='ok')
                        for i,c in enumerate(['F18','F14','F10','3UP8'])]),j9)
    base=dict(assembly='GRCh38',annotation='GENCODE v50',chrom='chr1',strand='+',start1=10,end1=13,mismatch_count=0,aso_sequence='ACGT',
              complementarity_wc_pairs=4,complementarity_status='ok',duplex_energy_kcal_mol=-4.,duplex_status='ok',
              accessibility_p_unpaired=.1,accessibility_status='ok',target_with_flank='ACGTACGTACGT',footprint_start1_in_context=5)
    pq.write_table(pa.Table.from_pylist([dict(base,site_id=f's{i}',aso_id=c) for i,c in enumerate(['3UP8','F18','F14','F10'])]),j3)
    j3.with_suffix('.done').write_text(json.dumps(dict(rows=4,params=dict(window=120,span=60))))
    args=['--j9',str(j9),'--j3',str(j3),'--out',str(out),'--limit','2']
    m.main(args); stamp=out.stat().st_mtime_ns; m.main(args)
    r=json.loads(out.read_text())
    assert r['j3_sample']['rows']==2
    assert r['j9']['excluded']==['3UP8']
    assert out.stat().st_mtime_ns==stamp
    assert all(n['site_id']!='s0' for n in r['j3_sample']['nulls'])
    assert all(n['observed_wc_pairs']==4 for n in r['j3_sample']['nulls'])
    assert r['j3_sample']['nulls'][0]['channels']['duplex']['status']=='blocked'
    # The one computed window is labelled from the marker, never assumed; the other
    # two declared J2 windows stay present-but-missing rather than silently reused.
    assert r['contract']['j3_fold_variant']=='w120s60'
    assert r['j3_sample']['j3_fold_variant']=='w120s60'
    absent={s['name'] for s in r['j3_sample']['settings']}&{'w80s40','w200s100'}
    assert absent=={'w80s40','w200s100'}
    assert all(r['j3_sample']['stability']['missing'][n]==['s1','s2'] for n in absent)


def test_complementarity_scorer_matches_j3_and_feeds_a_real_null():
    m=api()
    from conference.model_v2.j3_scoring import complementarity
    aso='ACGUACGU'; target='ACGUACGU'
    scorer=m.complementarity_scorer(aso)
    assert scorer(target)==float(complementarity(aso,target)['wc_pairs'])
    assert scorer('ACGTACGT')==scorer(target)     # DNA/RNA alphabets agree
    with pytest.raises(ValueError): scorer('AAAA')  # unequal lengths refuse, never pad
    with pytest.raises(ValueError): m.complementarity_scorer('')
    # A real (not blocked) shift null: uniform-without-replacement universe, p-value emitted.
    r=m.null_channels('ACGTACGTTGCAACGTACGTTGCA',start=0,length=8,n=12,seed=5,
                      scorers={'complementarity':scorer},min_decoys=3,gc_tolerance=1)
    assert r['complementarity']['shift']['status']=='ok'
    assert 0 < r['complementarity']['shift']['p_value'] <= 1
    assert r['complementarity']['shift']['n_decoys']>=3
    assert r['complementarity']['shuffle']['status']=='blocked'


