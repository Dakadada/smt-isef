def test_canonical_terminal_exons_and_gap_refusal(tmp_path):
    m=api(); p=tmp_path/'loci.tsv'
    p.write_text('tx:ex1\tchr1\t10\t230\t+\ntx:ex2\tchr1\t300\t530\t+\n')
    loci=m.load_loci([p])
    assert loci[0]['acceptor_position'] is None
