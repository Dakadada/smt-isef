    rows.append({**rows[0], "observation_id": "copy", "independent_unit_id": "copy_unit"})
    with pytest.raises(ec.UncertaintyRefused, match="duplicate assay"):
        ec.cluster_bootstrap_ci(rows, mean_score(list(range(13))), n_boot=20)
