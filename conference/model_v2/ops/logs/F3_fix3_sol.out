 succeeded in 369ms:
"""F3 - evaluation core: label states, leakage-free splits, guarded metrics, clustered uncertainty.

Statistics / software-engineering module only. It fits nothing and reads no outcome
data. Five pieces, each refusing loudly instead of degrading silently:

1. ``validate_table``  - exhaustive label states; a ``verified_negative`` needs explicit
   ``negative_evidence`` (assayed_and_powered is True + finite detection limit) and can
   never come from a responder-only table (absence is not a negative).
2. ``make_splits`` / ``make_nested_splits`` - purged group splits. Five leakage axes:
   near-identical ASO sequence, chemistry family, study, window, independent unit.
   The test set is one unit of the mode's primary axis; every other row sharing ANY
   active axis group with a test row is purged (in neither train nor test).
3. ``compute_metric`` - AUROC/AUPRC/FDR/accuracy/precision/recall/calibration only with
   enough verified negatives and positives (counted as independent units), otherwise
   ``MetricBlocked``. ``pu_report`` is the positive-unlabeled alternative and never
   emits a supervised metric. Unlabeled / unassayed / censored are never negatives.
4. ``cluster_bootstrap_ci`` - resamples effective independent clusters
   (``independent_unit_id`` merged with sequence / window overlap); refuses below
   ``min_clusters``.
5. ``BASELINES`` (M0..M6) and ``run_ablation`` (leave-feature-family-out interface).

``check_source_not_forbidden`` refuses the July exon-7 outcome workbook, any ``psi25``
directory and anything under ``feng/terminal`` (SCIENTIFIC_LOCK).
"""
from __future__ import annotations

import hashlib
import json
import math
import os
import random
import re
import unicodedata
from dataclasses import asdict, dataclass
from enum import Enum
from types import MappingProxyType
from typing import Any, Callable, Dict, List, Mapping, Optional, Sequence, Tuple
from urllib.parse import unquote

from conference.model_v2.trans_intervention import EVIDENCE_CLASSES

__all__ = [
    "LabelState", "ObservationTable", "validate_table", "read_table",
    "GroupingConfig", "Fold", "SplitPlan", "NestedSplitPlan", "axis_groups",
    "make_splits", "make_nested_splits", "verify_no_leakage",
    "MetricPolicy", "MetricResult", "compute_metric", "precision_recall_curve",
    "PUQuantity", "PUReport", "pu_report",
    "CIResult", "effective_clusters", "cluster_bootstrap_ci", "bootstrap_metric_ci",
    "FeatureFamily", "BaselineSpec", "BASELINES", "baseline_feature_columns",
    "permuted_reference_scores", "AblationCell", "AblationResult", "run_ablation",
    "check_source_not_forbidden",
]


# ------------------------------------------------------------------ errors
class SchemaError(ValueError):
    """A row or argument violates the observation-table contract."""


class NegativeEvidenceError(SchemaError):
    """A verified_negative lacks explicit, powered negative evidence."""


class LabelStateError(SchemaError):
    """A non-negative label state was used (or encoded) as a negative."""


class ForbiddenSourceError(RuntimeError):
    """An input path matches a forbidden outcome source."""


class SplitRefused(RuntimeError):
    """A split was refused (independent N too small, or nothing left to train on)."""


class LeakageError(RuntimeError):
    """A group straddles train and test. Indicates a bug; never expected."""


class MetricBlocked(RuntimeError):
    """A metric was refused; ``reason`` says why."""

    def __init__(self, metric: str, reason: str):
        super().__init__(f"{metric}: BLOCKED - {reason}")
        self.metric = metric
        self.reason = reason


class UncertaintyRefused(RuntimeError):
    """A confidence interval was refused (too few independent clusters)."""


class BaselineUndefined(ValueError):
    """The baseline has no agreed feature set yet."""


# ------------------------------------------------------------------ forbidden sources
_FORBIDDEN_PATTERNS: Tuple[Tuple[str, "re.Pattern[str]"], ...] = (
    ("july_exon7_outcome_workbook", re.compile(
        r"smn2[\W_]*exon[\W_]*7[\W_]*7[\W_]*27[\W_]*28[\W_]*complete[\W_]*data", re.I)),
    ("psi25", re.compile(r"(^|/)psi25(?![A-Za-z0-9])", re.I)),
    ("feng_terminal", re.compile(r"(^|/)feng/+terminal(?![A-Za-z0-9])", re.I)),
)


def _normalized_source_forms(raw: str) -> set[str]:
    forms = {raw}
    current = raw
    for _ in range(16):
        normalized = unicodedata.normalize("NFKC", unquote(current)).replace("\\", "/")
        forms.add(normalized)
        if normalized == current:
            break
        current = normalized
    else:
        raise ForbiddenSourceError("source normalization did not converge within 16 steps")
    for item in tuple(forms):
        expanded = os.path.expanduser(item.replace("\\", "/"))
        forms.update((os.path.normpath(expanded), os.path.abspath(expanded)))
        try:
            resolved = os.path.realpath(expanded)
            # Symlink targets may themselves use encoded or Unicode names.
            for _ in range(16):
                normalized = unicodedata.normalize("NFKC", unquote(resolved)).replace("\\", "/")
                forms.update((normalized, os.path.normpath(normalized)))
                if normalized == resolved:
                    break
                resolved = normalized
            else:
                raise ForbiddenSourceError("resolved source normalization did not converge")
        except (OSError, ValueError):
            pass
    return forms


def check_source_not_forbidden(path: Any) -> str:
    """Return ``str(path)`` or raise ``ForbiddenSourceError``.

    Checks the literal string, its URL-decoded form, the normalised absolute path
    and the symlink-resolved path. Only path names are inspected; nothing is opened.
    """
    raw = os.fspath(path) if isinstance(path, os.PathLike) else str(path)
    for form in _normalized_source_forms(raw):
        text = form.replace("\\", "/")
        for label, pattern in _FORBIDDEN_PATTERNS:
            if pattern.search(text):
                raise ForbiddenSourceError(
                    f"refused forbidden outcome source ({label}): {raw!r}")
    return raw


def _strings(value: Any) -> List[str]:
    if isinstance(value, str):
        return [value]
    if isinstance(value, os.PathLike):
        return [os.fspath(value)]
    if isinstance(value, Mapping):
        return [s for v in value.values() for s in _strings(v)]
    if isinstance(value, (list, tuple, set, frozenset)):
        return [s for v in value for s in _strings(v)]
    return []


# ------------------------------------------------------------------ label states / table
class LabelState(str, Enum):
    MEASURED_POSITIVE = "measured_positive"
    VERIFIED_NEGATIVE = "verified_negative"
    UNLABELED = "unlabeled"
    UNASSAYED = "unassayed"
    CENSORED = "censored"

    @classmethod
    def parse(cls, value: Any) -> "LabelState":
        if isinstance(value, cls):
            return value
        try:
            return cls(value)
        except ValueError:
            raise SchemaError(
                f"label_state {value!r} not in {[s.value for s in cls]}") from None


LABEL_STATES = tuple(s.value for s in LabelState)
POSITIVE = LabelState.MEASURED_POSITIVE.value
NEGATIVE = LabelState.VERIFIED_NEGATIVE.value
REQUIRED_FIELDS = ("observation_id", "label_state", "assay_id", "study_id",
                   "independent_unit_id", "provenance")
RESPONDER_ONLY_KINDS = frozenset({"responder_only", "responders_only", "hits_only",
                                  "positives_only"})
ABSENCE_BASES = frozenset({"absence", "absent", "absent_from_table", "not_listed",
                           "not_reported", "inferred", "assumed", "absence_from_responder_list"})
NEGATIVE_BASES = frozenset({"dose_response", "powered_assay", "direct_measurement",
                            "assayed_nonresponder", "measured_negative"})
SOURCE_TABLE_KINDS = RESPONDER_ONLY_KINDS | {"full_screen", "all_assayed", "complete",
                                           "dose_response", "assay_results"}
RESPONDER_ONLY_SOURCES = frozenset({"holgersen_s4", "holgersen_table_s4",
                                   "holgersen_supplementary_table_s4"})
BINARY_LABEL_FIELDS = ("binary_label", "label", "y")


def _category(value: str) -> str:
    return re.sub(r"[^a-z0-9]+", "_", unicodedata.normalize("NFKC", value).casefold()).strip("_")


def _freeze(value: Any) -> Any:
    if isinstance(value, Mapping):
        return MappingProxyType({k: _freeze(v) for k, v in value.items()})
    if isinstance(value, (tuple, list)):
        return tuple(_freeze(v) for v in value)
    if isinstance(value, (set, frozenset)):
        return frozenset(_freeze(v) for v in value)
    if isinstance(value, os.PathLike):
        return os.fspath(value)
    if value is None or isinstance(value, (str, int, float, bool)):
        return value
    raise SchemaError(f"unsupported mutable metadata value: {type(value).__name__}")


@dataclass(frozen=True)
class ObservationTable:
    """Deeply immutable validated rows; public consumers revalidate even this wrapper.

    ``duplicate_assay_records`` lists exact record copies differing only in row/unit
    identifiers. They are retained and counted as one independent unit for grouping;
    statistics refuse duplicate contributors rather than giving copies extra weight.
    """
    rows: Tuple[Mapping[str, Any], ...]
    duplicate_assay_records: Tuple[Tuple[str, ...], ...] = ()

    def __len__(self) -> int:
        return len(self.rows)

    @property
    def ids(self) -> Tuple[str, ...]:
        return tuple(r["observation_id"] for r in self.rows)

    def subset(self, indices: Sequence[int]) -> "ObservationTable":
        return ObservationTable(tuple(self.rows[i] for i in indices))


def _nonempty(row: Mapping[str, Any], name: str, where: str) -> str:
    value = row.get(name)
    if not isinstance(value, str) or not value.strip():
        raise SchemaError(f"{where}: field {name!r} must be a non-empty string")
    return value


def validate_table(rows: Any, *, responder_only_studies: Sequence[str] = ()) -> ObservationTable:
    """Validate observation rows (mappings) and return an ``ObservationTable``.

    ``responder_only_studies``: study ids whose tables list responders only (e.g. a
    hits-only supplement). No ``verified_negative`` may originate from them, and none
    from a row declaring ``source_table_kind`` in ``RESPONDER_ONLY_KINDS``.
    """
    if isinstance(rows, ObservationTable):
        rows = rows.rows
    responder_only = RESPONDER_ONLY_SOURCES | frozenset(_category(s) for s in responder_only_studies)
    out: List[Dict[str, Any]] = []
    seen = set()
    for index, row in enumerate(rows):
        where = f"row {index}"
        if not isinstance(row, Mapping):
            raise SchemaError(f"{where}: not a mapping")
        r = dict(row)
        oid = _nonempty(r, "observation_id", where)
        where = f"row {index} ({oid})"
        if oid in seen:
            raise SchemaError(f"{where}: duplicate observation_id")
        seen.add(oid)
        if "label_state" not in r:
            raise SchemaError(f"{where}: missing label_state")
        state = LabelState.parse(r["label_state"])
        r["label_state"] = state.value
        for name in ("assay_id", "study_id", "independent_unit_id"):
            _nonempty(r, name, where)
        prov = r.get("provenance")
        if isinstance(prov, Mapping):
            if not isinstance(prov.get("source"), str) or not prov["source"].strip():
                raise SchemaError(f"{where}: provenance mapping needs a non-empty 'source'")
        elif not isinstance(prov, str) or not prov.strip():
            raise SchemaError(f"{where}: provenance must be a non-empty string or mapping")
        for text in _strings(prov) + _strings(r.get("source_path")):
            check_source_not_forbidden(text)
        if r.get("evidence_class") is not None:
            r["evidence_class"] = _category(str(r["evidence_class"]))
            if r["evidence_class"] not in EVIDENCE_CLASSES:
                raise SchemaError(f"{where}: bad evidence_class {r['evidence_class']!r}")
        kind = _category(str(r.get("source_table_kind", "")))
        if kind and kind not in SOURCE_TABLE_KINDS:
            raise NegativeEvidenceError(f"{where}: unknown source_table_kind {kind!r}")
        if "source_table_kind" in r:
            r["source_table_kind"] = kind

        if state is LabelState.VERIFIED_NEGATIVE:
            sources = [r["study_id"]] + _strings(prov) + _strings(r.get("source_path"))
            source_tokens = [_category(form) for s in sources for form in _normalized_source_forms(s)]
            known_responder = any(
                f"_{known}_" in f"_{token}_" for known in responder_only for token in source_tokens)
            if kind in RESPONDER_ONLY_KINDS or known_responder:
                raise NegativeEvidenceError(
                    f"{where}: verified_negative from a responder-only table; absence "
                    "from a responder list is not a measured negative")
            ne = r.get("negative_evidence")
            if not isinstance(ne, Mapping):
                raise NegativeEvidenceError(
                    f"{where}: verified_negative requires an explicit negative_evidence mapping")
            if ne.get("assayed_and_powered") is not True:
                raise NegativeEvidenceError(
                    f"{where}: negative_evidence.assayed_and_powered must be exactly True")
            limit = ne.get("detection_limit")
            if isinstance(limit, bool) or not isinstance(limit, (int, float)) \
                    or not math.isfinite(limit):
                raise NegativeEvidenceError(
                    f"{where}: negative_evidence.detection_limit must be a finite number")
            basis = _category(str(ne.get("basis", "")))
            if basis not in NEGATIVE_BASES:
                raise NegativeEvidenceError(
                    f"{where}: negative_evidence.basis={ne.get('basis')!r} is absence-inferred "
                    "or not a recognized measured-evidence category")
            r["negative_evidence"] = {**ne, "basis": basis}
        for name in BINARY_LABEL_FIELDS:
            value = r.get(name)
            if value is None:
                continue
            if value not in (0, 1):
                raise SchemaError(f"{where}: {name}={value!r} is not binary")
            needed = LabelState.MEASURED_POSITIVE if value == 1 else LabelState.VERIFIED_NEGATIVE
            if state is not needed:
                raise LabelStateError(
                    f"{where}: {name}={int(value)} encodes {needed.value} but label_state is "
                    f"{state.value}; {state.value} is never a "
                    f"{'negative' if value == 0 else 'positive'}")
        out.append(_freeze(r))
    records: Dict[str, List[str]] = {}
    for r in out:
        identity = {k: v for k, v in r.items() if k not in ("observation_id", "independent_unit_id")}
        records.setdefault(_fingerprint(identity), []).append(r["observation_id"])
    duplicates = tuple(tuple(ids) for ids in records.values() if len(ids) > 1)
    return ObservationTable(tuple(out), duplicates)


def _as_table(rows: Any) -> ObservationTable:
    return validate_table(rows)


def read_table(path: Any, **kwargs: Any) -> ObservationTable:
    """Read a ``.jsonl`` / ``.json`` observation table, after the forbidden-source guard."""
    name = check_source_not_forbidden(path)
    with open(os.path.expanduser(name), "r", encoding="utf-8") as handle:
        if name.endswith(".jsonl"):
            rows = [json.loads(line) for line in handle if line.strip()]
        elif name.endswith(".json"):
            rows = json.load(handle)
        else:
            raise SchemaError(f"unsupported table format: {name!r} (use .jsonl or .json)")
    return validate_table(rows, **kwargs)


# ------------------------------------------------------------------ grouping
AXES = ("sequence", "chemistry", "study", "window", "independent_unit")
"""Adversarial tests for F3 evaluation_core: leakage, missingness, tiny-N, determinism,
forbidden sources, PU mode. Synthetic rows only - no lab data, no files outside tmp_path."""
from __future__ import annotations

import json
import os
import random
import sys
from dataclasses import replace
from pathlib import Path

import pytest

REPO_ROOT = Path(__file__).resolve().parents[3]
if str(REPO_ROOT) not in sys.path:
    sys.path.insert(0, str(REPO_ROOT))

from conference.model_v2 import evaluation_core as ec  # noqa: E402

BASES = "ACGT"
NEG_EVIDENCE = {"assayed_and_powered": True, "detection_limit": 0.05, "basis": "dose_response"}


@pytest.fixture(autouse=True)
def synthetic_chemistry_vocabulary(monkeypatch):
    # Synthetic independent families are explicitly registered by the test caller.
    names = ["chema", "chemy", "chemz"] + [f"chem{i}" for i in range(200)]
    names += [f"c{i}" for i in range(40)] + [f"cw{i}" for i in range(20)]
    names += [f"k{i}_{j}" for i in range(12) for j in range(6)]
    monkeypatch.setattr(ec, "CHEMISTRY_ALIASES", {**ec.CHEMISTRY_ALIASES,
                                               **{name: name for name in names}})


def rand_seq(rng, n=18):
    return "".join(rng.choice(BASES) for _ in range(n))


def row(oid, state="measured_positive", *, seq="ACGTACGTACGTACGTAC", chem="chemA", study="S1",
        unit=None, chrom="chr5", start=1000, end=1017, strand="+", **extra):
    r = {"observation_id": oid, "label_state": state, "assay_id": "assay1", "study_id": study,
         "independent_unit_id": unit or oid, "provenance": {"source": "synthetic:test"},
         "aso_sequence": seq, "chemistry_family": chem, "chrom": chrom, "start": start,
         "end": end, "strand": strand}
    if state == "verified_negative":
        r["negative_evidence"] = dict(NEG_EVIDENCE)
    r.update(extra)
    return r


def independent_rows(n, *, seed=7, states=None, n_studies=None, n_chem=None):
    """n rows that share NO group on any axis unless n_studies / n_chem fold them."""
    rng = random.Random(seed)
    out = []
    for i in range(n):
        out.append(row(
            f"o{i:03d}", (states[i] if states else "measured_positive"), seq=rand_seq(rng),
            chem=f"chem{i % n_chem if n_chem else i}", study=f"S{i % n_studies if n_studies else i}",
            start=1000 + 500 * i, end=1017 + 500 * i))
    return out


def labelled(n_pos, n_neg, n_unl=0, n_unassayed=0, n_censored=0, **kw):
    states = (["measured_positive"] * n_pos + ["verified_negative"] * n_neg
              + ["unlabeled"] * n_unl + ["unassayed"] * n_unassayed + ["censored"] * n_censored)
    return independent_rows(len(states), states=states, **kw)


def assert_no_straddle(plan):
    for fold in plan.folds:
        assert not set(fold.test_idx) & set(fold.train_idx)
        assert not set(fold.purged_idx) & (set(fold.test_idx) | set(fold.train_idx))
        assert len(fold.test_idx) + len(fold.train_idx) + len(fold.purged_idx) == len(plan.observation_ids)
        for axis in plan.axes:
            g = plan.group_ids[axis]
            assert not {g[i] for i in fold.test_idx} & {g[i] for i in fold.train_idx}, (fold.fold_id, axis)


# ------------------------------------------------------------------ label states / validator
def test_label_states_are_exhaustive_and_closed():
    assert set(ec.LABEL_STATES) == {"measured_positive", "verified_negative", "unlabeled",
                                    "unassayed", "censored"}
    with pytest.raises(ec.SchemaError, match="label_state"):
        ec.validate_table([row("a", "negative")])
    with pytest.raises(ec.SchemaError):
        ec.validate_table([row("a", "non_responder")])


@pytest.mark.parametrize("field", ["observation_id", "label_state", "assay_id", "study_id",
                                   "independent_unit_id", "provenance"])
def test_every_required_field_is_enforced(field):
    r = row("a")
    del r[field]
    with pytest.raises(ec.SchemaError):
        ec.validate_table([r])
    r = row("a")
    r[field] = ""
    with pytest.raises(ec.SchemaError):
        ec.validate_table([r])


def test_duplicate_observation_ids_and_bad_provenance_rejected():
    with pytest.raises(ec.SchemaError, match="duplicate"):
        ec.validate_table([row("a"), row("a")])
    with pytest.raises(ec.SchemaError, match="source"):
        ec.validate_table([row("a", provenance={"note": "x"})])
    with pytest.raises(ec.SchemaError, match="evidence_class"):
        ec.validate_table([row("a", evidence_class="measured")])


def test_valid_table_passes_and_all_states_accepted():
    table = ec.validate_table(labelled(1, 1, 1, 1, 1))
    assert [r["label_state"] for r in table.rows] == list(ec.LABEL_STATES)


@pytest.mark.parametrize("evidence", [
    None, {}, {"assayed_and_powered": True}, {"detection_limit": 0.1},
    {"assayed_and_powered": False, "detection_limit": 0.1},
    {"assayed_and_powered": "yes", "detection_limit": 0.1},
    {"assayed_and_powered": 1, "detection_limit": 0.1},
    {"assayed_and_powered": True, "detection_limit": None},
    {"assayed_and_powered": True, "detection_limit": float("nan")},
    {"assayed_and_powered": True, "detection_limit": True},
    {"assayed_and_powered": True, "detection_limit": 0.1, "basis": "absent_from_table"},
    {"assayed_and_powered": True, "detection_limit": 0.1, "basis": "Not_Listed"},
])
def test_verified_negative_needs_explicit_powered_evidence(evidence):
    r = row("n1", "verified_negative")
    r["negative_evidence"] = evidence
    with pytest.raises(ec.NegativeEvidenceError):
        ec.validate_table([r])


def test_negative_from_responder_only_table_is_rejected_even_with_claimed_evidence():
    r = row("n1", "verified_negative", source_table_kind="responder_only")
    with pytest.raises(ec.NegativeEvidenceError, match="responder-only"):
        ec.validate_table([r])
    r = row("n2", "verified_negative", study="holgersen_s4")
    with pytest.raises(ec.NegativeEvidenceError, match="responder-only"):
        ec.validate_table([r], responder_only_studies=["holgersen_s4"])
    # positives and unlabeled rows from the same responder-only study are fine
    ec.validate_table([row("p", study="holgersen_s4"), row("u", "unlabeled", study="holgersen_s4")],
                      responder_only_studies=["holgersen_s4"])


@pytest.mark.parametrize("state", ["unassayed", "unlabeled", "censored"])
        ec.cluster_bootstrap_ci(independent_rows(10), lambda idx: 1., **kwargs)


def test_r13_pu_ablation_records_k_outside_eligible_universe():
    rows = labelled(4, 3, n_unl=6, n_unassayed=5, n_censored=2)
    plan = ec.make_splits(rows, "leave_study_out")
    result = ec.run_ablation(rows, {}, "M0", plan, pu=True,
                             policy=ec.MetricPolicy(1, 1), top_k=(15,))
    assert result.pooled[0].pu.n_universe == 10
    assert "universe of 10" in result.pooled[0].blocked["pu_recall_at_top_k[15]"]


def test_r4_duplicate_assay_records_are_reported_and_never_independent():
    rows = [row("copy1"), row("copy2")]
    table = ec.validate_table(rows)
    assert table.duplicate_assay_records == (("copy1", "copy2"),)
    assert len(set(ec.effective_clusters(table, merge_axes=()))) == 1


def test_r4_sequence_bridge_connects_unit_counts_transitively():
    rows = labelled(3, 3)
    for i, seq in enumerate(("A" * 18, "A" * 16 + "CC", "A" * 14 + "CCCC")):
        rows[i]["aso_sequence"] = seq
    with pytest.raises(ec.MetricBlocked, match="1 independent measured_positive"):
        ec.compute_metric("auroc", rows, [1.] * 3 + [0.] * 3, policy=POLICY)


@pytest.mark.parametrize("kind", ["config", "groups", "folds"])
def test_r8_recomputes_plan_before_fit_even_when_ids_and_hash_are_unchanged(kind):
    rows = labelled(6, 6)
    plan = ec.make_splits(rows, "leave_study_out", n_folds=3)
                                        ("chrY", "Y"), ("chrM", "MT"), ("M", "chrMT")])
def test_fix2_chromosome_aliases_never_straddle(left, right):
    rows = independent_rows(8)
    rows[0]["chrom"] = left
    rows[1].update(chrom=right, start=rows[0]["start"], end=rows[0]["end"])
    for mode in ec.MODES:
        plan = ec.make_splits(rows, mode)
        assert plan.group_ids["window"][0] == plan.group_ids["window"][1]
        for fold in plan.folds:
            assert not ({0, 1} & set(fold.train_idx) and {0, 1} & set(fold.test_idx))
    assert ec.effective_clusters(rows)[0] == ec.effective_clusters(rows)[1]


@pytest.mark.parametrize("chrom", ["chr0", "chr23", "05", "NC_000005.10", "unknown"])
def test_fix2_unrecognized_chromosomes_refused(chrom):
    with pytest.raises(ec.SchemaError, match="chrom"):
        ec.axis_groups([row("a", chrom=chrom)], axes=("window",))


@pytest.mark.parametrize("entry", ["outer", "nested_outer", "nested_inner"])
@pytest.mark.parametrize("bad", [float("nan"), float("inf"), 0, -1, 1.5, True, "3", None])
def test_fix2_split_minima_are_positive_integers(entry, bad):
    rows = independent_rows(8)
    with pytest.raises(ec.SchemaError):
        if entry == "outer":
            ec.make_splits(rows, "leave_study_out", min_independent_groups=bad)
        else:
            kw = {"min_outer_groups" if entry == "nested_outer" else "min_inner_groups": bad}
            ec.make_nested_splits(rows, outer_mode="leave_study_out", **kw)


@pytest.mark.parametrize("metric", ["auroc", "auprc", "accuracy", "precision", "recall",
                                   "fdr", "brier", "calibration_error", "pr_curve", "ci"])
def test_fix2_exact_assay_copies_cannot_reweight_metrics(metric):
    rows = labelled(10, 10)
    scores = [.5] * 10 + [1.] + [0.] * 9
    assert ec.compute_metric("auroc", rows, scores).value == pytest.approx(.9)
    rows += [{**rows[10], "observation_id": f"copy{i}", "independent_unit_id": f"u{i}"}
             for i in range(20)]
    scores += [1.] * 20
    with pytest.raises(ec.MetricBlocked, match="duplicate assay"):
        if metric == "pr_curve":
            ec.precision_recall_curve(rows, scores)
        elif metric == "ci":
            ec.bootstrap_metric_ci("auroc", rows, scores, n_boot=20)
        else:
            ec.compute_metric(metric, rows, scores, threshold=.5)


@pytest.mark.parametrize("state", ["measured_positive", "unlabeled", "unassayed"])
def test_fix2_pu_refuses_duplicate_candidates(state):
    rows = labelled(10, 0, n_unl=10, n_unassayed=2)
    source = next(r for r in rows if r["label_state"] == state)
    rows.append({**source, "observation_id": "copy", "independent_unit_id": "copy_unit"})
    with pytest.raises(ec.MetricBlocked, match="duplicate assay"):
        ec.pu_report(rows, list(range(len(rows))), top_k=(5,), include_unassayed=True)


