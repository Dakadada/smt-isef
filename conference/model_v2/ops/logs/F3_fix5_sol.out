are opaque, CASE-SENSITIVE strings of 1..128 ASCII characters from
``[A-Za-z0-9._:+-]``. Whitespace, control/format characters and all non-ASCII
characters raise ``SchemaError``; IDs are never stripped, casefolded or Unicode
normalized. Public table consumers (including ``read_table``) validate this contract.
Sequence, chromosome and chemistry aliases remain canonicalized for assay identity.
Callers must assign distinct assay IDs to genuine replicate assays within a study.

``check_source_not_forbidden`` refuses'"''')
s = s.replace('REQUIRED_FIELDS = (', 'IDENTIFIER_FIELDS = (\"assay_id\", \"study_id\", \"independent_unit_id\", \"observation_id\")\\n_IDENTIFIER_RE = re.compile(r\"[A-Za-z0-9._:+-]{1,128}\")\\nREQUIRED_FIELDS = (', 1)
s = s.replace('def _canonicalize_assay_identity(', '''def _identifier(value: Any, name: str, where: str) -> str:
    if not isinstance(value, str) or _IDENTIFIER_RE.fullmatch(value) is None:
        raise SchemaError(
            f\"{where}: field {name"'!r} must be a case-sensitive ASCII identifier "
            "of 1..128 characters from [A-Za-z0-9._:+-]")
    return value


def _canonicalize_assay_identity('"''')
s = s.replace('    for name in (\"assay_id\", \"study_id\"):\\n        row[name] = unicodedata.normalize(\"NFKC\", _nonempty(row, name, where)).strip().casefold()\\n        _nonempty(row, name, where)\\n', '')
s = s.replace('    responder_only = RESPONDER_ONLY_SOURCES | frozenset(_category(s) for s in responder_only_studies)', '''    responder_only = frozenset(
        _identifier(s, \"study_id\", \"responder_only_studies\") for s in responder_only_studies)''')
s = s.replace('        oid = _nonempty(r, \"observation_id\", where)', '''        for name in IDENTIFIER_FIELDS:
            _identifier(r.get(name), name, where)
        oid = r[\"observation_id\"]''')
s = s.replace('        for name in (\"assay_id\", \"study_id\", \"independent_unit_id\"):\\n            _nonempty(r, name, where)\\n', '')
s = s.replace('f\"_{known}_\" in f\"_{token}_\" for known in responder_only for token in source_tokens)', 'f\"_{known}_\" in f\"_{token}_\" for known in RESPONDER_ONLY_SOURCES for token in source_tokens)')
s = s.replace('if kind in RESPONDER_ONLY_KINDS or known_responder:', 'if kind in RESPONDER_ONLY_KINDS or r[\"study_id\"] in responder_only or known_responder:')
s = s.replace('    rng = random.Random(_stable_seed(\"m0_permuted_reference\", seed))', '''    observation_ids = tuple(
        _identifier(oid, \"observation_id\", \"permuted_reference_scores\") for oid in observation_ids)
    rng = random.Random(_stable_seed(\"m0_permuted_reference\", seed))''')
p.write_text(s)
