s = s.replace('with pytest.raises(ec.UncertaintyRefused, match=\"duplicate assay\"):\\n            ec.cluster_bootstrap_ci(rows, statistic, n_boot=20)', 'with pytest.raises(ec.SchemaError if field.endswith(\"_id\") else ec.UncertaintyRefused):\\n            ec.cluster_bootstrap_ci(rows, statistic, n_boot=20)')
s = s.replace('with pytest.raises(ec.MetricBlocked, match=\"duplicate assay\"):\\n            if consumer == \"auroc\":', 'with pytest.raises(ec.SchemaError if field.endswith(\"_id\") else ec.MetricBlocked):\\n            if consumer == \"auroc\":')
