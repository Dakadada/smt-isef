    13	def test_rank_reversal_ties_and_missing_are_explicit():
    14	    m=api()
    15	    r=m.rank_stability({'a':{'x':1,'y':2,'z':3},'b':{'x':3,'y':2,'z':1}})
    16	    assert r['comparisons'][0]['spearman'] == pytest.approx(-1)
    17	    assert r['comparisons'][0]['kendall'] == pytest.approx(-1)
    18	    assert r['sign_flip_frequency'] == 1
    19	    assert r['stability_flag'] == 'unstable'
    20	    tied=m.rank_stability({'a':{'x':1,'y':1},'b':{'x':2,'y':2}})
    21	    assert tied['stability_flag'] == 'indeterminate'
    22	    assert tied['comparisons'][0]['kendall'] is None
    23	    missing=m.rank_stability({'a':{'x':1,'y':None},'b':{'x':1,'y':2}})
    24	    assert missing['stability_flag'] == 'indeterminate'
    25	    assert missing['missing']['a'] == ['y']
