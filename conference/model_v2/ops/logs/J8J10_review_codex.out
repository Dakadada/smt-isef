    22	def write(path, rows, metadata=None):
    23	    t = pa.Table.from_pylist(rows).replace_schema_metadata(metadata)
    24	    pq.write_table(t, path)
    25	    import hashlib
    26	    path.with_suffix('.done').write_text(json.dumps(dict(rows=len(rows), sha256=hashlib.sha256(path.read_bytes()).hexdigest())))
    27	    return path
