   249	    def ingest(self,kind,path,*,config_id=None):
   250	        if kind not in ('j2','j3','j4'): raise ValueError('unknown index kind')
   251	        identity=input_identity(path,kind); identity['config_id']=config_id
   252	        prior=self.db.execute('SELECT identity FROM inputs WHERE path=?',(identity['path'],)).fetchone()
   253	        if prior:
   254	            if prior[0]!=dumps(identity): raise ValueError('index input changed')
   255	            return
   256	        pf=pq.ParquetFile(path)
   257	        if OUTCOME_COLUMNS.intersection(x.lower() for x in pf.schema_arrow.names): raise ValueError('outcome columns forbidden')
   258	        if kind=='j4':
   259	            coords=(pf.schema_arrow.metadata or {}).get(b'coordinates',b'')
   260	            if b'GRCh38; GENCODE v50' not in coords: raise ValueError('atlas assembly fence')
   261	        # Project away the bulk sequence/structure columns at read time: the J3 shards
   262	        # are ~357 MB each and ~95% of that is flank/structure text this join discards.
   263	        columns=[n for n in pf.schema_arrow.names if n not in J3_DROP_COLUMNS] if kind=='j3' else None
   264	        try:
   265	            with self.db:
   266	                for batch in pf.iter_batches(batch_size=512,columns=columns):
   267	                    rows=batch.to_pylist()
   268	                    if kind=='j2':
   269	                        # Bounded compressed contiguous chunks; never one SQLite row per
   270	                        # base/grid cell (the full grid contains billions of cells).
   271	                        key=lambda r:(r['locus_id'],r['strand'],r['u'],r['W'],r['L'])
   272	                        for group,items in groupby(rows,key=key):
   273	                            chunk=list(items); positions=[r['pos_end_1b_transcript'] for r in chunk]
   274	                            if positions!=list(range(positions[0],positions[0]+len(positions))):
   275	                                raise ValueError('J2 positions must be contiguous and ordered within a grid chunk')
   276	                            previous=self.db.execute('SELECT 1 FROM j2 WHERE locus=? AND strand=? AND u=? AND w=? AND l=? AND first<=? AND last>=?',
   277	                                                     (*group,positions[-1],positions[0])).fetchone()
   278	                            if previous: raise ValueError('duplicate J2 grid positions')
   279	                            values=[r['p_unpaired'] if r['p_unpaired'] is not None else float('nan') for r in chunk]
   280	                            blob=zlib.compress(struct.pack('!'+str(len(values))+'d',*values))
   281	                            self.db.execute('INSERT INTO j2 VALUES (?,?,?,?,?,?,?,?)',(*group,positions[0],positions[-1],blob))
   282	                    for row in rows:
   283	                        if kind=='j3':
   284	                            fence(row)
   285	                            # Retain provenance/status and channel fields, omit large redundant flanks.
   286	                            keep={k:v for k,v in row.items() if k not in J3_DROP_COLUMNS}
   287	                            for channel,columns in {'duplex':('duplex_energy_kcal_mol',),
   288	                                    'accessibility':('accessibility_p_unpaired',),
   289	                                    'complementarity':('complementarity_wc_pairs','complementarity_gu_pairs','complementarity_mismatch_count')}.items():
   290	                                if channel+'_status' not in keep: continue
   291	                                invalid=any(keep.get(c) is None or not math.isfinite(keep[c]) for c in columns)
   292	                                if keep[channel+'_status']=='ok' and invalid:
   293	                                    keep[channel+'_status']='failed'
   294	                                    keep[channel+'_reason']='upstream ok status with missing/nonfinite numeric channel'
   295	                                if keep[channel+'_status']!='ok':
   296	                                    for c in columns: keep[c]=None
   297	                                    keep[channel+'_evidence_class']='not_available'
   298	                            self.db.execute('INSERT INTO j3 VALUES (?,?)',(row['site_id'],dumps(keep)))
   299	                        elif kind=='j2':
   300	                            continue
   301	                        else:
   302	                            row=dict(row,config_id=config_id)
   303	                            self.db.execute('INSERT INTO j4 VALUES (?,?,?,?,?,?)',(str(config_id)+':'+row['row_id'],row['chrom'],row['strand'],row['footprint_start'],row['footprint_end'],dumps(row)))
   304	                    size=self.db.execute('PRAGMA page_count').fetchone()[0]*self.db.execute('PRAGMA page_size').fetchone()[0]
   305	                    if size>self.max_bytes: raise ValueError('index disk budget exceeded; raise explicitly in Slurm')
   306	                self.db.execute('INSERT INTO inputs VALUES (?,?)',(identity['path'],dumps(identity)))
   307	        except sqlite3.IntegrityError as exc:
   308	            raise ValueError('duplicate feature keys; index transaction rolled back') from exc
   309	    def annotate(self,row,loci,geo):
   310	        fence(row)
   311	        hit=self.db.execute('SELECT payload FROM j3 WHERE id=?',(row['site_id'],)).fetchone()
   312	        channels=json.loads(hit[0]) if hit else dict(status='not_available',evidence_class='not_available',reason='site_id absent from indexed J3 inputs')
   313	        if hit:
   314	            for key in ('chrom','strand','start1','end1','assembly','annotation','aso_id'):
   315	                if channels.get(key)!=row.get(key): raise ValueError('site identity collision: '+key)
   316	        local=[l for l in geo.overlapping(row) if l['start1']<=row['start1'] and row['end1']<=l['end1']]
   317	        grids=[]
   318	        for l in local:
   319	            pos=row['end1']-l['start1']+1 if row['strand']=='+' else l['end1']-row['start1']+1
   320	            for w,span,u,first,blob in self.db.execute('SELECT w,l,u,first,values_blob FROM j2 WHERE locus=? AND strand=? AND u=? AND first<=? AND last>=?',
   321	                      (l['locus_id'],row['strand'],row['end1']-row['start1']+1,pos,pos)):
   322	                v=struct.unpack_from('!d',zlib.decompress(blob),8*(pos-first))[0]
   323	                grids.append(dict(locus_id=l['locus_id'],strand=row['strand'],pos_end_1b_transcript=pos,W=w,L=span,u=u,p_unpaired=v))
   324	        atlas=[json.loads(x[0]) for x in self.db.execute('SELECT payload FROM j4 WHERE chrom=? AND strand=? AND start<=? AND end>=?',
   325	                                                      (row['chrom'],row['strand'],row['end1'],row['start1']))]
   326	        return dict(row,j3_channels=dumps(channels),curated_geometry=dumps(geo.annotate(row)),
   327	                    j2_accessibility=dumps(accessibility(row,local,grids)),j4_ablation=dumps(atlas_summary(row,atlas)))
   328	
