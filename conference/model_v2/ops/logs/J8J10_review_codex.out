   330	def prepare_join(index,locus_paths,output_dir):
   331	    """One shared immutable catalog and geometry index for all output shards."""
   332	    output_dir=safe_path(output_dir); output_dir.mkdir(parents=True,exist_ok=True)
   333	    loci=load_loci(locus_paths)
   334	    locus_inputs=[dict(path=str(safe_path(p)),sha256=sha256(p),kind='loci') for p in locus_paths]
   335	    catalog=dict(version=VERSION,inputs=index.identities(),loci=locus_inputs,
   336	                 assembly=ASSEMBLY,annotation=ANNOTATION,
   337	                 geometry='canonical transcript exons +/-100nt; terminal nonsplice boundaries excluded')
   338	    path=output_dir/'feature_inputs.json'
   339	    if path.exists():
   340	        if json.loads(path.read_text())!=catalog: raise ValueError('join catalog inputs changed; use fresh output')
   341	    else: atomic_json(path,catalog)
   342	    return dict(loci=loci,geo=GeometryIndex(loci),catalog_sha256=sha256(path),
   343	                catalog_path=str(path),locus_inputs=locus_inputs,code_sha256=sha256(__file__),
   344	                index_version=(index.db.total_changes,index.db.execute('PRAGMA data_version').fetchone()[0]))
   345	
   346	
   347	def join_shard(j6_path,output,index,locus_paths,*,batch_size=512,context=None):
   348	    if batch_size<1: raise ValueError('positive batch size required')
   349	    source=input_identity(j6_path,'j6'); output=safe_path(output); output.parent.mkdir(parents=True,exist_ok=True)
   350	    context=context or prepare_join(index,locus_paths,output.parent)
   351	    if context['index_version']!=(index.db.total_changes,index.db.execute('PRAGMA data_version').fetchone()[0]):
   352	        raise ValueError('feature index changed after catalog snapshot')
   353	    inputs=[source,dict(path=context['catalog_path'],sha256=context['catalog_sha256'],kind='feature_catalog')]+context['locus_inputs']
   354	    contract=dict(version=VERSION,code_sha256=context['code_sha256'],inputs=inputs,
   355	                  catalog_sha256=context['catalog_sha256'],assembly=ASSEMBLY,annotation=ANNOTATION,exon_padding=100)
   356	    marker=output.with_suffix('.done')
   357	    if marker.exists():
   358	        try: old=json.loads(marker.read_text())
   359	        except (ValueError,OSError): old={}
   360	        if not isinstance(old,dict): old={}
   361	        if old.get('contract') is not None and old['contract']!=contract: raise ValueError('join inputs or implementation changed; use a fresh output')
   362	        if output.exists() and sha256(output)==old.get('sha256') and pq.read_metadata(output).num_rows==source['rows']:
   363	            return old
   364	    marker.unlink(missing_ok=True)
   365	    pf=pq.ParquetFile(j6_path)
   366	    if OUTCOME_COLUMNS.intersection(x.lower() for x in pf.schema_arrow.names): raise ValueError('outcome columns forbidden')
   367	    fields=[f.with_metadata({b'evidence_class':b'derived'}) for f in pf.schema_arrow]
   368	    for name in ('j3_channels','curated_geometry','j2_accessibility','j4_ablation'):
   369	        fields.append(pa.field(name,pa.string(),metadata={b'evidence_class':b'derived',b'cell_evidence':b'JSON status/evidence_class; J3 channel-specific companions'}))
   370	    schema=pa.schema(fields,metadata={b'coordinates':b'GRCh38; GENCODE v50; 1-based inclusive',b'j8_version':VERSION.encode()})
   371	    loci=context['loci']; geo=context['geo']; n=0
   372	    fd,temp=tempfile.mkstemp(dir=output.parent,suffix='.parquet.tmp'); os.close(fd)
   373	    try:
   374	        with pq.ParquetWriter(temp,schema,compression='zstd') as writer:
   375	            for batch in pf.iter_batches(batch_size=batch_size):
   376	                records=[index.annotate(r,loci,geo) for r in batch.to_pylist()]
   377	                writer.write_table(pa.Table.from_pylist(records,schema=schema)); n+=len(records)
   378	        if n!=source['rows']: raise ValueError('row-count conservation failed')
   379	        with open(temp,'rb') as stream: os.fsync(stream.fileno())
   380	        os.replace(temp,output)
   381	        result=dict(contract=contract,inputs=inputs,rows=n,sha256=sha256(output))
   382	        atomic_json(marker,result)
   383	        return result
   384	    finally:
   385	        if os.path.exists(temp): os.unlink(temp)
   386	
