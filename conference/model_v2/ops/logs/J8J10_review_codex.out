   407	def main(argv=None):
   408	    p=argparse.ArgumentParser(description=__doc__)
   409	    p.add_argument('--root',default='~/orcd/scratch/feng/model_v2'); p.add_argument('--out',required=True)
   410	    p.add_argument('--bounded',action='store_true'); p.add_argument('--max-index-gib',type=float,default=20)
   411	    p.add_argument('--loci',nargs='+',default=[str(Path(__file__).parent/'manifests'/f'j2_loci_phase{i}.tsv') for i in (1,2)])
   412	    args=p.parse_args(argv); out=safe_path(args.out); out.mkdir(parents=True,exist_ok=True)
   413	    j6,entries,manifests=production_inventory(args.root,bounded=args.bounded)
   414	    locus_paths=args.loci
   415	    with FeatureIndex(out/'index.sqlite',int(args.max_index_gib*1024**3)) as index:
   416	        for kind,path,cid in entries: index.ingest(kind,path,config_id=cid)
   417	        context=prepare_join(index,locus_paths,out)
   418	        count=0
   419	        for path in j6: count+=join_shard(path,out/path.name,index,locus_paths,context=context)['rows']
   420	        if not args.bounded:
   421	            gate=safe_path(args.root)/'j6_genome_v1/gate_report.json'
   422	            expected=json.loads(gate.read_text())['rows']
   423	            if count!=expected: raise ValueError('global J6 row-count conservation failed')
   424	            manifests.append(gate)
   425	        atomic_json(out/'manifest.json',dict(rows=count,n_shards=len(j6),coverage='partial' if args.bounded else 'full',
   426	          inputs=index.identities(),source_manifests=[dict(path=str(p),sha256=sha256(p)) for p in manifests],
   427	          note='J2 exact u only; no outcomes; per-output .done contains J6 and locus input hashes',
   428	          j2_coverage_warning='J2 folded u in {8,12,18}; ASO footprints are 10/14/18 nt, so only '
   429	                              '18-nt (F18) sites can match a J2 grid cell. All other sites report '
   430	                              'j2_accessibility not_available by design; no length substitution.'))
   431	
   432	
   433	if __name__=='__main__': main()
    83	def rank_stability(alternatives,*,candidates=None,min_agreement=.8,max_flip_fraction=0):
    84	    """Tau-b / Spearman on pairwise complete cases, with full-set coverage guard.
    85	
    86	    Sign flips compare strict pair orderings across every pair of settings. Ties
    87	    are not flips and are reported separately. Incomplete coverage cannot be
    88	    declared stable; an observed reversal can still establish instability.
    89	    """
    90	    if not -1<=min_agreement<=1 or not 0<=max_flip_fraction<=1: raise ValueError('invalid stability thresholds')
    91	    names=sorted(alternatives)
    92	    ids=sorted(candidates if candidates is not None else {c for scores in alternatives.values() for c in scores})
    93	    if len(ids)!=len(set(ids)): raise ValueError('duplicate candidates')
    94	    missing={n:[c for c in ids if not finite(alternatives[n].get(c))] for n in names}
    95	    comparisons=[]; flips=0; strict=0; ties=0
    96	    for a,b in combinations(names,2):
    97	        common=[c for c in ids if c not in missing[a] and c not in missing[b]]
    98	        x=[alternatives[a][c] for c in common]; y=[alternatives[b][c] for c in common]
    99	        tau=rho=None
   100	        if len(common)>=2 and len(set(x))>1 and len(set(y))>1:
   101	            with warnings.catch_warnings():
   102	                warnings.simplefilter('ignore')
   103	                tau=float(kendalltau(x,y).statistic); rho=float(spearmanr(x,y).statistic)
   104	            tau=tau if finite(tau) else None; rho=rho if finite(rho) else None
   105	        f=s=t=0
   106	        for i,j in combinations(range(len(common)),2):
   107	            dx=x[i]-x[j]; dy=y[i]-y[j]
   108	            if dx==0 or dy==0: t+=1
   109	            else: s+=1; f+=int(dx*dy<0)
   110	        flips+=f; strict+=s; ties+=t
   111	        comparisons.append(dict(settings=[a,b],n_common=len(common),kendall=tau,spearman=rho,
   112	                                sign_flips=f,strict_order_comparisons=s,tied_order_comparisons=t,
   113	                                sign_flip_frequency=f/s if s else None,evidence_class='derived'))
   114	    frequency=flips/strict if strict else None
   115	    known=[r for r in comparisons if r['kendall'] is not None and r['spearman'] is not None]
   116	    unstable=any(min(r['kendall'],r['spearman'])<min_agreement for r in known) or (frequency is not None and frequency>max_flip_fraction)
   117	    complete=bool(comparisons) and not any(missing.values()) and len(known)==len(comparisons)
   118	    flag='unstable' if unstable else ('stable' if complete else 'indeterminate')
   119	    return dict(stability_flag=flag,n_candidates=len(ids),missing=missing,comparisons=comparisons,
   120	                sign_flip_frequency=frequency,n_sign_flips=flips,n_strict_comparisons=strict,n_tied_comparisons=ties,
   121	                thresholds=dict(min_agreement=min_agreement,max_flip_fraction=max_flip_fraction),evidence_class='derived')
   122	
   123	
   124	def dna(sequence):
   125	    value=sequence.upper().replace('U','T')
   126	    if not value or set(value)-set('ACGT'): raise ValueError('nonempty unambiguous sequence required')
   127	    return value
   128	
   129	
   130	def dinucleotide_shuffle(sequence,*,seed):
   131	    """Randomized Euler trail; exact dinucleotide multiset, NOT a uniform sampler."""
   132	    sequence=dna(sequence); rng=random.Random(seed); edges={b:[] for b in 'ACGT'}
   133	    for a,b in zip(sequence,sequence[1:]): edges[a].append(b)
   134	    for values in edges.values(): rng.shuffle(values)
   135	    stack=[sequence[0]]; trail=[]
   136	    while stack:
   137	        if edges[stack[-1]]: stack.append(edges[stack[-1]].pop())
   138	        else: trail.append(stack.pop())
   139	    return ''.join(reversed(trail))
   140	
   141	
   142	def shifted_decoys(sequence,*,start,length,n,seed,gc_tolerance=0):
   143	    """Uniform without replacement over eligible 0-based starts in this locus.
   144	
   145	    Excludes the true start (overlap with the true footprint is allowed and stated).
   146	    GC tolerance is an absolute fraction difference, with exact length matching.
   147	    """
   148	    sequence=dna(sequence)
   149	    if any(type(x) is not int for x in (start,length,n)) or not 0<=start<=len(sequence)-length or length<1 or n<1:
   150	        raise ValueError('invalid footprint or draw count')
   151	    if not 0<=gc_tolerance<=1: raise ValueError('invalid GC tolerance')
   152	    gc=lambda s:sum(b in 'GC' for b in s)/len(s)
   153	    target=sequence[start:start+length]; target_gc=gc(target)
   154	    eligible=[i for i in range(len(sequence)-length+1) if i!=start and abs(gc(sequence[i:i+length])-target_gc)<=gc_tolerance+1e-12]
   155	    starts=sorted(random.Random(seed).sample(eligible,min(n,len(eligible))))
   156	    return dict(decoys=[dict(start=i,sequence=sequence[i:i+length]) for i in starts],
   157	                sampling_universe=dict(definition='all same-locus starts except observed start, exact length, GC-matched; overlap allowed',
   158	                    method='uniform_without_replacement',locus_sequence_sha256=__import__('hashlib').sha256(sequence.encode()).hexdigest(),
   159	                    locus_length=len(sequence),observed_start=start,length=length,target_gc=target_gc,
   160	                    gc_tolerance=gc_tolerance,eligible_count=len(eligible),eligible_starts=eligible),seed=seed)
   161	
   162	
   163	def empirical_null(observed,values,*,universe,min_decoys=20,higher_is_extreme=True):
   164	    """One-sided plus-one empirical tail; refuses missing scores or undefined universe."""
   165	    if not isinstance(universe,dict) or not isinstance(universe.get('definition'),str) or not universe['definition'].strip():
   166	        raise MetricBlocked('empirical_null','sampling universe is not defined')
   167	    if type(min_decoys) is not int or min_decoys<1: raise ValueError('positive minimum decoy count required')
   168	    if universe.get('method')=='randomized_euler_trail_nonuniform':
   169	        raise MetricBlocked('empirical_null','Euler-trail draw probabilities are not uniform; descriptive null only')
   170	    if not finite(observed) or any(not finite(v) for v in values):
   171	        raise MetricBlocked('empirical_null','missing/failed observed or decoy scores; no selective deletion')
   172	    if len(values)<min_decoys: raise MetricBlocked('empirical_null',f'n_decoys={len(values)} below minimum={min_decoys}')
   173	    extreme=sum(v>=observed if higher_is_extreme else v<=observed for v in values)
   174	    return dict(distribution=list(values),observed=observed,n_decoys=len(values),minimum_decoys=min_decoys,
   175	                p_value=(1+extreme)/(1+len(values)),tail='upper' if higher_is_extreme else 'lower',
   176	                sampling_universe=universe,evidence_class='derived',interpretation='conditional matched-decoy tail; not biological efficacy evidence')
   177	
   178	
   179	def null_channels(sequence,*,start,length,n,seed,scorers,min_decoys=20,gc_tolerance=0,directions=None):
   180	    """Callbacks are lookups/statistical descriptors only; absent channels are blocked.
   181	
   182	    Entire target flank is dinucleotide shuffled. Only draws also matching the
   183	    footprint GC are retained; acceptance counts and the nonuniform law are stated.
   184	    """
   185	    sequence=dna(sequence); target=sequence[start:start+length]
   186	    shifted=shifted_decoys(sequence,start=start,length=length,n=n,seed=seed,gc_tolerance=gc_tolerance)
   187	    target_gc=sum(b in 'GC' for b in target)/length
   188	    shuffled=[]
   189	    for i in range(n):
   190	        s=dinucleotide_shuffle(sequence,seed=seed+i)[start:start+length]
   191	        if abs(sum(b in 'GC' for b in s)/length-target_gc)<=gc_tolerance+1e-12: shuffled.append(s)
   192	    universe=dict(definition='dinucleotide-preserving permutations of the supplied flank, conditioned on footprint GC/length',
   193	                  method='randomized_euler_trail_nonuniform',locus_sequence_sha256=shifted['sampling_universe']['locus_sequence_sha256'],
   194	                  length=length,gc_tolerance=gc_tolerance,n_attempted=n,n_accepted=len(shuffled),n_unique=len(set(shuffled)))
   195	    result={}
   196	    for channel,scorer in sorted(scorers.items()):
   197	        if scorer is None:
   198	            result[channel]=dict(status='blocked',reason='decoy channel not precomputed; no scoring backend in J10',evidence_class='not_available'); continue
   199	        def score(s):
   200	            try:
   201	                v=scorer(s)
   202	            except (KeyError,ValueError,RuntimeError): return None
   203	            return v if finite(v) else None
   204	        observed=score(target); parts={}
   205	        for name,sequences,u in [('shift',[d['sequence'] for d in shifted['decoys']],shifted['sampling_universe']),('shuffle',shuffled,universe)]:
   206	            values=[score(s) for s in sequences]
   207	            try:
   208	                parts[name]=dict(status='ok',**empirical_null(observed,values,universe=u,min_decoys=min_decoys,
   209	                                                   higher_is_extreme=(directions or {}).get(channel,True)))
   210	            except MetricBlocked as exc:
   211	                parts[name]=dict(status='blocked',reason=exc.reason,p_value=None,distribution=values,observed=observed,
   212	                                 n_decoys=len(values),minimum_decoys=min_decoys,sampling_universe=u,evidence_class='derived')
   213	        result[channel]=parts
   214	    return result
   215	
   216	
   217	def complementarity_scorer(aso_sequence):
   218	    """Reuse the J3 descriptor itself: pure sequence arithmetic, no ViennaRNA/GPU/IO.
   219	
   220	    This is the only channel a decoy can be rescored for inside J10. Duplex energy
   221	    and accessibility need a folding backend, so their decoy scorers stay None and
   222	    their nulls are reported blocked rather than approximated.
   223	    """
   224	    if not isinstance(aso_sequence,str) or not aso_sequence.strip(): raise ValueError('ASO sequence required')
   225	    def score(sequence):
   226	        return float(j3_complementarity(aso_sequence,sequence)['wc_pairs'])
   227	    return score
   228	
   229	
   230	def _direction(column):
   231	    return -1 if any(x in column for x in ('energy','mismatch','abs_','n_sites','n_exact_sites')) else 1
   232	
   233	
   234	def descriptive_scores(features,columns):
   235	    """Prespecified equal-weight oriented rank composite; all cells must be present."""
   236	    ids=sorted(features)
   237	    if not ids or not columns: raise MetricBlocked('rank_composite','no feature columns / candidates')
   238	    missing=[(c,k) for c in ids for k in columns if not finite(features[c].get(k))]
   239	    if missing: raise MetricBlocked('rank_composite',f'{len(missing)} missing feature cells, e.g. {missing[:3]}')
   240	    scores={c:0. for c in ids}
   241	    for k in columns:
   242	        ranks=rankdata([_direction(k)*features[c][k] for c in ids],method='average')
   243	        for c,r in zip(ids,ranks): scores[c]+=float(r)/len(ids)/len(columns)
   244	    return scores
   245	
   246	
   247	def baseline_ablation(features,*,source_paths,seed=0):
   248	    """Use evaluation_core registry, lineage guard, M0 and supervised metric guard.
   249	
   250	    No fake split groups or fitted ablation are created: these candidates have no
   251	    verified negatives. Leave-outs here compare descriptive fixed composites.
   252	    """
   253	    if not source_paths: raise ValueError('feature provenance required')
   254	    for p in source_paths: ec.check_source_not_forbidden(p)
   255	    rows=[dict(observation_id=c,label_state='unlabeled',assay_id='unassayed',study_id='derived_feature_atlas',
   256	               independent_unit_id=c,provenance={'source':str(source_paths[0]),'source_paths':list(map(str,source_paths))}) for c in sorted(features)]
   257	    table=ec.validate_table(rows)
   258	    random_scores=ec.permuted_reference_scores(table.ids,seed)
   259	    try:
   260	        ec.compute_metric('auroc',table,random_scores,mode='pu')
   261	    except MetricBlocked as exc:
   262	        supervised=dict(status='blocked',reason='No verified negatives or measured labels. '+exc.reason)
   263	    else: raise RuntimeError('unlabeled supervised metric unexpectedly passed evaluation_core')
   264	    baselines={}
   265	    for name in ('M0','M1','M2','M3','M4','M5'):
   266	        columns=ec.baseline_feature_columns(name)
   267	        if name=='M0':
   268	            baselines[name]=dict(status='ok',scores=random_scores,evidence_class='model_assumption',seed=seed); continue
   269	        try:
   270	            full=descriptive_scores(features,columns)
   271	        except MetricBlocked as exc:
   272	            baselines[name]=dict(status='blocked',reason=exc.reason,evidence_class='not_available'); continue
   273	        leave={}
   274	        for family in ec.BASELINES[name].families:
   275	            kept=tuple(c for c in columns if c not in family.columns)
   276	            try:
   277	                scores=descriptive_scores(features,kept)
   278	                leave[family.name]=dict(status='ok',agreement=rank_stability({'full':full,'leave_out':scores}),columns=list(kept))
   279	            except MetricBlocked as exc:
   280	                leave[family.name]=dict(status='blocked',reason=exc.reason)
   281	        baselines[name]=dict(status='ok',scores=full,leave_out=leave,evidence_class='model_assumption')
   282	    return dict(mode='descriptive_rank_agreement_only',supervised=supervised,baselines=baselines,
   283	                composite='equal-weight oriented percentile ranks; fixed assumption, not fitted',
   284	                ablation_fit='not run: no supervised training/splits; evaluation_core registry and metric guards called',seed=seed)
   285	
   286	
   287	def j9_report(rows,*,source,seed=0,fold_variant='w120s60',mismatch_variant='mm3'):
   288	    candidates=['F18','F14','F10']; scores={}; features={c:{} for c in candidates}
   289	    baseline_variants=('default',fold_variant,mismatch_variant)
   290	    for row in rows:
   291	        if row['aso_id'] not in candidates: continue
   292	        value=row.get('value_double') if row.get('value_double') is not None else row.get('value_int')
   293	        key=(row['feature_name'],row['variant_id'])
   294	        scores.setdefault(key,{})
   295	        if row['aso_id'] in scores[key]: raise ValueError('duplicate J9 feature cell')
   296	        scores[key][row['aso_id']]=value if row['status']=='ok' and finite(value) else None
   297	        if row['variant_id'] in baseline_variants:
   298	            if row['feature_name'] in features[row['aso_id']]: raise ValueError('ambiguous baseline feature alternative')
   299	            features[row['aso_id']][row['feature_name']]=scores[key][row['aso_id']]
   300	    reports={}
   301	    for feature in sorted({k[0] for k in scores}):
   302	        alternatives={v:{c:(_direction(feature)*values[c] if finite(values.get(c)) else None) for c in candidates}
   303	                      for (f,v),values in scores.items() if f==feature}
   304	        reports[feature]=rank_stability(alternatives,candidates=candidates)
   305	    # Compare the prespecified thermodynamic/complementarity/accessibility channels.
   306	    channels={f:{c:(_direction(f)*scores.get((f,v),{}).get(c) if finite(scores.get((f,v),{}).get(c)) else None) for c in candidates}
   307	              for f,v in [('m1_wc_pairs','default'),('m2_duplex_energy_kcal_mol',fold_variant),('m3_accessibility_p_unpaired',fold_variant)]}
   308	    return dict(candidates=candidates,excluded=['3UP8'],per_feature=reports,channel_agreement=rank_stability(channels),
   309	                baseline_variants=list(baseline_variants),
   310	                ablation=baseline_ablation(features,source_paths=[source],seed=seed),evidence_class='derived')
   311	
   312	
   313	def main(argv=None):
   314	    import pyarrow.parquet as pq
   315	    from itertools import islice
   316	    p=argparse.ArgumentParser(description=__doc__)
   317	    p.add_argument('--j9',required=True); p.add_argument('--j3',required=True); p.add_argument('--out',required=True)
   318	    p.add_argument('--limit',type=int,default=300); p.add_argument('--seed',type=int,default=1729)
   319	    args=p.parse_args(argv)
   320	    if not 2<=args.limit<=1000: p.error('bounded sample limit must be 2..1000')
   321	    paths=[safe_path(args.j9),safe_path(args.j3)]
   322	    variant=j3_fold_variant(paths[1])
   323	    # Bounded output checkpoint; exact source SHA is acquired in Slurm, not login.
   324	    contract=dict(inputs=[dict(path=str(x),sha256=sha256(x)) for x in paths],seed=args.seed,limit=args.limit,
   325	                  j3_fold_variant=variant,code_sha256=sha256(__file__))
   326	    output=safe_path(args.out); output.parent.mkdir(parents=True,exist_ok=True)
   327	    if output.exists():
   328	        prior=json.loads(output.read_text())
   329	        if prior.get('contract')==contract: return
   330	        raise ValueError('changed robustness inputs; choose fresh output')
   331	    j9rows=pq.read_table(paths[0]).to_pylist()
   332	    columns=['site_id','aso_id','aso_sequence','assembly','annotation','chrom','strand','start1','end1','mismatch_count',
   333	             'complementarity_wc_pairs','complementarity_status','duplex_energy_kcal_mol','duplex_status',
   334	             'accessibility_p_unpaired','accessibility_status','target_with_flank','footprint_start1_in_context']
   335	    raw=list(islice((r for b in pq.ParquetFile(paths[1]).iter_batches(batch_size=64,columns=columns) for r in b.to_pylist() if r['aso_id']!='3UP8'),args.limit))
   336	    from conference.model_v2.j8_feature_join import fence
   337	    for r in raw: fence(r)
   338	    rows=[dict(candidate_id=r['site_id'],variant_id=variant,mismatch_count=r['mismatch_count'],
   339	               wc=r['complementarity_wc_pairs'],wc_status=r['complementarity_status'],
   340	               energy=r['duplex_energy_kcal_mol'],energy_status=r['duplex_status'],
   341	               access=r['accessibility_p_unpaired'],access_status=r['accessibility_status']) for r in raw]
   342	    settings=[Setting('complementarity','wc',variant),Setting('duplex','energy',variant,False),Setting('accessibility','access',variant)]
   343	    settings += [Setting(f'max_mismatch_{k}','wc',variant,True,k) for k in (0,1,2,3)]
   344	    # Explicit missing alternatives, never silently reuse the one computed J3 window.
   345	    settings += [Setting(v,'access',v) for v in FOLD_VARIANTS if v!=variant]
   346	    ids=[r['candidate_id'] for r in rows]
   347	    alternatives=alternative_scores(rows,settings,ids)
   348	    nulls=[]
   349	    for i,r in enumerate(raw[:3]):
   350	        length=r['end1']-r['start1']+1
   351	        start=r['footprint_start1_in_context']-1
   352	        scorer=complementarity_scorer(r['aso_sequence'])
   353	        # Orientation guard: the rescored observed footprint must reproduce the J3 cell.
   354	        observed=scorer(r['target_with_flank'][start:start+length])
   355	        if r['complementarity_status']=='ok' and observed!=float(r['complementarity_wc_pairs']):
   356	            raise ValueError('decoy scorer disagrees with the committed J3 complementarity cell: '+r['site_id'])
   357	        nulls.append(dict(site_id=r['site_id'],aso_id=r['aso_id'],observed_wc_pairs=observed,
   358	             channels=null_channels(r['target_with_flank'],start=start,length=length,n=50,seed=args.seed+i,
   359	             scorers={'complementarity':scorer,'duplex':None,'accessibility':None})))
   360	    result=dict(contract=contract,j9=j9_report(j9rows,source=str(paths[0]),seed=args.seed,fold_variant=variant),j3_sample=dict(
   361	        rows=len(raw),sampling_universe='first N non-3UP8 rows in explicitly named J3 shard; convenience sample, not genome representative',
   362	        j3_fold_variant=variant,settings=[asdict(s) for s in settings],stability=rank_stability(alternatives),nulls=nulls),
   363	        blocked=['Duplex-energy and accessibility decoy nulls blocked: both need a folding backend, '
   364	                 'and J10 runs no scoring backend. Only the pure-sequence complementarity channel is rescored.',
   365	                 'J3 alternative fold windows are absent; coverage explicitly incomplete.',
   366	                 'No verified negatives: supervised metrics blocked by evaluation_core.'])
   367	    atomic_json(output,result)
   368	
   369	
   370	if __name__=='__main__': main()

