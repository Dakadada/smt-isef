    30	def j3_fold_variant(path):
    31	    """Read the single J3 fold window from its commit marker; never assume a label."""
    32	    marker=safe_path(path).with_suffix('.done')
    33	    params=json.loads(marker.read_text()).get('params',{})
    34	    window,span=params.get('window'),params.get('span')
    35	    if type(window) is not int or type(span) is not int:
    36	        raise ValueError('J3 marker lacks explicit fold window/span; cannot label the accessibility variant')
    37	    label='w%ds%d'%(window,span)
    38	    if label not in FOLD_VARIANTS: raise ValueError('J3 fold window is outside the declared J2 variant set: '+label)
    39	    return label
