   126	def test_cli_is_bounded_excludes_3up8_and_restarts(tmp_path):
   127	    import json
   128	    import pyarrow as pa
   129	    import pyarrow.parquet as pq
   130	    m=api(); j9=tmp_path/'j9.parquet'; j3=tmp_path/'j3.parquet'; out=tmp_path/'result.json'
   131	    pq.write_table(pa.Table.from_pylist([dict(aso_id=c,feature_name='m1_wc_pairs',variant_id='default',value_int=i,value_double=None,status='ok')
   132	                        for i,c in enumerate(['F18','F14','F10','3UP8'])]),j9)
   133	    base=dict(assembly='GRCh38',annotation='GENCODE v50',chrom='chr1',strand='+',start1=10,end1=13,mismatch_count=0,aso_sequence='ACGT',
   134	              complementarity_wc_pairs=4,complementarity_status='ok',duplex_energy_kcal_mol=-4.,duplex_status='ok',
   135	              accessibility_p_unpaired=.1,accessibility_status='ok',target_with_flank='ACGTACGTACGT',footprint_start1_in_context=5)
   136	    pq.write_table(pa.Table.from_pylist([dict(base,site_id=f's{i}',aso_id=c) for i,c in enumerate(['3UP8','F18','F14','F10'])]),j3)
   137	    j3.with_suffix('.done').write_text(json.dumps(dict(rows=4,params=dict(window=120,span=60))))
   138	    args=['--j9',str(j9),'--j3',str(j3),'--out',str(out),'--limit','2']
   139	    m.main(args); stamp=out.stat().st_mtime_ns; m.main(args)
   140	    r=json.loads(out.read_text())
   141	    assert r['j3_sample']['rows']==2
   142	    assert r['j9']['excluded']==['3UP8']
   143	    assert out.stat().st_mtime_ns==stamp
   144	    assert all(n['site_id']!='s0' for n in r['j3_sample']['nulls'])
   145	    assert all(n['observed_wc_pairs']==4 for n in r['j3_sample']['nulls'])
   146	    assert r['j3_sample']['nulls'][0]['channels']['duplex']['status']=='blocked'
   147	    # The one computed window is labelled from the marker, never assumed; the other
   148	    # two declared J2 windows stay present-but-missing rather than silently reused.
   149	    assert r['contract']['j3_fold_variant']=='w120s60'
   150	    assert r['j3_sample']['j3_fold_variant']=='w120s60'
   151	    absent={s['name'] for s in r['j3_sample']['settings']}&{'w80s40','w200s100'}
   152	    assert absent=={'w80s40','w200s100'}
   153	    assert all(r['j3_sample']['stability']['missing'][n]==['s1','s2'] for n in absent)
