   156	def test_complementarity_scorer_matches_j3_and_feeds_a_real_null():
   157	    m=api()
   158	    from conference.model_v2.j3_scoring import complementarity
   159	    aso='ACGUACGU'; target='ACGUACGU'
   160	    scorer=m.complementarity_scorer(aso)
   161	    assert scorer(target)==float(complementarity(aso,target)['wc_pairs'])
   162	    assert scorer('ACGTACGT')==scorer(target)     # DNA/RNA alphabets agree
   163	    with pytest.raises(ValueError): scorer('AAAA')  # unequal lengths refuse, never pad
   164	    with pytest.raises(ValueError): m.complementarity_scorer('')
   165	    # A real (not blocked) shift null: uniform-without-replacement universe, p-value emitted.
   166	    r=m.null_channels('ACGTACGTTGCAACGTACGTTGCA',start=0,length=8,n=12,seed=5,
   167	                      scorers={'complementarity':scorer},min_decoys=3,gc_tolerance=1)
   168	    assert r['complementarity']['shift']['status']=='ok'
   169	    assert 0 < r['complementarity']['shift']['p_value'] <= 1
   170	    assert r['complementarity']['shift']['n_decoys']>=3
   171	    assert r['complementarity']['shuffle']['status']=='blocked'
   172	
