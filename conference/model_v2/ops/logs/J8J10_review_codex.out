    53	
    54	def sha256(path):
    55	    h = hashlib.sha256()
    56	    with safe_path(path).open('rb') as stream:
    57	        for chunk in iter(lambda: stream.read(1024 * 1024), b''):
    58	            h.update(chunk)
    59	    return h.hexdigest()
    60	
    61	
    62	def dumps(value):
    63	    return json.dumps(value, sort_keys=True, separators=(',', ':'), allow_nan=False)
    64	
    65	
    66	def atomic_json(path, value):
    67	    path = Path(path)
    68	    fd, temp = tempfile.mkstemp(dir=path.parent, suffix='.tmp')
    69	    try:
    70	        with os.fdopen(fd, 'w') as stream:
    71	            stream.write(dumps(value) + '\n'); stream.flush(); os.fsync(stream.fileno())
    72	        os.replace(temp, path)
    73	    finally:
    74	        if os.path.exists(temp): os.unlink(temp)
    75	
    76	
    77	def fence(row):
    78	    if row.get('assembly') != ASSEMBLY or row.get('annotation') != ANNOTATION:
    79	        raise ValueError('assembly/annotation fence requires GRCh38 / GENCODE v50')
    80	    if row.get('strand') not in ('+', '-') or not 1 <= row['start1'] <= row['end1']:
    81	        raise ValueError('invalid 1-based inclusive coordinates')
    82	
    83	
    84	def load_loci(paths):
    85	    result = {}
    86	    for path in paths:
    87	        with safe_path(path).open() as stream:
    88	            for line in stream:
    89	                if not line.strip() or line.startswith('#'): continue
    90	                lid, chrom, start, end, strand = line.strip().split('\t')
    91	                row = dict(locus_id=lid, chrom=chrom, start1=int(start), end1=int(end), strand=strand)
    92	                fence(dict(row, assembly=ASSEMBLY, annotation=ANNOTATION))
    93	                if row['end1'] - row['start1'] < 200: raise ValueError('locus lacks 100nt exon padding')
    94	                if lid in result and result[lid] != row: raise ValueError('conflicting locus geometry')
    95	                result[lid] = row
    96	    # These are full canonical transcript exon lists, not selected interior exons.
    97	    # Terminal transcript ends are not splice junctions. Fail on incomplete lists.
    98	    transcripts={}
    99	    for lid in result:
   100	        if ':ex' in lid:
   101	            tx, number=lid.rsplit(':ex',1)
   102	            transcripts.setdefault(tx,[]).append(int(number))
   103	    for tx, numbers in transcripts.items():
   104	        if sorted(numbers)!=list(range(1,max(numbers)+1)):
   105	            raise ValueError('incomplete canonical exon list: '+tx)
   106	    for lid,row in result.items():
   107	        if row['start1']==1:
   108	            raise ValueError('clipped exon padding needs explicit unpadded geometry')
   109	        if ':ex' in lid:
   110	            tx, number=lid.rsplit(':ex',1); number=int(number)
   111	            row['acceptor_position']=(row['start1']+100 if row['strand']=='+' else row['end1']-100) if number>1 else None
   112	            row['donor_position']=(row['end1']-100 if row['strand']=='+' else row['start1']+100) if number<max(transcripts[tx]) else None
   113	    return sorted(result.values(), key=lambda x:x['locus_id'])
   114	
   115	
   116	class GeometryIndex:
   117	    """Small curated exon index; nearest boundaries via bisect, overlaps by chromosome."""
   118	    def __init__(self, loci):
   119	        self.groups = {}; self.boundaries = {}; self.intervals={}
   120	        for loc in loci:
   121	            key = (loc['chrom'], loc['strand'])
   122	            self.groups.setdefault(key, []).append(loc)
   123	        for key, group in self.groups.items():
   124	            ordered=sorted(group,key=lambda l:(l['start1'],l['locus_id']))
   125	            ends=[]; maximum=0
   126	            for loc in ordered:
   127	                maximum=max(maximum,loc['end1']); ends.append(maximum)
   128	            self.intervals[key]=([l['start1'] for l in ordered],ends,ordered)
   129	            for kind in ('donor', 'acceptor'):
   130	                positions=[]
   131	                for loc in group:
   132	                    default=loc['end1']-100 if (kind == 'donor') == (key[1] == '+') else loc['start1']+100
   133	                    position=loc.get(kind+'_position',default)
   134	                    if position is not None: positions.append((position,loc['locus_id']))
   135	                self.boundaries[key, kind] = sorted(positions)
   136	
   137	    def overlapping(self,row):
   138	        item=self.intervals.get((row['chrom'],row['strand']))
   139	        if item is None: return []
   140	        starts,ends,ordered=item
   141	        lo=bisect_left(ends,row['start1']); hi=bisect_right(starts,row['end1'])
   142	        return [l for l in ordered[lo:hi] if l['end1']>=row['start1']]
   143	
   144	    def annotate(self, row):
   145	        fence(row)
   146	        key = (row['chrom'], row['strand']); group = self.groups.get(key, [])
   147	        result = dict(status='ok' if group else 'not_available', evidence_class='derived' if group else 'not_available',
   148	                      anchor='footprint_midpoint', donor_distance=None, acceptor_distance=None,
   149	                      donor_locus=None, acceptor_locus=None, region_class='not_available')
   150	        mid = (row['start1']+row['end1'])/2
   151	        for kind in ('donor','acceptor'):
   152	            boundaries = self.boundaries.get((key,kind), [])
   153	            i = bisect_left(boundaries, (mid, ''))
   154	            options = boundaries[max(0,i-1):i+1]
   155	            if options:
   156	                pos, lid = min(options, key=lambda x:(abs(x[0]-mid),x))
   157	                result[kind+'_distance'] = (mid-pos)*(1 if row['strand']=='+' else -1)
   158	                result[kind+'_locus'] = lid
   159	        local=self.overlapping(row)
   160	        overlaps = [l for l in local if l['start1']+100 <= row['end1'] and l['end1']-100 >= row['start1']]
   161	        if overlaps:
   162	            result['region_class'] = ('exonic' if any(l['start1']+100 <= row['start1'] and row['end1'] <= l['end1']-100 for l in overlaps)
   163	                                      else 'exon_intron_spanning')
   164	        elif local:
   165	            result['region_class'] = 'intronic_flank'
   166	        elif group: result['region_class'] = 'outside_curated_exons'
   167	        return result
   168	
   169	
   170	def geometry(row, loci):
   171	    return GeometryIndex(loci).annotate(row)
