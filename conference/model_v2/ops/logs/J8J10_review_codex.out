   233	class FeatureIndex:
   234	    """Single writer; transactional per-shard resume. No directory discovery."""
   235	    def __init__(self,path,max_bytes=20*1024**3):
   236	        self.path=safe_path(path); self.path.parent.mkdir(parents=True,exist_ok=True)
   237	        self.db=sqlite3.connect(self.path); self.max_bytes=max_bytes
   238	        self.db.executescript('''PRAGMA cache_size=-32768; PRAGMA temp_store=FILE;
   239	          CREATE TABLE IF NOT EXISTS inputs(path TEXT PRIMARY KEY, identity TEXT);
   240	          CREATE TABLE IF NOT EXISTS j3(id TEXT PRIMARY KEY,payload TEXT);
   241	          CREATE TABLE IF NOT EXISTS j2(locus TEXT,strand TEXT,u INTEGER,w INTEGER,l INTEGER,first INTEGER,last INTEGER,values_blob BLOB,
   242	            PRIMARY KEY(locus,strand,u,w,l,first));
   243	          CREATE TABLE IF NOT EXISTS j4(id TEXT PRIMARY KEY,chrom TEXT,strand TEXT,start INTEGER,end INTEGER,payload TEXT);
   244	          CREATE INDEX IF NOT EXISTS j4_overlap ON j4(chrom,strand,start,end);''')
   245	    def __enter__(self): return self
   246	    def __exit__(self,*args): self.db.close()
   247	    def identities(self):
   248	        return [json.loads(x[0]) for x in self.db.execute('SELECT identity FROM inputs ORDER BY path')]
   249	    def ingest(self,kind,path,*,config_id=None):
   250	        if kind not in ('j2','j3','j4'): raise ValueError('unknown index kind')
     1	"""J10: descriptive rank robustness and declared-universe perturbation nulls.
     2	
     3	No fitting, labels, outcomes, Vienna calls or GPU inference. Alternative columns
     4	must already be computed. Missing scores remain missing on a fixed candidate set.
     5	The default descriptive composite is the mean of oriented within-candidate-set
     6	percentile ranks: a model assumption, not an efficacy score. Supervised requests
     7	always pass through evaluation_core and are blocked for these unlabeled tables.
     8	"""
     9	from __future__ import annotations
    10	
    11	import argparse
    12	from dataclasses import asdict, dataclass
    13	from itertools import combinations
    14	import json
    15	import math
    16	from pathlib import Path
