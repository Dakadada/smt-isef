conference/model_v2/ops/briefs/j4_gate.json
"""J2: local RNA accessibility (RNAplfold unpaired prob) for loci. proxy-class output.
Usage: j2_fold.py LOCI_TSV FASTA OUT_DIR SHARD NSHARDS
LOCI_TSV cols: locus_id chrom start1 end1 strand   (1-based inclusive)
Read-only tiny fasta slices via .fai. Idempotent: skips shard if .done exists."""
import sys, os, json, hashlib, itertools
import RNA, pyarrow as pa, pyarrow.parquet as pq
COMP = str.maketrans("ACGTacgtN", "TGCAtgcaN")
def fai(path):
    d = {}
    for l in open(path + ".fai"):
        n, ln, off, bl, bw = l.split()[:5]; d[n] = (int(ln), int(off), int(bl), int(bw))
    return d
def fetch(fa, idx, chrom, s, e):
    ln, off, bl, bw = idx[chrom]
    assert 1 <= s <= e <= ln
    a, b = s - 1, e
    start = off + a // bl * bw + a % bl
    end = off + (b - 1) // bl * bw + (b - 1) % bl + 1
    with open(fa, "rb") as f:
        f.seek(start); raw = f.read(end - start)
    return raw.replace(b"\n", b"").decode().upper()
def main(loci, fa, out, shard, n, windows=((80, 40), (120, 60), (200, 100)), ulens=(8, 12, 18)):
    os.makedirs(out, exist_ok=True)
    done = f"{out}/j2_shard{shard:04d}.done"
    if os.path.exists(done): print("skip", done); return
    idx = fai(fa); rows = []
    recs = [l.split("\t") for l in open(loci).read().splitlines() if l and not l.startswith("#")]
    for i, (lid, chrom, s, e, st) in enumerate(recs):
        if i % n != shard: continue
        seq = fetch(fa, idx, chrom, int(s), int(e))
        if st == "-": seq = seq.translate(COMP)[::-1]
        rna = seq.replace("T", "U")
        for (W, L), u in itertools.product(windows, ulens):
            if W > len(rna): continue
            # RNAplfold: unpaired prob of u-mers ending at each position, 5'->3' transcript orientation
            p = RNA.pfl_fold_up(rna, u, W, L)
            for pos in range(1, len(rna) + 1):
                v = p[pos][u] if pos < len(p) and u < len(p[pos]) else float("nan")
                rows.append((lid, st, pos, W, L, u, v))
    cols = list(zip(*rows)) if rows else [[]] * 7
    t = pa.table(dict(zip(["locus_id","strand","pos_end_1b_transcript","W","L","u","p_unpaired"], cols)))
    t = t.replace_schema_metadata({"evidence_class": "proxy", "tool": "ViennaRNA " + RNA.__version__, "method": "RNAplfold pfl_fold_up", "chemistry": "unmodified RNA (model_assumption)"})
    tmp = f"{out}/j2_shard{shard:04d}.parquet.tmp"; fin = tmp[:-4]
    pq.write_table(t, tmp); os.replace(tmp, fin)
    h = hashlib.sha256(open(fin, "rb").read()).hexdigest()
    json.dump({"rows": t.num_rows, "sha256": h, "loci": loci, "fasta": fa}, open(done + ".tmp", "w")); os.replace(done + ".tmp", done)
    print("done", fin, t.num_rows, h)
if __name__ == "__main__":
    a = sys.argv; main(a[1], a[2], a[3], int(a[4]), int(a[5]))


# ------------------------------------------------------------------ forbidden sources
_FORBIDDEN_PATTERNS: Tuple[Tuple[str, "re.Pattern[str]"], ...] = (
    ("july_exon7_outcome_workbook", re.compile(
        r"smn2[\W_]*exon[\W_]*7[\W_]*7[\W_]*27[\W_]*28[\W_]*complete[\W_]*data", re.I)),
    ("psi25", re.compile(r"(^|/)psi25(?![A-Za-z0-9])", re.I)),
    ("feng_terminal", re.compile(r"(^|/)feng/+terminal(?![A-Za-z0-9])", re.I)),
)


def _normalized_source_forms(raw: str) -> set[str]:
    forms = {raw}
    current = raw
    for _ in range(16):
        normalized = unicodedata.normalize("NFKC", unquote(current)).replace("\\", "/")
        forms.add(normalized)
        if normalized == current:
            break
        current = normalized
    else:
        raise ForbiddenSourceError("source normalization did not converge within 16 steps")
    for item in tuple(forms):
        expanded = os.path.expanduser(item.replace("\\", "/"))
        forms.update((os.path.normpath(expanded), os.path.abspath(expanded)))
        try:
            resolved = os.path.realpath(expanded)
            # Symlink targets may themselves use encoded or Unicode names.
            for _ in range(16):
                normalized = unicodedata.normalize("NFKC", unquote(resolved)).replace("\\", "/")
                forms.update((normalized, os.path.normpath(normalized)))
                if normalized == resolved:
                    break
                resolved = normalized
            else:
                raise ForbiddenSourceError("resolved source normalization did not converge")
        except (OSError, ValueError):
            pass
    return forms


def check_source_not_forbidden(path: Any) -> str:
    """Return ``str(path)`` or raise ``ForbiddenSourceError``.

    Checks the literal string, its URL-decoded form, the normalised absolute path
    and the symlink-resolved path. Only path names are inspected; nothing is opened.
    """
    raw = os.fspath(path) if isinstance(path, os.PathLike) else str(path)
    for form in _normalized_source_forms(raw):
        text = form.replace("\\", "/")
        for label, pattern in _FORBIDDEN_PATTERNS:
            if pattern.search(text):
                raise ForbiddenSourceError(
                    f"refused forbidden outcome source ({label}): {raw!r}")
    return raw


def _strings(value: Any) -> List[str]:
    if isinstance(value, str):
        return [value]
    if isinstance(value, os.PathLike):


@dataclass(frozen=True)
class BaselineSpec:
    name: str
    kind: str                                 # permuted_reference | feature_set | undefined
    families: Tuple[FeatureFamily, ...]
    description: str

    @property
    def feature_columns(self) -> Tuple[str, ...]:
        return tuple(c for fam in self.families for c in fam.columns)


# Numeric J9 ``feature_name`` values (long-format ``value_double`` / ``value_int``).
_FAMILIES = (
    FeatureFamily("complementarity", (
        "m1_aso_length", "m1_wc_pairs", "m1_gu_pairs", "m1_mismatch_count", "m1_wc_fraction",
        "m1_n_sites_in_locus_window", "m1_n_exact_sites_in_locus_window"), "derived", "M1"),
    FeatureFamily("duplex", ("m2_duplex_energy_kcal_mol",), "model_assumption", "M2"),
    FeatureFamily("accessibility", ("m3_accessibility_p_unpaired",), "proxy", "M3"),
    FeatureFamily("splice_geometry", (
        "m4_abs_donor_dist_5p_from_last_exonic", "m4_abs_acceptor_dist_3p_from_first_exonic",
        "m4_target_span_nt"), "derived", "M4"),
    FeatureFamily("sequence_ablation_proxy", (
        "m5_raw_model_delta_mean", "m5_raw_model_delta_max"), "proxy", "M5"),
)


def _build_registry() -> Dict[str, BaselineSpec]:
    registry = {"M0": BaselineSpec("M0", "permuted_reference", (),
                                   "seeded permuted / random-order reference; uses no features")}
    for k, fam in enumerate(_FAMILIES, 1):
        registry[fam.introduced_by] = BaselineSpec(
            fam.introduced_by, "feature_set", _FAMILIES[:k],
            f"cumulative J9 baseline: families {[f.name for f in _FAMILIES[:k]]}")
    registry["M6"] = BaselineSpec(
        "M6", "undefined", (), "reserved: no M6 feature family is defined upstream (J9 stops "
        "at M5); register one with register_baseline() before use")
    return registry
        if any(type(x) is not int or x <= 0 for x in (window, span)) or span > window:
            raise ValueError("require 1 <= span <= window")
        self.backend, self.genome = backend, genome
        self.asos = dict(asos if asos is not None else {k: v.sequence_5to3 for k, v in ASOS.items()})
        self.flank, self.window, self.span = flank, window, span
        self.params = dict(version=VERSION, backend=backend.identity, flank=flank, window=window,
                           span=span, asos=self.asos.copy(), implementation_sha256=_sha256(__file__),
                           evidence=dict(complementarity="derived", duplex="model_assumption", accessibility="proxy"))
        self.cache = ChannelCache(cache_path, _digest(self.params))

    def _context(self, row):
        if self.genome is None:
            raise FileNotFoundError("indexed GRCh38 FASTA unavailable; flanks not supplied by J6")
        start, end, strand = row["start1"], row["end1"], row["strand"]
        if (type(start) is not int or type(end) is not int or not 1 <= start <= end or
                strand not in ("+", "-") or end - start + 1 != len(normalize(row["target_sequence"]))):
            raise ValueError("invalid site coordinates/strand/footprint")
        length = self.genome.length(row["chrom"])
        lo, hi = max(1, start - self.flank), min(length, end + self.flank)
        context = normalize(self.genome.fetch(row["chrom"], lo, hi))
        if strand == "-":
            context = context.translate(str.maketrans("ACGU", "UGCA"))[::-1]
        offset = start - lo if strand == "+" else hi - end
        target = normalize(row["target_sequence"])
        if context[offset:offset + len(target)] != target:
            raise ValueError("target does not match strand-oriented GRCh38 reference")
        return context, offset, context[:offset], context[offset + len(target):]

    def score(self, row):
        if row.get("assembly") != ASSEMBLY or row.get("annotation") != ANNOTATION:
            raise ValueError("J3 requires GRCh38 / GENCODE v50; liftover before scoring")
        aso = _attempt(lambda: dict(sequence=normalize(self.asos[row["aso_id"]])))
        target = _attempt(lambda: dict(sequence=normalize(row["target_sequence"])))
        comp = (_attempt(lambda: complementarity(aso["values"]["sequence"], target["values"]["sequence"]))
                if aso["status"] == target["status"] == "ok" else
                aso if aso["status"] != "ok" else target)
        context = _attempt(lambda: dict(zip(("sequence", "offset", "left", "right"), self._context(row))))
        ctx = context["values"]
        key = (cache_key(aso["values"]["sequence"], target["values"]["sequence"], (ctx["left"], ctx["right"]))
               if aso["status"] == target["status"] == context["status"] == "ok" else None)
        results = {"complementarity": comp}
        for channel in ("duplex", "accessibility"):
            dependency = (aso if channel == "duplex" and aso["status"] != "ok" else context)
            if dependency["status"] != "ok":
                results[channel] = dependency
                continue
            cached = self.cache.get(key, channel)
            if cached and cached["status"] == "ok":
                check = _attempt(lambda: _validate_values(channel, cached["values"]))
                if check["status"] != "ok":
                    cached = None
            if cached is not None:
                results[channel] = cached
                continue
            kwargs = (dict(aso=aso["values"]["sequence"], context=ctx["sequence"]) if channel == "duplex" else
                      dict(context=ctx["sequence"], start1=ctx["offset"] + 1,
                           length=len(target["values"]["sequence"]), window=self.window, span=self.span))
            result = _attempt(lambda: _validate_values(channel, self.backend.call(channel, **kwargs)))
            results[channel] = result
            self.cache.put(key, channel, result)
        output = dict(score_cache_key=key, aso_sequence=aso["values"].get("sequence"),
                      target_with_flank=ctx.get("sequence"), footprint_start1_in_context=(ctx["offset"] + 1 if ctx else None),
                      flank_left=ctx.get("left"), flank_right=ctx.get("right"),
                      duplex_model_assumption=ASSUMPTION,
                      duplex_scope="minimum duplex anywhere in target+flank; not footprint constrained",
                      accessibility_method="RNAplfold whole-footprint unpaired probability")
        for channel, result in results.items():
            output[channel + "_status"] = result["status"]
            output[channel + "_reason"] = result["reason"]
            output[channel + "_evidence_class"] = self.params["evidence"][channel]
        for name in ("wc_pairs", "gu_pairs", "mismatch_count", "mismatch_positions_1b"):
            output["complementarity_" + name] = comp["values"].get(name)

