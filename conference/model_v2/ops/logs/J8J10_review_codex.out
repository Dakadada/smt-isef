   173	
   174	def accessibility(row, loci, grids):
   175	    fence(row); hits = []
   176	    for loc in loci:
   177	        if (row['chrom'],row['strand']) != (loc['chrom'],loc['strand']): continue
   178	        if not loc['start1'] <= row['start1'] <= row['end1'] <= loc['end1']: continue
   179	        end = row['end1']-loc['start1']+1 if row['strand']=='+' else loc['end1']-row['start1']+1
   180	        length = row['end1']-row['start1']+1
   181	        for g in grids:
   182	            if (g['locus_id'],g['strand'],g['pos_end_1b_transcript'],g['u']) != (loc['locus_id'],row['strand'],end,length): continue
   183	            value = g.get('p_unpaired'); ok = value is not None and math.isfinite(value) and 0 <= value <= 1
   184	            hits.append(dict(locus_id=loc['locus_id'], W=g['W'], L=g['L'], u=g['u'],
   185	                             value=value if ok else None, status='ok' if ok else 'failed',
   186	                             evidence_class='proxy' if ok else 'not_available'))
   187	    return sorted(hits,key=lambda x:(x['locus_id'],x['W'],x['L'],x['u'])) or [dict(
   188	        value=None,status='not_available',evidence_class='not_available',reason='no exact locus/position/u grid cell; no length substitution')]
   189	
   190	
   191	def atlas_summary(row, atlas):
   192	    fence(row); hits=[]
   193	    for a in atlas:
   194	        if (a['chrom'],a['strand']) != (row['chrom'],row['strand']): continue
   195	        if a['footprint_start'] > row['end1'] or a['footprint_end'] < row['start1']: continue
   196	        exact=(a['footprint_start'],a['footprint_end'])==(row['start1'],row['end1'])
   197	        v=a.get('raw_model_delta')
   198	        ok=a.get('status')=='ok' and a.get('model_evidence') is True and v is not None and math.isfinite(v)
   199	        hits.append({k:a.get(k) for k in ('locus','config_id','site_kind','site_position','tissue','footprint_start','footprint_end')} |
   200	                    dict(value=v if ok else None, status='ok' if ok else 'failed', exact=exact,
   201	                         evidence_class='proxy' if ok else 'not_available'))
   202	    hits.sort(key=lambda a:dumps(a))
   203	    exact=[a for a in hits if a['exact']]; valid=[a['value'] for a in hits if a['status']=='ok']
   204	    exact_ok=bool(exact) and all(a['status']=='ok' for a in exact)
   205	    return dict(status='ok' if valid else ('failed' if hits else 'not_available'),
   206	                evidence_class='proxy' if valid else 'not_available', evidence_label='sequence_ablation_proxy',
   207	                exact_status='ok' if exact_ok else ('failed' if exact else 'not_available'),
   208	                exact_mean=sum(a['value'] for a in exact)/len(exact) if exact_ok else None,
   209	                overlap_mean=sum(valid)/len(valid) if valid else None,
   210	                n_failed=sum(a['status']!='ok' for a in hits), n_overlap=len(hits), cells=hits,
   211	                interpretation='raw N-ablation deltas; overlap is descriptive, not a site-specific prediction')
