   174	def test_fold_variant_refuses_unlabelled_or_undeclared_marker(tmp_path):
   175	    import json
   176	    m=api(); p=tmp_path/'j3.parquet'; p.write_bytes(b'x')
   177	    done=p.with_suffix('.done')
   178	    done.write_text(json.dumps({'rows': 1}))
   179	    with pytest.raises(ValueError, match='lacks explicit fold window'): m.j3_fold_variant(p)
   180	    done.write_text(json.dumps({'params': {'window': 70, 'span': 35}}))
   181	    with pytest.raises(ValueError, match='outside the declared J2 variant set'): m.j3_fold_variant(p)
   182	    done.write_text(json.dumps({'params': {'window': 200, 'span': 100}}))
   183	    assert m.j3_fold_variant(p)=='w200s100'

