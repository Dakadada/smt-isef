    25	MetricBlocked=ec.MetricBlocked
    26	# The fold windows J2 actually computed (jobs/j2_fold.py windows=((80,40),(120,60),(200,100))).
    27	FOLD_VARIANTS=('w80s40','w120s60','w200s100')
    28	
