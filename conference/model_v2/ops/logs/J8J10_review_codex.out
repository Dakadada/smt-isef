    75	def test_stream_join_conservation_missing_failure_evidence_and_idempotence(tmp_path):
    76	    m = api()
    77	    j6 = write(tmp_path/'j6.parquet', [site(), dict(site(), site_id='t', start1=150,end1=153)])
    78	    j3 = write(tmp_path/'j3.parquet', [dict(site(), duplex_status='failed', duplex_energy_kcal_mol=None)])
    79	    loci = tmp_path/'loci.tsv'; loci.write_text('e\tchr1\t10\t230\t+\n')
    80	    with m.FeatureIndex(tmp_path/'index.sqlite') as index:
    81	        index.ingest('j3', j3)
    82	        out = tmp_path/'out.parquet'
    83	        result = m.join_shard(j6, out, index, [loci], batch_size=1)
    84	        rows = pq.read_table(out).to_pylist()
    85	        assert result['rows'] == len(rows) == 2
    86	        assert json.loads(rows[0]['j3_channels'])['duplex_status'] == 'failed'
    87	        assert json.loads(rows[1]['j3_channels'])['status'] == 'not_available'
    88	        assert all(f.metadata.get(b'evidence_class') for f in pq.read_schema(out))
    89	        stamp = out.stat().st_mtime_ns
    90	        assert m.join_shard(j6, out, index, [loci])['rows'] == 2
    91	        assert out.stat().st_mtime_ns == stamp
    92	        assert len(result['inputs']) == 3
    93	        out.write_bytes(b'corrupt')
    94	        assert m.join_shard(j6, out, index, [loci])['rows'] == 2
    95	        loci.write_text('e\tchr1\t11\t231\t+\n')
    96	        with pytest.raises(ValueError, match='changed'):
    97	            m.join_shard(j6, out, index, [loci])
