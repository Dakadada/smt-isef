   213	
   214	def input_identity(path, kind):
   215	    path=safe_path(path); marker=(path.parent.parent/(path.stem+'.done')) if kind=='j4' else path.with_suffix('.done')
   216	    m=json.loads(marker.read_text())
   217	    entry=m.get('ablation',m)
   218	    digest=sha256(path); rows=pq.read_metadata(path).num_rows
   219	    if entry.get('sha256')!=digest or entry.get('rows')!=rows:
   220	        raise ValueError('invalid input commit marker')
   221	    if kind=='j2':
   222	        coordinates=(pq.read_schema(path).metadata or {}).get(b'coordinates',b'')
   223	        if coordinates:
   224	            valid=b'GRCh38; GENCODE v50' in coordinates
   225	        else:
   226	            fasta=str(m.get('fasta',''))
   227	            valid=('/gencode/v50/GRCh38.primary_assembly.genome.fa' in fasta and
   228	                   Path(str(m.get('loci',''))).name in ('j2_loci_phase1.tsv','j2_loci_phase2.tsv'))
   229	        if not valid: raise ValueError('J2 assembly fence requires coordinate metadata or pinned upstream FASTA/loci provenance')
   230	    return dict(path=str(path),sha256=digest,rows=rows,kind=kind,marker_sha256=sha256(marker))
