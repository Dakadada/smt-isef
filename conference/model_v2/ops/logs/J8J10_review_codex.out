    46	@dataclass(frozen=True)
    47	class Setting:
    48	    name: str
    49	    channel: str
    50	    variant_id: str='default'
    51	    higher_is_better: bool=True
    52	    max_mismatch: int | None=None
    53	
    54	    def __post_init__(self):
    55	        if not self.name or not self.channel or not self.variant_id: raise ValueError('setting names required')
    56	        if self.max_mismatch is not None and (type(self.max_mismatch) is not int or self.max_mismatch<0):
    57	            raise ValueError('nonnegative max_mismatch required')
