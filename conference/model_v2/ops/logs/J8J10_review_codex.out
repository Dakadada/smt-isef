    47	def safe_path(path):
    48	    p = Path(check_source_not_forbidden(path)).expanduser().resolve()
    49	    if any(x.lower() in {'wetlab', 'terminal', 'psi25'} for x in p.parts):
    50	        raise ValueError('outcome source forbidden')
    51	    return p
