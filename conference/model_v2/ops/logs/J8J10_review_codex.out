   388	def production_inventory(root,*,bounded=False):
   389	    """Enumerate only names declared by manifests / fixed upstream array sizes."""
   390	    root=safe_path(root)
   391	    manifest=root/'j6_genome_v1/run_manifest.json'
   392	    names=json.loads(manifest.read_text())['expected_shards']
   393	    j6=[root/'j6_genome_v1'/(n+'.parquet') for n in (names[:2] if bounded else names)]
   394	    entries=[('j3',root/'j3_genome_v1'/f'j3_shard{i:04d}_of0256.parquet',None) for i in range(1 if bounded else 256)]
   395	    for phase,count in ((1,32),(2,128)):
   396	        entries += [('j2',root/f'j2_phase{phase}'/f'j2_shard{i:04d}.parquet',None) for i in range(1 if bounded else count)]
   397	    config=root/'j4_configs/j4_configs_manifest.tsv'
   398	    with config.open() as stream:
   399	        rows=csv.DictReader((l.lstrip('#') for l in stream if l.startswith('#config_id') or not l.startswith('#')),delimiter='\t')
   400	        for r in rows:
   401	            if r['status']!='emitted': continue
   402	            cid=r['config_id']; entries.append(('j4',root/'j4_atlas_v1'/cid/'ablation_maps/shard_0.parquet',cid))
   403	            if bounded: break
   404	    return j6,entries,[manifest,config]
   405	
