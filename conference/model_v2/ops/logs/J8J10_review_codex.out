    60	def alternative_scores(rows,settings,candidates):
    61	    """Input wide rows keyed by (candidate_id, variant_id); no variant fallback."""
    62	    if len(candidates)!=len(set(candidates)) or not candidates: raise ValueError('unique nonempty candidates required')
    63	    if len(settings)!=len({s.name for s in settings}): raise ValueError('duplicate settings')
    64	    index={}
    65	    for row in rows:
    66	        key=(row['candidate_id'],row.get('variant_id','default'))
    67	        if key in index: raise ValueError('duplicate candidate/variant row')
    68	        index[key]=row
    69	    result={}
    70	    for setting in settings:
    71	        scores={}
    72	        for candidate in candidates:
    73	            r=index.get((candidate,setting.variant_id),{})
    74	            v=r.get(setting.channel)
    75	            status=r.get(setting.channel+'_status',r.get('status','ok'))
    76	            mm=r.get('mismatch_count')
    77	            eligible=setting.max_mismatch is None or (finite(mm) and mm<=setting.max_mismatch)
    78	            scores[candidate]=(v if setting.higher_is_better else -v) if finite(v) and status=='ok' and eligible else None
    79	        result[setting.name]=scores
    80	    return result
