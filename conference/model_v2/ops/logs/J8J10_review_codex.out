    42	ASSEMBLY, ANNOTATION = 'GRCh38', 'GENCODE v50'
    43	OUTCOME_COLUMNS = {'label', 'label_state', 'outcome', 'psi', 'delta_psi', 'dpsi', 'efficacy', 'potency'}
    44	J3_DROP_COLUMNS = {'target_with_flank', 'flank_left', 'flank_right', 'duplex_structure'}
