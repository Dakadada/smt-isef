    28	def test_alternatives_fixed_candidates_and_direction():
    29	    m=api(); rows=[dict(candidate_id='x',variant_id='w80',wc=3,energy=-4,mismatch_count=0),
    30	                  dict(candidate_id='y',variant_id='w80',wc=1,energy=-2,mismatch_count=2)]
    31	    settings=[m.Setting('wc','wc','w80',True,3),m.Setting('energy','energy','w80',False,3),m.Setting('k0','wc','w80',True,0)]
    32	    scores=m.alternative_scores(rows,settings,['x','y'])
    33	    assert scores['wc']['x'] > scores['wc']['y']
    34	    assert scores['energy']['x'] > scores['energy']['y']
    35	    assert scores['k0']['y'] is None
    36	    with pytest.raises(ValueError): m.alternative_scores(rows+rows,settings,['x','y'])
