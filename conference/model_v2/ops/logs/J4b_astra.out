"""Resolve and validate the feng GPU compute environment.

Pure resolution/inspection: this module emits ``module load`` lines and reports
which GPU libraries are importable in the (separately created) GPU conda env. It
NEVER runs a module, installs a package, or imports torch/openmm itself — every
function here is safe to call from the CPU ``feng-env`` and degrades gracefully
when the GPU env is absent.

Confirmed LMOD modules on this cluster (2026-09-03, read-only ``module avail``):
  cuda:      12.9.1, 13.0.1, 13.1.0
  cudnn:     9.8.0.87-cuda12
  gromacs:   2021.6, 2024.1, 2026.2
  miniforge: 23.11.0-0, 24.3.0-0, 25.11.0-0
No AlphaFold/Rosetta module exists.
"""

from __future__ import annotations

import os
import shutil
import subprocess
from pathlib import Path
from typing import Optional

# --- confirmed-available module versions (allowlists; reject anything else so a
# typo can't silently produce a `module load` line that fails only on the node).
CUDA_VERSIONS = frozenset({"12.9.1", "13.0.1", "13.1.0"})
CUDNN_VERSIONS = frozenset({"9.8.0.87-cuda12"})
GROMACS_VERSIONS = frozenset({"2021.6", "2024.1", "2026.2"})
MINIFORGE_VERSIONS = frozenset({"23.11.0-0", "24.3.0-0", "25.11.0-0"})

# --- pinned known-good default combo. cudnn 9.8 is built for cuda 12, so the
# default cuda is the 12.x line (12.9.1), NOT the 13.x modules — pairing cudnn9.8
# with cuda13 would be an unsupported mix. gromacs 2024.1 is the stable current
# release (2026.2 is newest but 2024.1 is the conservative default).
DEFAULT_CUDA = "12.9.1"
DEFAULT_CUDNN = "9.8.0.87-cuda12"
DEFAULT_GROMACS = "2024.1"
DEFAULT_MINIFORGE = "25.11.0-0"

# --- the GPU conda env path (created by setup_gpu_env.sh, not by this module).
GPU_ENV_PREFIX = "~/orcd/pool/feng-gpu-env"

# --- GPU libraries the deep-splice / MD scorers will need.
GPU_PACKAGES = ("torch", "spliceai", "pangolin", "openmm")


def resolve_modules(
    *,
    cuda: str = DEFAULT_CUDA,
    cudnn: str = DEFAULT_CUDNN,
    gromacs: Optional[str] = DEFAULT_GROMACS,
    miniforge: str = DEFAULT_MINIFORGE,
) -> list[str]:
    """Return the ``module load`` lines for a validated module combo.

    Every requested version must be in its confirmed-available allowlist; an
    unknown version raises ``ValueError`` rather than emitting a line that would
    fail only once the job is on a GPU node. ``gromacs=None`` omits the MD
    module (deep-splice-only jobs don't need it).
    """
    _require("cuda", cuda, CUDA_VERSIONS)
    _require("cudnn", cudnn, CUDNN_VERSIONS)
    _require("miniforge", miniforge, MINIFORGE_VERSIONS)
    _require_cuda_cudnn_compatible(cuda, cudnn)
    lines = [
        f"module load cuda/{cuda}",
        f"module load cudnn/{cudnn}",
        f"module load miniforge/{miniforge}",
    ]
    if gromacs is not None:
        _require("gromacs", gromacs, GROMACS_VERSIONS)
        # gromacs after cuda so its GPU build resolves against the loaded toolkit
        lines.insert(2, f"module load gromacs/{gromacs}")
    return lines


def _require(name: str, value: str, allowed: frozenset[str]) -> None:
    if value not in allowed:
        raise ValueError(
            f"unknown {name} module version {value!r}; "
            f"available: {sorted(allowed)}"
        )


def _cudnn_cuda_major(cudnn: str) -> Optional[str]:
    """The CUDA major a cudnn module is built for, from its ``-cuda<major>`` tag.

    e.g. ``9.8.0.87-cuda12`` -> ``"12"``. Returns None if the module name carries
    no such tag (then no cross-constraint can be enforced).
    """
    marker = "-cuda"
    idx = cudnn.rfind(marker)
    if idx == -1:
        return None
    tag = cudnn[idx + len(marker):]
    # keep only the leading digits (e.g. "12" from "12" or "12-foo")
    digits = ""
    for ch in tag:
        if ch.isdigit():
            digits += ch
        else:
            break
    return digits or None


def _require_cuda_cudnn_compatible(cuda: str, cudnn: str) -> None:
    """A ``-cuda<major>`` cudnn requires a cuda line of the same major.

    Both versions are individually in-allowlist by the time this runs; this
    catches an in-allowlist but mutually incompatible pairing (e.g. cuda 13.x
    with the cuda12-built cudnn) that would otherwise fail only on the node.
    Keyed generically off the cuda major, not a hardcoded pair.
    """
    needed_major = _cudnn_cuda_major(cudnn)
    if needed_major is None:
        return
    cuda_major = cuda.split(".", 1)[0]
    if cuda_major != needed_major:
        raise ValueError(
            f"incompatible module combo: cudnn {cudnn!r} is built for CUDA "
            f"{needed_major}.x but cuda {cuda!r} is a {cuda_major}.x line; "
            f"pick a cuda {needed_major}.x module (available: {sorted(CUDA_VERSIONS)})"
        )


def gpu_env_python(prefix: str = GPU_ENV_PREFIX) -> Path:
    """Expected python interpreter path inside the GPU conda env.

    Path-only; does not check existence (see :func:`check_gpu_env`).
    """
    return Path(os.path.expanduser(prefix)) / "bin" / "python"


def check_gpu_env(
    prefix: str = GPU_ENV_PREFIX,
    *,
    packages: tuple[str, ...] = GPU_PACKAGES,
    timeout_s: float = 120.0,
) -> dict:
    """Structured report on the GPU env: does it exist, which libs import.

    ``timeout_s`` is generous (torch's cold import is ~15-25s and slower under
    node CPU load); a probe that times out is reported False with a ``timeout:``
    error string -- inconclusive, not proof of absence -- so callers can tell a
    slow import from a genuinely missing package. This report is ADVISORY: GPU
    scorers do their real import inside their own worker and treat a genuine
    ImportError there as the authoritative "unavailable", never this probe.

    NEVER raises, NEVER installs. If the env python is absent, every package is
    reported missing. If present, each package is probed by a short subprocess
    ``import`` in that interpreter (isolated from this CPU process). Used to
    gate GPU scorers before they run — a missing env yields a clean
    "unavailable" report, not a crash.
    """
    py = gpu_env_python(prefix)
    report = {
        "prefix": os.path.expanduser(prefix),
        "python": str(py),
        "env_exists": py.exists(),
        "packages": {pkg: False for pkg in packages},
        "available": False,
        "errors": {},
    }
    if not py.exists():
        return report
    for pkg in packages:
        try:
            ok, err = _probe_import(py, pkg, timeout_s)
        except Exception as exc:  # never let a probe break the gating contract
            ok, err = False, f"{type(exc).__name__}: {exc}"
        report["packages"][pkg] = ok
        if err:
            report["errors"][pkg] = err
    report["available"] = all(report["packages"].values())
    return report


def _probe_import(py: Path, module: str, timeout_s: float) -> tuple[bool, str]:
    """Try ``python -c 'import <module>'`` in the GPU env; never raise."""
    try:
        proc = subprocess.run(
            [str(py), "-c", f"import {module}"],
            capture_output=True,
            text=True,
            timeout=timeout_s,
        )
    except (subprocess.TimeoutExpired, OSError) as exc:  # pragma: no cover - env-dependent
        return False, f"{type(exc).__name__}: {exc}"
    if proc.returncode == 0:
        return True, ""
    # Last non-empty line of stderr/stdout, or the exit code if the process said
    # nothing (or only whitespace) — must never IndexError on empty output.
    lines = (proc.stderr or proc.stdout or "").strip().splitlines()
    return False, lines[-1] if lines else f"exit {proc.returncode}"


def slurm_gpu_context() -> dict:
    """Read the current SLURM/GPU context from environment variables (logging).

    Returns a plain dict; empty/None fields when not running under SLURM.
    ``n_gpus`` counts the entries in ``CUDA_VISIBLE_DEVICES``.
    """
    cuda_visible = os.environ.get("CUDA_VISIBLE_DEVICES")
    n_gpus = 0
    if cuda_visible:
        n_gpus = len([d for d in cuda_visible.split(",") if d.strip() != ""])
    return {
        "partition": os.environ.get("SLURM_JOB_PARTITION"),
        "job_id": os.environ.get("SLURM_JOB_ID"),
        "array_job_id": os.environ.get("SLURM_ARRAY_JOB_ID"),
        "array_task_id": os.environ.get("SLURM_ARRAY_TASK_ID"),
        "cuda_visible_devices": cuda_visible,
        "n_gpus": n_gpus,
        "gres": os.environ.get("SLURM_JOB_GRES"),
        "under_slurm": os.environ.get("SLURM_JOB_ID") is not None,
    }


def module_cmd_available() -> bool:
    """Whether an LMOD ``module`` shim / ``lmod`` is reachable (advisory)."""
    return bool(shutil.which("lmod") or os.environ.get("LMOD_CMD"))
"""Preemption-safe checkpoint / requeue helpers for feng GPU jobs.

``mit_preemptable`` (the only partition with real GPU headroom for this user)
can evict a job at any time; SLURM sends ``SIGTERM`` ~60 s ahead when the sbatch
declares ``--signal=B:SIGTERM@60``. These helpers let a long GPU sweep persist
its per-shard progress on a 5-15 min cadence and, on the eviction warning, flush
one final checkpoint and ask SLURM to requeue THIS job so it resumes from the
last checkpoint instead of restarting from scratch.

Serialization is JSON, deliberately: checkpoint state here is shard-progress
bookkeeping (which shards are ``.done``, last-index, timestamps) — plain data.
JSON is human-inspectable, diffable, and carries no arbitrary-code / version
fragility that ``pickle`` would; anything not JSON-serializable does not belong
in a checkpoint. Writes are atomic (tmp in the same dir + ``os.replace``), so a
crash mid-write never corrupts or truncates the existing checkpoint.

No RNG; deterministic given its inputs.
"""

from __future__ import annotations

import json
import os
import signal
import subprocess
import time
from contextlib import contextmanager
from pathlib import Path
from typing import Any, Callable, Iterator, Optional


def save_checkpoint(state: dict, path: os.PathLike | str) -> Path:
    """Atomically write ``state`` (JSON) to ``path``.

    Writes to a sibling temp file then ``os.replace``s it over the target, so a
    reader never sees a partial file and an existing checkpoint survives a
    failure during serialization. Returns the checkpoint path.
    """
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(f"{path.name}.tmp.{os.getpid()}")
    try:
        with open(tmp, "w", encoding="utf-8") as fh:
            json.dump(state, fh, sort_keys=True, indent=2)
            fh.flush()
            os.fsync(fh.fileno())
        os.replace(tmp, path)
    finally:
        # Never leave a stray tmp file behind if json.dump raised mid-write.
        if tmp.exists():
            try:
                tmp.unlink()
            except OSError:  # pragma: no cover - best-effort cleanup
                pass
    return path


def load_checkpoint(path: os.PathLike | str) -> Optional[dict]:
    """Load a checkpoint, or ``None`` if it does not exist.

    A present-but-corrupt checkpoint raises ``json.JSONDecodeError`` (a real
    problem the caller must see) rather than being silently treated as absent.
    """
    path = Path(path)
    if not path.exists():
        return None
    with open(path, "r", encoding="utf-8") as fh:
        return json.load(fh)


def should_checkpoint(
    last_checkpoint_ts: Optional[float],
    interval_s: float,
    *,
    now: Optional[float] = None,
) -> bool:
    """Cadence gate: True if ``interval_s`` has elapsed since the last flush.

    ``last_checkpoint_ts=None`` (never checkpointed) returns True so the first
    checkpoint fires promptly. ``now`` is injectable for deterministic tests.
    """
    if interval_s <= 0:
        raise ValueError(f"interval_s must be positive, got {interval_s}")
    if last_checkpoint_ts is None:
        return True
    current = time.time() if now is None else now
    return (current - last_checkpoint_ts) >= interval_s


def requeue_self(*, job_id: Optional[str] = None, dry_run: bool = False) -> bool:
    """Ask SLURM to requeue the current job so it resumes after preemption.

    Resolves the job id from ``SLURM_JOB_ID`` when not given. Returns True if a
    requeue was issued (or would be, under ``dry_run``), False when there is no
    job id (e.g. running outside SLURM) or the ``scontrol`` call fails. Never
    raises — a failed requeue must not mask the checkpoint that preceded it.
    """
    jid = job_id or os.environ.get("SLURM_JOB_ID")
    if not jid:
        return False
    if dry_run:
        return True
    try:
        subprocess.run(["scontrol", "requeue", jid], check=True,
                       capture_output=True, text=True)
        return True
    except (subprocess.CalledProcessError, OSError):
        return False


@contextmanager
def checkpoint_on_signal(
    on_signal: Callable[[int], Any],
    *,
    signals: tuple[int, ...] = (signal.SIGTERM, signal.SIGUSR1),
    requeue: bool = True,
    exit_after: bool = True,
) -> Iterator[None]:
    """Install handlers that flush a checkpoint on the preemption warning.

    On any of ``signals`` (default SIGTERM + SIGUSR1, matching
    ``--signal=B:SIGTERM@60``), ``on_signal(signum)`` is called — the caller's
    final-flush callback — then, if ``requeue``, :func:`requeue_self` is invoked
    and (if ``exit_after``) the process exits 0 so SLURM's requeue takes effect
    cleanly. Prior handlers are restored on exit. Must be entered from the main
    thread (Python signal constraint).

    Under the ``gpu_preemptable.sbatch`` template, ``B:SIGTERM`` reaches only the
    batch shell, whose trap forwards SIGTERM to this payload and owns the SINGLE
    ``scontrol requeue``. In that wiring pass ``requeue=False`` here (flush-only)
    so requeue does not double-fire; ``exit_after=True`` still lets the payload
    exit cleanly once its final checkpoint is written.
    """
    previous: dict[int, Any] = {}

    def _handler(signum, _frame):
        failure: BaseException | None = None
        try:
            on_signal(signum)
        except BaseException as exc:
            failure = exc
        # Never resume from stale state: requeue is attempted only after the
        # final checkpoint callback completed successfully.
        if failure is None and requeue and not requeue_self():
            failure = RuntimeError("checkpoint succeeded but SLURM requeue failed")
        if exit_after:
            os._exit(1 if failure is not None else 0)
        if failure is not None:
            raise failure

    try:
        for sig in signals:
            previous[sig] = signal.signal(sig, _handler)
        yield
    finally:
        for sig, prev in previous.items():
            try:
                signal.signal(sig, prev)
            except (OSError, ValueError, TypeError):  # pragma: no cover
                pass
#!/usr/bin/env bash
# =============================================================================
# TEMPLATE — shared feng GPU preemptable sbatch. NOT a runnable job as-is.
#
# Copy this file, then fill every __PLACEHOLDER__ for your arm's payload:
#   __JOB_NAME__     e.g. feng-armE-md
#   __ARRAY_RANGE__  e.g. 1-15%2   (one shard per mer; %2 stays under any cap)
#   __WALLTIME__     e.g. 12:00:00 (<= 2-00:00:00 on mit_preemptable)
#   __PAYLOAD_CMD__  the per-shard GPU command (see the payload block below)
#
# Design (mirrors feng/scripts/armc_scan.sbatch + bench_intarna_scores.sbatch):
#   * mit_preemptable + --requeue + --signal=B:SIGTERM@60 : evictable partition
#     with real GPU headroom; SLURM warns ~60s before eviction.
#   * per-shard .done + skip-if-exists + atomic mv : idempotent across requeues.
#   * checkpoint/requeue trap wired to feng.gpu.checkpoint : a preempted shard
#     flushes its checkpoint and requeues, resuming instead of restarting.
#   * GPU conda env at ~/orcd/pool/feng-gpu-env (created by setup_gpu_env.sh).
#
# GPU partition facts (2026-09-03): mit_normal_gpu = 6h, QOS cap 2 GPU/user;
# mit_preemptable = 2-day, effectively unlimited GPU but REQUIRES this
# checkpoint+requeue discipline. Heavy sweeps -> this template (preemptable).
# =============================================================================
#SBATCH --job-name=__JOB_NAME__
#SBATCH --account=mit_general
#SBATCH --partition=mit_preemptable
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=4
#SBATCH --mem=32G
#SBATCH --time=__WALLTIME__
#SBATCH --requeue
#SBATCH --signal=B:SIGTERM@60
#SBATCH --array=__ARRAY_RANGE__
#SBATCH --output=feng/logs/%x-%A_%a.out
#SBATCH --error=feng/logs/%x-%A_%a.err

set -euo pipefail

# --- resolved module combo (keep in sync with feng.gpu.env.resolve_modules) ---
module load cuda/12.9.1
module load cudnn/9.8.0.87-cuda12
module load gromacs/2024.1          # drop for deep-splice-only (no MD) jobs
module load miniforge/25.11.0-0

# --- activate the GPU compute env (NOT the CPU feng-env) ----------------------
GPU_ENV_PREFIX="${FENG_GPU_ENV_PREFIX:-${HOME}/orcd/pool/feng-gpu-env}"
if [[ ! -d "${GPU_ENV_PREFIX}" ]]; then
    echo "ERROR: GPU env missing: ${GPU_ENV_PREFIX}" >&2
    echo "       create it once via feng/scripts/setup_gpu_env.sh (review first)" >&2
    exit 1
fi
CONDA_BASE="$(conda info --base)"
# shellcheck disable=SC1091
source "${CONDA_BASE}/etc/profile.d/conda.sh"
conda activate "${GPU_ENV_PREFIX}"

SUBMIT_DIR="${SLURM_SUBMIT_DIR:-$PWD}"
PYTHON_BIN="${GPU_ENV_PREFIX}/bin/python"
export PYTHONPATH="${SUBMIT_DIR}/feng/src:${PYTHONPATH:-}"

# --- self-heal SCRATCH: batch env may not inherit it; the ~/orcd/scratch
#     symlink is the authoritative resolver. The :? guard below still fires if
#     even the symlink is gone, so a genuinely missing scratch never runs.
: "${SCRATCH:=$(readlink -f "${HOME}/orcd/scratch" 2>/dev/null || true)}"
export SCRATCH

# --- output layout: per-shard result + sentinel + checkpoint ------------------
TASK="${SLURM_ARRAY_TASK_ID:?ERROR: run me as a SLURM array job}"
OUT_DIR="${FENG_GPU_OUT_DIR:-${SCRATCH:?SCRATCH is required}/feng/__JOB_NAME__}"
mkdir -p "${OUT_DIR}" feng/logs
OUT="${OUT_DIR}/shard_${TASK}.parquet"
DONE="${OUT_DIR}/shard_${TASK}.done"
CKPT="${OUT_DIR}/shard_${TASK}.ckpt.json"

# --- idempotent skip: a completed shard is never recomputed (requeue-safe) -----
if [[ -s "${OUT}" && -f "${DONE}" ]]; then
    echo "shard ${TASK} already done; skipping"
    exit 0
fi

# --- preemption trap: SLURM's --signal=B:SIGTERM@60 delivers to THIS batch shell
# ONLY (the `B:` prefix), never to the python payload. So the trap must FORWARD
# the signal to the payload child, WAIT for it to flush its final checkpoint
# within the ~60s grace, and THEN requeue exactly once. The bash trap is the
# SOLE requeue owner: the payload's checkpoint_on_signal MUST use requeue=False
# (flush-only) so requeue does not double-fire.
#
# The payload is responsible for: (1) reading ${CKPT} on start and resuming/
# skipping finished work; (2) writing ${CKPT} on the feng.gpu.checkpoint
# should_checkpoint cadence; (3) installing feng.gpu.checkpoint.checkpoint_on_
# signal(..., requeue=False) so a forwarded SIGTERM flushes one final checkpoint.
PAYLOAD_PID=""
requeue_handler() {
    echo "caught eviction signal; forwarding to payload ${PAYLOAD_PID:-none} to flush" >&2
    if [[ -n "${PAYLOAD_PID}" ]]; then
        kill -TERM "${PAYLOAD_PID}" 2>/dev/null || true
        # bounded by SLURM's grace window; wait for the child's final flush+exit
        if ! wait "${PAYLOAD_PID}"; then
            echo "ERROR: payload failed while handling checkpoint signal" >&2
            exit 1
        fi
    fi
    echo "requeuing job ${SLURM_JOB_ID:-unknown} (single requeue owner: sbatch trap)" >&2
    if [[ -z "${SLURM_JOB_ID:-}" ]] || ! scontrol requeue "${SLURM_JOB_ID}"; then
        echo "ERROR: checkpoint saved but requeue failed" >&2
        exit 1
    fi
    exit 0
}
trap requeue_handler SIGTERM SIGUSR1

# --- payload -----------------------------------------------------------------
# Write results to a temp file and atomically mv into place so a preemption
# mid-write never leaves a half-written ${OUT} that the skip check would trust.
# The partial is keyed on the STABLE array task id (NOT ${SLURM_JOB_ID}, which
# changes every requeue and would leak orphaned .partial.<oldid> files); clear
# any stale partial from a prior preempted attempt before writing.
TMP_OUT="${OUT}.partial.${TASK}"
rm -f "${TMP_OUT}"
echo "shard ${TASK}: starting payload -> ${OUT} (ckpt ${CKPT})"

# __PAYLOAD_CMD__ — replace with the arm's GPU scorer, e.g.:
#   "${PYTHON_BIN}" -m feng.titration.gpu_md \
#       --shard "${TASK}" --checkpoint "${CKPT}" --out "${TMP_OUT}"
# The module MUST: (1) load ${CKPT} if present and resume; (2) checkpoint on the
# feng.gpu.checkpoint cadence; (3) install checkpoint_on_signal(requeue=False)
# so a forwarded SIGTERM flushes a final checkpoint; (4) write ${TMP_OUT}.
# RUN IT IN THE BACKGROUND and `wait`, so the trap above can forward the signal
# to it — a foreground payload would never see the forwarded SIGTERM:
#
#   "${PYTHON_BIN}" -m __PAYLOAD_CMD__ \
#       --shard "${TASK}" --checkpoint "${CKPT}" --out "${TMP_OUT}" &
#   PAYLOAD_PID=$!
#   wait "${PAYLOAD_PID}"
echo "ERROR: __PAYLOAD_CMD__ not filled in — this is a template, not a live job" >&2
exit 2

# --- commit: atomic publish + sentinel (unreachable until payload filled) -----
mv -f "${TMP_OUT}" "${OUT}"
touch "${DONE}"
trap - SIGTERM SIGUSR1
echo "shard ${TASK}: done -> ${OUT}"
