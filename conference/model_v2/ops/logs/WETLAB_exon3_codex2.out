index 0000000000000000000000000000000000000000..29f259edf69725c9d18496eb9c2ad51b6a559838
--- /dev/null
+++ b/conference/model_v2/wetlab/README.md
@@ -0,0 +1,111 @@
+# Exon-3 exploratory workbook audit
+
+Source: user-supplied `SMN2_Exon3_Complete_Data.xlsx`, received date recorded in
+[`../ops/WETLAB_MANIFEST.json`](../ops/WETLAB_MANIFEST.json). The source is opened
+read-only and never saved. Exon-7 data, computational features, model training,
+tuning, p-values, AUC, and prospective claims are excluded.
+
+The workbook reports human SMN2Sup super-minigene RT-PCR/PAGE densitometry,
+18-mer ASOs at 5 nM, and one measurement per ASO. These are **observed workbook
+statements**, not independently established experimental facts. Raw exports are
+the workbook's transcriptions of PDFs; original PDFs/images were not supplied
+for this audit. Workbook creation time is not the experiment or receipt date.
+
+Reproduce using:
+
+```bash
+MPLCONFIGDIR=/tmp/wetlab-exon3-mpl /home/dashii/orcd/pool/feng-env/bin/python \
+  conference/model_v2/wetlab/exon3_parse.py \
+  /home/dashii/smt-isef/conference/model_v2/data/wetlab/SMN2_Exon3_Complete_Data.xlsx \
+  --output /home/dashii/orcd/scratch/feng/model_v2/wetlab_exon3/
+```
+
+**Execution deviation:** the requested scratch directory could not be created
+(`Read-only file system`). This session wrote the artifacts to the ignored
+[`outputs/`](outputs/) directory instead. The same command with
+`--output conference/model_v2/wetlab/outputs` reproduces the actual location.
+No commits, Slurm submissions, or changes to running jobs were made.
+
+Artifacts are `audit.json` (every nonempty source cell, metadata, raw counts,
+source SHA256, evidence schema, audit and confirmation list), `positional.tsv`,
+`psi_audit.tsv`, and `positional.png`/`.svg`. TSV blanks mean null/undefined,
+never zero; consult status columns and the JSON evidence schema. Figures plot
+the same evidence-classed table values; horizontal segments show labeled target
+intervals, not uncertainty intervals. Controls with undefined fractions are
+omitted. The schema assigns every table column an evidence class; all cells and
+metadata retain their workbook source. MW values are proxies, not verified bp.
+
+For each gel/lane, Band 1 and Band 2 volumes are independently grouped from raw
+rows; ladder rows are inventoried but excluded from calculation. Both bands must
+have finite positive volumes to calculate `100*I/(I+E)`. Missing, zero, negative,
+or nonnumeric bands yield null, never an imputed endpoint. Sample band duplicates,
+unknown band numbers and unmatched lane sets fail closed. A restricted arithmetic
+reader evaluates workbook PSI references separately and compares formulas and
+caches with the raw result (tolerance 0.000001 percentage points); exported
+3-decimal ratios use 0.0005 pp rounding tolerance. Unsupported formulas are
+reported, never executed. The source formulas/caches are preserved verbatim.
+
+The two control lanes have no Band 2 export row. The workbook states that export
+completeness was confirmed and uses zero, producing 100% PSI. Completeness does
+not establish zero skipped transcript. This audit preserves the workbook's
+100% values as workbook-only values and leaves both independent fractions null.
+For the 11 ASOs with both bands reported, all 22 PSI cells (Quantification and
+Summary) match independent recomputation, and their cached values agree. All
+26 PSI caches, including the two controls in both sheets, match their formulas.
+The 11 ASO exported Band 1 ratios agree within rounding tolerance.
+
+Exploratory values below are **derived conditional signal fractions**, assuming
+the supplied Band 1=inclusion/Band 2=skipping assignments; they are not validated
+transcript-molecule inclusion estimates. ASO positions and gel labels are
+**observed, unverified workbook annotations**. No control-normalized deltas are
+estimated; gel 7-9 has no on-gel controls.
+
+| ASO | Gel | Labeled exon-3 nt interval | Conditional signal fraction (%) |
+| --- | --- | --- | ---: |
+| A | 7-7 | 2–19 | 60.647 |
+| B | 7-7 | 16–33 | 59.986 |
+| C | 7-7 | 30–47 | 58.565 |
+| D | 7-7 | 43–60 | 43.952 |
+| E | 7-7 | 57–74 | 37.294 |
+| F | 7-9 | 71–88 | 52.463 |
+| G | 7-9 | 87–104 | 8.024 |
+| H | 7-9 | 103–120 | 10.469 |
+| I | 7-9 | 119–136 | 96.436 |
+| J | 7-9 | 135–152 | 41.622 |
+| K | 7-9 | 151–168 | 41.776 |
+
+All 11 labeled intervals have an internally consistent inclusive length of 18;
+that arithmetic does not verify their sequence, strand, or coordinate origin.
+Band 1 migrates more slowly and has a larger reported MW than Band 2 in all
+11 pairs, consistent with the supplied size order but insufficient to establish
+isoform identity. Exported MW proxies range from 547.923–569.977 (Band 1) and
+285.788–294.360 (Band 2) on 7-7, versus 587.008–609.070 and 322.032–338.495 on
+7-9. Pair separations range from 260.200–277.344 across both gels. These are
+**derived ranges of unverified sizing proxies**: both different product lengths
+and cross-gel calibration shifts require investigation. Primer-derived expected
+sizes are null because neither primer nor construct sequences are present.
+No fragment-length correction is applied; integrated signal fractions can differ
+from molecular fractions when products have different lengths.
+
+`needs_human_confirmation` in the JSON and manifest lists the unresolved items:
+ASO sequences/orientation/chemistry, construct/version/exon origin, primer binding
+sites/expected products, band identities, size shifts, original images/PDFs,
+detection limits, experimental-unit lineage and biological/technical replication,
+gel 7-9 controls, and coordinate compatibility. Biological and technical replicate
+IDs remain separate null fields. Gel/lane identifiers identify measurements only;
+they are not assigned either kind of replicate. No mean, SD or error bars are
+justified by the workbook's reported n=1.
+
+Computational comparison: **not comparable**. The assay is reported as a
+super-minigene, and construct-to-genome coordinates, assembly, sequence and
+strand are unverified. No feature join was attempted.
+
+Follow-up validation: obtain the complete construct and ordered ASO/primer
+sequences; align and verify all binding sites and expected amplicons; confirm
+products with junction sequencing and size anchors; inspect original gel images
+for background, saturation and detection thresholds; resolve size shifts; repeat
+ASOs with independent biological samples and separately identified technical
+repeats, randomized gel placement and matched controls on every gel. Establish
+assay linearity and a defensible length-correction protocol before quantitative
+transcript PSI interpretation. None of these recommendations retroactively
+validate the present measurements.
diff --git a/conference/model_v2/wetlab/exon3_parse.py b/conference/model_v2/wetlab/exon3_parse.py
new file mode 100644
index 0000000000000000000000000000000000000000..ba8d73a0e80b857f24ab48758fe5d356cac02abd
--- /dev/null
+++ b/conference/model_v2/wetlab/exon3_parse.py
@@ -0,0 +1,319 @@
+"""Read-only, exon-3-specific workbook audit. No inference of missing bands.
+
+All signal fractions are conditional on the workbook's unverified band roles.
+Run with the feng-env interpreter; see README.md for the command.
+"""
+from __future__ import annotations
+
+import argparse
+import ast
+import csv
+import hashlib
+import json
+import math
+import operator
+from pathlib import Path
+import re
+
+from openpyxl import load_workbook
+
+
+def finite_number(value):
+    return isinstance(value, (int, float)) and not isinstance(value, bool) and math.isfinite(value)
+
+
+def signal_fraction(included, excluded):
+    """Undetected/zero bands have no usable quantitative inclusion estimate."""
+    if not all(finite_number(v) and v > 0 for v in (included, excluded)):
+        return None
+    return 100 * included / (included + excluded)
+
+
+class FormulaReader:
+    """Evaluate only arithmetic and cell references; never execute workbook code."""
+
+    reference = re.compile(r"(?:(?:'([^']+)'|([A-Za-z_][A-Za-z_0-9 ]*))!)?(\$?[A-Z]{1,3}\$?\d+)")
+
+    def __init__(self, workbook):
+        self.workbook = workbook
+
+    def value(self, sheet, coordinate, active=None):
+        active = set() if active is None else active
+        key = (sheet, coordinate)
+        if key in active:
+            raise ValueError('cyclic formula reference')
+        value = self.workbook[sheet][coordinate].value
+        if not isinstance(value, str) or not value.startswith('='):
+            if not finite_number(value):
+                raise ValueError(f'non-numeric cell {sheet}!{coordinate}')
+            return value
+        active = active | {key}
+        refs = {}
+
+        def replace(match):
+            name = f'ref_{len(refs)}'
+            refs[name] = self.value(match[1] or match[2] or sheet,
+                                    match[3].replace('$', ''), active)
+            return name
+
+        expression = self.reference.sub(replace, value[1:])
+        binary = {ast.Add: operator.add, ast.Sub: operator.sub,
+                  ast.Mult: operator.mul, ast.Div: operator.truediv}
+
+        def evaluate(node):
+            if isinstance(node, ast.Constant) and finite_number(node.value):
+                return node.value
+            if isinstance(node, ast.Name) and node.id in refs:
+                return refs[node.id]
+            if isinstance(node, ast.BinOp) and type(node.op) in binary:
+                return binary[type(node.op)](evaluate(node.left), evaluate(node.right))
+            if isinstance(node, ast.UnaryOp) and isinstance(node.op, (ast.UAdd, ast.USub)):
+                return evaluate(node.operand) * (-1 if isinstance(node.op, ast.USub) else 1)
+            raise ValueError('unsupported formula syntax')
+
+        answer = evaluate(ast.parse(expression, mode='eval').body)
+        if not finite_number(answer):
+            raise ValueError('nonfinite formula result')
+        return answer
+
+
+def status(expected, actual, tolerance=1e-6):
+    if expected is None:
+        return 'undefined_missing_or_undetected_band'
+    if not finite_number(actual):
+        return 'unavailable'
+    return 'match' if abs(expected - actual) <= tolerance else 'discrepancy'
+
+
+def parse_workbook(path):
+    path = Path(path)
+    # Deliberately refuse the prohibited workbook, even on accidental invocation.
+    if 'exon7' in path.name.lower().replace('_', ''):
+        raise ValueError('exon-7 workbook is excluded')
+    original = path.read_bytes()
+    workbook = load_workbook(path, data_only=False)
+    cached = load_workbook(path, data_only=True)
+    required = {'Read me', 'Summary', 'Quantification', 'Raw 7-7', 'Raw 7-9', 'Methods'}
+    if set(workbook.sheetnames) != required:
+        raise ValueError('unexpected workbook sheets; inspect schema before parsing')
+    reader = FormulaReader(workbook)
+    cells, metadata = [], {}
+    for sheet in workbook:
+        for row in sheet:
+            for cell in row:
+                if cell.value is None:
+                    continue
+                cells.append({'sheet': sheet.title, 'cell': cell.coordinate,
+                              'value': cell.value,
+                              'cached_value': cached[sheet.title][cell.coordinate].value,
+                              'evidence_class': 'observed_workbook_cell'})
+                if sheet.title in ('Read me', 'Methods'):
+                    metadata[f'{sheet.title}!{cell.coordinate}'] = cell.value
+    bands = {}
+    raw_count = {}
+    for sheet_name in ('Raw 7-7', 'Raw 7-9'):
+        sheet = workbook[sheet_name]
+        gel = sheet_name.removeprefix('Raw ')
+        raw_count[sheet_name] = 0
+        for r in range(5, sheet.max_row + 1):
+            lane, band = sheet.cell(r, 1).value, sheet.cell(r, 2).value
+            if lane is None:
+                continue
+            raw_count[sheet_name] += 1
+            if lane == 1:  # retain ladder in inventory, exclude from fractions
+                continue
+            key = (gel, lane)
+            entries = bands.setdefault(key, {})
+            if band in entries:
+                raise ValueError(f'duplicate band {key}, {band}')
+            entries[band] = {'volume': sheet.cell(r, 7).value,
+                             'mw': sheet.cell(r, 6).value,
+                             'rf': sheet.cell(r, 5).value,
+                             'ratio': sheet.cell(r, 8).value,
+                             'label': sheet.cell(r, 3).value,
+                             'source': f'{sheet_name}!A{r}:I{r}'}
+            if band not in (1, 2):
+                raise ValueError(f'unexpected sample band {key}, {band}')
+
+    summary = {}
+    s = workbook['Summary']
+    for r in range(5, s.max_row + 1):
+        if not isinstance(s.cell(r, 1).value, int):
+            continue
+        key = (s.cell(r, 2).value, s.cell(r, 1).value)
+        if key in summary:
+            raise ValueError(f'duplicate summary lane {key}')
+        summary[key] = r
+    q = workbook['Quantification']
+    positional, audit, issues = [], [], []
+    seen = set()
+    for r in range(5, q.max_row + 1):
+        gel, lane, condition = [q.cell(r, c).value for c in (1, 2, 3)]
+        if gel is None:
+            continue
+        key = (gel, lane)
+        if key in seen or key not in bands or key not in summary:
+            raise ValueError(f'duplicate or unmatched quantification lane {key}')
+        seen.add(key)
+        entries = bands[key]
+        inc, exc = entries.get(1, {}), entries.get(2, {})
+        i, e = inc.get('volume'), exc.get('volume')
+        independent = signal_fraction(i, e)
+        sr = summary[key]
+        start, end = s.cell(sr, 4).value, s.cell(sr, 5).value
+        position_match = re.search(r'\((?:nt\s*)?(\d+)-(\d+)\)', str(condition))
+        if position_match and (start, end) != tuple(map(int, position_match.groups())):
+            issues.append(f'position_label_discrepancy: Quantification!C{r} vs Summary!D{sr}:E{sr}')
+        if start is not None and (not isinstance(start, int) or not isinstance(end, int)
+                                  or end - start + 1 != 18):
+            issues.append(f'position_length_discrepancy: Summary!D{sr}:E{sr}')
+        for band in entries.values():
+            # Raw B label omits "nt"; compare parsed interval rather than string.
+            raw_match = re.search(r'\((?:nt\s*)?(\d+)-(\d+)\)', str(band['label']))
+            if raw_match and position_match and raw_match.groups() != position_match.groups():
+                issues.append(f'raw_position_label_discrepancy: {band["source"]}')
+        imw, emw = inc.get('mw'), exc.get('mw')
+        row = dict(gel=gel, lane=lane, condition=condition, nt_start=start, nt_end=end,
+                   target_length_from_labels=None if start is None else end-start+1,
+                   included_volume=i, excluded_volume=e,
+                   included_status='absent_from_export' if not inc else ('reported_positive' if finite_number(i) and i > 0 else 'undetected_or_invalid'),
+                   excluded_status='absent_from_export' if not exc else ('reported_positive' if finite_number(e) and e > 0 else 'undetected_or_invalid'),
+                   signal_fraction_pct=independent,
+                   included_size_proxy=imw, excluded_size_proxy=emw,
+                   band_size_difference_proxy=imw-emw if all(finite_number(v) for v in (imw, emw)) else None,
+                   expected_included_bp=None, expected_excluded_bp=None,
+                   biological_replicate_id=None, technical_replicate_id=None,
+                   experimental_unit_id=f'{gel}:lane{lane}',
+                   band_assignment='supplied_unverified',
+                   differing_product_lengths='needs_human_confirmation',
+                   on_gel_control_available=gel == '7-7',
+                   source_included=inc.get('source'), source_excluded=exc.get('source'),
+                   source_position=f'Summary!D{sr}:E{sr}')
+        positional.append(row)
+        if exc and inc and not (finite_number(inc['rf']) and finite_number(exc['rf'])
+                                and inc['rf'] < exc['rf'] and finite_number(imw)
+                                and finite_number(emw) and imw > emw):
+            issues.append(f'band_order_discrepancy: {gel} lane {lane}')
+        for sheet, coordinate in [('Quantification', f'G{r}'), ('Summary', f'F{sr}')]:
+            try:
+                formula_value = reader.value(sheet, coordinate)
+                formula_error = None
+            except (ValueError, KeyError, SyntaxError, ZeroDivisionError) as error:
+                formula_value, formula_error = None, str(error)
+            cache = cached[sheet][coordinate].value
+            audit.append(dict(gel=gel, lane=lane, source=f'{sheet}!{coordinate}',
+                              formula=workbook[sheet][coordinate].value,
+                              formula_value=formula_value, formula_error=formula_error,
+                              cached_value=cache, independent_value=independent,
+                              independent_status='defined_conditional_signal_fraction' if independent is not None else 'undefined_missing_or_undetected_band',
+                              formula_status=status(independent, formula_value),
+                              cached_status=status(independent, cache) if independent is not None else ('unavailable' if cache is None else 'workbook_only_missing_band'),
+                              cache_vs_formula_status=status(formula_value, cache),
+                              export_ratio=inc.get('ratio'),
+                              export_status=status(independent, inc.get('ratio'), .000500001),
+                              difference_formula_pp=None if independent is None or formula_value is None else formula_value-independent,
+                              difference_cached_pp=None if independent is None or not finite_number(cache) else cache-independent))
+        # Audit quantification volume references independently of their downstream PSI.
+        for col, expected in [('D', i), ('E', e)]:
+            try:
+                actual = reader.value('Quantification', f'{col}{r}')
+            except (ValueError, KeyError, SyntaxError, ZeroDivisionError):
+                actual = None
+            if expected is None:
+                issues.append(f'missing_band_workbook_value: Quantification!{col}{r}={actual}; independent=None')
+            elif status(expected, actual) != 'match':
+                issues.append(f'volume_reference_discrepancy: Quantification!{col}{r}')
+    if seen != set(bands) or seen != set(summary):
+        raise ValueError('raw/quantification/summary lane sets differ')
+
+    schemas = {}
+    observed = {'gel', 'lane', 'condition', 'nt_start', 'nt_end', 'included_volume',
+                'excluded_volume', 'formula', 'cached_value', 'export_ratio'}
+    missing = {'expected_included_bp', 'expected_excluded_bp',
+               'biological_replicate_id', 'technical_replicate_id'}
+    for name, records in [('positional', positional), ('psi_audit', audit)]:
+        schemas[name] = {key: ('missing_needs_human_confirmation' if key in missing else
+                               'proxy_workbook_MW_not_verified_product_size' if 'proxy' in key else
+                               'observed_workbook_unverified' if key in observed else
+                               'source_locator' if key.startswith('source') else
+                               'derived_conditional_on_supplied_band_roles' if key in ('signal_fraction_pct', 'independent_value') else
+                               'derived_audit_or_policy') for key in records[0]} if records else {}
+    needs = [
+        'ASO A-K sequences, chemistry, 5-to-3 orientation and strand; labels alone do not establish binding',
+        'Full SMN2Sup construct sequence/version and exon-3 coordinate origin; verify labeled intervals against sequence',
+        'Primer sequences, binding sites and expected inclusion/skipping amplicon sizes; construct specificity unverified',
+        'Band identities via junction sequencing or product-size anchors; relative migration order is only internally consistent',
+        'Differing product lengths: within-lane size separation and between-gel MW shifts; calibration vs alternate products unresolved',
+        'Original gel images and PDF exports; workbook transcription and background/saturation/linear range unverified',
+        'Detection limits for absent/weak bands; absent export row cannot establish zero transcript',
+        'Biological versus technical experimental units, sample lineage, cell system, timing and replicate IDs; n=1 is workbook-reported only',
+        'Matched on-gel controls for gel 7-9; no cross-gel normalized effect estimated',
+        'Genome/transcript/construct alignment and assembly before any computational-feature comparison',
+    ]
+    return dict(source={'path': str(path.resolve()), 'bytes': len(original),
+                        'sha256': hashlib.sha256(original).hexdigest(),
+                        'sheet_names': workbook.sheetnames,
+                        'evidence_class': 'observed_file_and_derived_hash'},
+                metadata=metadata, cells=cells, raw_row_counts=raw_count,
+                positional=positional, psi_audit=audit, issues=issues,
+                needs_human_confirmation=needs, comparability='not comparable',
+                evidence_schema=schemas,
+                evidence_conventions={
+                    'metadata': 'observed_workbook_statement_not_independent_verification',
+                    'cells': 'observed_workbook_cells_including_formulas_and_cached_values',
+                    'raw_row_counts': 'derived_count_including_ladder',
+                    'issues': 'derived_audit_finding',
+                    'needs_human_confirmation': 'missing_or_unverified_evidence',
+                    'comparability': 'policy_no_verified_system_coordinate_compatibility',
+                    'null': 'missing_or_undefined_never_imputed; see status columns',
+                    'schema': 'column classes apply to every value in JSON and TSV, including nulls',
+                    'figures': 'plots of positional columns; same evidence classes and units'})
+
+
+def write_outputs(result, output):
+    output = Path(output)
+    output.mkdir(parents=True, exist_ok=True)
+    (output/'audit.json').write_text(json.dumps(result, indent=2, allow_nan=False)+'\n')
+    for name in ('positional', 'psi_audit'):
+        with (output/f'{name}.tsv').open('w', newline='') as handle:
+            records = result[name]
+            writer = csv.DictWriter(handle, fieldnames=list(result['evidence_schema'][name]), delimiter='\t')
+            writer.writeheader()
+            writer.writerows(records)
+    import matplotlib
+    matplotlib.use('Agg')
+    import matplotlib.pyplot as plt
+    fig, axes = plt.subplots(1, 2, figsize=(11, 4), sharey=True)
+    for ax, gel in zip(axes, ('7-7', '7-9')):
+        for row in result['positional']:
+            if row['gel'] != gel or row['nt_start'] is None or row['signal_fraction_pct'] is None:
+                continue
+            y = row['signal_fraction_pct']
+            ax.plot([row['nt_start'], row['nt_end']], [y, y], marker='|')
+            ax.annotate(row['condition'].split(' (')[0], ((row['nt_start']+row['nt_end'])/2, y),
+                        xytext=(0, 5), textcoords='offset points', ha='center', fontsize=8)
+        ax.set(xlim=(0, 175), ylim=(0, 105), xlabel='Workbook exon-3 nt labels (unverified)',
+               title=f'Gel {gel}'+(' — no on-gel controls' if gel == '7-9' else ''))
+    axes[0].set_ylabel('Conditional Band 1 signal fraction (%)')
+    fig.suptitle('Exploratory only: supplied band identities; n=1 reported per ASO')
+    fig.text(.5, .01, 'No length correction; missing bands undefined; size shifts unresolved; no prospective/model comparison.',
+             ha='center', fontsize=8)
+    fig.tight_layout(rect=(0, .05, 1, .93))
+    fig.savefig(output/'positional.png', dpi=160)
+    fig.savefig(output/'positional.svg')
+    plt.close(fig)
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('workbook', type=Path)
+    parser.add_argument('--output', type=Path, required=True)
+    args = parser.parse_args()
+    result = parse_workbook(args.workbook)
+    write_outputs(result, args.output)
+    print(json.dumps({'lanes': len(result['positional']), 'PSI_cells_audited': len(result['psi_audit']),
+                      'issues': result['issues'], 'source': result['source']}, indent=2))
+
+
+if __name__ == '__main__':
+    main()
diff --git a/conference/model_v2/wetlab/tests/test_exon3_parse.py b/conference/model_v2/wetlab/tests/test_exon3_parse.py
new file mode 100644
index 0000000000000000000000000000000000000000..69006291491c47fafa64a891f5ac9ff2110a172a
--- /dev/null
+++ b/conference/model_v2/wetlab/tests/test_exon3_parse.py
@@ -0,0 +1,146 @@
+"""Synthetic fixtures only: no laboratory workbook is read by tests."""
+import importlib.util
+from pathlib import Path
+import sys
+
+import pytest
+from openpyxl import Workbook
+
+SPEC = importlib.util.spec_from_file_location(
+    "exon3_parse", Path(__file__).parents[1] / "exon3_parse.py")
+mod = importlib.util.module_from_spec(SPEC)
+sys.modules[SPEC.name] = mod
+SPEC.loader.exec_module(mod)
+
+
+@pytest.mark.parametrize("i,e,expected", [(3, 1, 75), (0, 4, None),
+    (4, 0, None), (None, 4, None), (4, None, None), (0, 0, None),
+    (-1, 4, None), (float('nan'), 4, None), ('-', 4, None)])
+def test_signal_fraction_preserves_undetected_and_invalid(i, e, expected):
+    assert mod.signal_fraction(i, e) == expected
+
+
+def fixture(tmp_path, missing=False, duplicate=False, bad_reference=False):
+    w = Workbook()
+    w.remove(w.active)
+    for name in ['Read me', 'Summary', 'Quantification', 'Raw 7-7', 'Raw 7-9', 'Methods']:
+        w.create_sheet(name)
+    for name in ['Raw 7-7', 'Raw 7-9']:
+        w[name].append(['title'])
+        w[name].cell(4, 1, 'Lane #')
+    raw = w['Raw 7-7']
+    for r, values in enumerate([[5,1,'ASO A (nt 2-19)',1,.4,560,30,75,'-'],
+                              [5,2,'ASO A (nt 2-19)',1,.6,290,10,25,'-']], 5):
+        if missing and r == 6:
+            continue
+        for c, v in enumerate(values, 1): raw.cell(r,c,v)
+    if duplicate:
+        for c in range(1,10): raw.cell(7,c,raw.cell(5,c).value)
+    q = w['Quantification']
+    vals = ['7-7',5,'ASO A (nt 2-19)',"='Raw 7-7'!G5",
+            0 if missing else "='Raw 7-7'!G6", '=D5+E5',
+            '=100*E5/F5' if bad_reference else '=100*D5/F5', '=100*E5/F5']
+    for c,v in enumerate(vals,1): q.cell(5,c,v)
+    s = w['Summary']
+    for c,v in enumerate([5,'7-7','ASO A (nt 2-19)',2,19,'=Quantification!G5'],1):
+        s.cell(5,c,v)
+    w['Methods']['A5']='Endpoint'
+    w['Methods']['B5']='Synthetic metadata'
+    p=tmp_path/'synthetic.xlsx'
+    w.save(p)
+    return p
+
+
+def test_raw_recomputation_and_no_cached_value(tmp_path):
+    result=mod.parse_workbook(fixture(tmp_path))
+    row=result['positional'][0]
+    assert row['signal_fraction_pct']==75
+    assert row['nt_start']==2 and row['nt_end']==19
+    assert row['biological_replicate_id'] is None
+    assert row['technical_replicate_id'] is None
+    assert row['expected_included_bp'] is None
+    assert row['band_size_difference_proxy']==270
+    assert result['metadata']['Methods!B5']=='Synthetic metadata'
+    assert any(a['cached_status']=='unavailable' for a in result['psi_audit'])
+    assert result['comparability']=='not comparable'
+
+
+def test_missing_band_not_workbook_zero(tmp_path):
+    result=mod.parse_workbook(fixture(tmp_path,missing=True))
+    row=result['positional'][0]
+    assert row['excluded_volume'] is None
+    assert row['signal_fraction_pct'] is None
+    assert row['excluded_status']=='absent_from_export'
+    assert result['psi_audit'][0]['formula_value']==100
+    assert result['psi_audit'][0]['independent_status']=='undefined_missing_or_undetected_band'
+
+
+def test_duplicate_band_fails_closed(tmp_path):
+    with pytest.raises(ValueError, match='duplicate'):
+        mod.parse_workbook(fixture(tmp_path,duplicate=True))
+
+
+def test_wrong_formula_detected_independently(tmp_path):
+    result=mod.parse_workbook(fixture(tmp_path,bad_reference=True))
+    assert result['positional'][0]['signal_fraction_pct']==75
+    assert result['psi_audit'][0]['formula_status']=='discrepancy'
+
+
+def test_stale_cache_reported(tmp_path):
+    from zipfile import ZipFile, ZIP_DEFLATED
+    p=fixture(tmp_path)
+    with ZipFile(p) as z: parts={n:z.read(n) for n in z.namelist()}
+    import re
+    parts['xl/worksheets/sheet3.xml'], count = re.subn(
+        rb'(<f>100\*D5/F5</f>)<v(?:\s*/>|></v>)',
+        rb'\1<v>12</v>', parts['xl/worksheets/sheet3.xml'])
+    assert count == 1
+    with ZipFile(p,'w',ZIP_DEFLATED) as z:
+        for n,v in parts.items(): z.writestr(n,v)
+    result=mod.parse_workbook(p)
+    assert result['psi_audit'][0]['cached_value']==12
+    assert result['psi_audit'][0]['cached_status']=='discrepancy'
+
+
+def test_output_schema_covers_every_value_and_source_unchanged(tmp_path):
+    import hashlib
+    p=fixture(tmp_path)
+    before=hashlib.sha256(p.read_bytes()).hexdigest()
+    result=mod.parse_workbook(p)
+    mod.write_outputs(result,tmp_path/'out')
+    assert hashlib.sha256(p.read_bytes()).hexdigest()==before
+    assert set(result['positional'][0])==set(result['evidence_schema']['positional'])
+    assert set(result['psi_audit'][0])==set(result['evidence_schema']['psi_audit'])
+    assert (tmp_path/'out'/'positional.png').stat().st_size>0
+    assert (tmp_path/'out'/'positional.tsv').exists()
+
+
+def test_position_and_migration_conflicts_reported(tmp_path):
+    from openpyxl import load_workbook
+    p=fixture(tmp_path)
+    w=load_workbook(p)
+    w['Summary']['E5']=20
+    w['Raw 7-7']['E6']=.3
+    w.save(p)
+    result=mod.parse_workbook(p)
+    assert any('position_label_discrepancy' in x for x in result['issues'])
+    assert any('position_length_discrepancy' in x for x in result['issues'])
+    assert any('band_order_discrepancy' in x for x in result['issues'])
+
+
+@pytest.mark.parametrize('formula', ['=SUM(D5:E5)', '=G5', '=1/0'])
+def test_unsupported_cyclic_or_divzero_formula_has_no_score(tmp_path, formula):
+    from openpyxl import load_workbook
+    p=fixture(tmp_path)
+    w=load_workbook(p)
+    w['Quantification']['G5']=formula
+    w.save(p)
+    result=mod.parse_workbook(p)
+    assert result['psi_audit'][0]['formula_value'] is None
+    assert result['psi_audit'][0]['formula_error']
+    assert result['positional'][0]['signal_fraction_pct']==75
+
+
+def test_exon7_rejected_before_opening():
+    with pytest.raises(ValueError, match='excluded'):
+        mod.parse_workbook('/does/not/exist/SMN2_Exon7_7_27+28_Complete_Data.xlsx')

