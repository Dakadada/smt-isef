    39	def independent_rows(n, *, seed=7, states=None, n_studies=None, n_chem=None):
    40	    """n rows that share NO group on any axis unless n_studies / n_chem fold them."""
    41	    rng = random.Random(seed)
    42	    out = []
    43	    for i in range(n):
    44	        out.append(row(
    45	            f"o{i:03d}", (states[i] if states else "measured_positive"), seq=rand_seq(rng),
    46	            chem=f"chem{i % n_chem if n_chem else i}", study=f"S{i % n_studies if n_studies else i}",
    47	            start=1000 + 500 * i, end=1017 + 500 * i))
    48	    return out
    49	
