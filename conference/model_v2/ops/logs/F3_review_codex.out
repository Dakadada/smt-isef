   508	def test_pu_quantities_values():
   509	    rows = labelled(4, 0, n_unl=16)
   510	    report = ec.pu_report(rows, list(range(20, 0, -1)), top_k=(2, 4, 20), min_positives=3)
   511	    assert report.get("pu_recall_at_top_k", 2).value == 0.5
   512	    assert report.get("pu_recall_at_top_k", 4).value == 1.0
   513	    assert report.get("pu_recall_at_top_k", 20).value == 1.0
   514	    assert report.get("pu_positive_vs_unlabeled_rank_probability").value == 1.0
   515	    assert report.get("pu_positive_mean_percentile_rank").value == pytest.approx((19.5 + 18.5 + 17.5 + 16.5) / 80)
   516	    assert report.blocked == {"pu_prior_adjusted_rank_probability": "no class_prior stated"}
   517	    assert (report.n_positive_rows, report.n_universe) == (4, 20)
