   279	                            study=f"s{rng.randrange(12)}", start=start, end=start + rng.randrange(10, 40),
   280	                            strand=rng.choice("+-"), chrom=rng.choice(["chr1", "chr5", "chrX"])))
   281	        for mode in ec.MODES:
   282	            for n_folds in (None, 2):
