   520	def test_pu_ties_get_expected_credit_not_optimistic_credit():
   521	    rows = labelled(4, 0, n_unl=16)
   522	    report = ec.pu_report(rows, [1.0] * 20, top_k=(5,), min_positives=3)
   523	    assert report.get("pu_recall_at_top_k", 5).value == pytest.approx(0.25)     # 5/20 by chance
   524	    assert report.get("pu_positive_vs_unlabeled_rank_probability").value == 0.5
   525	    assert report.get("pu_positive_median_percentile_rank").value == 0.5
   526	
   527	
   528	def test_pu_prior_adjustment_is_tagged_model_assumption_and_states_the_prior():
   529	    rows = labelled(4, 0, n_unl=16)
   530	    values = [20, 19, 5, 4] + list(range(18, 2, -1))
   531	    base = ec.pu_report(rows, values, min_positives=3).get("pu_positive_vs_unlabeled_rank_probability").value
   532	    q = ec.pu_report(rows, values, class_prior=0.2, min_positives=3).get("pu_prior_adjusted_rank_probability")
   533	    assert q.evidence_class == "model_assumption"
   534	    assert "class prior of 0.2" in q.pu_assumption and "SCAR" in q.pu_assumption
   535	    assert q.value == pytest.approx((base - 0.1) / 0.8)
   536	    with pytest.raises(ec.SchemaError):
   537	        ec.pu_report(rows, values, class_prior=1.0, min_positives=3)
   538	
   539	
   540	def test_pu_universe_excludes_verified_negatives_censored_and_by_default_unassayed():
   541	    rows = labelled(4, 3, n_unl=6, n_unassayed=5, n_censored=2)
   542	    values = list(range(20))
   543	    report = ec.pu_report(rows, values, min_positives=3)
   544	    assert report.n_universe == 10
   545	    assert report.excluded_by_state == {"verified_negative": 3, "unassayed": 5, "censored": 2}
   546	    wider = ec.pu_report(rows, values, min_positives=3, include_unassayed=True)
   547	    assert wider.n_universe == 15 and "unassayed" in wider.universe_states
