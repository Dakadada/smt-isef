   466	# ------------------------------------------------------------------ splits
   467	@dataclass(frozen=True)
   468	class Fold:
   469	    fold_id: int
   470	    test_idx: Tuple[int, ...]
   471	    train_idx: Tuple[int, ...]
   472	    purged_idx: Tuple[int, ...]              # share a group with test; in neither side
   473	    test_group_ids: Tuple[str, ...]          # held-out primary-axis units
   474	    held_out_groups: Mapping[str, Tuple[str, ...]]  # per axis, every group touching test
   475	
   476	
   477	@dataclass(frozen=True)
   478	class SplitPlan:
   479	    mode: str
   480	    primary_axis: str
   481	    axes: Tuple[str, ...]
   482	    relaxed_axes: Tuple[str, ...]
   483	    seed: int
   484	    n_independent_groups: int                # connected components over all active axes
   485	    observation_ids: Tuple[str, ...]
   486	    group_ids: Mapping[str, Tuple[str, ...]]
   487	    folds: Tuple[Fold, ...]
   488	
   489	
   490	@dataclass(frozen=True)
   491	class NestedSplitPlan:
   492	    outer: SplitPlan
   493	    inner: Tuple[Tuple[Fold, ...], ...]      # inner[k] folds live inside outer.folds[k].train_idx
   494	    inner_mode: str
