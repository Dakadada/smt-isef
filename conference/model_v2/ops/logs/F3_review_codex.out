   848	def pu_report(rows: Any, scores: Any, *, top_k: Sequence[int] = (), class_prior: Optional[float] = None,
   849	              min_positives: int = 10, include_unassayed: bool = False) -> PUReport:
   850	    """PU-valid quantities only. The candidate universe is measured_positive + unlabeled
   851	    (+ unassayed if ``include_unassayed``); verified_negative and censored rows are excluded.
   852	
   853	    ``class_prior`` is a STATED assumption (fraction of true positives among the
   854	    non-positive universe rows), never estimated here; the prior-adjusted statistic is
   855	    only emitted when it is given and is tagged ``model_assumption``.
   856	    """
   857	    table = _as_table(rows)
   858	    s_all = _resolve_scores(table, scores)
   859	    states = [LabelState.UNLABELED.value] + ([LabelState.UNASSAYED.value] if include_unassayed else [])
   860	    pos = [i for i, r in enumerate(table.rows) if r["label_state"] == POSITIVE]
   861	    unl = [i for i, r in enumerate(table.rows) if r["label_state"] in states]
   862	    excluded: Dict[str, int] = {}
   863	    for r in table.rows:
   864	        if r["label_state"] != POSITIVE and r["label_state"] not in states:
   865	            excluded[r["label_state"]] = excluded.get(r["label_state"], 0) + 1
   866	    pos_units = {table.rows[i]["independent_unit_id"] for i in pos}
   867	    if len(pos_units) < min_positives:
   868	        raise MetricBlocked("pu_report", f"{len(pos_units)} independent measured_positive "
   869	                            f"unit(s) ({len(pos)} rows) < minimum {min_positives}")
   870	    if class_prior is not None and not 0.0 <= class_prior < 1.0:
   871	        raise SchemaError("class_prior must be in [0, 1)")
   872	    universe = pos + unl
   873	    s = [s_all[i] for i in universe]
   874	    is_pos = [1] * len(pos) + [0] * len(unl)
   875	    n = len(universe)
   876	    out: List[PUQuantity] = []
   877	    blocked: Dict[str, str] = {}
   878	    universe_note = f"{_PU_BASE}; universe = {n} rows ({' + '.join([POSITIVE] + states)})"
   879	
   880	    order = sorted(range(n), key=lambda i: -s[i])
   881	    for k in top_k:
   882	        if isinstance(k, bool) or not isinstance(k, int) or not 1 <= k <= n:
   883	            raise SchemaError(f"top_k entry {k!r} must be an int in [1, {n}]")
   884	        hits, taken, i = 0.0, 0, 0
   885	        while i < n and taken < k:  # a tie group straddling k gets fractional credit
   886	            j = i
   887	            while j < n and s[order[j]] == s[order[i]]:
   888	                j += 1
   889	            group_pos = sum(is_pos[order[m]] for m in range(i, j))
   890	            hits += group_pos * min(1.0, (k - taken) / (j - i))
   891	            taken += j - i
   892	            i = j
   893	        out.append(PUQuantity(
   894	            "pu_recall_at_top_k", hits / len(pos), "derived",
   895	            f"{universe_note}; recall of KNOWN positives only, ties at the cut-off get "
   896	            "expected credit under random tie-breaking; says nothing about precision", k))
   897	
   898	    ranks = _midranks(s)
   899	    pct = sorted((ranks[i] - 0.5) / n for i in range(len(pos)))
   900	    mid = len(pct) // 2
   901	    median = pct[mid] if len(pct) % 2 else (pct[mid - 1] + pct[mid]) / 2
   902	    note = f"{universe_note}; percentile of mid-rank within the universe (1 = top)"
   903	    out.append(PUQuantity("pu_positive_mean_percentile_rank", sum(pct) / len(pct), "derived", note))
   904	    out.append(PUQuantity("pu_positive_median_percentile_rank", median, "derived", note))
   905	
   906	    if not unl:
   907	        blocked["pu_positive_vs_unlabeled_rank_probability"] = "no unlabeled rows in the universe"
   908	    else:
   909	        prob = _rank_probability(s[:len(pos)], s[len(pos):])
   910	        out.append(PUQuantity(
   911	            "pu_positive_vs_unlabeled_rank_probability", prob, "derived",
   912	            f"{universe_note}; P(positive outranks an unlabeled row) with ties = 1/2; NOT a "
   913	            "ranking statistic against negatives - hidden positives pull it toward 0.5"))
   914	        if class_prior is None:
   915	            blocked["pu_prior_adjusted_rank_probability"] = "no class_prior stated"
   916	        else:
   917	            out.append(PUQuantity(
   918	                "pu_prior_adjusted_rank_probability",
   919	                (prob - class_prior / 2) / (1 - class_prior), "model_assumption",
   920	                f"{universe_note}; assumes labelled positives are selected completely at "
   921	                f"random (SCAR) and a STATED, not estimated, class prior of {class_prior} "
   922	                "among unlabeled rows; may leave [0, 1] if the prior is wrong"))
   923	    return PUReport("positive_unlabeled", tuple(out), len(pos), len(pos_units), n,
   924	                    tuple([POSITIVE] + states), excluded, class_prior, blocked)
