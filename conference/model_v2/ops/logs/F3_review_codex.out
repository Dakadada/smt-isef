   491	def test_pu_mode_never_emits_supervised_metrics():
   492	    rows = labelled(4, 0, n_unl=16)
   493	    report = ec.pu_report(rows, list(range(20, 0, -1)), top_k=(4, 10), class_prior=0.1, min_positives=3)
   494	    names = {q.name for q in report.quantities}
   495	    assert names <= set(ec.PU_QUANTITIES)
   496	    banned = set(ec.SUPERVISED_METRICS) | {"auc", "average_precision", "f1", "roc_auc"}
   497	    assert not {ec.metric_key(n) for n in names} & banned
   498	    assert not any(b in n for n in names for b in ("auprc", "auroc", "fdr", "accuracy", "precision"))
   499	    assert report.mode == "positive_unlabeled"
   500	    for q in report.quantities:
   501	        assert q.evidence_class in ec.EVIDENCE_CLASSES
   502	        assert "never counted as negatives" in q.pu_assumption
   503	    for name in ("auprc", "auroc", "fdr", "accuracy", "precision", "recall"):
   504	        with pytest.raises(ec.MetricBlocked, match="positive-unlabeled mode never emits"):
   505	            ec.compute_metric(name, rows, list(range(20)), mode="pu", policy=ec.MetricPolicy(0, 0))
