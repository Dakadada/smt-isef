   550	def test_pu_blocked_with_too_few_independent_positives_and_bad_k():
   551	    rows = labelled(4, 0, n_unl=6)
   552	    for r in rows[:4]:
   553	        r["independent_unit_id"] = "same_animal"
   554	    with pytest.raises(ec.MetricBlocked, match="1 independent measured_positive"):
   555	        ec.pu_report(rows, list(range(10)), min_positives=3)
   556	    with pytest.raises(ec.SchemaError, match="top_k"):
   557	        ec.pu_report(labelled(4, 0, n_unl=6), list(range(10)), top_k=(11,), min_positives=3)
   558	    only_pos = ec.pu_report(labelled(4, 0), [1, 2, 3, 4], min_positives=3)
   559	    assert "pu_positive_vs_unlabeled_rank_probability" in only_pos.blocked
