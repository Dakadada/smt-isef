  1062	
  1063	def _build_registry() -> Dict[str, BaselineSpec]:
  1064	    registry = {"M0": BaselineSpec("M0", "permuted_reference", (),
  1065	                                   "seeded permuted / random-order reference; uses no features")}
  1066	    for k, fam in enumerate(_FAMILIES, 1):
  1067	        registry[fam.introduced_by] = BaselineSpec(
  1068	            fam.introduced_by, "feature_set", _FAMILIES[:k],
  1069	            f"cumulative J9 baseline: families {[f.name for f in _FAMILIES[:k]]}")
  1070	    registry["M6"] = BaselineSpec(
  1071	        "M6", "undefined", (), "reserved: no M6 feature family is defined upstream (J9 stops "
  1072	        "at M5); register one with register_baseline() before use")
  1073	    return registry
  1074	
  1075	
  1076	BASELINES: Dict[str, BaselineSpec] = _build_registry()
  1077	
  1078	
  1079	def register_baseline(spec: BaselineSpec) -> None:
  1080	    """Define / replace a baseline (e.g. M6 once its feature family is agreed)."""
  1081	    if spec.kind not in ("permuted_reference", "feature_set"):
  1082	        raise SchemaError(f"bad baseline kind {spec.kind!r}")
  1083	    for fam in spec.families:
  1084	        if fam.evidence_class not in EVIDENCE_CLASSES:
  1085	            raise SchemaError(f"bad evidence class {fam.evidence_class!r}")
  1086	    BASELINES[spec.name] = spec
  1087	
  1088	
  1089	def baseline_feature_columns(name: str) -> Tuple[str, ...]:
  1090	    if name not in BASELINES:
  1091	        raise SchemaError(f"unknown baseline {name!r}; known: {sorted(BASELINES)}")
  1092	    spec = BASELINES[name]
  1093	    if spec.kind == "undefined":
  1094	        raise BaselineUndefined(f"{name}: {spec.description}")
  1095	    return spec.feature_columns
