from conference.model_v2 import evaluation_core as e
from conference.model_v2.tests.test_evaluation_core import row, independent_rows, labelled

def show(tag, fn):
    try: print(tag, fn())
    except Exception as x: print(tag, type(x).__name__, str(x)[:180])

# Direct construction and ordinary post-validation mutation skip all evidence checks.
r=labelled(10,10)
for x in r[10:]: del x['negative_evidence']
t=e.ObservationTable(tuple(r))
show('unvalidated_table', lambda: [e.compute_metric(k,t,[1.]*10+[0.]*10,threshold=.5).value for k in ('auprc','auroc','fdr','accuracy')])
t=e.validate_table(labelled(10,0,n_unl=10))
for x in t.rows[10:]: x['label_state']='verified_negative'
show('mutated_validated_table', lambda: e.compute_metric('auroc',t,[1.]*10+[0.]*10).value)
for m in ('auprc','accuracy','fdr','auroc'):
    show('zero_negative_policy_'+m, lambda m=m:e.compute_metric(m,labelled(10,0),[1.]*10,policy=e.MetricPolicy(0,1),threshold=.5).value)
show('nan_negative_policy', lambda:e.compute_metric('accuracy',labelled(10,0),[1.]*10,policy=e.MetricPolicy(float('nan'),1),threshold=.5).value)
# Identical observation clones bypass the independent minimum.
r=[row('p'+str(i),unit='p'+str(i)) for i in range(10)]+[row('n'+str(i),'verified_negative',unit='n'+str(i)) for i in range(10)]
show('cloned_units', lambda:(e.compute_metric('auroc',r,[1.]*10+[0.]*10).n_negative_units, len(set(e.effective_clusters(r)))))
# A known responder-only source is accepted unless the caller configures its identity.
r=labelled(10,10)
for x in r: x['study_id']='holgersen_s4'; x['provenance']={'source':'Holgersen S4'}
show('holgersen_s4_default', lambda:e.compute_metric('auroc',r,[1.]*10+[0.]*10).value)
# Same real unit, no other axis shared.
r=independent_rows(6)
r[1]['independent_unit_id']=r[0]['independent_unit_id']
p=e.make_splits(r,'leave_study_out'); f=p.folds[0]
show('split_shared_unit', lambda:({r[i]['independent_unit_id'] for i in f.test_idx}&{r[i]['independent_unit_id'] for i in f.train_idx},p.n_independent_groups))
n=e.make_nested_splits(r,outer_mode='leave_study_out')
show('nested_outer_shared_unit',lambda:any({r[i]['independent_unit_id'] for i in o.test_idx}&{r[i]['independent_unit_id'] for i in f.train_idx+f.test_idx} for o,inner in zip(n.outer.folds,n.inner) for f in inner))
# Canonical family aliases are not grouped.
r=independent_rows(6);r[0]['chemistry_family']='MOE';r[1]['chemistry_family']=\"2'-MOE\"
p=e.make_splits(r,'leave_study_out'); f=p.folds[0]
show('chem_alias', lambda:(p.group_ids['chemistry'][:2], 1 in f.train_idx,0 in f.test_idx))
# Removal of a sequence bridge changes inner group identity.
r=independent_rows(7)
for i,s in enumerate(('A'*18,'A'*16+'CC','A'*14+'CCCC','G'*18)):
    r[i]['aso_sequence']=s
r[3]['start']=r[1]['start'];r[3]['end']=r[1]['end']
n=e.make_nested_splits(r,outer_mode='leave_study_out')
o=next(f for f in n.outer.folds if 3 in f.test_idx);inner=n.inner[o.fold_id]
show('nested_bridge',lambda:(o.test_idx,o.purged_idx,n.outer.group_ids['sequence'][:4],[(f.test_idx,f.train_idx) for f in inner if (0 in f.test_idx and 2 in f.train_idx) or (2 in f.test_idx and 0 in f.train_idx)]))
# Stale metadata plan remains accepted when rows keep IDs.
r=labelled(6,6);p=e.make_splits(r,'leave_study_out',n_folds=3)
for x in r: x['aso_sequence']=r[0]['aso_sequence']
show('stale_plan',lambda: len(e.run_ablation(r,{},'M0',p,policy=e.MetricPolicy(1,1)).cells))
# One real experimental study is counted as 12 independent CI clusters.
r=independent_rows(12)
for x in r:x['study_id']='same_study'
show('bootstrap_study',lambda:e.cluster_bootstrap_ci(r,lambda idx:sum(idx)/len(idx),n_boot=20).n_clusters)
r=independent_rows(10)
show('bootstrap_nan_point',lambda:e.cluster_bootstrap_ci(r,lambda idx:float('nan') if tuple(idx)==tuple(range(10)) else 1.,n_boot=20))
show('bootstrap_one_draw',lambda:e.cluster_bootstrap_ci(r,lambda idx:sum(idx)/len(idx),n_boot=1))
# PU ablations count excluded rows in the top-k bound.
