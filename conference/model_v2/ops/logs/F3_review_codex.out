   562	# ------------------------------------------------------------------ clustered uncertainty
   563	def mean_score(values):
   564	    return lambda idx: sum(values[i] for i in idx) / len(idx)
   565	
   566	
   567	def test_ci_refused_below_minimum_clusters():
   568	    rows = independent_rows(9)
   569	    with pytest.raises(ec.UncertaintyRefused, match="9 independent cluster"):
   570	        ec.cluster_bootstrap_ci(rows, mean_score(list(range(9))), n_boot=50)
   571	    ci = ec.cluster_bootstrap_ci(independent_rows(10), mean_score(list(range(10))), n_boot=200)
   572	    assert ci.n_clusters == 10 and ci.lower <= ci.point <= ci.upper and ci.evidence_class == "derived"
   573	
   574	
   575	def test_correlated_windows_are_one_cluster_even_with_distinct_unit_ids():
   576	    rows = independent_rows(8)
   577	    for i in range(8):          # 8 more rows overlapping the first window, each its own "unit"
   578	        rows.append(row(f"w{i}", seq=rand_seq(random.Random(900 + i)), chem=f"cw{i}", study=f"sw{i}",
   579	                        start=1002 + i, end=1019 + i))
   580	    assert len(set(r["independent_unit_id"] for r in rows)) == 16

