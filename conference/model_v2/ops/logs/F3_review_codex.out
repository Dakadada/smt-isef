    95	# ------------------------------------------------------------------ forbidden sources
    96	_FORBIDDEN_PATTERNS: Tuple[Tuple[str, "re.Pattern[str]"], ...] = (
    97	    ("july_exon7_outcome_workbook", re.compile(
    98	        r"smn2[\W_]*exon[\W_]*7[\W_]*7[\W_]*27[\W_]*28[\W_]*complete[\W_]*data", re.I)),
    99	    ("psi25", re.compile(r"(^|/)psi25(?![A-Za-z0-9])", re.I)),
   100	    ("feng_terminal", re.compile(r"(^|/)feng/+terminal(?![A-Za-z0-9])", re.I)),
   101	)
