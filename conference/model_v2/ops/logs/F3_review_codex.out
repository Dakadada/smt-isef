   367	def test_splits_are_deterministic_and_order_independent_in_group_ids():
   368	    rows = independent_rows(20, n_studies=10)
   369	    a = ec.make_splits(rows, "leave_study_out", seed=11, n_folds=4)
   370	    b = ec.make_splits(rows, "leave_study_out", seed=11, n_folds=4)
   371	    c = ec.make_splits(rows, "leave_study_out", seed=12, n_folds=4)
   372	    assert a == b
   373	    assert [f.test_idx for f in a.folds] != [f.test_idx for f in c.folds]
   374	    shuffled = list(reversed(rows))
   375	    d = ec.make_splits(shuffled, "leave_study_out", seed=11, n_folds=4)
   376	    as_ids = lambda plan: sorted(sorted(plan.observation_ids[i] for i in f.test_idx) for f in plan.folds)
   377	    assert as_ids(a) == as_ids(d)
   378	    n1 = ec.make_nested_splits(rows, outer_mode="leave_study_out", seed=3, outer_n_folds=5, inner_n_folds=2)
   379	    n2 = ec.make_nested_splits(rows, outer_mode="leave_study_out", seed=3, outer_n_folds=5, inner_n_folds=2)
   380	    assert n1 == n2
