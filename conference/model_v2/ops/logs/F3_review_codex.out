   334	def test_nested_inner_folds_never_see_outer_test_groups():
   335	    rows = independent_rows(15, n_studies=5)
   336	    rows.append(row("dup", seq=rows[0]["aso_sequence"], chem="chemZ", study="S3",
   337	                    start=700000, end=700017))     # links study S0 and S3 through a duplicate
   338	    nested = ec.make_nested_splits(rows, outer_mode="leave_study_out",
   339	                                   inner_mode="leave_one_aso_out", min_outer_groups=3,
   340	                                   min_inner_groups=3)
   341	    plan = nested.outer
   342	    assert_no_straddle(plan)
   343	    assert len(nested.inner) == len(plan.folds)
   344	    for outer, inner in zip(plan.folds, nested.inner):
   345	        barred_rows = set(outer.test_idx) | set(outer.purged_idx)
   346	        assert inner
   347	        for f in inner:
   348	            seen = set(f.test_idx) | set(f.train_idx) | set(f.purged_idx)
   349	            assert seen == set(outer.train_idx)
   350	            assert not seen & barred_rows
   351	            for axis in plan.axes:
   352	                g = plan.group_ids[axis]
   353	                assert not {g[i] for i in seen} & {g[i] for i in outer.test_idx}
   354	                assert not {g[i] for i in f.test_idx} & {g[i] for i in f.train_idx}
