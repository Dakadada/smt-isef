   159	def test_near_identical_and_truncated_sequences_cluster():
   160	    base = "ACGTACGTTTGGCCAAGT"
   161	    one_sub = base[:5] + "T" + base[6:]
   162	    truncated = base[2:16]              # 14-mer inside the 18-mer (edit distance 4)
   163	    far = "GGGGGGCCCCCCAAAAAA"
   164	    rows = [row("a", seq=base), row("b", seq=one_sub), row("c", seq=truncated), row("d", seq=far)]
   165	    g = ec.axis_groups(rows, axes=("sequence",))["sequence"]
   166	    assert g[0] == g[1] == g[2] != g[3]
   167	    strict = ec.GroupingConfig(sequence_threshold=0, containment_is_identical=False)
   168	    g = ec.axis_groups(rows, strict, axes=("sequence",))["sequence"]
   169	    assert len(set(g)) == 4
   170	    hamming = ec.GroupingConfig(sequence_metric="hamming", sequence_threshold=1,
   171	                                containment_is_identical=False)
   172	    g = ec.axis_groups(rows, hamming, axes=("sequence",))["sequence"]
   173	    assert g[0] == g[1] and g[2] not in (g[0], g[3])
