  1048	# Numeric J9 ``feature_name`` values (long-format ``value_double`` / ``value_int``).
  1049	_FAMILIES = (
  1050	    FeatureFamily("complementarity", (
  1051	        "m1_aso_length", "m1_wc_pairs", "m1_gu_pairs", "m1_mismatch_count", "m1_wc_fraction",
  1052	        "m1_n_sites_in_locus_window", "m1_n_exact_sites_in_locus_window"), "derived", "M1"),
  1053	    FeatureFamily("duplex", ("m2_duplex_energy_kcal_mol",), "model_assumption", "M2"),
  1054	    FeatureFamily("accessibility", ("m3_accessibility_p_unpaired",), "proxy", "M3"),
  1055	    FeatureFamily("splice_geometry", (
  1056	        "m4_abs_donor_dist_5p_from_last_exonic", "m4_abs_acceptor_dist_3p_from_first_exonic",
  1057	        "m4_target_span_nt"), "derived", "M4"),
  1058	    FeatureFamily("sequence_ablation_proxy", (
  1059	        "m5_raw_model_delta_mean", "m5_raw_model_delta_max"), "proxy", "M5"),
  1060	)
