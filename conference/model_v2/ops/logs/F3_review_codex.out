   141	# ------------------------------------------------------------------ label states / table
   142	class LabelState(str, Enum):
   143	    MEASURED_POSITIVE = "measured_positive"
   144	    VERIFIED_NEGATIVE = "verified_negative"
   145	    UNLABELED = "unlabeled"
   146	    UNASSAYED = "unassayed"
   147	    CENSORED = "censored"
   148	
   149	    @classmethod
   150	    def parse(cls, value: Any) -> "LabelState":
   151	        if isinstance(value, cls):
   152	            return value
   153	        try:
   154	            return cls(value)
   155	        except ValueError:
   156	            raise SchemaError(
   157	                f"label_state {value!r} not in {[s.value for s in cls]}") from None
   158	
   159	
   160	LABEL_STATES = tuple(s.value for s in LabelState)
   161	POSITIVE = LabelState.MEASURED_POSITIVE.value
   162	NEGATIVE = LabelState.VERIFIED_NEGATIVE.value
   163	REQUIRED_FIELDS = ("observation_id", "label_state", "assay_id", "study_id",
   164	                   "independent_unit_id", "provenance")
   165	RESPONDER_ONLY_KINDS = frozenset({"responder_only", "responders_only", "hits_only",
   166	                                  "positives_only"})
   167	ABSENCE_BASES = frozenset({"absence", "absent", "absent_from_table", "not_listed",
   168	                           "not_reported", "inferred", "assumed"})
   169	BINARY_LABEL_FIELDS = ("binary_label", "label", "y")
   170	
   171	
   172	@dataclass(frozen=True)
   173	class ObservationTable:
   174	    """Validated rows. Build with ``validate_table``; never construct by hand."""
   175	    rows: Tuple[Mapping[str, Any], ...]
   176	
   177	    def __len__(self) -> int:
   178	        return len(self.rows)
   179	
   180	    @property
   181	    def ids(self) -> Tuple[str, ...]:
   182	        return tuple(r["observation_id"] for r in self.rows)
   183	
   184	    def subset(self, indices: Sequence[int]) -> "ObservationTable":
   185	        return ObservationTable(tuple(self.rows[i] for i in indices))
   186	
   187	
   188	def _nonempty(row: Mapping[str, Any], name: str, where: str) -> str:
   189	    value = row.get(name)
   190	    if not isinstance(value, str) or not value.strip():
   191	        raise SchemaError(f"{where}: field {name!r} must be a non-empty string")
   192	    return value
   193	
   194	
   195	def validate_table(rows: Any, *, responder_only_studies: Sequence[str] = ()) -> ObservationTable:
   196	    """Validate observation rows (mappings) and return an ``ObservationTable``.
   197	
   198	    ``responder_only_studies``: study ids whose tables list responders only (e.g. a
   199	    hits-only supplement). No ``verified_negative`` may originate from them, and none
   200	    from a row declaring ``source_table_kind`` in ``RESPONDER_ONLY_KINDS``.
   201	    """
   202	    if isinstance(rows, ObservationTable):
   203	        rows = rows.rows
   204	    responder_only = frozenset(responder_only_studies)
   205	    out: List[Dict[str, Any]] = []
   206	    seen = set()
   207	    for index, row in enumerate(rows):
   208	        where = f"row {index}"
   209	        if not isinstance(row, Mapping):
   210	            raise SchemaError(f"{where}: not a mapping")
   211	        r = dict(row)
   212	        oid = _nonempty(r, "observation_id", where)
   213	        where = f"row {index} ({oid})"
   214	        if oid in seen:
   215	            raise SchemaError(f"{where}: duplicate observation_id")
   216	        seen.add(oid)
   217	        if "label_state" not in r:
   218	            raise SchemaError(f"{where}: missing label_state")
   219	        state = LabelState.parse(r["label_state"])
   220	        r["label_state"] = state.value
   221	        for name in ("assay_id", "study_id", "independent_unit_id"):
   222	            _nonempty(r, name, where)
   223	        prov = r.get("provenance")
   224	        if isinstance(prov, Mapping):
   225	            if not isinstance(prov.get("source"), str) or not prov["source"].strip():
   226	                raise SchemaError(f"{where}: provenance mapping needs a non-empty 'source'")
   227	        elif not isinstance(prov, str) or not prov.strip():
   228	            raise SchemaError(f"{where}: provenance must be a non-empty string or mapping")
   229	        for text in _strings(prov) + _strings(r.get("source_path")):
   230	            check_source_not_forbidden(text)
   231	        if r.get("evidence_class") is not None and r["evidence_class"] not in EVIDENCE_CLASSES:
   232	            raise SchemaError(f"{where}: bad evidence_class {r['evidence_class']!r}")
   233	
   234	        if state is LabelState.VERIFIED_NEGATIVE:
   235	            kind = str(r.get("source_table_kind", "")).strip().lower()
   236	            if kind in RESPONDER_ONLY_KINDS or r["study_id"] in responder_only:
   237	                raise NegativeEvidenceError(
   238	                    f"{where}: verified_negative from a responder-only table; absence "
   239	                    "from a responder list is not a measured negative")
   240	            ne = r.get("negative_evidence")
   241	            if not isinstance(ne, Mapping):
   242	                raise NegativeEvidenceError(
   243	                    f"{where}: verified_negative requires an explicit negative_evidence mapping")
   244	            if ne.get("assayed_and_powered") is not True:
   245	                raise NegativeEvidenceError(
   246	                    f"{where}: negative_evidence.assayed_and_powered must be exactly True")
   247	            limit = ne.get("detection_limit")
   248	            if isinstance(limit, bool) or not isinstance(limit, (int, float)) \
   249	                    or not math.isfinite(limit):
   250	                raise NegativeEvidenceError(
   251	                    f"{where}: negative_evidence.detection_limit must be a finite number")
   252	            if str(ne.get("basis", "")).strip().lower() in ABSENCE_BASES:
   253	                raise NegativeEvidenceError(
   254	                    f"{where}: negative_evidence.basis={ne.get('basis')!r} is absence-inferred")
   255	        for name in BINARY_LABEL_FIELDS:
   256	            value = r.get(name)
   257	            if value is None:
   258	                continue
   259	            if value not in (0, 1):
   260	                raise SchemaError(f"{where}: {name}={value!r} is not binary")
   261	            needed = LabelState.MEASURED_POSITIVE if value == 1 else LabelState.VERIFIED_NEGATIVE
   262	            if state is not needed:
   263	                raise LabelStateError(
   264	                    f"{where}: {name}={int(value)} encodes {needed.value} but label_state is "
   265	                    f"{state.value}; {state.value} is never a "
   266	                    f"{'negative' if value == 0 else 'positive'}")
   267	        out.append(r)
   268	    return ObservationTable(tuple(out))
   269	
   270	
   271	def _as_table(rows: Any) -> ObservationTable:
   272	    return rows if isinstance(rows, ObservationTable) else validate_table(rows)
   273	
   274	
   275	def read_table(path: Any, **kwargs: Any) -> ObservationTable:
   276	    """Read a ``.jsonl`` / ``.json`` observation table, after the forbidden-source guard."""
   277	    name = check_source_not_forbidden(path)
   278	    with open(os.path.expanduser(name), "r", encoding="utf-8") as handle:
   279	        if name.endswith(".jsonl"):
   280	            rows = [json.loads(line) for line in handle if line.strip()]
   281	        elif name.endswith(".json"):
   282	            rows = json.load(handle)
   283	        else:
   284	            raise SchemaError(f"unsupported table format: {name!r} (use .jsonl or .json)")
   285	    return validate_table(rows, **kwargs)
