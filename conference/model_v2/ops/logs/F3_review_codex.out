   103	
   104	def check_source_not_forbidden(path: Any) -> str:
   105	    """Return ``str(path)`` or raise ``ForbiddenSourceError``.
   106	
   107	    Checks the literal string, its URL-decoded form, the normalised absolute path
   108	    and the symlink-resolved path. Only path names are inspected; nothing is opened.
   109	    """
   110	    raw = os.fspath(path) if isinstance(path, os.PathLike) else str(path)
   111	    forms = {raw, unquote(raw)}
   112	    for item in list(forms):
   113	        expanded = os.path.expanduser(item)
   114	        forms.add(os.path.normpath(expanded))
   115	        forms.add(os.path.abspath(expanded))
   116	        try:
   117	            forms.add(os.path.realpath(expanded))
   118	        except (OSError, ValueError):
   119	            pass
   120	    for form in forms:
   121	        text = form.replace("\\", "/")
   122	        for label, pattern in _FORBIDDEN_PATTERNS:
   123	            if pattern.search(text):
   124	                raise ForbiddenSourceError(
   125	                    f"refused forbidden outcome source ({label}): {raw!r}")
   126	    return raw
   127	
   128	
   129	def _strings(value: Any) -> List[str]:
   130	    if isinstance(value, str):
   131	        return [value]
   132	    if isinstance(value, os.PathLike):
   133	        return [os.fspath(value)]
   134	    if isinstance(value, Mapping):
   135	        return [s for v in value.values() for s in _strings(v)]
   136	    if isinstance(value, (list, tuple, set, frozenset)):
   137	        return [s for v in value for s in _strings(v)]
   138	    return []
   139	
