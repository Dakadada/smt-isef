   630	_ALIASES = {"auc": "auroc", "roc_auc": "auroc", "roc": "auroc", "average_precision": "auprc",
   631	            "pr_auc": "auprc", "ppv": "precision", "sensitivity": "recall", "tpr": "recall",
   632	            "ece": "calibration_error", "calibration": "calibration_error",
   633	            "false_discovery_rate": "fdr"}
   634	SUPERVISED_METRICS = ("auroc", "auprc", "accuracy", "precision", "recall", "fdr", "brier",
   635	                      "calibration_error")
   636	_THRESHOLD_METRICS = ("accuracy", "precision", "recall", "fdr")
