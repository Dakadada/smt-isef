  1128	    pooled: Tuple[AblationCell, ...]          # per variant, out-of-fold scores pooled
  1129	    pooled_note: str = ("pooled cells combine scores from different per-fold models; "
  1130	                        "they are comparable only if the model's score scale is")
  1131	
  1132	    def blocked_reasons(self) -> Dict[Tuple[str, Optional[int], str], str]:
  1133	        return {(c.variant, c.fold_id, m): r for c in self.cells + self.pooled
  1134	                for m, r in c.blocked.items()}
  1135	
  1136	
  1137	FitPredict = Callable[[List[Dict[str, Any]], List[Dict[str, Any]], Tuple[str, ...]],
  1138	                      Mapping[str, float]]
  1139	
  1140	
  1141	def _evaluate(table: ObservationTable, scores: Mapping[str, float], pu: bool,
  1142	              metrics: Sequence[str], policy: MetricPolicy, threshold: Optional[float],
  1143	              top_k: Sequence[int], class_prior: Optional[float]
  1144	              ) -> Tuple[Tuple[MetricResult, ...], Optional[PUReport], Dict[str, str]]:
  1145	    blocked: Dict[str, str] = {}
  1146	    if pu:
  1147	        try:
  1148	            report = pu_report(table, scores, top_k=[k for k in top_k if k <= len(table)],
  1149	                               class_prior=class_prior, min_positives=policy.min_positives)
  1150	        except MetricBlocked as exc:
  1151	            return (), None, {exc.metric: exc.reason}
  1152	        blocked.update(report.blocked)
  1153	        for k in top_k:
  1154	            if k > len(table):
  1155	                blocked[f"pu_recall_at_top_k[{k}]"] = f"k={k} exceeds universe of {len(table)}"
  1156	        return (), report, blocked
  1157	    results = []
  1158	    for name in metrics:
  1159	        try:
  1160	            results.append(compute_metric(name, table, scores, policy=policy, threshold=threshold))
  1161	        except MetricBlocked as exc:
  1162	            blocked[name] = exc.reason
  1163	    return tuple(results), None, blocked
  1164	
  1165	
  1166	def run_ablation(rows: Any, features: Mapping[str, Mapping[str, Any]], baseline: str,
  1167	                 plan: SplitPlan, fit_predict: Optional[FitPredict] = None, *,
  1168	                 metrics: Sequence[str] = ("auroc", "auprc"), pu: bool = False,
  1169	                 policy: MetricPolicy = MetricPolicy(), threshold: Optional[float] = None,
  1170	                 top_k: Sequence[int] = (), class_prior: Optional[float] = None,
  1171	                 seed: int = 0, source_paths: Sequence[Any] = ()) -> AblationResult:
  1172	    """Leave-feature-family-out runner (interface only: the caller supplies the model).
  1173	
  1174	    ``fit_predict(train, test, columns) -> {observation_id: score}``. Train records
  1175	    carry ``label_state``; test records do NOT (labels cannot leak into prediction).
  1176	    M0 ignores ``fit_predict`` and scores with a seeded permutation. Every blocked
  1177	    metric is recorded with its reason instead of being dropped.
  1178	    ``source_paths``: every input file behind ``rows`` / ``features``; each is checked
  1179	    against the forbidden outcome sources before anything runs.
  1180	    """
  1181	    for path in source_paths:
  1182	        check_source_not_forbidden(path)
  1183	    table = _as_table(rows)
  1184	    if plan.observation_ids != table.ids:
  1185	        raise SchemaError("split plan was built for a different table (observation ids differ)")
  1186	    verify_no_leakage(plan)
  1187	    for name in metrics:
  1188	        _check_supervised_request(name, "supervised", (NEGATIVE,))
  1189	    spec = BASELINES.get(baseline)
  1190	    columns = baseline_feature_columns(baseline)  # raises for unknown / undefined
  1191	    if spec.kind == "permuted_reference":
  1192	        variants: List[Tuple[str, Optional[str], Tuple[str, ...]]] = [("permuted_reference", None, ())]
  1193	    else:
  1194	        if fit_predict is None:
  1195	            raise SchemaError(f"{baseline} needs a fit_predict callable")
  1196	        missing = [oid for oid in table.ids if oid not in features]
  1197	        if missing:
  1198	            raise SchemaError(f"features missing for {len(missing)} rows, e.g. {missing[:3]}")
  1199	        variants = [("full", None, columns)] + [
  1200	            (f"drop:{fam.name}", fam.name,
  1201	             tuple(c for other in spec.families if other is not fam for c in other.columns))
  1202	            for fam in spec.families]
  1203	
  1204	    def record(i: int, cols: Tuple[str, ...], with_label: bool) -> Dict[str, Any]:
  1205	        row = table.rows[i]
  1206	        rec: Dict[str, Any] = {"observation_id": row["observation_id"],
  1207	                               "features": {c: features[row["observation_id"]].get(c) for c in cols}}
  1208	        if with_label:
  1209	            rec["label_state"] = row["label_state"]
  1210	        return rec
  1211	
  1212	    cells, pooled = [], []
  1213	    for variant, dropped, cols in variants:
  1214	        oof: Dict[str, float] = {}
  1215	        for fold in plan.folds:
  1216	            test_ids = [table.ids[i] for i in fold.test_idx]
  1217	            if spec.kind == "permuted_reference":
  1218	                scores = permuted_reference_scores(test_ids, _stable_seed(seed, fold.fold_id) % 2 ** 31)
  1219	            else:
  1220	                scores = dict(fit_predict([record(i, cols, True) for i in fold.train_idx],
  1221	                                          [record(i, cols, False) for i in fold.test_idx], cols))
  1222	                if set(scores) != set(test_ids):
  1223	                    raise SchemaError(f"fit_predict must score exactly the test rows of fold "
  1224	                                      f"{fold.fold_id}")
  1225	            oof.update(scores)
  1226	            sub = table.subset(fold.test_idx)
  1227	            res, report, blocked = _evaluate(sub, scores, pu, metrics, policy, threshold, top_k,
  1228	                                             class_prior)
  1229	            cells.append(AblationCell(variant, dropped, cols, fold.fold_id, fold.test_group_ids,
  1230	                                      fold.held_out_groups, len(fold.train_idx),
  1231	                                      len(fold.test_idx), len(fold.purged_idx), res, report,
  1232	                                      blocked))
  1233	        index = [i for i, oid in enumerate(table.ids) if oid in oof]
  1234	        res, report, blocked = _evaluate(table.subset(index), oof, pu, metrics, policy, threshold,
  1235	                                         top_k, class_prior)
  1236	        pooled.append(AblationCell(
  1237	            variant, dropped, cols, None,
  1238	            tuple(sorted({g for f in plan.folds for g in f.test_group_ids})), {}, 0, len(index),
  1239	            0, res, report, blocked))
  1240	    return AblationResult(baseline, "positive_unlabeled" if pu else "supervised", plan.mode,
  1241	                          plan.relaxed_axes, seed, tuple(cells), tuple(pooled))

