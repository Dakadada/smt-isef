   639	def metric_key(name: str) -> str:
   640	    key = str(name).strip().lower().replace("-", "_").replace(" ", "_")
   641	    for prefix in ("sklearn.metrics.", "metrics."):
   642	        if key.startswith(prefix):
   643	            key = key[len(prefix):]
   644	    key = key.replace("_score", "").strip("_")
   645	    return _ALIASES.get(key, key)
