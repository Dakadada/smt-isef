   217	# ------------------------------------------------------------------ leakage traps
   218	def test_trap_duplicate_aso_under_different_ids_never_straddles():
   219	    rows = independent_rows(6)
   220	    rows.append(row("dup", seq=rows[0]["aso_sequence"], chem="chemZ", study="SZ",
   221	                    start=900000, end=900017))
   222	    plan = ec.make_splits(rows, "leave_study_out")
   223	    assert_no_straddle(plan)
   224	    for fold in plan.folds:
   225	        ids = {plan.observation_ids[i] for i in fold.train_idx}
   226	        held = {plan.observation_ids[i] for i in fold.test_idx} | \
   227	               {plan.observation_ids[i] for i in fold.purged_idx}
   228	        assert not ({"o000", "dup"} & ids and {"o000", "dup"} & held)
   229	    # the duplicate is purged (not trained on) when its twin's study is held out
   230	    fold = next(f for f in plan.folds if f.test_group_ids == ("study:S0",))
   231	    assert [plan.observation_ids[i] for i in fold.purged_idx] == ["dup"]
   232	
   233	
   234	def test_trap_overlapping_windows_across_studies_never_split():
   235	    rows = independent_rows(6)
   236	    rows.append(row("ovl", seq="GGGGGGGGGGCCCCCCCC", chem="chemY", study="SY",
   237	                    start=rows[2]["start"] + 5, end=rows[2]["end"] + 5))
   238	    for mode in ("leave_one_aso_out", "leave_study_out", "region_blocked"):
   239	        plan = ec.make_splits(rows, mode)
   240	        assert_no_straddle(plan)
   241	        for fold in plan.folds:
   242	            train = {plan.observation_ids[i] for i in fold.train_idx}
   243	            assert not ({"o002", "ovl"} & train and {"o002", "ovl"} - train), mode
   244	    plan = ec.make_splits(rows, "region_blocked")
   245	    fold = next(f for f in plan.folds if "o002" in {plan.observation_ids[i] for i in f.test_idx})
   246	    assert {plan.observation_ids[i] for i in fold.test_idx} == {"o002", "ovl"}
