  1098	def permuted_reference_scores(observation_ids: Sequence[str], seed: int = 0) -> Dict[str, float]:
  1099	    """M0: seeded random scores, independent of input order."""
  1100	    rng = random.Random(_stable_seed("m0_permuted_reference", seed))
  1101	    return {oid: rng.random() for oid in sorted(observation_ids)}
