    51	def labelled(n_pos, n_neg, n_unl=0, n_unassayed=0, n_censored=0, **kw):
    52	    states = (["measured_positive"] * n_pos + ["verified_negative"] * n_neg
    53	              + ["unlabeled"] * n_unl + ["unassayed"] * n_unassayed + ["censored"] * n_censored)
    54	    return independent_rows(len(states), states=states, **kw)
