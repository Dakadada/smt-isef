   647	
   648	def _resolve_scores(table: ObservationTable, scores: Any) -> List[float]:
   649	    if isinstance(scores, Mapping):
   650	        missing = [oid for oid in table.ids if oid not in scores]
   651	        if missing:
   652	            raise SchemaError(f"scores missing for {len(missing)} rows, e.g. {missing[:3]}")
   653	        out = [scores[oid] for oid in table.ids]
   654	    else:
   655	        out = list(scores)
   656	        if len(out) != len(table):
   657	            raise SchemaError(f"{len(out)} scores for {len(table)} rows")
   658	    for value in out:
   659	        if isinstance(value, bool) or not isinstance(value, (int, float)) or not math.isfinite(value):
   660	            raise SchemaError(f"score {value!r} is not a finite number")
   661	    return [float(v) for v in out]
   662	
   663	
   664	def _midranks(values: Sequence[float]) -> List[float]:
   665	    order = sorted(range(len(values)), key=values.__getitem__)
   666	    ranks = [0.0] * len(values)
   667	    i = 0
   668	    while i < len(order):
   669	        j = i
   670	        while j + 1 < len(order) and values[order[j + 1]] == values[order[i]]:
   671	            j += 1
   672	        for k in range(i, j + 1):
   673	            ranks[order[k]] = (i + j) / 2 + 1
   674	        i = j + 1
   675	    return ranks
   676	
   677	
   678	def _rank_probability(pos: Sequence[float], other: Sequence[float]) -> float:
   679	    """P(pos > other) + 0.5 P(tie), tie-exact (Mann-Whitney U / (n_pos * n_other))."""
   680	    ranks = _midranks(list(pos) + list(other))
   681	    u = sum(ranks[:len(pos)]) - len(pos) * (len(pos) + 1) / 2
   682	    return u / (len(pos) * len(other))
   683	
   684	
   685	def _pr_points(y: Sequence[int], s: Sequence[float]) -> List[Tuple[float, float, float]]:
   686	    """(threshold, precision, recall) at each distinct score, descending; ties grouped."""
   687	    n_pos = sum(y)
   688	    order = sorted(range(len(s)), key=lambda i: -s[i])
   689	    points, tp, fp, i = [], 0, 0, 0
   690	    while i < len(order):
   691	        j = i
   692	        while j < len(order) and s[order[j]] == s[order[i]]:
   693	            tp += y[order[j]]
   694	            fp += 1 - y[order[j]]
   695	            j += 1
   696	        points.append((s[order[i]], tp / (tp + fp), tp / n_pos))
   697	        i = j
   698	    return points
   699	
   700	
   701	def _metric_value(key: str, y: Sequence[int], s: Sequence[float],
   702	                  threshold: Optional[float], n_bins: int) -> float:
   703	    n_pos = sum(y)
   704	    if key == "auroc":
   705	        return _rank_probability([v for v, t in zip(s, y) if t], [v for v, t in zip(s, y) if not t])
   706	    if key == "auprc":  # average precision; a tie group contributes one step
   707	        total, prev = 0.0, 0.0
   708	        for _, precision, recall in _pr_points(y, s):
   709	            total += (recall - prev) * precision
   710	            prev = recall
   711	        return total
   712	    if key in _THRESHOLD_METRICS:
   713	        if threshold is None:
   714	            raise SchemaError(f"{key} needs an explicit threshold (score >= threshold is positive)")
   715	        pred = [v >= threshold for v in s]
   716	        tp = sum(1 for p, t in zip(pred, y) if p and t)
   717	        fp = sum(1 for p, t in zip(pred, y) if p and not t)
   718	        if key == "accuracy":
   719	            return (tp + sum(1 for p, t in zip(pred, y) if not p and not t)) / len(y)
   720	        if key == "recall":
   721	            return tp / n_pos
   722	        if tp + fp == 0:
   723	            raise MetricBlocked(key, f"no predictions at threshold {threshold}; {key} undefined")
   724	        return tp / (tp + fp) if key == "precision" else fp / (tp + fp)
   725	    if any(v < 0.0 or v > 1.0 for v in s):
   726	        raise SchemaError(f"{key} needs probabilities in [0, 1]")
   727	    if key == "brier":
   728	        return sum((v - t) ** 2 for v, t in zip(s, y)) / len(y)
   729	    if n_bins < 1:
   730	        raise SchemaError("n_bins must be >= 1")
   731	    bins: Dict[int, List[Tuple[float, int]]] = {}
   732	    for v, t in zip(s, y):
   733	        bins.setdefault(min(int(v * n_bins), n_bins - 1), []).append((v, t))
   734	    return sum(abs(sum(v for v, _ in b) - sum(t for _, t in b)) for b in bins.values()) / len(y)
   735	
   736	
   737	def _supervised(key: str, display: str, states: Sequence[str], units: Sequence[str],
   738	                scores: Sequence[float], policy: MetricPolicy, threshold: Optional[float],
   739	                n_bins: int) -> MetricResult:
   740	    keep = [i for i, st in enumerate(states) if st in (POSITIVE, NEGATIVE)]
   741	    y = [1 if states[i] == POSITIVE else 0 for i in keep]
   742	    s = [scores[i] for i in keep]
   743	    pos_units = {units[i] for i in keep if states[i] == POSITIVE}
   744	    neg_units = {units[i] for i in keep if states[i] == NEGATIVE}
   745	    excluded: Dict[str, int] = {}
   746	    for st in states:
   747	        if st not in (POSITIVE, NEGATIVE):
   748	            excluded[st] = excluded.get(st, 0) + 1
   749	    problems = []
   750	    if len(neg_units) < policy.min_verified_negatives:
   751	        problems.append(f"{len(neg_units)} independent verified_negative unit(s) "
   752	                        f"({len(y) - sum(y)} rows) < minimum {policy.min_verified_negatives}")
   753	    if len(pos_units) < policy.min_positives:
   754	        problems.append(f"{len(pos_units)} independent measured_positive unit(s) "
   755	                        f"({sum(y)} rows) < minimum {policy.min_positives}")
   756	    if problems:
   757	        raise MetricBlocked(display, "; ".join(problems) + (
   758	            f"; excluded (never negatives): {excluded}" if excluded else "")
   759	            + ". Use pu_report() for positive-unlabeled quantities.")
   760	    value = _metric_value(key, y, s, threshold, n_bins)
   761	    return MetricResult(key, value, "derived", "supervised", sum(y), len(y) - sum(y),
   762	                        len(pos_units), len(neg_units), excluded, len(s) - len(set(s)),
   763	                        threshold if key in _THRESHOLD_METRICS else None)
   764	
   765	
   766	def _check_supervised_request(name: str, mode: str, negative_states: Sequence[str]) -> str:
   767	    key = metric_key(name)
   768	    if mode == "pu":
   769	        raise MetricBlocked(name, "positive-unlabeled mode never emits supervised metrics; "
   770	                                  "use pu_report()")
   771	    if mode != "supervised":
   772	        raise SchemaError(f"unknown mode {mode!r}")
   773	    extra = set(negative_states) - {NEGATIVE}
   774	    if extra or NEGATIVE not in negative_states:
   775	        raise LabelStateError(
   776	            f"negative_states={list(negative_states)}: only verified_negative is a negative; "
   777	            f"{sorted(extra)} can never be treated as negative")
   778	    if key not in SUPERVISED_METRICS:
   779	        raise SchemaError(f"unknown metric {name!r}; supported: {list(SUPERVISED_METRICS)}")
   780	    return key
   781	
   782	
   783	def compute_metric(name: str, rows: Any, scores: Any, *, policy: MetricPolicy = MetricPolicy(),
   784	                   threshold: Optional[float] = None, n_bins: int = 10,
   785	                   mode: str = "supervised",
   786	                   negative_states: Sequence[str] = (NEGATIVE,)) -> MetricResult:
   787	    """Guarded supervised metric over measured_positive vs verified_negative rows only.
   788	
   789	    Higher score = more positive. Raises ``MetricBlocked`` (with ``.reason``) when
   790	    either class has fewer independent units than ``policy`` requires.
   791	    """
   792	    key = _check_supervised_request(name, mode, negative_states)
   793	    table = _as_table(rows)
   794	    s = _resolve_scores(table, scores)
   795	    return _supervised(key, name, [r["label_state"] for r in table.rows],
   796	                       [r["independent_unit_id"] for r in table.rows], s, policy, threshold,
   797	                       n_bins)
   798	
   799	
   800	def precision_recall_curve(rows: Any, scores: Any, *, policy: MetricPolicy = MetricPolicy()
   801	                           ) -> List[Tuple[float, float, float]]:
   802	    """Guarded (threshold, precision, recall) points; same blocking rule as AUPRC."""
   803	    table = _as_table(rows)
   804	    s = _resolve_scores(table, scores)
   805	    compute_metric("auprc", table, s, policy=policy)  # raises MetricBlocked if not allowed
   806	    keep = [i for i, r in enumerate(table.rows) if r["label_state"] in (POSITIVE, NEGATIVE)]
   807	    return _pr_points([int(table.rows[i]["label_state"] == POSITIVE) for i in keep],
   808	                      [s[i] for i in keep])
   809	
   810	
   811	# ------------------------------------------------------------------ positive-unlabeled mode
   812	PU_QUANTITIES = ("pu_recall_at_top_k", "pu_positive_mean_percentile_rank",
   813	                 "pu_positive_median_percentile_rank",
   814	                 "pu_positive_vs_unlabeled_rank_probability",
   815	                 "pu_prior_adjusted_rank_probability")
   816	_PU_BASE = ("positive-unlabeled: unlabeled candidates are a mixture of undiscovered "
   817	            "positives and negatives and are never counted as negatives")
   818	
   819	
   820	@dataclass(frozen=True)
   821	class PUQuantity:
   822	    name: str
   823	    value: float
   824	    evidence_class: str
   825	    pu_assumption: str
   826	    k: Optional[int] = None
   827	
   828	
   829	@dataclass(frozen=True)
   830	class PUReport:
   831	    mode: str
   832	    quantities: Tuple[PUQuantity, ...]
   833	    n_positive_rows: int
   834	    n_positive_units: int
   835	    n_universe: int
   836	    universe_states: Tuple[str, ...]
   837	    excluded_by_state: Mapping[str, int]
   838	    class_prior: Optional[float]
   839	    blocked: Mapping[str, str]
   840	
   841	    def get(self, name: str, k: Optional[int] = None) -> PUQuantity:
   842	        for q in self.quantities:
   843	            if q.name == name and q.k == k:
   844	                return q
   845	        raise KeyError((name, k))
   846	
   847	
   848	def pu_report(rows: Any, scores: Any, *, top_k: Sequence[int] = (), class_prior: Optional[float] = None,
   849	              min_positives: int = 10, include_unassayed: bool = False) -> PUReport:
   850	    """PU-valid quantities only. The candidate universe is measured_positive + unlabeled
   851	    (+ unassayed if ``include_unassayed``); verified_negative and censored rows are excluded.
   852	
   853	    ``class_prior`` is a STATED assumption (fraction of true positives among the
   854	    non-positive universe rows), never estimated here; the prior-adjusted statistic is
   855	    only emitted when it is given and is tagged ``model_assumption``.
   856	    """
   857	    table = _as_table(rows)
   858	    s_all = _resolve_scores(table, scores)
   859	    states = [LabelState.UNLABELED.value] + ([LabelState.UNASSAYED.value] if include_unassayed else [])
   860	    pos = [i for i, r in enumerate(table.rows) if r["label_state"] == POSITIVE]
   861	    unl = [i for i, r in enumerate(table.rows) if r["label_state"] in states]
   862	    excluded: Dict[str, int] = {}
   863	    for r in table.rows:
   864	        if r["label_state"] != POSITIVE and r["label_state"] not in states:
   865	            excluded[r["label_state"]] = excluded.get(r["label_state"], 0) + 1

 succeeded in 72ms:
   290	                tested = [i for f in plan.folds for i in f.test_idx]
   291	                assert sorted(tested) == list(range(40))      # every row tested exactly once
