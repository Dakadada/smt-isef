   287	
   288	# ------------------------------------------------------------------ grouping
   289	AXES = ("sequence", "chemistry", "study", "window")
   290	MODES = {"leave_one_aso_out": "sequence", "leave_study_out": "study",
   291	         "region_blocked": "window"}
   292	_SEQ_RE = re.compile(r"^[ACGTN]+$")
   293	
   294	
   295	@dataclass(frozen=True)
   296	class GroupingConfig:
   297	    """Leakage axes and their thresholds.
   298	
   299	    ``relax`` removes axes from the keep-together set; it is recorded on every plan
   300	    as ``relaxed_axes`` (a declared leakage risk), never applied silently.
   301	    ``window_padding`` pads each window on both sides before clustering (1-based
   302	    closed coordinates, as in J6 ``start1``/``end1``).
   303	    """
   304	    sequence_metric: str = "edit"            # "edit" (Levenshtein) or "hamming"
   305	    sequence_threshold: int = 2
   306	    containment_is_identical: bool = True    # truncations (e.g. 14-mer inside 18-mer)
   307	    min_containment_length: int = 8
   308	    window_padding: int = 0
   309	    strand_aware: bool = True
   310	    relax: Tuple[str, ...] = ()
   311	    max_unique_sequences: int = 4000         # O(n^2) pairwise guard (login-node safe)
   312	
   313	    def __post_init__(self) -> None:
   314	        if self.sequence_metric not in ("edit", "hamming"):
   315	            raise SchemaError(f"bad sequence_metric {self.sequence_metric!r}")
   316	        if self.sequence_threshold < 0 or self.window_padding < 0:
   317	            raise SchemaError("thresholds and padding must be >= 0")
   318	        bad = set(self.relax) - set(AXES)
   319	        if bad:
   320	            raise SchemaError(f"unknown axes in relax: {sorted(bad)}")
   321	
   322	    @property
   323	    def axes(self) -> Tuple[str, ...]:
   324	        return tuple(a for a in AXES if a not in self.relax)
   325	
   326	
   327	class _UnionFind:
   328	    def __init__(self, n: int):
   329	        self.parent = list(range(n))
   330	
   331	    def find(self, x: int) -> int:
   332	        while self.parent[x] != x:
   333	            self.parent[x] = self.parent[self.parent[x]]
   334	            x = self.parent[x]
   335	        return x
   336	
   337	    def union(self, a: int, b: int) -> None:
   338	        ra, rb = self.find(a), self.find(b)
   339	        if ra != rb:
   340	            self.parent[max(ra, rb)] = min(ra, rb)
   341	
   342	
   343	def normalize_sequence(seq: Any) -> str:
   344	    if not isinstance(seq, str):
   345	        raise SchemaError(f"aso_sequence must be a string, got {seq!r}")
   346	    out = "".join(seq.split()).upper().replace("U", "T")
   347	    if not _SEQ_RE.match(out):
   348	        raise SchemaError(f"aso_sequence {seq!r} is not ACGTUN")
   349	    return out
   350	
   351	
   352	def _edit_within(a: str, b: str, limit: int) -> bool:
   353	    if abs(len(a) - len(b)) > limit:
   354	        return False
   355	    prev = list(range(len(b) + 1))
   356	    for i, ca in enumerate(a, 1):
   357	        cur = [i]
   358	        for j, cb in enumerate(b, 1):
   359	            cur.append(min(prev[j] + 1, cur[j - 1] + 1, prev[j - 1] + (ca != cb)))
   360	        if min(cur) > limit:
   361	            return False
   362	        prev = cur
   363	    return prev[-1] <= limit
   364	
   365	
   366	def _near_identical(a: str, b: str, cfg: GroupingConfig) -> bool:
   367	    if a == b:
   368	        return True
   369	    short, long_ = (a, b) if len(a) <= len(b) else (b, a)
   370	    if cfg.containment_is_identical and len(short) >= cfg.min_containment_length \
   371	            and short in long_:
   372	        return True
   373	    if cfg.sequence_metric == "hamming":
   374	        return len(a) == len(b) and sum(x != y for x, y in zip(a, b)) <= cfg.sequence_threshold
   375	    return _edit_within(a, b, cfg.sequence_threshold)
   376	
   377	
   378	def _sequence_groups(table: ObservationTable, cfg: GroupingConfig) -> List[str]:
   379	    seqs = [normalize_sequence(r.get("aso_sequence")) for r in table.rows]
   380	    uniq = sorted(set(seqs))
   381	    if len(uniq) > cfg.max_unique_sequences:
   382	        raise SplitRefused(
   383	            f"{len(uniq)} unique sequences exceeds max_unique_sequences="
   384	            f"{cfg.max_unique_sequences}; pairwise clustering refused on this node")
   385	    uf = _UnionFind(len(uniq))
   386	    for i in range(len(uniq)):
   387	        for j in range(i + 1, len(uniq)):
   388	            if _near_identical(uniq[i], uniq[j], cfg):
   389	                uf.union(i, j)
   390	    label = {s: f"seq:{uniq[uf.find(i)]}" for i, s in enumerate(uniq)}  # root = smallest
   391	    return [label[s] for s in seqs]
   392	
   393	
   394	def _window_groups(table: ObservationTable, cfg: GroupingConfig) -> List[str]:
   395	    keyed: Dict[Tuple[str, str], List[Tuple[int, int, int]]] = {}
   396	    for i, r in enumerate(table.rows):
   397	        chrom, start, end, strand = r.get("chrom"), r.get("start"), r.get("end"), r.get("strand")
   398	        ok = (isinstance(chrom, str) and chrom and strand in ("+", "-")
   399	              and all(isinstance(v, int) and not isinstance(v, bool) for v in (start, end))
   400	              and 1 <= start <= end)
   401	        if not ok:
   402	            raise SchemaError(
   403	                f"row {i} ({r['observation_id']}): window axis needs chrom, 1-based closed "
   404	                "int start<=end, strand in +/-")
   405	        keyed.setdefault((chrom, strand if cfg.strand_aware else "*"), []).append((start, end, i))
   406	    out = [""] * len(table)
   407	    for (chrom, strand), items in sorted(keyed.items()):
   408	        items.sort()
   409	        cluster: List[int] = []
   410	        lo = hi = 0
   411	        for start, end, i in items + [(None, None, -1)]:  # sentinel flushes the last cluster
   412	            if cluster and (start is None or start > hi + 2 * cfg.window_padding):
   413	                for member in cluster:
   414	                    out[member] = f"win:{chrom}:{strand}:{lo}-{hi}"
   415	                cluster = []
   416	            if start is None:
   417	                break
   418	            if not cluster:
   419	                lo, hi = start, end
   420	            cluster.append(i)
   421	            hi = max(hi, end)
   422	    return out
   423	
   424	
   425	def axis_groups(rows: Any, config: GroupingConfig = GroupingConfig(),
   426	                axes: Optional[Sequence[str]] = None) -> Dict[str, Tuple[str, ...]]:
   427	    """Per-row group id on each requested leakage axis."""
   428	    table = _as_table(rows)
   429	    out: Dict[str, Tuple[str, ...]] = {}
   430	    for axis in (config.axes if axes is None else axes):

