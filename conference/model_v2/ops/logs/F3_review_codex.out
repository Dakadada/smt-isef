    53	# ------------------------------------------------------------------ errors
    54	class SchemaError(ValueError):
    55	    """A row or argument violates the observation-table contract."""
    56	
    57	
    58	class NegativeEvidenceError(SchemaError):
    59	    """A verified_negative lacks explicit, powered negative evidence."""
    60	
    61	
    62	class LabelStateError(SchemaError):
    63	    """A non-negative label state was used (or encoded) as a negative."""
    64	
    65	
    66	class ForbiddenSourceError(RuntimeError):
    67	    """An input path matches a forbidden outcome source."""
    68	
    69	
    70	class SplitRefused(RuntimeError):
    71	    """A split was refused (independent N too small, or nothing left to train on)."""
    72	
    73	
    74	class LeakageError(RuntimeError):
    75	    """A group straddles train and test. Indicates a bug; never expected."""
    76	
    77	
    78	class MetricBlocked(RuntimeError):
    79	    """A metric was refused; ``reason`` says why."""
    80	
    81	    def __init__(self, metric: str, reason: str):
    82	        super().__init__(f"{metric}: BLOCKED - {reason}")
    83	        self.metric = metric
    84	        self.reason = reason
    85	
    86	
    87	class UncertaintyRefused(RuntimeError):
    88	    """A confidence interval was refused (too few independent clusters)."""
    89	
    90	
    91	class BaselineUndefined(ValueError):
    92	    """The baseline has no agreed feature set yet."""
