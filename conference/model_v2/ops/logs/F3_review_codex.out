   942	
   943	def effective_clusters(rows: Any, *, merge_axes: Sequence[str] = ("sequence", "window"),
   944	                       config: GroupingConfig = GroupingConfig()) -> Tuple[str, ...]:
   945	    """Independent cluster per row: ``independent_unit_id`` merged with every listed
   946	    leakage axis, so overlapping windows / near-identical ASOs filed under different
   947	    unit ids still count as ONE cluster."""
   948	    table = _as_table(rows)
   949	    lists: List[Sequence[str]] = [[f"unit:{r['independent_unit_id']}" for r in table.rows]]
   950	    lists += list(axis_groups(table, config, tuple(merge_axes)).values())
   951	    return tuple(_components(table, lists))
   952	
   953	
   954	def _quantile(sorted_values: Sequence[float], q: float) -> float:
   955	    pos = q * (len(sorted_values) - 1)
   956	    lo = int(math.floor(pos))
   957	    hi = min(lo + 1, len(sorted_values) - 1)
   958	    return sorted_values[lo] + (sorted_values[hi] - sorted_values[lo]) * (pos - lo)
   959	
   960	
   961	def cluster_bootstrap_ci(rows: Any, statistic: Callable[[Sequence[int]], float], *,
   962	                         n_boot: int = 1000, seed: int = 0, min_clusters: int = 10,
   963	                         alpha: float = 0.05, merge_axes: Sequence[str] = ("sequence", "window"),
   964	                         config: GroupingConfig = GroupingConfig(),
   965	                         max_failed_fraction: float = 0.1) -> CIResult:
   966	    """Percentile cluster bootstrap. ``statistic(indices)`` receives row indices (with
   967	    repeats) of whole resampled clusters. Refuses with ``UncertaintyRefused`` when
   968	    fewer than ``min_clusters`` effective clusters exist, or when too many replicates
   969	    are degenerate (``MetricBlocked`` / non-finite)."""
   970	    table = _as_table(rows)
   971	    if n_boot < 1 or not 0.0 < alpha < 1.0:
   972	        raise SchemaError("need n_boot >= 1 and 0 < alpha < 1")
   973	    clusters = effective_clusters(table, merge_axes=merge_axes, config=config)
   974	    members: Dict[str, List[int]] = {}
   975	    for i, c in enumerate(clusters):
   976	        members.setdefault(c, []).append(i)
   977	    ids = sorted(members)
   978	    if len(ids) < min_clusters:
   979	        raise UncertaintyRefused(
   980	            f"CI refused: {len(ids)} independent cluster(s) from {len(table)} rows "
   981	            f"(units merged over {list(merge_axes)}) < minimum {min_clusters}; correlated "
   982	            "rows are not independent replicates")
   983	    point = float(statistic(tuple(range(len(table)))))
   984	    rng = random.Random(_stable_seed("cluster_bootstrap", seed))
   985	    values, failed = [], 0
   986	    for _ in range(n_boot):
   987	        draw = [ids[rng.randrange(len(ids))] for _ in ids]
   988	        try:
   989	            value = float(statistic(tuple(i for c in draw for i in members[c])))
   990	        except MetricBlocked:
   991	            failed += 1
   992	            continue
   993	        if math.isfinite(value):
   994	            values.append(value)
   995	        else:
   996	            failed += 1
   997	    if failed > max_failed_fraction * n_boot:
   998	        raise UncertaintyRefused(
   999	            f"CI refused: {failed}/{n_boot} bootstrap replicates were degenerate "
  1000	            f"(> {max_failed_fraction:.0%}); too few clusters per class for a stable interval")
  1001	    values.sort()
  1002	    return CIResult(point, _quantile(values, alpha / 2), _quantile(values, 1 - alpha / 2), alpha,
  1003	                    len(ids), n_boot, failed, seed, tuple(merge_axes),
  1004	                    "percentile_cluster_bootstrap", "derived")
  1005	
  1006	
  1007	def bootstrap_metric_ci(name: str, rows: Any, scores: Any, *,
  1008	                        policy: MetricPolicy = MetricPolicy(), threshold: Optional[float] = None,
  1009	                        n_bins: int = 10, **kwargs: Any) -> CIResult:
  1010	    """Cluster-bootstrap CI for a guarded metric. The point estimate must pass the full
  1011	    ``policy``; replicates only need both classes present (else counted as failed)."""
  1012	    key = _check_supervised_request(name, "supervised", (NEGATIVE,))
  1013	    table = _as_table(rows)
  1014	    s = _resolve_scores(table, scores)
  1015	    states = [r["label_state"] for r in table.rows]
  1016	    units = [r["independent_unit_id"] for r in table.rows]
  1017	    compute_metric(name, table, s, policy=policy, threshold=threshold, n_bins=n_bins)
  1018	    relaxed = MetricPolicy(1, 1)
  1019	
  1020	    def statistic(indices: Sequence[int]) -> float:
  1021	        return _supervised(key, name, [states[i] for i in indices], [units[i] for i in indices],
  1022	                           [s[i] for i in indices], relaxed, threshold, n_bins).value
  1023	
  1024	    return cluster_bootstrap_ci(table, statistic, **kwargs)
