   445	
   446	def _components(table: ObservationTable, group_lists: Sequence[Sequence[str]]) -> List[str]:
   447	    """Connected components of rows linked through any of the given group ids."""
   448	    uf = _UnionFind(len(table))
   449	    for groups in group_lists:
   450	        first: Dict[str, int] = {}
   451	        for i, g in enumerate(groups):
   452	            uf.union(first.setdefault(g, i), i)
   453	    ids = table.ids
   454	    smallest: Dict[int, str] = {}
   455	    for i in range(len(table)):
   456	        root = uf.find(i)
   457	        smallest[root] = min(smallest.get(root, ids[i]), ids[i])
   458	    return [f"component:{smallest[uf.find(i)]}" for i in range(len(table))]
