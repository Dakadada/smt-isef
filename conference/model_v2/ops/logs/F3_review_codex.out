   496	
   497	def verify_no_leakage(plan: SplitPlan) -> None:
   498	    """Raise ``LeakageError`` if any active-axis group appears in both train and test."""
   499	    for fold in plan.folds:
   500	        if set(fold.test_idx) & set(fold.train_idx):
   501	            raise LeakageError(f"fold {fold.fold_id}: a row is in both train and test")
   502	        for axis in plan.axes:
   503	            groups = plan.group_ids[axis]
   504	            both = {groups[i] for i in fold.train_idx} & {groups[i] for i in fold.test_idx}
   505	            if both:
   506	                raise LeakageError(f"fold {fold.fold_id}: {axis} groups straddle: {sorted(both)}")
   507	
   508	
   509	def make_splits(rows: Any, mode: str, *, config: GroupingConfig = GroupingConfig(),
   510	                seed: int = 0, n_folds: Optional[int] = None,
   511	                min_independent_groups: int = 3) -> SplitPlan:
   512	    """Purged group split.
   513	
   514	    ``n_folds=None``: leave-one-primary-unit-out (one ASO cluster / study / region
   515	    block per fold, sorted order). ``n_folds=k``: seeded k-fold over independent
   516	    components. Refuses (``SplitRefused``) when the number of independent components
   517	    over all active axes is below ``min_independent_groups``.
   518	    """
   519	    if mode == "nested":
   520	        raise SchemaError("use make_nested_splits for mode='nested'")
   521	    if mode not in MODES:
   522	        raise SchemaError(f"unknown mode {mode!r}; expected {sorted(MODES)} or 'nested'")
   523	    primary = MODES[mode]
   524	    axes = config.axes
   525	    if primary not in axes:
   526	        raise SchemaError(f"mode {mode!r} cannot relax its own primary axis {primary!r}")
   527	    table = _as_table(rows)
   528	    groups = axis_groups(table, config, axes)
   529	    comp = _components(table, [groups[a] for a in axes])
   530	    n_comp = len(set(comp))
   531	    if n_comp < min_independent_groups:
   532	        raise SplitRefused(
   533	            f"{mode}: independent N too small - {n_comp} independent group(s) over axes "
   534	            f"{list(axes)} from {len(table)} rows, need >= {min_independent_groups}. "
   535	            "Rows sharing a sequence cluster, chemistry family, study or overlapping "
   536	            "window are one unit; relaxing an axis must be explicit (GroupingConfig.relax).")
   537	    n = len(table)
   538	    if n_folds is None:
   539	        units = sorted(set(groups[primary]))
   540	        tests = [[i for i in range(n) if groups[primary][i] == u] for u in units]
   541	    else:
   542	        if not 2 <= n_folds <= n_comp:
   543	            raise SplitRefused(
   544	                f"{mode}: n_folds={n_folds} impossible with {n_comp} independent group(s)")
   545	        order = sorted(set(comp))
   546	        random.Random(_stable_seed("kfold", mode, seed)).shuffle(order)
   547	        bucket = {c: k % n_folds for k, c in enumerate(order)}
   548	        tests = [[i for i in range(n) if bucket[comp[i]] == k] for k in range(n_folds)]
   549	    folds = []
   550	    for fold_id, test in enumerate(tests):
   551	        test_set = set(test)
   552	        held = {a: frozenset(groups[a][i] for i in test) for a in axes}
   553	        train, purged = [], []
   554	        for i in range(n):
   555	            if i in test_set:
   556	                continue
   557	            (purged if any(groups[a][i] in held[a] for a in axes) else train).append(i)
   558	        if not train:
   559	            raise SplitRefused(
   560	                f"{mode}: fold {fold_id} has no training rows after purging groups shared "
   561	                "with the test unit")
   562	        folds.append(Fold(fold_id, tuple(test), tuple(train), tuple(purged),
   563	                          tuple(sorted({groups[primary][i] for i in test})),
   564	                          {a: tuple(sorted(held[a])) for a in axes}))
   565	    plan = SplitPlan(mode, primary, axes, tuple(config.relax), seed, n_comp, table.ids,
   566	                     groups, tuple(folds))
   567	    verify_no_leakage(plan)
   568	    return plan
   569	
   570	
   571	def make_nested_splits(rows: Any, *, outer_mode: str, inner_mode: Optional[str] = None,
   572	                       config: GroupingConfig = GroupingConfig(), seed: int = 0,
   573	                       outer_n_folds: Optional[int] = None, inner_n_folds: Optional[int] = None,
   574	                       min_outer_groups: int = 3, min_inner_groups: int = 3) -> NestedSplitPlan:
   575	    """Nested purged splits. Inner folds are built only from each outer fold's train
   576	    rows, so they never contain an outer test (or purged) row or any of its groups.
   577	    Refuses, naming the outer fold, when either level has too few independent groups."""
   578	    table = _as_table(rows)
   579	    inner_mode = inner_mode or outer_mode
   580	    outer = make_splits(table, outer_mode, config=config, seed=seed, n_folds=outer_n_folds,
   581	                        min_independent_groups=min_outer_groups)
   582	    inner_all = []
   583	    for fold in outer.folds:
   584	        index = fold.train_idx
   585	        try:
   586	            sub = make_splits(table.subset(index), inner_mode, config=config,
   587	                              seed=_stable_seed("inner", seed, fold.fold_id) % (2 ** 31),
   588	                              n_folds=inner_n_folds, min_independent_groups=min_inner_groups)
   589	        except SplitRefused as exc:
   590	            raise SplitRefused(
   591	                f"nested refused: outer fold {fold.fold_id} (held out "
   592	                f"{list(fold.test_group_ids)}) leaves too little for inner folds - {exc}"
   593	            ) from None
   594	        inner = tuple(
   595	            Fold(f.fold_id, tuple(index[i] for i in f.test_idx),
   596	                 tuple(index[i] for i in f.train_idx), tuple(index[i] for i in f.purged_idx),
   597	                 f.test_group_ids, f.held_out_groups)
   598	            for f in sub.folds)
   599	        excluded = set(fold.test_idx) | set(fold.purged_idx)
   600	        for f in inner:
   601	            if (set(f.test_idx) | set(f.train_idx)) & excluded:
   602	                raise LeakageError(f"inner fold of outer {fold.fold_id} sees outer test rows")
   603	        inner_all.append(inner)
   604	    return NestedSplitPlan(outer, tuple(inner_all), inner_mode)
