   294	def test_verify_no_leakage_detects_a_tampered_plan():
   295	    plan = ec.make_splits(independent_rows(5), "leave_one_aso_out")
   296	    f = plan.folds[0]
   297	    bad = ec.Fold(f.fold_id, f.test_idx, f.train_idx + f.test_idx, f.purged_idx,
   298	                  f.test_group_ids, f.held_out_groups)
   299	    tampered = ec.SplitPlan(plan.mode, plan.primary_axis, plan.axes, plan.relaxed_axes, plan.seed,
   300	                            plan.n_independent_groups, plan.observation_ids, plan.group_ids, (bad,))
   301	    with pytest.raises(ec.LeakageError):
   302	        ec.verify_no_leakage(tampered)
