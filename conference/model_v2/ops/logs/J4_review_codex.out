    54	
    55	def half_open(start: int, end: int) -> tuple[int, int]:
    56	    if type(start) is not int or type(end) is not int or not 1 <= start <= end:
    57	        raise ValueError("invalid 1-based inclusive interval")
    58	    return start - 1, end
    59	
    60	
    61	def inclusive(start: int, end: int) -> tuple[int, int]:
    62	    if type(start) is not int or type(end) is not int or not 0 <= start < end:
    63	        raise ValueError("invalid 0-based half-open interval")
    64	    return start + 1, end
    65	
