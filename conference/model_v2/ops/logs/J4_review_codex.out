    43	def digest(value) -> str:
    44	    return hashlib.sha256(json.dumps(value, sort_keys=True, separators=(",", ":"), allow_nan=False).encode()).hexdigest()
    45	
    46	
    47	def file_sha(path) -> str:
    48	    h = hashlib.sha256()
    49	    with open(path, "rb") as stream:
    50	        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
    51	            h.update(chunk)
    52	    return h.hexdigest()
