   360	def reference_from_rows(window, rows, item):
   361	    values = np.full((4, 2 * window.distance + 1), np.nan)
   362	    for row in rows:
   363	        if row["status"] != "ok":
   364	            return None, row["error"], item
   365	        values[TISSUES.index(row["tissue"]), output_index(window, row["site_position"])] = row["reference_score"]
   366	    return values, None, item
