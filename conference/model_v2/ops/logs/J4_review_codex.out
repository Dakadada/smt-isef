    31	# Sole requeue owner, following feng/scripts/templates/gpu_preemptable.sbatch.
    32	# Python installs checkpoint_on_signal(requeue=False), flushes, and exits 0.
    33	PAYLOAD_PID=""
    34	requeue_handler() {
    35	    trap '' SIGTERM SIGUSR1
    36	    if [[ -n "${PAYLOAD_PID}" ]]; then
    37	        kill -TERM "${PAYLOAD_PID}" 2>/dev/null || true
    38	        if ! wait "${PAYLOAD_PID}"; then
    39	            echo 'ERROR: payload checkpoint flush failed; refusing requeue' >&2
    40	            exit 1
    41	        fi
    42	    fi
    43	    if [[ -z "${SLURM_JOB_ID:-}" ]] || ! scontrol requeue "${SLURM_JOB_ID}"; then
    44	        echo 'ERROR: checkpoint saved but requeue failed' >&2
    45	        exit 1
    46	    fi
    47	    exit 0
    48	}
    49	trap requeue_handler SIGTERM SIGUSR1
    50	CHECK_ARGS=()
    51	if [[ "${J4_CHECK_TOLERANCE:-0}" == 1 ]]; then
    52	    CHECK_ARGS+=(--check-tolerance)
    53	fi
    54	"${PYTHON_BIN}" -m conference.model_v2.gpu_perturbation_atlas \
    55	    --smoke --output-dir "${OUT}" --batch-size 2 "${CHECK_ARGS[@]}" &
    56	PAYLOAD_PID=$!
    57	wait "${PAYLOAD_PID}"
    58	trap - SIGTERM SIGUSR1

