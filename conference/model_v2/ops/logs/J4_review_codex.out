   369	def run_atlas(windows, grid, genome, scorer, output_dir, *, batch_size=4, shard=0, shards=1, reference_dir=None):
   370	    if type(batch_size) is not int or not 1 <= batch_size <= 64:
   371	        raise ValueError("batch_size must be 1..64")
   372	    windows = sorted(windows, key=lambda w: (w.locus, w.chrom, w.center, w.strand))
   373	    if not windows or len({digest(asdict(w)) for w in windows}) != len(windows):
   374	        raise ValueError("unique nonempty windows required")
   375	    # Cheap bounded FASTA slices only; never hash or scan a whole genome.
   376	    sequences = [oriented_sequence(genome, w, scorer.context) for w in windows]
   377	    for w in windows:
