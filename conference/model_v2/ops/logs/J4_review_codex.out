   300	def verify_artifact(item, provenance):
   301	    path = Path(item["path"])
   302	    if not path.is_file() or file_sha(path) != item["sha256"]:
   303	        raise ValueError(f"artifact integrity failed: {path}")
   304	    metadata = pq.read_metadata(path)
   305	    if metadata.num_rows != item["rows"] or json.loads(metadata.metadata[b"provenance"]) != provenance:
   306	        raise ValueError(f"artifact integrity/metadata failed: {path}")
