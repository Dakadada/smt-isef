   142	class PangolinScorer:
   143	    """Real, deterministic batched inference. Construction requires Slurm.
   144	
   145	    Models remain on CPU between calls; only one is resident on GPU at a time.
   146	    This bounds accelerator memory independently of ensemble size. A failed
   147	    model call invalidates the entire batch, never a partial ensemble average.
   148	    """
   149	    context = gs.PANGOLIN_CONTEXT
   150	
   151	    def __init__(self, device="cuda"):
   152	        if not os.environ.get("SLURM_JOB_ID"):
   153	            raise RuntimeError("real Pangolin inference requires a Slurm allocation")
   154	        os.environ.setdefault("CUBLAS_WORKSPACE_CONFIG", ":4096:8")
   155	        from feng import source_auth
   156	        identity = source_auth.verify_pangolin_package()
   157	        import torch
   158	        import pangolin.model as pm
   159	        if device not in ("cpu", "cuda") or (device == "cuda" and not torch.cuda.is_available()):
   160	            raise RuntimeError("requested CUDA device unavailable or invalid device")
   161	        self.torch, self.device = torch, device
   162	        torch.set_num_threads(max(1, int(os.environ.get("SLURM_CPUS_PER_TASK", "1"))))
   163	        torch.manual_seed(0)
   164	        torch.use_deterministic_algorithms(True)
   165	        torch.backends.cudnn.benchmark = False
   166	        torch.backends.cudnn.deterministic = True
   167	        torch.backends.cuda.matmul.allow_tf32 = False
   168	        torch.backends.cudnn.allow_tf32 = False
   169	        mdir = Path(pm.__file__).parent / "models"
   170	        hashes, self.models = {}, []
   171	        for filename in gs.PANGOLIN_WEIGHT_FILENAMES:
   172	            path = mdir / filename
   173	            before = file_sha(path)
   174	            model = pm.Pangolin(pm.L, pm.W, pm.AR)
   175	            model.load_state_dict(torch.load(path, map_location="cpu", weights_only=True))
   176	            if before != file_sha(path):
   177	                raise ValueError("weights changed during load")
   178	            model.eval()
   179	            self.models.append(model)
   180	            hashes[filename] = before
   181	        root = Path(__file__).resolve().parents[2]
   182	        source_paths = [Path(__file__), Path(ti.__file__), Path(gs.__file__), Path(ck.__file__),
   183	                        Path(source_auth.__file__), root / "feng/src/feng/pangolin_package_seed_provenance.json"]
   184	        sources = {str(p.relative_to(root)): file_sha(p) for p in source_paths}
   185	        self.provenance = {
   186	            "model": "Pangolin-1.0.2-splice-probability-four-tissue-three-replicate",
   187	            "output_channels": [1, 4, 7, 10],
   188	            "model_sha256": file_sha(pm.__file__), "weights_sha256": digest(hashes),
   189	            "weight_files": hashes, "source_sha256": digest(sources), "source_files": sources,
   190	            **identity, "model_evidence": True, "torch_version": torch.__version__,
   191	            "device": device, "deterministic": True, "tf32": False,
   192	        }
   193	
   194	    def clear_oom(self):
   195	        if self.device == "cuda":
   196	            self.torch.cuda.empty_cache()
   197	
   198	    def predict(self, sequences):
   199	        torch = self.torch
   200	        if not sequences or len({len(s) for s in sequences}) != 1:
   201	            raise ValueError("batch requires equal, nonempty sequence lengths")
   202	        if any(set(s) - set("ACGTN") for s in sequences):
   203	            raise ValueError("non-DNA model input")
   204	        size = len(sequences[0]) - 2 * self.context
   205	        if size < 1:
   206	            raise ValueError("sequence shorter than model context")
   207	        # N is all-zero, matching the existing feng scorer exactly.
   208	        encoded = np.array([[[float(b == base) for b in s] for base in "ACGT"] for s in sequences], dtype=np.float32)
   209	        x = torch.from_numpy(encoded).to(self.device)
   210	        scores = np.zeros((len(sequences), 4, size), dtype=np.float64)
   211	        try:
   212	            with torch.inference_mode():
   213	                for i, model in enumerate(self.models):
   214	                    try:
   215	                        model.to(self.device)
   216	                        prediction = model(x)[:, (1, 4, 7, 10)[i // 3], :].cpu().numpy()
   217	                        if prediction.shape != (len(sequences), size):
   218	                            raise ValueError("unexpected Pangolin output shape")
   219	                        scores[:, i // 3, :] += prediction / 3.0
   220	                    finally:
   221	                        model.cpu()
   222	        finally:
   223	            del x
   224	        return scores
   225	
   226	
   227	def score_batch(scorer, sequences):
   228	    """Return (scores-or-None, reason) per input, retrying smaller OOM batches."""
   229	    if not sequences:
   230	        return []
   231	    try:
   232	        values = np.asarray(scorer.predict(sequences), dtype=float)
   233	        shape = (len(sequences), 4, len(sequences[0]) - 2 * scorer.context)
   234	        if values.shape != shape:
   235	            raise ValueError(f"invalid scorer shape {values.shape}, expected {shape}")
   236	        return [(row, None) if np.isfinite(row).all() else (None, "nonfinite model output") for row in values]
   237	    except Exception as exc:
   238	        reason = f"{type(exc).__name__}: {exc}"
   239	        oom = "out of memory" in str(exc).lower()
   240	    # Outside except: release traceback references to accelerator tensors before retry.
   241	    if oom:
   242	        scorer.clear_oom()
   243	    if len(sequences) > 1:
   244	        middle = len(sequences) // 2
   245	        return score_batch(scorer, sequences[:middle]) + score_batch(scorer, sequences[middle:])
   246	    return [(None, reason)]
   247	
   248	
   249	def row_schema(provenance):
   250	    strings = ["row_id", "locus", "chrom", "strand", "site_kind", "status", "error",
   251	               "evidence_class", "evidence_category"]
   252	    integers = ["window_start", "window_end", "site_position", "tissue", "footprint_start", "footprint_end", "length"]
   253	    fields = [(s, pa.string()) for s in strings] + [(s, pa.int64()) for s in integers]
   254	    fields += [(s, pa.float64()) for s in ("reference_score", "masked_score", "raw_model_delta")]
   255	    fields += [("model_evidence", pa.bool_())]
   256	    return pa.schema(fields, metadata={b"provenance": json.dumps(provenance, sort_keys=True).encode(),
   257	                                      b"coordinates": b"GRCh38; GENCODE v50; 1-based inclusive",
   258	                                      b"interpretation": b"N-ablation cis-feature sensitivity; not occupancy or delta PSI"})
   259	
   260	
   261	@contextmanager
   262	def file_lock(path):
   263	    path.parent.mkdir(parents=True, exist_ok=True)
   264	    with open(path, "a") as stream:
   265	        fcntl.flock(stream, fcntl.LOCK_EX)
   266	        yield
   267	
   268	
   269	def atomic_parquet(path, rows, provenance):
   270	    path.parent.mkdir(parents=True, exist_ok=True)
   271	    temp = path.with_name(f"{path.name}.tmp.{os.getpid()}")
   272	    try:
   273	        pq.write_table(pa.Table.from_pylist(rows, schema=row_schema(provenance)), temp)
   274	        with open(temp, "rb") as stream:
   275	            os.fsync(stream.fileno())
   276	        os.replace(temp, path)
   277	    finally:
   278	        temp.unlink(missing_ok=True)
   279	    return artifact(path, len(rows))
   280	
   281	
   282	def artifact(path, rows):
   283	    return {"path": str(path.resolve()), "sha256": file_sha(path), "rows": rows}
   284	
   285	
   286	def save_manifest(data, path):
   287	    """Detect torn/manual edits as well as corruption of referenced artifacts."""
   288	    ck.save_checkpoint(dict(data, integrity_sha256=digest(data)), path)
   289	
   290	
   291	def load_manifest(path):
   292	    data = ck.load_checkpoint(path)
   293	    if data is not None:
   294	        actual = data.pop("integrity_sha256", None)
   295	        if actual != digest(data):
   296	            raise ValueError(f"manifest integrity failed: {path}")
   297	    return data
   298	
