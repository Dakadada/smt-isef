    67	@dataclass(frozen=True)
    68	class Site:
    69	    position: int
    70	    kind: str
    71	
    72	    def __post_init__(self):
    73	        half_open(self.position, self.position)
    74	        if self.kind not in ("donor", "acceptor"):
    75	            raise ValueError("site kind must be donor or acceptor; position is exonic base")
    76	
    77	
    78	@dataclass(frozen=True)
    79	class Window:
    80	    locus: str
    81	    chrom: str
    82	    strand: str
    83	    center: int
    84	    distance: int
    85	    sites: tuple[Site, ...]
    86	
    87	    def __post_init__(self):
    88	        if not self.locus or not self.chrom or self.strand not in ("+", "-"):
    89	            raise ValueError("invalid locus/chrom/strand")
    90	        if type(self.distance) is not int or not 0 <= self.distance <= 45000:
    91	            raise ValueError("distance must be an integer in 0..45000")
    92	        half_open(self.center - self.distance, self.center + self.distance)
    93	        if not self.sites or len(set(self.sites)) != len(self.sites):
    94	            raise ValueError("nonempty unique splice sites required")
    95	        for site in self.sites:
    96	            gs.readout_index(self.center, site.position, self.distance)
