   269	def atomic_parquet(path, rows, provenance):
   270	    path.parent.mkdir(parents=True, exist_ok=True)
   271	    temp = path.with_name(f"{path.name}.tmp.{os.getpid()}")
   272	    try:
   273	        pq.write_table(pa.Table.from_pylist(rows, schema=row_schema(provenance)), temp)
   274	        with open(temp, "rb") as stream:
   275	            os.fsync(stream.fileno())
   276	        os.replace(temp, path)
   277	    finally:
   278	        temp.unlink(missing_ok=True)
   279	    return artifact(path, len(rows))
