   222	def test_sigterm_flushes_resume_without_requeue(atlas, tmp_path):
   223	    import subprocess
   224	    import sys
   225	    # Only test-double inference in child. Actual SIGTERM exercises the flush hook.
   226	    child = '''
   227	import os, signal
   228	from pathlib import Path
   229	from conference.model_v2.tests.test_gpu_perturbation_atlas import StubScorer, tiny
   230	from conference.model_v2 import gpu_perturbation_atlas as a
   231	class Terminated(StubScorer):
   232	    def predict(self, seqs):
   233	        if len(self.calls) == 2:
   234	            os.kill(os.getpid(), signal.SIGTERM)
   235	        return super().predict(seqs)
   236	genome, window, grid = tiny(a)
   237	a.run_atlas([window], grid, genome, Terminated(), Path(os.environ['ATLAS_TEST_OUT']), batch_size=1)
   238	'''
   239	    env = dict(os.environ, ATLAS_TEST_OUT=str(tmp_path), OPENBLAS_NUM_THREADS='1',
   240	               OMP_NUM_THREADS='1', MKL_NUM_THREADS='1', NUMEXPR_NUM_THREADS='1')
   241	    result = subprocess.run([sys.executable, '-c', child], env=env, capture_output=True, text=True, timeout=20)
   242	    assert result.returncode == 0, result.stderr
   243	    state = json.loads((tmp_path / 'shard_0.checkpoint.json').read_text())
   244	    assert state['next'] == 1 and not (tmp_path / 'shard_0.done').exists()
   245	    genome, window, grid = tiny(atlas)
   246	    done = atlas.run_atlas([window], grid, genome, StubScorer(), tmp_path, batch_size=1)
   247	    assert done['expected_rows'] == 32 and done['failures'] == 0
