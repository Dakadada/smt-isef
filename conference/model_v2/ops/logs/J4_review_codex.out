   423	            while state["next"] < len(work):
   424	                first = state["next"]
   425	                batch = work[first:first + batch_size]
   426	                # Equal-length contexts are mandatory for batching. Split at window boundary.
   427	                batch = batch[:next((i for i, t in enumerate(batch) if t[0] != batch[0][0]), len(batch))]
