import signal
import subprocess
import time
from contextlib import contextmanager
from pathlib import Path
from typing import Any, Callable, Iterator, Optional


def save_checkpoint(state: dict, path: os.PathLike | str) -> Path:
    """Atomically write ``state`` (JSON) to ``path``.

    Writes to a sibling temp file then ``os.replace``s it over the target, so a
    reader never sees a partial file and an existing checkpoint survives a
    failure during serialization. Returns the checkpoint path.
    """
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(f"{path.name}.tmp.{os.getpid()}")
    try:
        with open(tmp, "w", encoding="utf-8") as fh:
            json.dump(state, fh, sort_keys=True, indent=2)
            fh.flush()
            os.fsync(fh.fileno())
        os.replace(tmp, path)
    finally:
        # Never leave a stray tmp file behind if json.dump raised mid-write.
        if tmp.exists():
            try:
                tmp.unlink()
            except OSError:  # pragma: no cover - best-effort cleanup
                pass
    return path


def load_checkpoint(path: os.PathLike | str) -> Optional[dict]:
    """Load a checkpoint, or ``None`` if it does not exist.

    A present-but-corrupt checkpoint raises ``json.JSONDecodeError`` (a real
    problem the caller must see) rather than being silently treated as absent.
    """
    path = Path(path)
    if not path.exists():
        return None
    with open(path, "r", encoding="utf-8") as fh:
        return json.load(fh)


def checkpoint_on_signal(
    on_signal: Callable[[int], Any],
    *,
    signals: tuple[int, ...] = (signal.SIGTERM, signal.SIGUSR1),
    requeue: bool = True,
    exit_after: bool = True,
) -> Iterator[None]:
    """Install handlers that flush a checkpoint on the preemption warning.

    On any of ``signals`` (default SIGTERM + SIGUSR1, matching
    ``--signal=B:SIGTERM@60``), ``on_signal(signum)`` is called — the caller's
    final-flush callback — then, if ``requeue``, :func:`requeue_self` is invoked
    and (if ``exit_after``) the process exits 0 so SLURM's requeue takes effect
    cleanly. Prior handlers are restored on exit. Must be entered from the main
    thread (Python signal constraint).

    Under the ``gpu_preemptable.sbatch`` template, ``B:SIGTERM`` reaches only the
    batch shell, whose trap forwards SIGTERM to this payload and owns the SINGLE
    ``scontrol requeue``. In that wiring pass ``requeue=False`` here (flush-only)
    so requeue does not double-fire; ``exit_after=True`` still lets the payload
    exit cleanly once its final checkpoint is written.
    """
    previous: dict[int, Any] = {}

    def _handler(signum, _frame):
        failure: BaseException | None = None
        try:
            on_signal(signum)
        except BaseException as exc:
            failure = exc
        # Never resume from stale state: requeue is attempted only after the
        # final checkpoint callback completed successfully.
        if failure is None and requeue and not requeue_self():
            failure = RuntimeError("checkpoint succeeded but SLURM requeue failed")
        if exit_after:
            os._exit(1 if failure is not None else 0)
        if failure is not None:
            raise failure

    try:
        for sig in signals:
            previous[sig] = signal.signal(sig, _handler)
        yield
    finally:
        for sig, prev in previous.items():
            try:
                signal.signal(sig, prev)
            except (OSError, ValueError, TypeError):  # pragma: no cover
                pass
    out = str(seq).strip().upper().replace("U", "T")
    _req(len(out) > 0, "empty sequence")
    _req(set(out) <= set("ACGT"), f"non-ACGT characters in sequence: {seq!r}")
    return out


def reverse_complement(seq: str) -> str:
    return seq.upper().translate(_COMP)[::-1]


# --------------------------------------------------------------------------- genome access
class InMemoryGenome:
    """Tiny sequence source for tests: {chrom: plus-strand sequence}."""

    def __init__(self, sequences: Mapping[str, str]):
        self._seqs = {k: v.upper() for k, v in sequences.items()}

    def length(self, chrom: str) -> int:
        if chrom not in self._seqs:
            raise GenomeAccessError(f"unknown contig {chrom!r}")
        return len(self._seqs[chrom])

    def fetch(self, chrom: str, start: int, end: int) -> str:
        n = self.length(chrom)
        if not (1 <= start <= end <= n):
            raise GenomeAccessError(f"slice {chrom}:{start}-{end} outside 1..{n}")
        return self._seqs[chrom][start - 1 : end]


class FaiFastaReader:
    """Pure-python random access via the ``.fai`` index (read-only, small slices)."""

    def __init__(self, fasta_path: Optional[str] = None):
        raw = fasta_path or os.environ.get(FASTA_ENV) or DEFAULT_FASTA
        self.path = Path(os.path.expanduser(str(raw)))
        self.fai_path = Path(str(self.path) + ".fai")
        if not self.path.is_file():
            raise GenomeAccessError(f"genome fasta not found: {self.path}")
        if not self.fai_path.is_file():
            raise GenomeAccessError(f"fasta index not found: {self.fai_path}")
        self._index: Dict[str, Tuple[int, int, int, int]] = {}
        with open(self.fai_path, "r", encoding="ascii") as fh:
            for line in fh:
                parts = line.rstrip("\n").split("\t")
                if len(parts) < 5:
                    continue
                self._index[parts[0]] = (int(parts[1]), int(parts[2]), int(parts[3]), int(parts[4]))

    def length(self, chrom: str) -> int:
        if chrom not in self._index:
            raise GenomeAccessError(f"unknown contig {chrom!r}")
        return self._index[chrom][0]

    def _offset(self, chrom: str, pos0: int) -> int:
        _, off, line_bases, line_width = self._index[chrom]
        return off + (pos0 // line_bases) * line_width + (pos0 % line_bases)

    def fetch(self, chrom: str, start: int, end: int) -> str:
        n = self.length(chrom)
        if not (1 <= start <= end <= n):
            raise GenomeAccessError(f"slice {chrom}:{start}-{end} outside 1..{n}")
        if end - start + 1 > MAX_SLICE_BASES:
            raise GenomeAccessError(f"slice larger than {MAX_SLICE_BASES} bases refused")
        first = self._offset(chrom, start - 1)
        last = self._offset(chrom, end - 1)
        with open(self.path, "rb") as fh:
            fh.seek(first)
            raw = fh.read(last - first + 1)
        seq = raw.replace(b"\n", b"").replace(b"\r", b"").decode("ascii").upper()
        if len(seq) != end - start + 1:
            raise GenomeAccessError(f"short read for {chrom}:{start}-{end}")
        return seq


