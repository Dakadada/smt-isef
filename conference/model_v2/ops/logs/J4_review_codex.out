   309	def rows_for(window, provenance, reference, alt=None, footprint=None, error=None):
   310	    rows = []
   311	    start, end = window.center - window.distance, window.center + window.distance
   312	    for site in sorted(window.sites, key=lambda s: (s.position, s.kind)):
   313	        for tii, tissue in enumerate(TISSUES):
   314	            idx = output_index(window, site.position)
   315	            ref = None if reference is None else float(reference[tii, idx])
   316	            masked = None if alt is None else float(alt[tii, idx])
   317	            failed = error is not None or ref is None or (footprint is not None and masked is None)
   318	            rows.append({
   319	                "row_id": digest([asdict(window), site.position, site.kind, tissue, footprint]),
   320	                "locus": window.locus, "chrom": window.chrom, "strand": window.strand,
   321	                "window_start": start, "window_end": end, "site_position": site.position,
   322	                "site_kind": site.kind, "tissue": tissue,
   323	                "footprint_start": None if footprint is None else footprint[0],
   324	                "footprint_end": None if footprint is None else footprint[1],
   325	                "length": None if footprint is None else footprint[1] - footprint[0] + 1,
   326	                "reference_score": ref, "masked_score": masked,
   327	                "raw_model_delta": None if failed or footprint is None else masked - ref,
   328	                "status": "failed" if failed else "ok", "error": error or ("missing score" if failed else None),
   329	                "evidence_class": "derived" if footprint is None else "sequence_ablation_proxy",
   330	                "evidence_category": "not_available" if failed or not provenance["model_evidence"] else ("derived" if footprint is None else "proxy"),
   331	                "model_evidence": provenance["model_evidence"] and not failed,
   332	            })
   333	    return rows
