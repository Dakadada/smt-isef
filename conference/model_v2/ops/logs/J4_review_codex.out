   470	def cpu_gpu_tolerance(sequences, *, atol=1e-5, rtol=1e-4):
   471	    scorer = PangolinScorer("cuda")
   472	    gpu = scorer.predict(sequences)
   473	    scorer.device = "cpu"
   474	    cpu = scorer.predict(sequences)
   475	    return {"passed": bool(np.allclose(cpu, gpu, atol=atol, rtol=rtol)),
   476	            "max_absolute_error": float(np.max(np.abs(cpu - gpu))), "atol": atol, "rtol": rtol,
   477	            "provenance": scorer.provenance}
   478	
   479	
   480	def smoke_config():
   481	    # Exon-7 donor is LAST EXONIC base, not intron first base 70076575.
   482	    return [Window("SMN2_exon7", "chr5", "+", gs.EXON7_LAST_BASE_1B, 50,
   483	                   (Site(gs.EXON7_LAST_BASE_1B, "donor"),))], Grid((18,), gs.ISS_N1_START_1B - 2, gs.ISS_N1_END_1B + 2, 1)
