    99	@dataclass(frozen=True)
   100	class Grid:
   101	    lengths: tuple[int, ...]
   102	    start: int
   103	    end: int
   104	    stride: int
   105	
   106	    def __post_init__(self):
   107	        half_open(self.start, self.end)
   108	        if type(self.stride) is not int or self.stride <= 0:
   109	            raise ValueError("positive integer stride required")
   110	        if (not self.lengths or len(set(self.lengths)) != len(self.lengths)
   111	                or any(type(n) is not int or not 1 <= n <= self.end - self.start + 1 for n in self.lengths)):
   112	            raise ValueError("unique positive lengths must fit tiling interval")
   113	
   114	
   115	def output_index(window: Window, position: int) -> int:
   116	    index = gs.readout_index(window.center, position, window.distance)
   117	    return index if window.strand == "+" else 2 * window.distance - index
   118	
   119	
   120	def oriented_sequence(genome, window: Window, context: int, footprint=None) -> str:
   121	    start, end = gs.window_bounds_1b(window.center, window.distance, context)
   122	    half_open(start, end)
   123	    seq = genome.fetch(window.chrom, start, end).upper()
   124	    if len(seq) != end - start + 1 or set(seq) - set("ACGTN"):
   125	        raise ValueError("invalid reference sequence or context length")
   126	    if footprint is not None:
   127	        seq = gs.footprint_mask(seq, footprint[0], footprint[1], start)
   128	    return seq if window.strand == "+" else ti.reverse_complement(seq)
   129	
   130	
   131	def tasks(windows, grid: Grid, shard=0, shards=1) -> Iterator[tuple[int, int, int]]:
   132	    if type(shards) is not int or type(shard) is not int or not 0 <= shard < shards:
   133	        raise ValueError("require 0 <= shard < shards")
   134	    for wi, window in enumerate(windows):
   135	        for length in sorted(grid.lengths):
   136	            for start in range(grid.start, grid.end - length + 2, grid.stride):
   137	                identity = [asdict(window), start, length]
   138	                if int(digest(identity), 16) % shards == shard:
   139	                    yield wi, start, length
