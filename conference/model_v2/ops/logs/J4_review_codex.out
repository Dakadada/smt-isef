   403	        state = load_manifest(checkpoint) or {"run_id": run_id, "next": 0, "parts": [], "references": []}
   404	        if state["run_id"] != run_id or not 0 <= state["next"] <= len(work):
   405	            raise ValueError("checkpoint config/integrity mismatch")
