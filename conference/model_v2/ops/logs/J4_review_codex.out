   250	def test_sentinel_shell_is_single_requeue_owner(tmp_path):
   251	    import signal
   252	    import subprocess
   253	    import time
   254	    job = Path(__file__).resolve().parents[1] / 'jobs/j4_sentinel.sbatch'
   255	    fake_env = tmp_path / 'env'
   256	    fake_bin = fake_env / 'bin'
   257	    fake_bin.mkdir(parents=True)
   258	    (fake_bin / 'python').write_text('''#!/bin/bash
   259	trap 'echo flushed > "$TEST_DIR/flushed"; exit 0' TERM
   260	: > "$TEST_DIR/started"
   261	while true; do sleep 0.1; done
   262	''')
   263	    (fake_bin / 'python').chmod(0o755)
   264	    (fake_bin / 'scontrol').write_text('''#!/bin/bash
   265	test -f "$TEST_DIR/flushed" || exit 1
   266	echo "$*" >> "$TEST_DIR/requeues"
   267	''')
   268	    (fake_bin / 'scontrol').chmod(0o755)
   269	    startup = tmp_path / 'startup'
   270	    startup.write_text('module() { :; }; export -f module\n')
   271	    env = dict(os.environ, BASH_ENV=str(startup), PATH=str(fake_bin) + ':' + os.environ['PATH'],
   272	               J4_GPU_ENV=str(fake_env), J4_OUT_DIR=str(tmp_path / 'out'), TEST_DIR=str(tmp_path), SLURM_JOB_ID='123')
   273	    child = subprocess.Popen(['bash', str(job)], env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
   274	    try:
   275	        deadline = time.monotonic() + 5
   276	        while not (tmp_path / 'started').exists() and child.poll() is None and time.monotonic() < deadline:
   277	            time.sleep(.05)
   278	        assert (tmp_path / 'started').exists()
   279	        child.send_signal(signal.SIGTERM)
   280	        _, err = child.communicate(timeout=5)
   281	        assert child.returncode == 0, err
   282	        assert (tmp_path / 'requeues').read_text().splitlines() == ['requeue 123']
   283	    finally:
   284	        if child.poll() is None:
   285	            child.kill()
   286	            child.wait()
   287	
