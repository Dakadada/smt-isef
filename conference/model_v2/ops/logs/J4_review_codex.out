   249	def row_schema(provenance):
   250	    strings = ["row_id", "locus", "chrom", "strand", "site_kind", "status", "error",
   251	               "evidence_class", "evidence_category"]
   252	    integers = ["window_start", "window_end", "site_position", "tissue", "footprint_start", "footprint_end", "length"]
   253	    fields = [(s, pa.string()) for s in strings] + [(s, pa.int64()) for s in integers]
