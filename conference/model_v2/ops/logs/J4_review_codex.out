   336	def reference_scores(window, sequence, scorer, directory, provenance):
   337	    key = digest({"window": asdict(window), "context": scorer.context,
   338	                  "sequence_sha256": hashlib.sha256(sequence.encode()).hexdigest(), "provenance": provenance})
   339	    marker = directory / f"{key}.done"
   340	    with file_lock(directory / f"{key}.lock"):
   341	        if marker.exists():
   342	            record = load_manifest(marker)
   343	            if record["key"] != key or record["provenance"] != provenance:
   344	                raise ValueError("reference cache integrity failed")
   345	            verify_artifact(record["artifact"], provenance)
   346	            rows = pq.read_table(record["artifact"]["path"]).to_pylist()
   347	        else:
   348	            values, reason = score_batch(scorer, [sequence])[0]
   349	            rows = rows_for(window, provenance, values, error=reason)
   350	            # Failed attempts cannot overwrite artifacts cited by another run.
   351	            path = directory / f"{key}_{digest(rows)}.parquet"
   352	            record = {"key": key, "provenance": provenance,
   353	                      "artifact": atomic_parquet(path, rows, provenance)}
   354	            # Failed references remain explicit artifacts, but are not reusable cache hits.
   355	            if reason is None:
   356	                save_manifest(record, marker)
   357	    return reference_from_rows(window, rows, record["artifact"])
