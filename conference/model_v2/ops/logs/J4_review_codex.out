   486	def main(argv=None):
   487	    parser = argparse.ArgumentParser(description=__doc__)
   488	    mode = parser.add_mutually_exclusive_group(required=True)
   489	    mode.add_argument("--smoke", action="store_true")
   490	    mode.add_argument("--config", type=Path)
   491	    parser.add_argument("--output-dir", type=Path, required=True)
   492	    parser.add_argument("--fasta", default=ti.DEFAULT_FASTA)
   493	    parser.add_argument("--batch-size", type=int, default=4)
   494	    parser.add_argument("--shard", type=int, default=0)
   495	    parser.add_argument("--shards", type=int, default=1)
   496	    parser.add_argument("--check-tolerance", action="store_true")
   497	    args = parser.parse_args(argv)
   498	    if args.smoke:
   499	        windows, grid = smoke_config()
   500	    else:
   501	        config = json.loads(args.config.read_text())
   502	        if config.get("assembly") != ti.ASSEMBLY or config.get("annotation") != ti.ANNOTATION:
   503	            raise ValueError("GRCh38 / GENCODE v50 assembly fence required")
   504	        windows = [Window(**dict(w, sites=tuple(Site(**s) for s in w["sites"]))) for w in config["windows"]]
   505	        grid = Grid(**dict(config["grid"], lengths=tuple(config["grid"]["lengths"])))
   506	    # Startup has no completed work to persist. Shell remains sole requeue owner.
   507	    with ck.checkpoint_on_signal(lambda _sig: None, requeue=False):
   508	        genome = ti.FaiFastaReader(args.fasta)
   509	        scorer = PangolinScorer()
   510	        done = run_atlas(windows, grid, genome, scorer, args.output_dir,
   511	                         batch_size=args.batch_size, shard=args.shard, shards=args.shards)
   512	        if args.check_tolerance:
   513	            del scorer
   514	            report = cpu_gpu_tolerance([oriented_sequence(genome, windows[0], gs.PANGOLIN_CONTEXT)])
   515	            ck.save_checkpoint(report, args.output_dir / "cpu_gpu_tolerance.json")
   516	            if not report["passed"]:
   517	                return 1
   518	        print(json.dumps({k: done[k] for k in ("status", "expected_rows", "failures", "run_id")}, sort_keys=True))
   519	        return int(done["failures"] > 0)
   520	
   521	
   522	if __name__ == "__main__":
   523	    raise SystemExit(main())

