new file mode 100644
index 0000000000000000000000000000000000000000..f606b304bb88c4ab1d4c2b8ce22e84ccf352089b
--- /dev/null
+++ b/conference/model_v2/j6_site_universe.py
@@ -0,0 +1,503 @@
+"""Derived, substitution-only ASO sites in GRCh38 / GENCODE v50 pre-mRNA.
+
+Coverage: complete contiguous gene bodies, including exons AND introns, on the
+annotated gene strand; no intergenic sequence, no exon-union index, and no
+splice-concatenated RNA. A hit must fit entirely inside its gene. Ambiguous
+reference bases count as substitutions, never wildcards. K defaults to 3 (use
+0, 1, 2, or 3 for the usual nested universes); edit distance is not implemented.
+
+The GTF loader reads gene records only. Consequently region_class and transcript
+membership are not_available/null unless callers supply Transcript annotations.
+With annotations, junction-spanning means a *genomic exon/intron boundary*, not
+a spliced exon/exon junction. Alternative-transcript classes are preserved.
+Same ASO/coordinates/strand within one gene collapse to one record, with sorted
+transcript IDs; different genes (including paralogs) NEVER collapse. Gene-only
+records have transcript_ids=None, not a fabricated empty transcript list.
+
+Shards own genomic leftmost starts in closed, fixed chromosome windows; a right
+halo retains boundary hits on both strands. Region bounds restrict starts, not
+ends. IDs depend on coordinates/gene/ASO/sequence, not sharding or K. SMN ambiguity
+means the identical transcript-sense sequence was verified in the other SMN gene
+in the supplied gene universe, even if it lies outside the current shard.
+
+Outputs are explicit-schema Parquet, then an atomic .done JSON commit marker.
+Restart verifies parameters, input identities, row count, and Parquet SHA256.
+Input identities use resolved path/size/mtime_ns/inode plus FAI SHA256; they are
+filesystem identities, NOT full FASTA/GTF content hashes. Inputs must be immutable
+during a run. No full reference hashing or unbounded reference fetch is performed.
+
+CLI (from repo root, with PYTHONPATH=feng/src):
+  python -m conference.model_v2.j6_site_universe --output-dir OUT [--region chr5:70000000-71100000]
+"""
+from __future__ import annotations
+
+import argparse
+from dataclasses import asdict, dataclass
+import fcntl
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+import tempfile
+from typing import Mapping, Sequence
+
+from conference.model_v2.trans_intervention import (
+    ANNOTATION, ASSEMBLY, ASOS, ASO, DEFAULT_FASTA, FaiFastaReader,
+    MAX_SLICE_BASES, reverse_complement,
+)
+from feng.scan.seed_extend import seed_and_extend
+
+VERSION = "1.0.0"
+DEFAULT_GTF = "~/orcd/scratch/feng/gencode/v50/gencode.v50.primary_assembly.annotation.gtf"
+DEFAULT_WINDOW = 50_000
+
+
+def _interval(start, end):
+    if type(start) is not int or type(end) is not int or not 1 <= start <= end:
+        raise ValueError("coordinates must be integers with 1 <= start <= end")
+
+
+@dataclass(frozen=True)
+class Transcript:
+    transcript_id: str
+    start1: int
+    end1: int
+    exons: tuple[tuple[int, int], ...]
+    utrs: tuple[tuple[int, int], ...] = ()
+
+    def __post_init__(self):
+        _interval(self.start1, self.end1)
+        if not self.transcript_id or not self.exons:
+            raise ValueError("transcript ID and complete exon intervals required")
+        for lo, hi in self.exons + self.utrs:
+            _interval(lo, hi)
+            if not self.start1 <= lo <= hi <= self.end1:
+                raise ValueError("feature outside transcript")
+        exons = sorted(self.exons)
+        if any(a[1] >= b[0] for a, b in zip(exons, exons[1:])):
+            raise ValueError("overlapping exon intervals within a transcript")
+        for lo, hi in self.utrs:
+            if not any(a <= lo <= hi <= b for a, b in self.exons):
+                raise ValueError("UTR outside exons")
+
+
+@dataclass(frozen=True)
+class Gene:
+    gene_id: str
+    chrom: str
+    start1: int
+    end1: int
+    strand: str
+    gene_name: str = ""
+    transcripts: tuple[Transcript, ...] | None = None
+
+    def __post_init__(self):
+        _interval(self.start1, self.end1)
+        if not self.gene_id or not self.chrom or self.strand not in ("+", "-"):
+            raise ValueError("gene ID, chromosome and +/- strand required")
+        if self.transcripts is not None:
+            ids = [t.transcript_id for t in self.transcripts]
+            if not ids or len(ids) != len(set(ids)):
+                raise ValueError("supply distinct transcripts, or None for unavailable")
+            if any(not self.start1 <= t.start1 <= t.end1 <= self.end1 for t in self.transcripts):
+                raise ValueError("transcript outside gene")
+
+
+@dataclass(frozen=True, order=True)
+class Shard:
+    chrom: str
+    start1: int
+    end1: int
+
+    def __post_init__(self):
+        _interval(self.start1, self.end1)
+        if not re.fullmatch(r"[A-Za-z0-9_.-]+", self.chrom):
+            raise ValueError("unsafe chromosome name")
+
+    @property
+    def shard_id(self):
+        return f"{self.chrom}.{self.start1:012d}-{self.end1:012d}"
+
+
+@dataclass(frozen=True)
+class Site:
+    site_id: str
+    aso_id: str
+    chrom: str
+    start1: int
+    end1: int
+    strand: str
+    gene_id: str
+    gene_name: str
+    region_class: str
+    region_classes: tuple[str, ...]
+    transcript_ids: tuple[str, ...] | None
+    mismatch_count: int
+    mismatch_positions: tuple[int, ...]
+    target_sequence: str
+    paralog_ambiguity: bool
+    evidence_class: str = "derived"
+    assembly: str = ASSEMBLY
+    annotation: str = ANNOTATION
+
+
+def _json(value):
+    return json.dumps(value, sort_keys=True, separators=(",", ":"), ensure_ascii=True)
+
+
+def _digest(value):
+    return hashlib.sha256(_json(value).encode()).hexdigest()
+
+
+def _genes(genes):
+    unique = {}
+    for gene in genes:
+        if gene.gene_id in unique and unique[gene.gene_id] != gene:
+            raise ValueError(f"conflicting records for gene {gene.gene_id}")
+        unique[gene.gene_id] = gene
+    return tuple(sorted(unique.values(), key=lambda g: (g.chrom, g.start1, g.end1, g.gene_id)))
+
+
+def _budget(value):
+    if type(value) is not int:
+        raise TypeError("max_mismatch must be an integer")
+    if value < 0:
+        raise ValueError("max_mismatch must be nonnegative")
+
+
+def read_gene_bodies(path, *, region=None) -> tuple[Gene, ...]:
+    """Stream one known GTF file; parse only gene lines, retain full gene bounds.
+
+    Header must explicitly identify GRCh38 and version 50. No feature/transcript
+    inference is attempted. Optional region bounds filter overlapping genes.
+    """
+    if region is not None:
+        Shard(*region)
+    genes = []
+    valid_header = False
+    with Path(path).expanduser().open() as handle:
+        for line in handle:
+            if line.startswith("#"):
+                if line.startswith("##description:"):
+                    if not (re.search(r"\bGRCh38\b", line) and re.search(r"\bversion 50\b", line)):
+                        raise ValueError("GTF must declare GRCh38 / GENCODE version 50")
+                    valid_header = True
+                continue
+            prefix = line.split("\t", 3)
+            if len(prefix) < 4 or prefix[2] != "gene":
+                continue
+            fields = line.rstrip("\n").split("\t")
+            if len(fields) != 9:
+                raise ValueError("malformed GTF gene record")
+            chrom, _, _, lo, hi, _, strand, _, attrs = fields
+            lo, hi = int(lo), int(hi)
+            if region and (chrom != region[0] or hi < region[1] or lo > region[2]):
+                continue
+            attributes = dict(re.findall(r'(\w+) "([^"\n]*)";', attrs))
+            genes.append(Gene(attributes["gene_id"], chrom, lo, hi, strand,
+                              attributes.get("gene_name", "")))
+    if not valid_header:
+        raise ValueError("missing GRCh38 / GENCODE v50 GTF description")
+    return _genes(genes)
+
+
+def make_shards(genes, *, window_size=DEFAULT_WINDOW, region=None) -> tuple[Shard, ...]:
+    """Stable chromosome windows; region clipping affects the explicit shard ID."""
+    if type(window_size) is not int or window_size < 1 or window_size > MAX_SLICE_BASES:
+        raise ValueError("window_size must be 1..100000")
+    if region is not None:
+        Shard(*region)
+    windows = set()
+    for gene in _genes(genes):
+        lo, hi = gene.start1, gene.end1
+        if region:
+            if gene.chrom != region[0]:
+                continue
+            lo, hi = max(lo, region[1]), min(hi, region[2])
+        if lo > hi:
+            continue
+        for index in range((lo - 1) // window_size, (hi - 1) // window_size + 1):
+            start, end = index * window_size + 1, (index + 1) * window_size
+            if region:
+                start, end = max(start, region[1]), min(end, region[2])
+            windows.add(Shard(gene.chrom, start, end))
+    return tuple(sorted(windows))
+
+
+def site_sort_key(site):
+    return site.chrom, site.start1, site.end1, site.strand, site.gene_id, site.aso_id
+
+
+def _annotation(gene, start, end):
+    if gene.transcripts is None:
+        return "not_available", (), None
+    classes, transcripts = set(), []
+    for tx in gene.transcripts:
+        if not tx.start1 <= start <= end <= tx.end1:
+            continue
+        transcripts.append(tx.transcript_id)
+        exon_bases = sum(max(0, min(end, b) - max(start, a) + 1) for a, b in tx.exons)
+        if exon_bases == 0:
+            classes.add("intron")
+        elif exon_bases < end - start + 1:
+            classes.add("junction-spanning")
+        elif any(a <= start <= end <= b for a, b in tx.utrs):
+            classes.add("UTR")
+        else:
+            classes.add("exon")
+    regions = tuple(sorted(classes))
+    region = regions[0] if len(regions) == 1 else "transcript_dependent" if regions else "not_available"
+    return region, regions, tuple(sorted(transcripts))
+
+
+def _fetch(genome, chrom, start, end):
+    """Bound every individual public FASTA fetch, including API-only large shards."""
+    parts = []
+    for lo in range(start, end + 1, MAX_SLICE_BASES):
+        hi = min(end, lo + MAX_SLICE_BASES - 1)
+        part = genome.fetch(chrom, lo, hi)
+        if len(part) != hi - lo + 1:
+            raise ValueError("short reference fetch")
+        parts.append(part)
+    return "".join(parts).upper()
+
+
+def enumerate_sites(genome, genes: Sequence[Gene], asos: Sequence[ASO], *,
+                    max_mismatch=3, shard: Shard | None = None) -> list[Site]:
+    """Complete Hamming enumeration, using Feng seed-and-extend read-only.
+
+    Memory is bounded by a chromosome window plus output rows for that window.
+    Unsharded calls internally use the same windows, retaining identical site IDs.
+    """
+    _budget(max_mismatch)
+    genes = _genes(genes)
+    asos = tuple(sorted(asos, key=lambda a: a.aso_id))
+    if len({a.aso_id for a in asos}) != len(asos):
+        raise ValueError("duplicate ASO IDs")
+    if not asos:
+        raise ValueError("at least one ASO is required")
+    if shard is None:
+        return sorted([site for window in make_shards(genes)
+                       for site in enumerate_sites(genome, genes, asos,
+                                                   max_mismatch=max_mismatch, shard=window)],
+                      key=site_sort_key)
+    selected = [g for g in genes if g.chrom == shard.chrom and
+                g.start1 <= shard.end1 and g.end1 >= shard.start1]
+    if not selected:
+        return []
+    length = genome.length(shard.chrom)
+    if any(g.end1 > length for g in selected):
+        raise ValueError("gene outside reference chromosome")
+    halo_end = min(length, shard.end1 + max(a.length for a in asos) - 1)
+    if shard.start1 > length:
+        return []
+    sequence = _fetch(genome, shard.chrom, shard.start1, halo_end)
+    sites = []
+    paralog_sequences = {}
+    for gene in selected:
+        start = max(gene.start1, shard.start1)
+        end = min(gene.end1, halo_end)
+        reference = sequence[start - shard.start1:end - shard.start1 + 1]
+        for aso in asos:
+            query = aso.target_sequence if gene.strand == "+" else aso.sequence_5to3
+            for hit in seed_and_extend(query, reference, max_mismatch=max_mismatch):
+                lo, hi = start + hit.start, start + hit.end - 1
+                if lo > shard.end1:
+                    continue
+                target = reference[hit.start:hit.end]
+                if gene.strand == "-":
+                    target = reverse_complement(target)
+                positions = tuple(sorted(aso.length - i for i, (a, b) in
+                                         enumerate(zip(aso.target_sequence, target)) if a != b))
+                if len(positions) != hit.mismatches:
+                    raise ValueError("scanner/mismatch-position disagreement")
+                ambiguous = False
+                if gene.gene_name in ("SMN1", "SMN2"):
+                    other_name = "SMN1" if gene.gene_name == "SMN2" else "SMN2"
+                    for other in genes:
+                        if other.gene_name != other_name:
+                            continue
+                        if other.gene_id not in paralog_sequences:
+                            seq = _fetch(genome, other.chrom, other.start1, other.end1)
+                            paralog_sequences[other.gene_id] = seq if other.strand == "+" else reverse_complement(seq)
+                        if target in paralog_sequences[other.gene_id]:
+                            ambiguous = True
+                            break
+                region, regions, transcripts = _annotation(gene, lo, hi)
+                identity = [ASSEMBLY, ANNOTATION, aso.aso_id, aso.sequence_5to3,
+                            gene.gene_id, gene.chrom, lo, hi, gene.strand, target]
+                sites.append(Site("j6-" + _digest(identity), aso.aso_id, gene.chrom, lo, hi,
+                                  gene.strand, gene.gene_id, gene.gene_name, region, regions,
+                                  transcripts, hit.mismatches, positions, target, ambiguous))
+    return sorted(sites, key=site_sort_key)
+
+
+def _sha256(path):
+    digest = hashlib.sha256()
+    with Path(path).open("rb") as handle:
+        for block in iter(lambda: handle.read(1024 * 1024), b""):
+            digest.update(block)
+    return digest.hexdigest()
+
+
+def file_identity(path):
+    path = Path(path).expanduser().resolve(strict=True)
+    info = path.stat()
+    result = dict(path=str(path), size=info.st_size, mtime_ns=info.st_mtime_ns, inode=info.st_ino)
+    fai = Path(str(path) + ".fai")
+    if fai.is_file():
+        result["fai_sha256"] = _sha256(fai)
+    return result
+
+
+def _check_identities(identities):
+    for identity in identities.values():
+        if "path" in identity and file_identity(identity["path"]) != identity:
+            raise ValueError("reference input identity changed during run")
+
+
+def _schema():
+    import pyarrow as pa
+    return pa.schema([
+        ("site_id", pa.string()), ("aso_id", pa.string()), ("chrom", pa.string()),
+        ("start1", pa.int64()), ("end1", pa.int64()), ("strand", pa.string()),
+        ("gene_id", pa.string()), ("gene_name", pa.string()), ("region_class", pa.string()),
+        ("region_classes", pa.list_(pa.string())), ("transcript_ids", pa.list_(pa.string())),
+        ("mismatch_count", pa.int32()), ("mismatch_positions", pa.list_(pa.int32())),
+        ("target_sequence", pa.string()), ("paralog_ambiguity", pa.bool_()),
+        ("evidence_class", pa.string()), ("assembly", pa.string()), ("annotation", pa.string()),
+    ])
+
+
+def _fsync_dir(path):
+    fd = os.open(path, os.O_RDONLY)
+    try:
+        os.fsync(fd)
+    finally:
+        os.close(fd)
+
+
+def run_shard(*, genome, genes, asos, shard, output_dir, identities: Mapping,
+              max_mismatch=3) -> Path:
+    """Commit/reuse one shard; .done is the sole completeness marker.
+
+    Per-shard advisory locks serialize concurrent retries. Orphan temporary files
+    are ignored; absent/invalid markers or changed parameters force a rebuild.
+    """
+    import pyarrow as pa
+    import pyarrow.parquet as pq
+    _budget(max_mismatch)
+    if not {"fasta", "gtf"} <= identities.keys():
+        raise ValueError("both FASTA and GTF identities are required")
+    genes = _genes(genes)
+    asos = tuple(sorted(asos, key=lambda a: a.aso_id))
+    if not asos or len({a.aso_id for a in asos}) != len(asos):
+        raise ValueError("distinct ASO IDs required")
+    output_dir = Path(output_dir)
+    output_dir.mkdir(parents=True, exist_ok=True)
+    path = output_dir / (shard.shard_id + ".parquet")
+    done = path.with_suffix(".done")
+    import feng.scan.seed_extend as scanner
+    params = dict(version=VERSION, assembly=ASSEMBLY, annotation=ANNOTATION,
+                  shard=asdict(shard), max_mismatch=max_mismatch, mode="substitutions",
+                  asos=[dict(aso_id=a.aso_id, sequence=a.sequence_5to3) for a in asos],
+                  gene_universe_sha256=_digest([asdict(g) for g in genes]),
+                  implementation_sha256=_sha256(__file__), scanner_sha256=_sha256(scanner.__file__))
+    expected = json.loads(_json(dict(params=params, identities=identities)))
+    with path.with_suffix(".lock").open("a") as lock:
+        fcntl.flock(lock, fcntl.LOCK_EX)
+        _check_identities(identities)
+        try:
+            manifest = json.loads(done.read_text())
+            if (all(manifest.get(k) == v for k, v in expected.items()) and
+                    manifest["sha256"] == _sha256(path) and
+                    manifest["rows"] == pq.read_metadata(path).num_rows):
+                return path
+        except (OSError, ValueError, KeyError, TypeError, pa.ArrowException):
+            pass
+        # Invalidate the old commit marker BEFORE replacing its data file.
+        done.unlink(missing_ok=True)
+        _fsync_dir(output_dir)
+        sites = enumerate_sites(genome, genes, asos, max_mismatch=max_mismatch, shard=shard)
+        _check_identities(identities)
+        table = pa.Table.from_pylist([asdict(s) for s in sites], schema=_schema())
+        temps = []
+        try:
+            fd, temp = tempfile.mkstemp(prefix=shard.shard_id + ".", suffix=".tmp", dir=output_dir)
+            os.close(fd)
+            temps.append(Path(temp))
+            pq.write_table(table, temp, compression="zstd")
+            with open(temp, "rb") as handle:
+                os.fsync(handle.fileno())
+            sha = _sha256(temp)
+            os.replace(temp, path)
+            _fsync_dir(output_dir)
+            manifest = dict(**expected, rows=table.num_rows, sha256=sha)
+            _check_identities(identities)
+            fd, temp = tempfile.mkstemp(prefix=shard.shard_id + ".", suffix=".tmp", dir=output_dir)
+            temps.append(Path(temp))
+            with os.fdopen(fd, "w") as handle:
+                handle.write(_json(manifest) + "\n")
+                handle.flush()
+                os.fsync(handle.fileno())
+            os.replace(temp, done)
+            _fsync_dir(output_dir)
+        finally:
+            for temp in temps:
+                temp.unlink(missing_ok=True)
+    return path
+
+
+def _region(text):
+    match = re.fullmatch(r"([A-Za-z0-9_.-]+):(\d+)-(\d+)", text)
+    if not match:
+        raise argparse.ArgumentTypeError("region must be chrom:start1-end1")
+    chrom, start, end = match.groups()
+    try:
+        return_tuple = chrom, int(start), int(end)
+        Shard(*return_tuple)
+        return return_tuple
+    except ValueError as exc:
+        raise argparse.ArgumentTypeError(str(exc)) from exc
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--fasta", default=DEFAULT_FASTA)
+    parser.add_argument("--gtf", default=DEFAULT_GTF)
+    parser.add_argument("--output-dir", required=True)
+    parser.add_argument("--region", type=_region)
+    parser.add_argument("--asos", nargs="+", choices=sorted(ASOS), default=["F18", "F14", "F10"])
+    parser.add_argument("--max-mismatch", type=int, default=3)
+    parser.add_argument("--window-size", type=int, default=DEFAULT_WINDOW)
+    parser.add_argument("--shard-index", type=int, default=0)
+    parser.add_argument("--shard-count", type=int, default=1)
+    args = parser.parse_args(argv)
+    _budget(args.max_mismatch)
+    if not 0 <= args.shard_index < args.shard_count:
+        parser.error("require 0 <= shard-index < shard-count")
+    genome = FaiFastaReader(args.fasta)
+    identities = dict(fasta=file_identity(genome.path), gtf=file_identity(args.gtf))
+    genes = read_gene_bodies(args.gtf, region=args.region)
+    if file_identity(args.gtf) != identities["gtf"]:
+        raise ValueError("GTF changed while reading")
+    if not genes:
+        parser.error("no gene bodies overlap the requested universe")
+    asos = [ASOS[name] for name in args.asos]
+    shards = make_shards(genes, window_size=args.window_size, region=args.region)
+    for index, shard in enumerate(shards):
+        if index % args.shard_count != args.shard_index:
+            continue
+        if (file_identity(genome.path) != identities["fasta"] or
+                file_identity(args.gtf) != identities["gtf"]):
+            raise ValueError("reference input identity changed during run")
+        path = run_shard(genome=genome, genes=genes, asos=asos, shard=shard,
+                         output_dir=args.output_dir, identities=identities,
+                         max_mismatch=args.max_mismatch)
+        print(path, flush=True)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/conference/model_v2/jobs/j6_sentinel.sbatch b/conference/model_v2/jobs/j6_sentinel.sbatch
new file mode 100644
index 0000000000000000000000000000000000000000..085db5210f01a7df8fd42636490294b6f4200c92
--- /dev/null
+++ b/conference/model_v2/jobs/j6_sentinel.sbatch
@@ -0,0 +1,17 @@
+#!/bin/bash
+#SBATCH --job-name=mv2-j6-sentinel
+#SBATCH --partition=mit_quicktest
+#SBATCH --time=00:10:00
+#SBATCH --mem=4G
+#SBATCH --cpus-per-task=1
+#SBATCH --requeue
+#SBATCH --output=/home/dashii/smt-isef/conference/model_v2/ops/logs/%x-%j.out
+set -euo pipefail
+cd /home/dashii/smt-isef
+export PYTHONPATH=feng/src${PYTHONPATH:+:$PYTHONPATH}
+exec /home/dashii/orcd/pool/smt-isef-env/bin/python \
+  -m conference.model_v2.j6_site_universe \
+  --fasta "$HOME/orcd/scratch/feng/gencode/v50/GRCh38.primary_assembly.genome.fa" \
+  --gtf "$HOME/orcd/scratch/feng/gencode/v50/gencode.v50.primary_assembly.annotation.gtf" \
+  --output-dir "$HOME/orcd/scratch/feng/model_v2/j6_sentinel" \
+  --region chr5:70000000-71100000 --asos F18 F14 F10 --max-mismatch 3
diff --git a/conference/model_v2/tests/test_j6_site_universe.py b/conference/model_v2/tests/test_j6_site_universe.py
new file mode 100644
index 0000000000000000000000000000000000000000..73ef801fdb1335110766e5499aa12c580c2b4634
--- /dev/null
+++ b/conference/model_v2/tests/test_j6_site_universe.py
@@ -0,0 +1,331 @@
+"""J6: independent Hamming oracle, annotation, coordinates, and crash recovery."""
+import dataclasses
+import hashlib
+import json
+import random
+import subprocess
+import sys
+from pathlib import Path
+
+import pytest
+
+ROOT = Path(__file__).resolve().parents[3]
+sys.path.insert(0, str(ROOT))
+sys.path.insert(0, str(ROOT / "feng/src"))
+from conference.model_v2 import trans_intervention as ti
+
+
+def module():
+    from conference.model_v2 import j6_site_universe
+    return j6_site_universe
+
+
+def test_module_exposes_site_enumerator():
+    assert callable(module().enumerate_sites)
+
+
+def rc(seq):
+    return seq.translate(str.maketrans("ACGTN", "TGCAN"))[::-1]
+
+
+def oracle(seqs, genes, asos, k):
+    rows = set()
+    for gene in genes:
+        for aso in asos:
+            query = rc(aso.sequence_5to3)
+            for start in range(gene.start1, gene.end1 - len(query) + 2):
+                target = seqs[gene.chrom][start - 1:start + len(query) - 1]
+                if gene.strand == "-":
+                    target = rc(target)
+                positions = tuple(sorted(len(query) - i for i, (a, b) in
+                                         enumerate(zip(query, target)) if a != b or b == "N"))
+                if len(positions) <= k:
+                    rows.add((aso.aso_id, gene.chrom, start, start + len(query) - 1,
+                              gene.strand, gene.gene_id, target, positions))
+    return rows
+
+
+def key(site):
+    return (site.aso_id, site.chrom, site.start1, site.end1, site.strand,
+            site.gene_id, site.target_sequence, site.mismatch_positions)
+
+
+@pytest.mark.parametrize("k", range(4))
+@pytest.mark.parametrize("seed", [0, 17, 98])
+def test_seed_extend_equals_independent_oracle_with_edges_N_overlaps(seed, k):
+    j = module()
+    rng = random.Random(seed)
+    seq = list("".join(rng.choice("ACGTN") for _ in range(190)))
+    target = "AACGTT"
+    for pos, planted in [(0, target), (15, "AATGTT"), (40, rc(target)),
+                         (65, "AACNTT"), (100, "AAAAAAA"), (184, target)]:
+        seq[pos:pos + len(planted)] = planted
+    seqs = {"chrT": "".join(seq), "chrTiny": "AC"}
+    genes = [j.Gene("g+", "chrT", 1, 190, "+"),
+             j.Gene("g-", "chrT", 1, 190, "-"),
+             j.Gene("partial", "chrT", 3, 187, "+"),
+             j.Gene("tiny", "chrTiny", 1, 2, "+")]
+    asos = [ti.ASO("q", rc(target)), ti.ASO("overlap", "TTTT"), ti.ASO("short", "A")]
+    genome = ti.InMemoryGenome(seqs)
+    expected = oracle(seqs, genes, asos, k)
+    unsharded = j.enumerate_sites(genome, genes, asos, max_mismatch=k)
+    assert {key(s) for s in unsharded} == expected
+    sharded = [s for shard in j.make_shards(genes, window_size=13)
+               for s in j.enumerate_sites(genome, genes, asos, max_mismatch=k, shard=shard)]
+    assert {key(s) for s in sharded} == expected
+    assert len(sharded) == len(expected)
+    assert {s.site_id for s in sharded} == {s.site_id for s in unsharded}
+    assert all(s.mismatch_count == len(s.mismatch_positions) and s.evidence_class == "derived"
+               for s in sharded)
+
+
+@pytest.mark.parametrize("strand,sequence,want", [("+", "TACGTA", (4,)), ("-", "TACGTA", (4,))])
+def test_mismatch_positions_are_one_based_ASO_five_prime(strand, sequence, want):
+    j = module()
+    sense = sequence
+    genome = ti.InMemoryGenome({"chrT": sense if strand == "+" else rc(sense)})
+    sites = j.enumerate_sites(genome, [j.Gene("g", "chrT", 1, 6, strand)],
+                              [ti.ASO("a", rc("TATGTA"))], max_mismatch=1)
+    assert len(sites) == 1
+    assert sites[0].mismatch_positions == want
+    assert sites[0].target_sequence == sense
+
+
+def test_annotation_collapses_transcripts_but_not_overlapping_genes():
+    j = module()
+    transcripts = (j.Transcript("t2", 1, 16, ((1, 8), (13, 16)), ((1, 4),)),
+                   j.Transcript("t1", 1, 16, ((1, 8), (13, 16)), ((1, 4),)))
+    genes = [j.Gene("g", "chrT", 1, 16, "+", transcripts=transcripts),
+             j.Gene("other", "chrT", 1, 16, "+")]
+    sites = j.enumerate_sites(ti.InMemoryGenome({"chrT": "A" * 16}), genes,
+                              [ti.ASO("a", "TTTT")], max_mismatch=0)
+    assert len(sites) == 26
+    by_start = {s.start1: s for s in sites if s.gene_id == "g"}
+    assert by_start[1].region_class == "UTR"
+    assert by_start[5].region_class == "exon"
+    assert by_start[7].region_class == "junction-spanning"
+    assert by_start[9].region_class == "intron"
+    assert by_start[1].transcript_ids == ("t1", "t2")
+    assert all(s.region_class == "not_available" and s.transcript_ids is None
+               for s in sites if s.gene_id == "other")
+
+
+def test_alternative_transcripts_preserve_multiple_region_classes():
+    j = module()
+    txs = (j.Transcript("exonic", 1, 8, ((1, 8),)),
+           j.Transcript("intronic", 1, 8, ((1, 2), (7, 8))))
+    gene = j.Gene("g", "chrT", 1, 8, "+", transcripts=txs)
+    sites = j.enumerate_sites(ti.InMemoryGenome({"chrT": "AACCGGTT"}), [gene],
+                              [ti.ASO("a", "CCGG")], max_mismatch=0)
+    assert len(sites) == 1
+    assert sites[0].region_class == "transcript_dependent"
+    assert sites[0].region_classes == ("exon", "intron")
+
+
+def test_gene_gtf_reader_is_gene_only_region_bounded_and_assembly_fenced(tmp_path):
+    j = module()
+    path = tmp_path / "genes.gtf"
+    path.write_text('##description: genome (GRCh38), version 50\n'
+                    'chrT\tt\tgene\t1\t20\t.\t+\t.\tgene_id "g1"; gene_name "SMN2";\n'
+                    'chrT\tt\texon\tBROKEN\tIGNORED\t.\t+\t.\t.\n'
+                    'chrT\tt\tgene\t30\t40\t.\t-\t.\tgene_id "g2";\n')
+    genes = j.read_gene_bodies(path, region=("chrT", 10, 25))
+    assert [(g.gene_id, g.start1, g.end1, g.gene_name) for g in genes] == [("g1", 1, 20, "SMN2")]
+    for header in ["GRCh37, version 50", "GRCh38, version 49", "unknown"]:
+        path.write_text("##description: " + header + "\n")
+        with pytest.raises(ValueError):
+            j.read_gene_bodies(path)
+
+
+def test_region_limits_ownership_without_cutting_boundary_hit():
+    j = module()
+    gene = j.Gene("g", "chrT", 1, 12, "+")
+    genome = ti.InMemoryGenome({"chrT": "AAAAAAAAAAAA"})
+    shards = j.make_shards([gene], window_size=4, region=("chrT", 4, 6))
+    sites = [s for shard in shards for s in j.enumerate_sites(
+        genome, [gene], [ti.ASO("a", "TTTT")], max_mismatch=0, shard=shard)]
+    assert [s.start1 for s in sites] == [4, 5, 6]
+    assert len({s.site_id for s in sites}) == 3
+    assert j.make_shards([gene], window_size=4) == j.make_shards([gene, gene], window_size=4)
+
+
+def tiny_job(tmp_path):
+    j = module()
+    genome = ti.InMemoryGenome({"chrT": "AACCGGTT"})
+    genes = [j.Gene("g", "chrT", 1, 8, "+")]
+    asos = [ti.ASO("a", "CCGG")]
+    shard = j.make_shards(genes, window_size=8)[0]
+    return j, dict(genome=genome, genes=genes, asos=asos, shard=shard,
+                   output_dir=tmp_path, max_mismatch=0,
+                   identities={"fasta": {"test": "synthetic"}, "gtf": {"test": "synthetic"}})
+
+
+def test_atomic_parquet_manifest_and_restart_idempotence(tmp_path):
+    import pyarrow.parquet as pq
+    j, kwargs = tiny_job(tmp_path)
+    path = j.run_shard(**kwargs)
+    done = path.with_suffix(".done")
+    manifest = json.loads(done.read_text())
+    assert manifest["rows"] == 1
+    assert manifest["sha256"] == hashlib.sha256(path.read_bytes()).hexdigest()
+    assert manifest["params"]["max_mismatch"] == 0
+    assert manifest["identities"] == kwargs["identities"]
+    table = pq.read_table(path)
+    assert table.to_pylist()[0]["mismatch_positions"] == []
+    assert table.to_pylist()[0]["transcript_ids"] is None
+    mtimes = path.stat().st_mtime_ns, done.stat().st_mtime_ns
+    j.run_shard(**kwargs)
+    assert (path.stat().st_mtime_ns, done.stat().st_mtime_ns) == mtimes
+    assert not list(tmp_path.glob("*.tmp"))
+
+
+@pytest.mark.parametrize("damage", ["parquet", "manifest", "missing_done", "params", "identity", "genes", "rows"])
+def test_restart_rebuilds_incomplete_corrupt_or_stale_shards(tmp_path, damage):
+    j, kwargs = tiny_job(tmp_path)
+    path = j.run_shard(**kwargs)
+    done = path.with_suffix(".done")
+    if damage == "parquet":
+        path.write_bytes(b"corrupt")
+    elif damage == "manifest":
+        done.write_text("{")
+    elif damage == "missing_done":
+        done.unlink()
+    elif damage == "params":
+        kwargs["max_mismatch"] = 1
+    elif damage == "identity":
+        kwargs["identities"]["fasta"]["test"] = "changed"
+    elif damage == "genes":
+        kwargs["genes"] = [dataclasses.replace(kwargs["genes"][0], gene_id="new")]
+    else:
+        manifest = json.loads(done.read_text())
+        manifest["rows"] = 100
+        done.write_text(json.dumps(manifest))
+    j.run_shard(**kwargs)
+    manifest = json.loads(done.read_text())
+    assert manifest["rows"] == 1
+    assert manifest["sha256"] == hashlib.sha256(path.read_bytes()).hexdigest()
+    assert manifest["params"]["max_mismatch"] == kwargs["max_mismatch"]
+    assert manifest["identities"] == kwargs["identities"]
+    if damage == "genes":
+        import pyarrow.parquet as pq
+        assert pq.read_table(path).to_pylist()[0]["gene_id"] == "new"
+
+
+def test_empty_shard_has_typed_schema(tmp_path):
+    import pyarrow.parquet as pq
+    j, kwargs = tiny_job(tmp_path)
+    kwargs["asos"] = [ti.ASO("nohit", "AAAA")]
+    path = j.run_shard(**kwargs)
+    table = pq.read_table(path)
+    assert table.num_rows == 0
+    assert str(table.schema.field("start1").type) == "int64"
+    assert "mismatch_positions" in table.column_names
+
+
+def test_crash_between_parquet_and_marker_leaves_no_valid_commit(tmp_path, monkeypatch):
+    j, kwargs = tiny_job(tmp_path)
+    replace = j.os.replace
+
+    def crash_at_done(source, dest):
+        if str(dest).endswith(".done"):
+            raise OSError("simulated interruption")
+        return replace(source, dest)
+
+    monkeypatch.setattr(j.os, "replace", crash_at_done)
+    with pytest.raises(OSError, match="simulated interruption"):
+        j.run_shard(**kwargs)
+    assert len(list(tmp_path.glob("*.parquet"))) == 1
+    assert not list(tmp_path.glob("*.done"))
+    assert not list(tmp_path.glob("*.tmp"))
+    monkeypatch.setattr(j.os, "replace", replace)
+    path = j.run_shard(**kwargs)
+    assert path.with_suffix(".done").is_file()
+
+
+def test_stale_real_input_identity_cannot_resume(tmp_path):
+    j, kwargs = tiny_job(tmp_path / "output")
+    fasta = tmp_path / "reference.fa"
+    fasta.write_text(">chrT\nAACCGGTT\n")
+    kwargs["identities"]["fasta"] = j.file_identity(fasta)
+    j.run_shard(**kwargs)
+    fasta.write_text(">chrT\nAACCGGTTAAAA\n")
+    with pytest.raises(ValueError, match="identity changed"):
+        j.run_shard(**kwargs)
+
+
+def test_reference_mutation_during_enumeration_cannot_commit(tmp_path):
+    j, kwargs = tiny_job(tmp_path / "output")
+    fasta = tmp_path / "reference.fa"
+    fasta.write_text(">chrT\nAACCGGTT\n")
+    kwargs["identities"]["fasta"] = j.file_identity(fasta)
+
+    class ChangingGenome(ti.InMemoryGenome):
+        def fetch(self, chrom, start, end):
+            fasta.write_text(">chrT\nAACCGGTTAAAA\n")
+            return super().fetch(chrom, start, end)
+
+    kwargs["genome"] = ChangingGenome({"chrT": "AACCGGTT"})
+    with pytest.raises(ValueError, match="identity changed"):
+        j.run_shard(**kwargs)
+    assert not list((tmp_path / "output").glob("*.done"))
+
+
+def test_cli_with_synthetic_fai_gtf_and_idempotent_restart(tmp_path):
+    import os
+    import pyarrow.parquet as pq
+    fasta = tmp_path / "tiny.fa"
+    fasta.write_text(">chrT\nAACCGGTT\n")
+    fasta.with_suffix(".fa.fai").write_text("chrT\t8\t6\t8\t9\n")
+    gtf = tmp_path / "genes.gtf"
+    gtf.write_text('##description: genome (GRCh38), version 50\n'
+                   'chrT\tt\tgene\t1\t8\t.\t+\t.\tgene_id "g";\n')
+    out = tmp_path / "output"
+    cmd = [sys.executable, "-m", "conference.model_v2.j6_site_universe",
+           "--fasta", str(fasta), "--gtf", str(gtf), "--output-dir", str(out),
+           "--region", "chrT:1-8", "--max-mismatch", "0", "--window-size", "4"]
+    env = dict(os.environ, PYTHONPATH=str(ROOT / "feng/src"))
+    subprocess.run(cmd, check=True, env=env, cwd=ROOT, capture_output=True, text=True)
+    files = list(out.glob("*.done"))
+    assert len(files) == 2
+    mtimes = {p.name: p.stat().st_mtime_ns for p in files}
+    subprocess.run(cmd, check=True, env=env, cwd=ROOT, capture_output=True, text=True)
+    assert {p.name: p.stat().st_mtime_ns for p in files} == mtimes
+    assert sum(pq.read_metadata(p).num_rows for p in out.glob("*.parquet")) == 0
+
+
+@pytest.mark.parametrize("bad", [-1, 1.5, True])
+def test_invalid_budgets_fail_closed(bad):
+    j, kwargs = tiny_job(Path("unused"))
+    with pytest.raises((TypeError, ValueError)):
+        j.enumerate_sites(kwargs["genome"], kwargs["genes"], kwargs["asos"], max_mismatch=bad)
+
+
+def test_duplicate_ASO_ids_and_conflicting_gene_ids_fail_closed():
+    j, kw = tiny_job(Path("unused"))
+    with pytest.raises(ValueError):
+        j.enumerate_sites(kw["genome"], kw["genes"], kw["asos"] * 2)
+    with pytest.raises(ValueError):
+        j.enumerate_sites(kw["genome"], kw["genes"] + [
+            dataclasses.replace(kw["genes"][0], strand="-")], kw["asos"])
+
+
+def test_real_GRCh38_SMN1_SMN2_exact_hits_and_paralog_ambiguity():
+    j = module()
+    try:
+        genome = ti.FaiFastaReader()
+    except ti.GenomeAccessError as exc:
+        pytest.skip(str(exc))
+    genes = [j.Gene("SMN2", "chr5", 70076521, 70076674, "+", "SMN2"),
+             j.Gene("SMN1", "chr5", 70951941, 70952094, "+", "SMN1")]
+    asos = [ti.ASOS[a] for a in ("F18", "F14", "F10")]
+    sites = j.enumerate_sites(genome, genes, asos, max_mismatch=0)
+    for aso_id, length in [("F18", 18), ("F14", 14), ("F10", 10)]:
+        selected = [s for s in sites if s.aso_id == aso_id and s.start1 in (70076584, 70952004)]
+        assert {(s.gene_id, s.start1, s.end1) for s in selected} == {
+            ("SMN2", 70076584, 70076584 + length - 1),
+            ("SMN1", 70952004, 70952004 + length - 1)}
+        assert len({s.site_id for s in selected}) == 2
+        assert all(s.paralog_ambiguity for s in selected)
+    sharded = [s for shard in j.make_shards(genes, window_size=100)
+               for s in j.enumerate_sites(genome, genes, asos, max_mismatch=0, shard=shard)]
+    assert sharded == sorted(sites, key=j.site_sort_key)

