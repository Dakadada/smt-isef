"""Typed, versioned, immutable representation of an ASO intervention on a pre-mRNA locus.

Scope: bookkeeping only (identity, genomic placement, splice-junction geometry,
evidence labels). Nothing here predicts potency, occupancy or PSI; those are
carried as explicit ``unidentifiable`` predictions with no value.

Coordinates: 1-based inclusive, GRCh38, GENCODE v50, genomic (+ strand) numbering.
``target_sequence`` is always transcript-sense DNA == reverse complement of the ASO.

CLI: ``python -m conference.model_v2.trans_intervention {validate,place,schema}``
"""
from __future__ import annotations

import argparse
import hashlib
import json
import os
import sys
from dataclasses import dataclass, fields, is_dataclass
from pathlib import Path
from typing import Any, Dict, List, Mapping, Optional, Sequence, Tuple

SCHEMA_VERSION = "1.0.0"
ASSEMBLY = "GRCh38"
ANNOTATION = "GENCODE v50"

EVIDENCE_CLASSES = (
    "observed",
    "derived",
    "proxy",
    "model_assumption",
    "unlabeled",
    "not_available",
)
STATUSES = ("placed", "needs_human_confirmation", "no_match", "mismatch")
ROLES = ("reference", "alternate")
STRANDS = ("+", "-")
IDENTIFIABILITY = ("identifiable", "unidentifiable")
REGIONS = ("exonic", "intronic", "exon_intron_spanning")
END_REGIONS = ("exonic", "intronic_upstream", "intronic_downstream")

DEFAULT_FASTA = "~/orcd/scratch/feng/gencode/v50/GRCh38.primary_assembly.genome.fa"
FASTA_ENV = "TRANS_INTERVENTION_FASTA"
MAX_SLICE_BASES = 100_000
SCHEMA_DIR = Path(__file__).resolve().parent / "schema"
SCHEMA_FILENAME = "trans_intervention.schema.json"

_COMP = str.maketrans("ACGTN", "TGCAN")


class SchemaError(ValueError):
    """Structural or invariant violation in an intervention record."""


class ParalogJoinError(ValueError):
    """Attempt to join placements that belong to different loci."""


class GenomeAccessError(RuntimeError):
    """Fasta / index unavailable or a slice request is out of bounds."""


def _req(cond: bool, msg: str) -> None:
    if not cond:
        raise SchemaError(msg)


def normalize_sequence(seq: str) -> str:
    """Upper-case DNA alphabet (U -> T); only A/C/G/T accepted."""
    out = str(seq).strip().upper().replace("U", "T")
    _req(len(out) > 0, "empty sequence")
    _req(set(out) <= set("ACGT"), f"non-ACGT characters in sequence: {seq!r}")
    return out


def reverse_complement(seq: str) -> str:
    return seq.upper().translate(_COMP)[::-1]


# --------------------------------------------------------------------------- genome access
class InMemoryGenome:
    """Tiny sequence source for tests: {chrom: plus-strand sequence}."""

    def __init__(self, sequences: Mapping[str, str]):
        self._seqs = {k: v.upper() for k, v in sequences.items()}

    def length(self, chrom: str) -> int:
        if chrom not in self._seqs:
            raise GenomeAccessError(f"unknown contig {chrom!r}")
        return len(self._seqs[chrom])

    def fetch(self, chrom: str, start: int, end: int) -> str:
        n = self.length(chrom)
        if not (1 <= start <= end <= n):
            raise GenomeAccessError(f"slice {chrom}:{start}-{end} outside 1..{n}")
        return self._seqs[chrom][start - 1 : end]


class FaiFastaReader:
    """Pure-python random access via the ``.fai`` index (read-only, small slices)."""

    def __init__(self, fasta_path: Optional[str] = None):
        raw = fasta_path or os.environ.get(FASTA_ENV) or DEFAULT_FASTA
        self.path = Path(os.path.expanduser(str(raw)))
        self.fai_path = Path(str(self.path) + ".fai")
        if not self.path.is_file():
            raise GenomeAccessError(f"genome fasta not found: {self.path}")
        if not self.fai_path.is_file():
            raise GenomeAccessError(f"fasta index not found: {self.fai_path}")
        self._index: Dict[str, Tuple[int, int, int, int]] = {}
        with open(self.fai_path, "r", encoding="ascii") as fh:
            for line in fh:
                parts = line.rstrip("\n").split("\t")
                if len(parts) < 5:
                    continue
                self._index[parts[0]] = (int(parts[1]), int(parts[2]), int(parts[3]), int(parts[4]))

    def length(self, chrom: str) -> int:
        if chrom not in self._index:
            raise GenomeAccessError(f"unknown contig {chrom!r}")
        return self._index[chrom][0]

    def _offset(self, chrom: str, pos0: int) -> int:
        _, off, line_bases, line_width = self._index[chrom]
        return off + (pos0 // line_bases) * line_width + (pos0 % line_bases)

    def fetch(self, chrom: str, start: int, end: int) -> str:
        n = self.length(chrom)
        if not (1 <= start <= end <= n):
            raise GenomeAccessError(f"slice {chrom}:{start}-{end} outside 1..{n}")
        if end - start + 1 > MAX_SLICE_BASES:
            raise GenomeAccessError(f"slice larger than {MAX_SLICE_BASES} bases refused")
        first = self._offset(chrom, start - 1)
        last = self._offset(chrom, end - 1)
        with open(self.path, "rb") as fh:
            fh.seek(first)
            raw = fh.read(last - first + 1)
        seq = raw.replace(b"\n", b"").replace(b"\r", b"").decode("ascii").upper()
        if len(seq) != end - start + 1:
            raise GenomeAccessError(f"short read for {chrom}:{start}-{end}")
        return seq


# --------------------------------------------------------------------------- data model
@dataclass(frozen=True)
class Modification:
    position: int  # 1-based from the ASO 5' end
    sugar: str = "unknown"
    backbone: str = "unknown"
    base: str = "unknown"

    def __post_init__(self) -> None:
        _req(isinstance(self.position, int) and self.position >= 1, "modification position must be >= 1")


@dataclass(frozen=True)
class Chemistry:
    family: str = "unknown"
    modifications: Tuple[Modification, ...] = ()
    evidence: str = "not_available"

    def __post_init__(self) -> None:
        _req(self.evidence in EVIDENCE_CLASSES, f"bad evidence class {self.evidence!r}")
        _req(bool(self.family), "chemistry family must be non-empty ('unknown' allowed)")
        if self.family == "unknown":
            _req(self.evidence in ("not_available", "unlabeled"), "unknown chemistry must be not_available/unlabeled")
            _req(len(self.modifications) == 0, "unknown chemistry cannot list modifications")
        else:
            _req(self.evidence != "not_available", "known chemistry needs an evidence class")
        pos = [m.position for m in self.modifications]
        _req(len(pos) == len(set(pos)), "duplicate modification positions")
        _req(pos == sorted(pos), "modifications must be sorted by position")


@dataclass(frozen=True)
class ASO:
    aso_id: str
    sequence_5to3: str
    chemistry: Chemistry = Chemistry()
    requires_human_confirmation: bool = False
    sequence_evidence: str = "unlabeled"
    note: str = ""

    def __post_init__(self) -> None:
        _req(bool(self.aso_id), "aso_id required")
        object.__setattr__(self, "sequence_5to3", normalize_sequence(self.sequence_5to3))
        _req(self.sequence_evidence in EVIDENCE_CLASSES, f"bad evidence class {self.sequence_evidence!r}")
        for m in self.chemistry.modifications:
            _req(m.position <= self.length, f"modification position {m.position} beyond ASO length {self.length}")

    @property
    def length(self) -> int:
        return len(self.sequence_5to3)

    @property
    def target_sequence(self) -> str:
        """Transcript-sense DNA the ASO base-pairs with."""
        return reverse_complement(self.sequence_5to3)


@dataclass(frozen=True)
class Locus:
    """One exon-centred pre-mRNA locus. Paralogs are distinct loci, never merged."""

    locus_id: str
    gene: str
    paralog_group: str
    role: str
    chrom: str
    strand: str
    search_start: int
    search_end: int
    exon_label: str
    exon_start: int  # genomic, 1-based inclusive
    exon_end: int
    coords_evidence: str = "derived"
    assembly: str = ASSEMBLY
    annotation: str = ANNOTATION
    note: str = ""

    def __post_init__(self) -> None:
        _req(bool(self.locus_id), "locus_id required")
        _req(self.role in ROLES, f"bad role {self.role!r}")
        _req(self.strand in STRANDS, f"bad strand {self.strand!r}")
        _req(self.coords_evidence in EVIDENCE_CLASSES, f"bad evidence class {self.coords_evidence!r}")
        _req(1 <= self.search_start <= self.search_end, "bad search window")
        _req(self.search_start <= self.exon_start <= self.exon_end <= self.search_end, "exon outside search window")

    @property
    def sign(self) -> int:
        return 1 if self.strand == "+" else -1

    @property
    def donor_last_exonic_base(self) -> int:
        return self.exon_end if self.strand == "+" else self.exon_start

    @property
    def donor_first_intronic_base(self) -> int:
        return self.donor_last_exonic_base + self.sign

"""Complete seed-and-extend candidate scanning for the clean-room Feng arm.

The scanner reports sequence-similarity candidates only. It does not estimate
hybridization thermodynamics or splice activity. Coordinates are zero-based,
half-open offsets into each supplied reference sequence, and the caller must supply
the query in the orientation expected to match the reference.

The default seed policy partitions a query into ``budget + 1`` nonempty, balanced
blocks. An alignment with at most ``budget`` substitutions (Hamming mode) or edit
operations (edit mode) must leave at least one block exactly matched by the
pigeonhole principle, so extending every occurrence of every block cannot miss an
eligible interval. When a nonempty exact seed cannot be guaranteed, the scanner
falls back to exhaustive extension rather than sacrificing completeness.
"""

from __future__ import annotations

from collections.abc import Mapping
from dataclasses import dataclass
from enum import Enum


_CANONICAL_BASES = frozenset("ACGT")
_IUPAC_BASES = frozenset("ACGTRYSWKMBDHVN")


class SeedLengthPolicy(str, Enum):
    """Completeness-preserving policies for selecting candidate intervals."""

    BALANCED = "balanced"
    EXHAUSTIVE = "exhaustive"


@dataclass(frozen=True, order=True, slots=True)
class HybridizationHit:
    """One sequence candidate in a named reference.

    ``mismatches`` is the Hamming count in fixed-window mode. In edit mode it is
    the substitution count in the minimum-edit alignment, with fewer substitutions
    used as the deterministic tie-break between equally short alignments.
    """

    reference_name: str
    start: int
    end: int
    mismatches: int
    edit_distance: int


def seed_and_extend(
    query: str,
    reference: str | Mapping[str, str],
    *,
    max_mismatch: int | None = None,
    max_edit: int | None = None,
    seed_policy: SeedLengthPolicy | str = SeedLengthPolicy.BALANCED,
    reference_name: str = "reference",
) -> tuple[HybridizationHit, ...]:
    """Return every reference interval within the declared sequence budget.

    Args:
        query: Nonempty oligo sequence in reference-matching orientation. ``U`` and
            ``T`` compare as equivalent. IUPAC ambiguity symbols are valid input but
            count as mismatches rather than as wildcards.
        reference: One sequence or a mapping of reference names to sequences.
        max_mismatch: Maximum substitutions. When ``max_edit`` is absent this selects
            fixed-length Hamming mode and defaults to zero. In edit mode it is an
            optional cap on substitutions in the optimal alignment.
        max_edit: When provided, select variable-length edit mode and require
            Levenshtein distance at most this value.
        seed_policy: ``balanced`` uses the pigeonhole-complete partition described in
            the module docstring; ``exhaustive`` disables seeding for audit use.
        reference_name: Name assigned when ``reference`` is a single sequence.

    Returns:
        A deterministically sorted tuple of unique :class:`HybridizationHit` values.

    Raises:
        TypeError: If sequences, names, or budgets have invalid types.
        ValueError: If the query is empty, a sequence contains a non-IUPAC symbol, a
            budget is negative, a reference name is empty, or the policy is unknown.

    Hamming mode evaluates query-length windows. Edit mode evaluates every nonempty
    window whose length differs from the query by at most ``max_edit``. Seeding only
    prunes which of those windows require extension; it never changes eligibility.
    """
    normalized_query = _normalize_sequence(query, label="query", allow_empty=False)
    references = _normalize_references(reference, reference_name)
    mismatch_budget = _validate_budget(max_mismatch, "max_mismatch")
    edit_budget = _validate_budget(max_edit, "max_edit")
    try:
        policy = SeedLengthPolicy(seed_policy)
    except (TypeError, ValueError) as error:
        choices = ", ".join(item.value for item in SeedLengthPolicy)
        raise ValueError(f"seed_policy must be one of: {choices}") from error

    if edit_budget is None:
        effective_mismatch_budget = 0 if mismatch_budget is None else mismatch_budget
        hits = _scan_hamming(
            normalized_query,
            references,
            effective_mismatch_budget,
            policy,
        )
    else:
        hits = _scan_edit(
            normalized_query,
            references,
            mismatch_budget,
            edit_budget,
            policy,
        )
    return tuple(sorted(hits))


def _normalize_sequence(sequence: str, *, label: str, allow_empty: bool) -> str:
    if not isinstance(sequence, str):
        raise TypeError(f"{label} must be a string")
    normalized = sequence.upper().replace("U", "T")
    if not normalized and not allow_empty:
        raise ValueError(f"{label} must not be empty")
    invalid = sorted(set(normalized) - _IUPAC_BASES)
    if invalid:
        raise ValueError(f"{label} contains non-IUPAC symbols: {''.join(invalid)}")
    return normalized


def _normalize_references(
    reference: str | Mapping[str, str],
    reference_name: str,
) -> tuple[tuple[str, str], ...]:
    if isinstance(reference, str):
        items = ((reference_name, reference),)
    elif isinstance(reference, Mapping):
        items = tuple(reference.items())
    else:
        raise TypeError("reference must be a sequence string or a name-to-sequence mapping")

    normalized: list[tuple[str, str]] = []
    for name, sequence in items:
        if not isinstance(name, str):
            raise TypeError("reference names must be strings")
        if not name:
            raise ValueError("reference names must not be empty")
        normalized.append(
            (name, _normalize_sequence(sequence, label=f"reference {name!r}", allow_empty=True))
        )
    return tuple(normalized)


def _validate_budget(value: int | None, label: str) -> int | None:
    if value is None:
        return None
    if type(value) is not int:
        raise TypeError(f"{label} must be an integer")
    if value < 0:
        raise ValueError(f"{label} must be nonnegative")
    return value


def _bases_match(left: str, right: str) -> bool:
    return left in _CANONICAL_BASES and right in _CANONICAL_BASES and left == right


def _hamming_distance(query: str, target: str) -> int:
    return sum(not _bases_match(left, right) for left, right in zip(query, target, strict=True))


def _alignment_cost(query: str, target: str) -> tuple[int, int]:
    """Return minimum edit distance and its minimum substitution tie-break."""
    previous = [(column, 0) for column in range(len(target) + 1)]
    for row, query_base in enumerate(query, start=1):
        current = [(row, 0)]
        for column, target_base in enumerate(target, start=1):
            deletion = (previous[column][0] + 1, previous[column][1])
            insertion = (current[column - 1][0] + 1, current[column - 1][1])
            if _bases_match(query_base, target_base):
                diagonal = previous[column - 1]
            else:
                diagonal = (previous[column - 1][0] + 1, previous[column - 1][1] + 1)
            current.append(min(deletion, insertion, diagonal))
        previous = current
    return previous[-1]


def _balanced_seeds(query: str, budget: int) -> tuple[tuple[int, str], ...]:
    if budget >= len(query):
        return ()
    block_count = budget + 1
    short_length, longer_blocks = divmod(len(query), block_count)
    offset = 0
    seeds: list[tuple[int, str]] = []
    for index in range(block_count):
        length = short_length + (index < longer_blocks)
        seeds.append((offset, query[offset : offset + length]))
        offset += length
    return tuple(seeds)


def _exact_occurrences(reference: str, seed: str) -> tuple[int, ...]:
    if any(base not in _CANONICAL_BASES for base in seed):
        return ()
    positions: list[int] = []
    position = reference.find(seed)
    while position != -1:
        positions.append(position)
        position = reference.find(seed, position + 1)
    return tuple(positions)


def _hamming_candidate_starts(
    query: str,
    reference: str,
    budget: int,
    policy: SeedLengthPolicy,
) -> set[int]:
    final_start = len(reference) - len(query)
    if final_start < 0:
        return set()
    seeds = () if policy is SeedLengthPolicy.EXHAUSTIVE else _balanced_seeds(query, budget)
    if not seeds:
        return set(range(final_start + 1))
    starts: set[int] = set()
    for query_offset, seed in seeds:
        for occurrence in _exact_occurrences(reference, seed):
            start = occurrence - query_offset
            if 0 <= start <= final_start:
                starts.add(start)
    return starts


def _scan_hamming(
    query: str,
    references: tuple[tuple[str, str], ...],
    budget: int,
    policy: SeedLengthPolicy,
) -> set[HybridizationHit]:
    hits: set[HybridizationHit] = set()
    for name, sequence in references:
        for start in _hamming_candidate_starts(query, sequence, budget, policy):
            end = start + len(query)
            mismatches = _hamming_distance(query, sequence[start:end])
            if mismatches <= budget:
                hits.add(HybridizationHit(name, start, end, mismatches, mismatches))
    return hits


def _edit_candidate_intervals(
    query: str,
    reference: str,
    budget: int,
    policy: SeedLengthPolicy,
) -> set[tuple[int, int]]:
    minimum_length = max(1, len(query) - budget)
    maximum_length = len(query) + budget
    seeds = () if policy is SeedLengthPolicy.EXHAUSTIVE else _balanced_seeds(query, budget)

    if not seeds:
        return {
            (start, start + length)
            for start in range(len(reference))
            for length in range(
                minimum_length,
                min(maximum_length, len(reference) - start) + 1,
            )
        }

    intervals: set[tuple[int, int]] = set()
    for query_offset, seed in seeds:
        for occurrence in _exact_occurrences(reference, seed):

